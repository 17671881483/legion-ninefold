  "sourceEvidence": [
    {
      "line": 29774,
      "text": "function SetTargetAttackFormAbility takes unit Pf,unit Om,integer Ph returns nothing"
    },
    {
      "line": 29775,
      "text": "local unit Ki=CreateUnit(GetOwningPlayer(Pf),$65303057,GetUnitX(Om),GetUnitY(Om),270)"
    },
    {
      "line": 29776,
      "text": "call SetUnitUserData(Ki,GetUnitUserData(Pf))"
    },
    {
      "line": 29777,
      "text": "call GroupAddUnit(JH[GetUnitUserData(Pf)],Ki)"
    },
    {
      "line": 29778,
      "text": "call UnitAddType(Ki,UNIT_TYPE_SUMMONED)"
    },
    {
      "line": 29779,
      "text": "call UnitAddAbility(Ki,Ph)"
    },
    {
      "line": 29780,
      "text": "call IssueTargetOrder(Ki,\"attack\",Om)"
    },
    {
      "line": 29781,
      "text": "call UnitApplyTimedLife(Ki,$42487765,5)"
    },
    {
      "line": 29782,
      "text": "set Pf=null"
    },
    {
      "line": 29783,
      "text": "set Om=null"
    },
    {
      "line": 29784,
      "text": "set Ki=null"
    },
    {
      "line": 29785,
      "text": "endfunction"
    },
    {
      "line": 29786,
      "text": "function SelectRange takes unit Pf,real FF,real FG,real Px returns group"
    },
    {
      "line": 29787,
      "text": "local group DG=CreateGroup()"
