      "line": 32969,
      "text": "function NagaAttack takes unit Bc,unit Om returns nothing"
    },
    {
      "line": 32970,
      "text": "local unit Ki"
    },
    {
      "line": 32971,
      "text": "if GetRandomPercentageBJ()<=15 then"
    },
    {
      "line": 32972,
      "text": "set Ki=CreateUnit(GetOwningPlayer(Bc),Pn,GetUnitX(Bc),GetUnitY(Bc),GetUnitFacing(Bc))"
    },
    {
      "line": 32973,
      "text": "call UnitAddAbility(Ki,$4131444E)"
    },
    {
      "line": 32974,
      "text": "call UnitApplyTimedLife(Ki,$42487765,1)"
    },
    {
      "line": 32975,
      "text": "call IssueTargetOrder(Ki,\"sleep\",Om)"
    },
    {
      "line": 32976,
      "text": "set Ki=null"
    },
    {
      "line": 32977,
      "text": "endif"
    },
    {
      "line": 32978,
      "text": "set Bc=null"
    },
    {
      "line": 32979,
      "text": "set Om=null"
    },
    {
      "line": 32980,
      "text": "endfunction"
    },
    {
      "line": 42252,
      "text": "function Trig_New_UnitAttackActions takes nothing returns boolean"
    },
    {
      "line": 42253,
      "text": "local unit Qf=GetTriggerUnit()"
    },
    {
      "line": 42254,
      "text": "local unit i=GetEventDamageSource()"
    },
    {
      "line": 42255,
      "text": "local integer BF=GetUnitTypeId(i)"
    },
    {
      "line": 42270,
      "text": "if YDWEIsEventAttackDamage() and not LoadBoolean(O,GetHandleId(i),StringHash(\"Attack\")) then"
    },
    {
      "line": 42271,
      "text": "call SaveBoolean(O,GetHandleId(i),StringHash(\"Attack\"),true)"
    },
    {
      "line": 42272,
      "text": "if GetUnitAbilityLevel(i,$4131554B)>0 then"
    },
    {
      "line": 42273,
      "text": "call NazuoCurseAttack(i,Qf,GetUnitAbilityLevel(i,$4131554B))"
    },
    {
      "line": 42274,
      "text": "endif"
    },
    {
      "line": 42275,
      "text": "if GetUnitAbilityLevel(i,$41315652)>0 then"
    },
    {
      "line": 42276,
      "text": "call ArthasAttack(i,Qf,GetEventDamage())"
    },
    {
      "line": 42277,
      "text": "call ArthasReadyAttack(i,GetEventDamage())"
    },
    {
      "line": 42278,
      "text": "endif"
    },
    {
      "line": 42279,
      "text": "if GetUnitAbilityLevel(i,$4131444F)>0 then"
    },
    {
      "line": 42280,
      "text": "call NagaAttack(i,Qf)"
    },
    {
      "line": 42281,
      "text": "endif"
    },
    {
      "line": 42794,
      "text": "call SaveBoolean(O,GetHandleId(i),StringHash(\"Attack\"),false)"
    },
    {
      "line": 42795,
      "text": "endif"
    },
    {
      "line": 42804,
      "text": "function InitTrig_New_UnitAttack takes nothing returns nothing"
    },
    {
      "line": 42805,
      "text": "set b4=CreateTrigger()"
    },
    {
      "line": 42806,
      "text": "call YDWESyStemAnyUnitDamagedRegistTrigger(b4)"
    },
    {
      "line": 42807,
      "text": "call TriggerAddCondition(b4,Condition(function Trig_New_UnitAttackActions))"
    },
    {
      "line": 42808,
      "text": "endfunction"
    },
    {
      "line": 49754,
      "text": "call InitTrig_New_UnitAttack()"
    }
