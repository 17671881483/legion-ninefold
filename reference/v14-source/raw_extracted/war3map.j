function Anduin___SelectRange takes unit Pf,real FF,real FG,real Px returns group
local group DG=CreateGroup()
local group Om=CreateGroup()
local unit D6=null
call GroupEnumUnitsInRange(DG,FF,FG,Px,null)
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
if IsUnitEnemy(D6,GetOwningPlayer(Pf)) and not IsUnitType(D6,UNIT_TYPE_DEAD) and GetUnitAbilityLevel(D6,$4176756C)==0 then
call GroupAddUnit(Om,D6)
endif
call GroupRemoveUnit(DG,D6)
endloop
call DestroyGroup(DG)
set DG=null
set D6=null
set Pf=null
set Py=Om
set Om=null
return Py
endfunction
function Anduin___ApplyDamage takes unit Ei,real FF,real FG returns nothing
local group aJ=Anduin___SelectRange(Ei,FF,FG,aI)
local unit D6
loop
set D6=FirstOfGroup(aJ)
exitwhen D6==null
call UnitDamageTargetBJ(Ei,D6,aK,ATTACK_TYPE_MAGIC,DAMAGE_TYPE_MAGIC)
call GroupRemoveUnit(aJ,D6)
endloop
call DestroyGroup(aJ)
set aJ=null
set Ei=null
set D6=null
endfunction
function Anduin___CloudEffectTick takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer aE=GetHandleId(t)
local unit Ei=LoadUnitHandle(O,aE,0)
local real aH=LoadReal(O,aE,1)
call Anduin___ApplyDamage(Ei,LoadReal(O,aE,3),LoadReal(O,aE,4))
call SetUnitState(Ei,UNIT_STATE_LIFE,GetUnitState(Ei,UNIT_STATE_LIFE)+aL)
set aH=aH-1.
call SaveReal(O,aE,1,aH)
if aH<=0 then
call DestroyEffect(LoadEffectHandle(O,aE,2))
call FlushChildHashtable(O,aE)
call DestroyTimer(t)
set t=null
set Ei=null
return
endif
set t=null
set Ei=null
endfunction
function Anduin_CreateRainCloud takes unit Ei,real FF,real FG returns nothing
local timer t
local integer aE
if IsUnitType(Ei,UNIT_TYPE_ANCIENT) then
set Ei=null
return
endif
set t=CreateTimer()
set aE=GetHandleId(t)
call SaveUnitHandle(O,aE,0,Ei)
call SaveReal(O,aE,1,aF)
call SaveReal(O,aE,3,FF)
call SaveReal(O,aE,4,FG)
if GetUnitTypeId(Ei)==$68305842 then
call SaveAgentHandle(O,aE,2,AddSpecialEffect("Bjladyayqs01_Spell02.mdx",FF,FG))
else
call SaveAgentHandle(O,aE,2,AddSpecialEffect(aG,FF,FG))
endif
call TimerStart(t,1.,true,function Anduin___CloudEffectTick)
set t=null
set Ei=null
endfunction
function Anduin_SetUnitDamage takes unit Om,real P8 returns nothing
if GetUnitAbilityLevel(Om,$42303830)>0 then
call EXSetEventDamage(P8*(1-.3))
endif
set Om=null
endfunction
function Anduin___EggCheckTimer takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
local group DG=CreateGroup()
local unit D6
set bj_groupEnumTypeId=$6830505A
call GroupEnumUnitsOfPlayer(DG,GetOwningPlayer(Bc),filterGetUnitsOfPlayerAndTypeId)
if CountUnitsInGroup(DG)==0 then
set bj_groupEnumTypeId=$68305843
call GroupEnumUnitsOfPlayer(DG,GetOwningPlayer(Bc),filterGetUnitsOfPlayerAndTypeId)
endif
if CountUnitsInGroup(DG)>0 then
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
if GetUnitUserData(D6)==GetUnitUserData(Bc) then
call UnitAddAbility(D6,$41315355)
call UnitMakeAbilityPermanent(D6,true,$41315355)
call UnitAddAbility(D6,$41315354)
call UnitMakeAbilityPermanent(D6,true,$41315354)
call UnitAddAbility(Bc,$41315355)
call UnitMakeAbilityPermanent(Bc,true,$41315355)
call UnitAddAbility(Bc,$41315354)
call UnitMakeAbilityPermanent(Bc,true,$41315354)
endif
endloop
endif
call DestroyGroup(DG)
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTimer(t)
set t=null
set Bc=null
set DG=null
set D6=null
endfunction
function Anduin_EggCheck takes unit Bc returns nothing
local timer t=CreateTimer()
call SaveUnitHandle(O,GetHandleId(t),0,Bc)
call TimerStart(t,1,false,function Anduin___EggCheckTimer)
set t=null
set Bc=null
endfunction
function GetFoodMaxLevel takes integer BF returns integer
if BF!=C9 then
return S2I(LoadStr(B,BF,StringHash("maxlevel")))
endif
if DB then
return DC
endif
return DD
endfunction
function IsUnitRevive takes unit Bc returns boolean
local integer BB=0
loop
exitwhen BB>n
if GetUnitAbilityLevel(Bc,m[BB])>0 then
set Bc=null
return true
endif
set BB=BB+1
endloop
set Bc=null
return false
endfunction
