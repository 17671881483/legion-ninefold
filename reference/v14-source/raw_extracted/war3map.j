call TriggerRegisterDeathEvent(t,Bc)
call TriggerRegisterTimerEvent(t,.2,true)
call TriggerRegisterTimerEvent(t,0,false)
call TriggerAddAction(t,function ArthasSoaringWindImpactAction)
call SaveAgentHandle(O,GetHandleId(t),0,Bc)
call SaveReal(O,GetHandleId(t),1,GetUnitX(Om))
call SaveReal(O,GetHandleId(t),2,GetUnitY(Om))
set Bc=null
set Om=null
set t=null
endfunction
