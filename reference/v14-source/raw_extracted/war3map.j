function ArthasSoaringWindImpactAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
local real FF=LoadReal(O,GetHandleId(t),1)
local real FG=LoadReal(O,GetHandleId(t),2)
local real Pm=GetRandomDirectionDeg()
local real Qx=GetRandomReal(0,600)
local real Qv=FF+CosBJ(Pm)*Qx
local real Qw=FG+SinBJ(Pm)*Qx
local group DG=SelectRange(Bc,Qv,Qw,300)
local unit D6
call DestroyEffect(AddSpecialEffect(ArthasModel("LJQ_AlsaceDark_LFCJ.mdx","Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdl"),Qv,Qw))
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
call UnitDamageTargetBJ(Bc,D6,78,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
endloop
call DestroyGroup(DG)
if GetTriggerExecCount(t)*.2>=6 or GetTriggerEventId()==EVENT_WIDGET_DEATH then
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
endif
set t=null
set Bc=null
set DG=null
endfunction
function ArthasSoaringWindImpact takes unit Bc,unit Om returns nothing
