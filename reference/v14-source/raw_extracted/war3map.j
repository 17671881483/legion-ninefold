endfunction
function SkillTriggerGuldanFel takes nothing returns nothing
local unit i=GetSpellAbilityUnit()
local unit D6=null
local group DG=SelectRangeAlly(i,GetUnitX(i),GetUnitY(i),1200)
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
if D6!=i then
call UnitAddAbility(D6,$41683038)
call UnitMakeAbilityPermanent(D6,true,$41683038)
endif
set D6=null
endloop
call DestroyGroup(DG)
set DG=null
set D6=null
set i=null
endfunction
function SkillTriggerOldTeamFlag takes nothing returns nothing
if GetSpellAbilityId()==$41303445 then
if IsPlayerAlly(GetOwningPlayer(GetSpellAbilityUnit()),Player(8)) and GetSpellAbilityId()==$41303445 then
set NJ=true
call ForForce(oldcodefn_CN(Player(8)),function jP)
endif
if IsPlayerAlly(GetOwningPlayer(GetSpellAbilityUnit()),Player(9)) and GetSpellAbilityId()==$41303445 then
set NK=true
call ForForce(oldcodefn_CN(Player(9)),function OC5F_LP)
endif
elseif GetSpellAbilityId()==$41303446 then
set NJ=false
call ForForce(oldcodefn_CN(Player(8)),function kP)
set NK=false
call ForForce(oldcodefn_CN(Player(9)),function oldcodefn_MP)
endif
endfunction
function Trig_SkillTriggerActions takes nothing returns nothing
local integer BF=GetSpellAbilityId()
if BF==$41323948 then
call SkillTriggerVillageCall()
elseif BF==$41683037 then
call SkillTriggerGuldanFel()
elseif BF==$41303445 or BF==$41303446 then
call SkillTriggerOldTeamFlag()
endif
endfunction
function Trig_SkillTriggerConditions takes nothing returns boolean
local integer BF=GetSpellAbilityId()
if BF==$41323948 or BF==$41683037 or BF==$41303445 or BF==$41303446 then
return true
endif
return false
endfunction
function InitTrig_SkillTrigger takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(t,Condition(function Trig_SkillTriggerConditions))
call TriggerAddAction(t,function Trig_SkillTriggerActions)
set t=null
endfunction
