function BoxGiftIsOwnedAlive takes player h,unit i returns boolean
local boolean DJ=false
if i!=null then
if GetOwningPlayer(i)==h and not IsUnitType(i,UNIT_TYPE_DEAD) then
set DJ=true
endif
endif
set h=null
