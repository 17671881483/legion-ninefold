call RemoveSkillList(Pf,StringHash("box2"))
else
call DisplayTimedTextToPlayer(h,0,0,10,"伐木等级已满!!!")
endif
elseif BN==$41313332 then
set D1=LoadRectHandle(O,GetHandleId(h),StringHash("building_rect"))
if RectContainsCoords(D1,FF,FG) then
set Ki=CreateUnit(h,KM[GetRandomInt(1,I7[3])],FF,FG,270)
call GroupAddUnit(Bu,Ki)
call TriggerExecute(Bv)
