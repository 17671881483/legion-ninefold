function vf takes nothing returns nothing
local trigger t
local unit i=GetEnumUnit()
local player BF=GetOwningPlayer(i)
local integer Pd=0
local integer Pe=0
set Nr=GetEnumUnit()
set Pb=GetUnitLoc(Nr)
call ShowUnitHide(Nr)
if Dg<13 or LoadBoolean(O,GetPlayerId(BF),StringHash("201111")) then
if IsPlayerAlly(GetOwningPlayer(Nr),Player(8)) then
set Pc=Player(8)
else
set Pc=Player(9)
endif
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=M2
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
if GetUnitTypeId(Nr)==Ml[bj_forLoopAIndex] then
set Bi=bj_forLoopAIndex
endif
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
if GetUnitAbilityLevel(i,$41304C50)>0 and GetPlayerTechCountSimple($52303159,GetOwningPlayer(i))==1 then
set Pd=1
endif
if LoadBoolean(O,GetHandleId(i),StringHash("A0Z1")) then
set Pe=1
endif
if LoadBoolean(O,GetHandleId(i),StringHash("A0Z2")) then
set Pe=2
endif
set Kc=CreateUnit(Pc,Mk[Bi],GetLocationX(Pb),GetLocationY(Pb),bj_UNIT_FACING)
call SetUnitUserData(Kc,1+GetPlayerId(GetOwningPlayer(Nr)))
call ExecuteFunc("PassiveSkillNoArgJJC")
if Pe==1 then
call UnitAddAbility(Kc,$41305A30)
call UnitAddAbility(Kc,$41305A31)
call UnitMakeAbilityPermanent(Kc,true,$41305A30)
call UnitMakeAbilityPermanent(Kc,true,$41305A31)
elseif Pe==2 then
call UnitAddAbility(Kc,$41305A32)
call UnitMakeAbilityPermanent(Kc,true,$41305A32)
call YDWEGeneralBounsSystemUnitSetBonus(Kc,0,0,300)
endif
if Pd==1 then
if GetUnitAbilityLevel(Kc,$41304C50)>0 then
call UnitAddAbility(Kc,$41304C4F)
call UnitAddAbility(Kc,$41304C51)
else
call UnitAddAbility(Kc,$41304C52)
endif
endif
if GetUnitAbilityLevel(Kc,$41304B51)>0 then
set t=CreateTrigger()
call TriggerAddAction(t,function Arthas)
call SaveUnitHandle(O,GetHandleId(t),StringHash("Death_Knight"),Kc)
call SavePlayerHandle(O,GetHandleId(t),StringHash("P_Id"),BF)
call TriggerRegisterUnitLifeEvent(t,Kc,LESS_THAN_OR_EQUAL,0)
call TriggerRegisterUnitEvent(t,Kc,EVENT_UNIT_SPELL_EFFECT)
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_DEATH)
set t=null
elseif GetUnitTypeId(Kc)==$68304433 or GetUnitTypeId(Kc)==$68324132 then
call SaveInteger(O,GetHandleId(BF),StringHash("Bone_Dragon"),LoadInteger(O,GetHandleId(BF),StringHash("Bone_Dragon"))+1)
call SavePlayerHandle(O,GetHandleId(Kc),StringHash("P_id"),BF)
endif
if GetUnitTypeId(Kc)==$68304A52 then
call SaveUnitHandle(O,GetHandleId(BF),StringHash("h0JR"),Kc)
endif
if GetUnitTypeId(Kc)==$68304A4A then
call SaveInteger(O,GetHandleId(BF),StringHash("HP200"),LoadInteger(O,GetHandleId(BF),StringHash("HP200"))+1)
endif
if GetUnitTypeId(Kc)==$68303342 or GetUnitTypeId(Kc)==$68304F43 then
call SaveInteger(O,GetHandleId(BF),StringHash("HP50"),LoadInteger(O,GetHandleId(BF),StringHash("HP50"))+1)
endif
if GetUnitTypeId(Kc)==$68303343 then
call SaveInteger(O,GetHandleId(BF),StringHash("Speed1"),LoadInteger(O,GetHandleId(BF),StringHash("Speed1"))+1)
endif
if GetUnitTypeId(Kc)==$68304A4E or GetUnitTypeId(Kc)==$68304F5A then
call SaveInteger(O,GetHandleId(BF),StringHash("Speed3"),LoadInteger(O,GetHandleId(BF),StringHash("Speed3"))+1)
endif
if GetUnitTypeId(Kc)==$68304A50 then
call SaveInteger(O,GetHandleId(BF),StringHash("Attack20"),LoadInteger(O,GetHandleId(BF),StringHash("Attack20"))+1)
endif
if GetUnitTypeId(Kc)==$68303344 then
call SaveInteger(O,GetHandleId(BF),StringHash("Attack5"),LoadInteger(O,GetHandleId(BF),StringHash("Attack5"))+1)
endif
call War_BUFF(Kc)
if GetUnitAbilityLevel(Kc,$41706878)>0 then
call Phoenix(Kc)
endif
call SetUnitColor(Kc,GetPlayerColor(GetOwningPlayer(Nr)))
call SetUnitUserData(Kc,1+GetPlayerId(GetOwningPlayer(Nr)))
if IsPlayerAlly(GetOwningPlayer(Kc),Player(8)) then
call GroupAddUnit(Jx,Kc)
else
call GroupAddUnit(Jw,Kc)
endif
if GetUnitTypeId(Kc)==$6E303452 or GetUnitTypeId(Kc)==$6E30344F then
call UnitRemoveAbility(Kc,$41305152)
call UnitRemoveAbility(Kc,$41305153)
endif
call UnitResetCooldown(Kc)
call SetUnitMoveSpeed(Kc,0.)
call SetUnitPathing(Kc,true)
call IssuePointOrderByIdLoc(Kc,851986,GetPlayerStartLocationLoc(GetOwningPlayer(Nr)))
call RemoveLocation(Pb)
endif
set i=null
set BF=null
endfunction
