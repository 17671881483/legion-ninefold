function GetStrEx takes integer BB returns string
if BB>Er then
return ""
endif
return Ep[BB]
endfunction
function StrEx takes string En returns integer
local integer y=0
local integer BB=0
local integer Eq=0
local string Bj=""
local integer Eo=StringLength(En)
set Ep[0]=En
if En=="" then
return 0
endif
loop
set Bj=SubString(En,BB,BB+1)
exitwhen Bj=="" or Bj==null or BB>Eo
if Bj==" " then
set y=y+1
set Ep[y]=SubString(En,Eq,BB)
set Eq=BB+1
set BB=BB+1
endif
set BB=BB+1
endloop
set y=y+1
set Ep[y]=SubString(En,Eq,BB)
set Er=y
return y
endfunction
