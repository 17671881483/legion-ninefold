function GarroshLethalStrikeAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
local unit Pf=LoadUnitHandle(O,GetHandleId(t),1)
local effect DE
if GetKillingUnit()==Bc then
if GetUnitAbilityLevel(Bc,Qk)<100 then
if GetUnitAbilityLevel(Bc,Qk)==0 then
call UnitAddAbility(Bc,Qk)
call UnitAddAbility(Pf,Qk)
else
call SetUnitAbilityLevel(Bc,Qk,GetUnitAbilityLevel(Bc,Qk)+1)
call SetUnitAbilityLevel(Pf,Qk,GetUnitAbilityLevel(Pf,Qk)+1)
endif
else
call UnitRemoveAbility(Bc,Qk)
call UnitRemoveAbility(Pf,Qk)
call AoeDamage(Bc,GetUnitX(Bc),GetUnitY(Bc),600,5000,ATTACK_TYPE_MELEE,DAMAGE_TYPE_MAGIC)
call SetUnitAnimation(Bc,"spell")
set DE=AddSpecialEffect("TX_LJQ_yueya.mdx",GetUnitX(Bc),GetUnitY(Bc))
call EXEffectMatRotateZ(DE,GetUnitFacing(Bc))
call EXSetEffectSize(DE,2)
call YDWETimerDestroyEffect(.2,DE)
set DE=null
endif
elseif GetTriggerUnit()==Bc then
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
endif
set t=null
set Bc=null
set Pf=null
endfunction
function GarroshLethalStrike takes unit Bc,unit Pf returns nothing
local trigger t=CreateTrigger()
call SaveAgentHandle(O,GetHandleId(t),0,Bc)
call SaveAgentHandle(O,GetHandleId(t),1,Pf)
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_DEATH)
call TriggerAddAction(t,function GarroshLethalStrikeAction)
set Bc=null
set t=null
set Pf=null
endfunction
function GarroshGroundBreakingAxeCallBackEx takes nothing returns nothing
local trigger t=GetChargeTrigger()
local unit Bc=GetChargeSource()
local unit Ki=GetChargeDummy()
local group DG=LoadGroupHandle(O,GetHandleId(t),StringHash("group"))
local group Po=SelectRange(Bc,GetUnitX(Ki),GetUnitY(Ki),300)
local unit D6
local real Pm
local real QT=GetChargeSpeed()
if DG==null then
set DG=CreateGroup()
call SaveAgentHandle(O,GetHandleId(t),StringHash("group"),DG)
endif
loop
set D6=FirstOfGroup(Po)
exitwhen D6==null
call GroupRemoveUnit(Po,D6)
set Pm=GetAngleFromUnit(Ki,D6)
if LoadBoolean(O,GetHandleId(Ki),StringHash("not_path"))==false then
call SetUnitPosition(D6,GetUnitX(Ki),GetUnitY(Ki))
endif
if not IsUnitInGroup(D6,DG) then
call UnitDamageTargetBJ(Bc,D6,215,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
call GroupAddUnit(DG,D6)
endif
endloop
call DestroyGroup(Po)
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",GetUnitX(Ki),GetUnitY(Ki)))
set Bc=null
set Ki=null
set DG=null
set Po=null
endfunction
