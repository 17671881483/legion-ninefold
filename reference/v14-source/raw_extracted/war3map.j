function Trig_AbilityInitActions takes nothing returns nothing
local unit i=CreateUnit(Player(0),Pn,0,0,0)
set bj_lastCreatedUnit=i
call YDWEFlyEnable(i)
call AbilityInitPreloadOnUnit(i,QW)
call AbilityInitPreloadOnUnit(i,QX)
call AbilityInitPreloadOnUnit(i,$41304932)
call AbilityInitPreloadOnUnit(i,$41304934)
call AbilityInitPreloadOnUnit(i,$41304936)
call UnitAddAbility(i,$41304942)
call UnitRemoveAbility(i,$41304950)
call UnitAddAbility(i,$41304950)
call UnitRemoveAbility(i,$41304951)
call UnitAddAbility(i,$41304951)
call UnitRemoveAbility(i,$41304B30)
call UnitAddAbility(i,$41304B30)
call UnitRemoveAbility(i,$41304B31)
call UnitAddAbility(i,$41304B31)
call AbilityInitPreloadOnUnit(i,$41305A4F)
call AbilityInitRegisterConfiguredAbilities()
call RemoveUnit(i)
call TriggerExecute(Kk)
call RemoveUnit(CreateUnit(Player(0),$65303053,0,0,0))
call RemoveUnit(CreateUnit(Player(0),$65303055,0,0,0))
set i=null
call AbilityInitSaveBuildingRects()
endfunction
