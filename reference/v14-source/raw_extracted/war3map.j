function KickFunc takes nothing returns boolean
local integer BB=0
local real DK=GetTime()
loop
exitwhen BB>11
if IsPlayer(Player(BB)) and DK-FB[BB]>Eu then
if IsPlayerAlly(Player(BB),GetLocalPlayer()) then
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,30,FW[BB+1]+GetPlayerName(Player(BB))+YDWETranslate("|r 5分钟内没有进行任何操作，输入 |cffffcc00-kickafk ")+I2S(BB+1)+YDWETranslate("|r 将该玩家踢出游戏。"))
endif
endif
set BB=BB+1
endloop
return false
endfunction
function KickAFK takes nothing returns boolean
local integer BB
local real DK=GetTime()
call StrEx(GetEventPlayerChatString())
set BB=S2I(GetStrEx(2))-1
if BB<0 or BB>7 then
return false
endif
if IsPlayer(Player(BB)) and DK-FB[BB]>Eu and IsPlayerAlly(Player(BB),GetTriggerPlayer()) then
if GetLocalPlayer()==Player(BB) then
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,3600.,YDWETranslate("|cffff0000你因为暂离时间过长被踢出了游戏！|r"))
call RemoveUnit(CreateUnit(Player(BB),$55303054,0,0,270))
call RemovePlayer(Player(BB),PLAYER_GAME_RESULT_DEFEAT)
endif
endif
return false
endfunction
function con_delete takes nothing returns nothing
call GroupRemoveUnit(L,GetEnumUnit())
call RemoveUnit(GetEnumUnit())
endfunction
function ProphecyNormalMax takes player h returns integer
if Dg>=15 and GetPlayerTechCount(h,$52333034,true)>0 then
return 7
endif
return 5
endfunction
function ProphecyIsMemberAvailable takes player h returns boolean
return GetPlayerTechMaxAllowedSwap($52303848,h)>GetPlayerTechCount(h,$52303848,true)
endfunction
function ProphecyCloseSpecial takes player h returns nothing
call SetPlayerTechMaxAllowedSwap($52303131,0,h)
call SetPlayerTechMaxAllowedSwap($52303848,0,h)
endfunction
function ProphecyKeepMemberOnly takes player h returns nothing
call SetPlayerTechMaxAllowedSwap($52303047,0,h)
call SetPlayerTechMaxAllowedSwap($52303131,0,h)
endfunction
function ProphecyOpenNormalOnly takes player h returns nothing
call ProphecyCloseSpecial(h)
call SetPlayerTechMaxAllowedSwap($52303047,ProphecyNormalMax(h),h)
endfunction
function con_KR0G takes nothing returns nothing
local integer BB=0
local player h
loop
exitwhen BB>7
set h=Player(BB)
if GetPlayerTechCount(h,$52333034,true)>0 then
if ProphecyIsMemberAvailable(h) then
call SetPlayerTechMaxAllowedSwap($52303047,0,h)
call SetPlayerTechMaxAllowedSwap($52303131,0,h)
else
if GetPlayerTechMaxAllowedSwap($52303131,h)>GetPlayerTechCount(h,$52303131,true) then
call SetPlayerTechResearchedSwap($52303047,GetPlayerTechCountSimple($52303131,h),h)
endif
call ProphecyOpenNormalOnly(h)
endif
endif
set BB=BB+1
endloop
set h=null
endfunction
function con takes nothing returns nothing
local unit i=GetEnumUnit()
local unit FC=LoadUnitHandle(K,StringHash("mobileT"),1)
local unit FD=GetEnumUnit()
local unit FE=null
local real D1=GetUnitX(i)
local real BB=GetUnitY(i)
local player h=GetOwningPlayer(i)
local integer BF=GetPlayerId(GetOwningPlayer(i))+1
local integer Bj=0
if IsUnitHidden(i)==true and GetUnitTypeId(i)==$75316D62 or GetUnitTypeId(i)==$75303156 or GetUnitTypeId(i)==$75303155 then
call GroupRemoveUnit(L,i)
set FE=LoadUnitHandle(K,StringHash("mobilf"),GetHandleId(i))
set i=LoadUnitHandle(K,StringHash("mobile"),GetHandleId(i))
call RemoveUnit(FC)
call RemoveUnit(FD)
call RemoveUnit(FE)
call ShowUnit(i,true)
call SetUnitPosition(i,D1,BB)
if GetUnitAbilityLevel(i,$41304948)==0 and GetUnitTypeId(i)!=$68304A4D and GetUnitTypeId(i)!=$68305354 then
call UnitRemoveAbility(i,$41313138)
set Bj=LoadInteger(K,StringHash("Moving_i"),BF)-1
call SaveInteger(K,StringHash("Moving_i"),BF,Bj)
if Bj>0 then
call SetPlayerAbilityAvailable(h,$41313138,true)
endif
else
call SetPlayerAbilityAvailable(h,$41313138,true)
endif
if GetLocalPlayer()==h then
call SelectUnit(i,true)
endif
endif
set i=null
set FC=null
set FD=null
set FE=null
set h=null
endfunction
function Play_Con takes nothing returns nothing
local unit i=GetConstructingStructure()
if GetUnitTypeId(i)==$75316D74 or GetUnitTypeId(i)==$75303153 or GetUnitTypeId(i)==$75303154 then
call SaveUnitHandle(K,StringHash("mobileT"),1,i)
call ForGroup(L,function con)
endif
set i=null
endfunction
function Skills_Con takes nothing returns nothing
local unit i=GetTriggerUnit()
local real FF=GetUnitX(i)
local real FG=GetUnitY(i)
local unit FC=null
local unit FD=null
local player h=GetOwningPlayer(i)
local integer Bj=GetPlayerId(h)
if GetSpellAbilityId()==$41313138 then
call SetPlayerAbilityAvailable(h,$41313138,false)
if 0>=LoadInteger(K,StringHash("Moving_i"),Bj+1) then
return
endif
call ShowUnit(i,false)
if GetUnitTypeId(i)==$6E303444 then
set FC=CreateUnit(h,$75303155,FH[Bj],FI[Bj],270.)
elseif GetUnitTypeId(i)==$6E30344C or GetUnitTypeId(i)==$6E30344B or GetUnitTypeId(i)==$6E303448 or GetUnitTypeId(i)==$6E303446 or GetUnitTypeId(i)==$6E30344E or GetUnitTypeId(i)==$6E303451 then
set FC=CreateUnit(h,$75303156,FH[Bj],FI[Bj],270.)
else
set FC=CreateUnit(h,$75316D62,FH[Bj],FI[Bj],270.)
endif
call SaveUnitHandle(K,StringHash("mobile"),GetHandleId(FC),i)
set FD=CreateUnit(h,$75316D75,FF,FG,270.)
call SaveUnitHandle(K,StringHash("mobilf"),GetHandleId(FC),FD)
call GroupAddUnit(L,FC)
call GroupAddUnit(L,FD)
call SetUnitPosition(FC,FF,FG)
call SetUnitPosition(FD,FF,FG)
if GetLocalPlayer()==GetOwningPlayer(FC) then
call SelectUnit(FC,true)
endif
endif
if GetSpellAbilityId()==$41314832 then
call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()),$41313138,true)
call GroupRemoveUnit(L,i)
set FC=LoadUnitHandle(K,StringHash("mobile"),GetHandleId(i))
call RemoveUnit(i)
call ShowUnit(FC,true)
if GetLocalPlayer()==GetOwningPlayer(FC) then
call SelectUnit(FC,true)
endif
endif
set i=null
set FC=null
set FD=null
set h=null
endfunction
function chooseConditions takes nothing returns boolean
return GetUnitTypeId(GetTriggerUnit())==$75316D62 or GetUnitTypeId(GetTriggerUnit())==$75303155 or GetUnitTypeId(GetTriggerUnit())==$75303156
endfunction
function chooseActions takes nothing returns nothing
if GetLocalPlayer()==GetTriggerPlayer() then
call ForceUIKey("B")
call ForceUIKey("Q")
endif
endfunction
function callModeWingEffe takes integer BB returns nothing
local string array FM
local integer Bj=0
set FM[1]=SubString(ER[BB],0,2)
set FM[2]=SubString(ER[BB],2,4)
set FM[3]=SubString(ER[BB],4,6)
set FM[4]=SubString(ER[BB],6,8)
set FM[5]=SubString(ER[BB],8,10)
set FM[6]=SubString(ER[BB],10,12)
set FM[7]=SubString(ER[BB],12,14)
set Bj=S2I(FM[1])*4-4
set Ke[BB]=S2I(SubString(SL[BB],Bj,Bj+3))
set Bj=S2I(FM[2])*4-4
set EX[BB]=S2I(SubString(FN[BB],Bj,Bj+3))
set Bj=S2I(FM[3])*4-4
set EW[BB]=S2I(SubString(FO[BB],Bj,Bj+3))
set Bj=S2I(FM[4])*4-4
set ET[BB]=S2I(SubString(FU[BB],Bj,Bj+3))
set Bj=S2I(FM[5])*4-4
set FP[BB]=S2I(SubString(FQ[BB],Bj,Bj+3))
set Bj=S2I(FM[6])*4-4
set SV[BB]=S2I(SubString(SU[BB],Bj,Bj+3))
set Bj=S2I(FM[7])*4-4
set EH[BB]=S2I(SubString(SY[BB],Bj,Bj+3))
set S2[BB]=AddSpecialEffect(ES[SV[BB]],GetUnitX(Hk[BB]),GetUnitY(Hk[BB]))
endfunction
function ModeWingEffeStr takes string FJ,integer BB returns nothing
local integer Bj=BB-1
local string CP=SubString(FJ,0,2)
local string FK=SubString(FJ,2,4)
local integer D1=S2I(FK)
local integer CT=D1*4-4
local integer BF=LoadInteger(K,StringHash("SkillCD"),GetHandleId(EG[BB]))
local string array FM
local integer FL=GetUnitAbilityLevel(EG[BB],$41305654)
set FM[0]=FK
set FM[1]=SubString(ER[Bj],0,2)
set FM[2]=SubString(ER[Bj],2,4)
set FM[3]=SubString(ER[Bj],4,6)
set FM[4]=SubString(ER[Bj],6,8)
set FM[5]=SubString(ER[Bj],8,10)
set FM[6]=SubString(ER[Bj],10,12)
set FM[7]=SubString(ER[Bj],12,14)
if D1<10 then
set FM[0]="0"+I2S(D1)
endif
if CP=="-E" or CP=="-e" then
call DestroyEffect(EY[BB])
set FM[2]=FM[0]
if D1>0 then
set EX[Bj]=S2I(SubString(FN[Bj],CT,CT+3))
set EY[BB]=AddSpecialEffectTarget(ES[EX[Bj]],EG[BB],"origin")
call DestroyEffect(LoadEffectHandle(O,GetPlayerId(GetOwningPlayer(EG[BB])),100869))
endif
endif
if CP=="-W" or CP=="-w" then
call DestroyEffect(EV[BB])
set FM[3]=FM[0]
if D1>0 then
set EW[Bj]=S2I(SubString(FO[Bj],CT,CT+3))
set EV[BB]=AddSpecialEffectTarget(ES[EW[Bj]],EG[BB],"chest")
call DestroyEffect(LoadEffectHandle(O,GetPlayerId(GetOwningPlayer(EG[BB])),100868))
endif
endif
if CP=="-B" or CP=="-b" then
set FM[5]=FM[0]
set FP[Bj]=S2I(SubString(FQ[Bj],CT,CT+3))
call DestroyEffect(AddSpecialEffect(FR[FP[Bj]],GetUnitX(EG[BB]),GetUnitY(EG[BB])))
call SaveStr(O,GetPlayerId(GetOwningPlayer(EG[BB])),100870,null)
endif
if CP=="-Y" or CP=="-y" and GetPlayerTechCount(Player(Bj),$52333033,true)==1 then
if D1>0 then
set FM[7]="01"
set EH[Bj]=1
else
set FM[7]="00"
set EH[Bj]=0
endif
if D1==5 then
call SetPlayerTechMaxAllowed(Player(Bj),FS[Bj],0)
endif
endif
set CP=SubString(FJ,0,4)
set FK=SubString(FJ,4,6)
set D1=S2I(FK)
if D1<10 then
set FM[0]="0"+I2S(D1)
endif
set CT=D1*4-4
if CP=="-DZW" or CP=="-dzw" then
call DestroyEffect(FT[BB])
set FM[4]=FM[0]
if D1>0 then
set ET[Bj]=S2I(SubString(FU[Bj],CT,CT+3))
set FT[BB]=AddSpecialEffectTarget(ES[ET[Bj]],EG[BB],"chest")
endif
endif
set ER[Bj]=FM[1]+FM[2]+FM[3]+FM[4]+FM[5]+FM[6]+FM[7]
endfunction
function ModeWingEffe takes nothing returns nothing
call ModeWingEffeStr(GetEventPlayerChatString(),GetConvertedPlayerId(GetTriggerPlayer()))
endfunction
