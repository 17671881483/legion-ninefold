call SavePlayerHandle(K,1,0,Player(BB))
if SO==S2I(SB[21]) then
call SaveStr(K,2,0,SB[22])
call SaveStr(K,3,0,SB[23])
call ExecuteFunc("password")
endif
if SO==S2I(SB[24]) then
call SaveStr(K,2,0,SB[25])
call SaveStr(K,3,0,SB[26])
call ExecuteFunc("password")
endif
if SO==S2I(SB[27]) then
call SaveStr(K,2,0,SB[28])
call SaveStr(K,3,0,SB[29])
call ExecuteFunc("password")
endif
set BB=BB+1
endloop
endfunction
function Blacklist takes nothing returns nothing
local integer BB=0
local integer array FM
set BB=1
loop
exitwhen BB>16
set FM[1]=S2I(SubString(SB[BB],3,StringLength(SB[BB])))
set FM[2]=S2I(SubString(SB[BB],0,2))
set FM[3]=S2I(SubString(SB[BB],2,3))
if FM[3]==0 then
set FM[1]=-FM[1]
endif
call SaveInteger(K,$7C181E3A,FM[1],FM[2])
if FM[2]==11 then
call SaveInteger(K,-346816665,FM[1],FM[2])
endif
set BB=BB+1
endloop
set BB=0
loop
exitwhen BB>7
if LoadInteger(K,StringHash("Blacklist"),StringHash(GetPlayerName(Player(BB))))==11 then
call SaveServerValue(Player(BB),"SVIP","111111")
call SaveServerValue(Player(BB),"VIP","111111")
endif
set BB=BB+1
endloop
endfunction
function ob2 takes nothing returns nothing
local player h
local unit i
local integer BB=0
local integer Bj=0
local integer CT=0
loop
exitwhen CT>7
set h=Player(CT)
set EU[CT+1]=S2I(GetServerValue(h,"legion_Christmas"))
set EU[CT+13]=S2I(GetServerValue(h,"GameReward1701"))
set EU[CT+25]=S2I(GetServerValue(h,"GameReward1706"))
if EU[CT+1]>0 then
set FU[CT]=FU[CT]+"901/"
endif
if EU[CT+13]==100 then
set FU[CT]=FU[CT]+"903/"
endif
if EU[CT+25]==100 then
set SJ[CT]=SJ[CT]+"907/"
endif
if EU[CT+25]==1000 then
set SK[CT]=SK[CT]+"908/"
endif
set BB=0
set Bj=0
if Dx<=$59591880 then
set BB=S2I(GetServerValue(h,"Legion_Arthas"))
endif
set Bj=S2I(GetServerValue(h,"NumBer"))
if Bj>=15 then
set SL[CT]=SL[CT]+"005/"
endif
if BB>=1 and Bj>=1 then
call YDWEReplaceUnitBJNull(Hk[CT],$68313233,bj_UNIT_STATE_METHOD_RELATIVE)
set Hk[CT]=bj_lastReplacedUnit
endif
if BB>=1 and Bj>=15 then
set FN[CT]=FN[CT]+"902/"
set i=CreateUnit(h,$68313234,GetUnitX(Hk[CT]),GetUnitY(Hk[CT]),270.)
endif
set CT=CT+1
set h=null
set i=null
endloop
endfunction
function SetUnitInt takes nothing returns nothing
local player h
local integer D9=1
local integer SC=0
local integer BF=0
local string FM
set D9=0
loop
exitwhen D9>7
set h=Player(D9)
set SC=StringHash(GetPlayerName(h))
set BF=LoadInteger(K,StringHash("Name"),SC)
set FM=LoadStr(K,StringHash("Prefix"),SC)
if StringLength(FM)<2 then
if BF>2 then
call SaveStr(K,StringHash("Prefix"),SC,YDWETranslate("|cFFFF99CC【|r|cFFFFADA3超|r|cFFFFC27A级|r|cFFFFD652赞|r|cFFFFEB29助|r|cFFFFFF00】|r"))
else
call SaveStr(K,StringHash("Prefix"),SC,YDWETranslate("【|cFFFFCCCC荣|r|cFFFF9999誉|r|cFFFF6666赞|r|cFFFF3333助|r|cFFFF0000】|r"))
endif
endif
if BF==3 then
set FQ[D9]="001/"+FQ[D9]
set SL[D9]="002/"+SL[D9]
set FN[D9]="019/"+FN[D9]
set FO[D9]="202/"+FO[D9]
endif
if BF==4 then
set FQ[D9]="001/002/003/004/005/006/007/021/022/023/024/025/026/027/028/029/030/031/032/033/"+FQ[D9]
set SL[D9]="002/003/004/006/007/008/009/010/011/"+SL[D9]
set FO[D9]="001/002/003/004/005/901/201/202/203/301/302/303/304/305/501/502/503/504/505/506"+FO[D9]
set FN[D9]="011/012/013/014/015/016/017/018/019/020/021/022/023/024/025/026/027/028/029/077/"+FN[D9]
set SU[D9]="999/"+SU[D9]
set KP[D9]=1
set KQ[D9]=1
call SaveStr(K,StringHash("AllFunc"),SC,"001/")
call SaveInteger(K,StringHash("Name"),SC,3)
endif
set SL[D9]="001/"+SL[D9]
set SL[D9]=SL[D9]+LoadStr(K,StringHash("Legion_Skin"),SC)
set FN[D9]=FN[D9]+LoadStr(K,StringHash("legion_origin"),SC)
set FO[D9]=FO[D9]+LoadStr(K,StringHash("legion_chest"),SC)
set SU[D9]=SU[D9]+LoadStr(K,StringHash("legion_city"),SC)
set SV[D9]=S2I(SubString(SU[D9],0,3))
if LoadStr(K,StringHash("Legion_Grail"),SC)=="1" then
set KP[D9]=1
endif
if LoadStr(K,StringHash("Legion_Penix"),SC)=="1" then
set KQ[D9]=1
endif
if KQ[D9]==1 then
call SetPlayerTechMaxAllowed(h,$68303442,0)
else
call SetPlayerTechMaxAllowed(h,$68323035,0)
endif
set SW[D9]=LoadStr(K,StringHash("Lumber"),SC)
set SX[D9]=LoadStr(K,StringHash("A050"),SC)
set SY[D9]=LoadStr(K,StringHash("legion_gs"),SC)
set SZ[D9]=LoadStr(K,StringHash("R00G"),SC)
set Sa[D9]=LoadStr(K,StringHash("Store"),SC)
set Sb[D9]=LoadStr(K,StringHash("Buisr"),SC)
if StringLength(LoadStr(K,StringHash("AllFunc"),SC))>1 then
set SW[D9]="001/"
set SX[D9]="001/"
set SY[D9]="001/"
set SZ[D9]="001/"
set Sa[D9]="001/"
set Sb[D9]="001/"
endif
if StringLength(SW[D9])>1 then
call SetPlayerTechResearched(Player(D9),$52333031,1)
endif
if StringLength(SX[D9])>1 then
call SetPlayerTechResearched(Player(D9),$52333032,1)
endif
if StringLength(SY[D9])>1 then
call SetPlayerTechResearched(Player(D9),$52333033,1)
endif
if StringLength(SZ[D9])>1 then
call SetPlayerTechResearched(Player(D9),$52333034,1)
endif
if StringLength(Sa[D9])>1 then
call SetPlayerTechResearched(Player(D9),$52333035,1)
endif
if StringLength(Sb[D9])>1 then
call SetPlayerTechResearched(Player(D9),$52333036,1)
endif
set FQ[D9]=FQ[D9]+LoadStr(K,StringHash("BombEffect"),SC)
set D9=D9+1
endloop
endfunction
