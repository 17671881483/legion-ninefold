local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
local trigger El=CreateTrigger()
local unit Ki
local integer BB=0
local integer a1=LoadInteger(O,GetHandleId(Bc),$41314242)+1
call SaveInteger(O,GetHandleId(Bc),$41314242,a1)
if a1>=6 then
call UnitRemoveAbility(Bc,$41314242)
endif
call PauseUnit(Bc,false)
call SaveAgentHandle(O,GetHandleId(El),0,Bc)
call SaveInteger(O,GetHandleId(El),2,QK)
call TriggerAddAction(El,function IllidanAisinosFlameActionAction)
if GetUnitTypeId(Bc)==$68305657 then
call SetUnitTypeModel($6E303656,"LJQ_FireElementalRed01.mdx",null)
else
call SetUnitTypeModel($6E303656,"FireElementalGreen.mdx",null)
endif
loop
set BB=BB+1
set Ki=CreateUnit(GetOwningPlayer(Bc),$6E303656,GetUnitX(Bc),GetUnitY(Bc),GetUnitFacing(Bc))
call GroupAddUnit(JW,Ki)
call SetUnitUserData(Ki,GetUnitUserData(Bc))
call GroupAddUnit(JH[GetUnitUserData(Bc)],Ki)
call TriggerRegisterDeathEvent(El,Ki)
call SetUnitUserData(Ki,GetUnitUserData(Bc))
exitwhen BB>=QK
endloop
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
set t=null
set El=null
set Bc=null
endfunction
function IllidanAisinosFlame takes unit Bc returns nothing
local trigger t
local integer a1=LoadInteger(O,GetHandleId(Bc),$41314242)
if a1>=6 then
call UnitRemoveAbility(Bc,$41314242)
set Bc=null
set t=null
return
endif
if IsUnitType(Bc,UNIT_TYPE_ANCIENT) then
set Bc=null
set t=null
return
endif
set t=CreateTrigger()
call IllidanAlternate(Bc)
call PauseUnit(Bc,true)
call SetUnitAnimation(Bc,"morph")
call SaveAgentHandle(O,GetHandleId(t),0,Bc)
call TriggerRegisterTimerEvent(t,2.5,false)
call TriggerAddAction(t,function IllidanAisinosFlameAction)
set Bc=null
set t=null
endfunction
function IllidanSummoningShadowDemons takes unit Bc,integer x returns nothing
