if BF==StringCase(BF,true) then
set BF=BF+"U"
endif
call StoreInteger(IR,"c2i",BF,BB)
set BB=BB+1
endloop
endfunction
function pN takes string IS returns string
local integer Eq
local integer BB=0
local string IU=""
local string IT
loop
exitwhen BB>=StringLength(IS)
set IT=SubString(IS,BB,BB+1)
set Eq=0
loop
exitwhen Eq>=StringLength(" \\")
if IT==SubString(" \\",Eq,Eq+1) then
set IT="\\"+IT
exitwhen true
endif
set Eq=Eq+1
endloop
set IU=IU+IT
set BB=BB+1
endloop
return IU
endfunction
