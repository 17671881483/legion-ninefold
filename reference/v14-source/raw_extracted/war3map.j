call SetPlayerAbilityAvailable(Player(0),$41303834,false)
call SetPlayerAbilityAvailable(Player(1),$41303834,false)
call SetPlayerAbilityAvailable(Player(2),$41303834,false)
call SetPlayerAbilityAvailable(Player(3),$41303834,false)
call YDWEPolledWaitNull(1)
call SetPlayerAbilityAvailable(Player(0),$41303834,true)
call SetPlayerAbilityAvailable(Player(1),$41303834,true)
call SetPlayerAbilityAvailable(Player(2),$41303834,true)
call SetPlayerAbilityAvailable(Player(3),$41303834,true)
else
