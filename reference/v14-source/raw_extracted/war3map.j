function OC5F_Uh takes nothing returns nothing
set Pb=GetUnitLoc(GetEnumUnit())
set Jn=oldcodefn_EN(600.,Pb,Condition(function OC5F_Ph))
if Iz[GetUnitUserData(GetEnumUnit())]==false and GetUnitStateSwap(UNIT_STATE_MANA,GetEnumUnit())>=GetUnitStateSwap(UNIT_STATE_MAX_MANA,GetEnumUnit())-2 and GetUnitMoveSpeed(GetEnumUnit())>=5. and CountUnitsInGroup(Jn)>0 then
set Iz[GetUnitUserData(GetEnumUnit())]=true
set Pb=GetUnitLoc(GetEnumUnit())
call GroupClear(Ji)
set Ji=oldcodefn_EN(128.,Pb,Condition(function OC5F_Qh))
if IsUnitGroupEmptyBJ(Ji) then
call DestroyGroup(Ji)
set Ji=oldcodefn_EN(256.,Pb,Condition(function sh))
if IsUnitGroupEmptyBJ(Ji) then
set Ji=oldcodefn_EN(384.,Pb,Condition(function oldcodefn_Sh))
endif
endif
set Nr=GroupPickRandomUnit(Ji)
call RemoveLocation(Pb)
call DestroyGroup(Ji)
call UnitAddAbility(GetEnumUnit(),$41303058)
call IssueTargetOrderById(GetEnumUnit(),852209,Nr)
else
if GetUnitAbilityLevelSwapped($41303058,GetEnumUnit())==1 then
call UnitRemoveAbility(GetEnumUnit(),$41303058)
endif
endif
call DestroyGroup(Jn)
call RemoveLocation(Pb)
endfunction
