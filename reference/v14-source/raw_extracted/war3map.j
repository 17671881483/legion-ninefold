function EasterEggRegisterMonsterArt takes integer BM,integer BN,string BO,string BP returns nothing
local timer t=CreateTimer()
if BM>0 then
call SaveInteger(O,BM,StringHash("ArtSkl"),BN)
endif
call SaveStr(O,BN,StringHash("Art"),BO)
call SaveStr(O,BN,StringHash("DisArt"),BP)
call SaveStr(O,BN,StringHash("StateArt"),BP)
call EXDclareButtonIcon(BO)
call SaveInteger(O,GetHandleId(t),0,BN)
call SaveStr(O,GetHandleId(t),1,BO)
call SaveStr(O,GetHandleId(t),2,BP)
call TimerStart(t,0,false,function EasterEgg___UpdataArtTimer)
set t=null
endfunction
function YseraEasterEggRegisterArt takes nothing returns nothing
call EasterEggRegisterMonsterArt($6830594D,$4132594B,"yiselalxt.blp","yiselalxt.blp")
endfunction
function EasterEggRegisterMonsterUpMenu takes integer BN,integer BS returns nothing
call SaveInteger(O,BN,StringHash("Menu"),BS)
endfunction
function EasterEggRegisterShowShop takes player h,unit SF returns nothing
local integer BB=0
local integer Os=0
local integer QK=LoadInteger(O,StringHash("EasterEgg"),StringHash("count"))
local player Yf=null
if h==null or SF==null then
set h=null
set SF=null
return
endif
set Yf=GetOwningPlayer(SF)
call SaveInteger(O,GetHandleId(SF),StringHash("page"),1)
call SaveBoolean(O,GetHandleId(SF),StringHash("EasterEgg"),true)
call SaveUnitHandle(O,GetHandleId(h),StringHash("EasterEggShop"),SF)
loop
set BB=BB+1
exitwhen BB>QK
set Os=LoadInteger(O,StringHash("EasterEgg"),BB)
exitwhen Os==0
call UnitAddAbility(SF,Os)
call UnitMakeAbilityPermanent(SF,true,Os)
if BB>dM then
call SetPlayerAbilityAvailable(Yf,Os,false)
endif
endloop
call UnitAddAbility(SF,$41305851)
call UnitAddAbility(SF,$41305852)
set Yf=null
set h=null
set SF=null
endfunction
function EasterEgg___SetPage takes unit SF,integer w returns nothing
local integer dQ=0
local integer BB=0
local integer Os=0
local player Yf=null
if SF==null then
set SF=null
return
endif
set dQ=LoadInteger(O,GetHandleId(SF),StringHash("page"))
set Yf=GetOwningPlayer(SF)
loop
set BB=BB+1
set Os=LoadInteger(O,StringHash("EasterEgg"),BB+(dQ-1)*dM)
if Os>0 then
call SetPlayerAbilityAvailable(Yf,Os,false)
endif
set Os=LoadInteger(O,StringHash("EasterEgg"),BB+(w-1)*dM)
if Os>0 and GetUnitAbilityLevel(SF,Os)==0 then
elseif Os>0 then
call SetPlayerAbilityAvailable(Yf,Os,true)
endif
exitwhen BB>=dM
endloop
call SaveInteger(O,GetHandleId(SF),StringHash("page"),w)
set Yf=null
set SF=null
endfunction
function EasterEgg___ChangePage takes unit SF,integer cK returns integer
local integer w=0
local integer cY=EasterEgg___GetMaxPage()
if SF==null then
set SF=null
return 0
endif
set w=LoadInteger(O,GetHandleId(SF),StringHash("page"))+cK
if w>cY then
set w=1
elseif w<1 then
set w=cY
endif
call EasterEgg___SetPage(SF,w)
set SF=null
return w
endfunction
function EasterEggNext takes unit SF returns integer
local integer w=EasterEgg___ChangePage(SF,1)
set SF=null
return w
endfunction
function EasterEggBack takes unit SF returns integer
local integer w=EasterEgg___ChangePage(SF,-1)
set SF=null
return w
endfunction
function EasterEgg___SetSklArt takes player h,integer BN,string BO returns nothing
local string ZR=LoadStr(O,BN,StringHash("StateArt"))
if GetLocalPlayer()==h then
set ZR=BO
endif
call EXSetAbilityString(BN,1,204,ZR)
call SaveStr(O,BN,StringHash("StateArt"),ZR)
set ZR=null
set BO=null
set h=null
endfunction
function EasterEgg___UnlockEasterEggAbility takes player Yf,unit SF,integer ZQ,integer BN returns boolean
local string BO=null
if ZQ<=0 or BN<=0 or LoadBoolean(O,ZQ,GetHandleId(SF)) then
set Yf=null
set SF=null
return false
endif
call SaveBoolean(O,ZQ,GetHandleId(SF),true)
set BO=LoadStr(O,BN,StringHash("Art"))
call EasterEgg___SetSklArt(Yf,BN,BO)
set BO=null
set Yf=null
set SF=null
return true
endfunction
function EasterBuildingCreate takes unit C3 returns nothing
local integer x=GetUnitTypeId(C3)
local integer BN=LoadInteger(O,x,StringHash("ArtSkl"))
local string BO=LoadStr(O,BN,StringHash("Art"))
local unit SF=LoadUnitHandle(O,GetHandleId(GetOwningPlayer(C3)),StringHash("EasterEggShop"))
local player Yf=null
local integer ZS
local integer ZT
local boolean ZU=false
if SF==null then
set BO=null
set C3=null
set SF=null
return
endif
set Yf=GetOwningPlayer(SF)
if BN==0 then
set x=LoadInteger(O,x,StringHash("SkinBase"))
if x>0 then
set BN=LoadInteger(O,x,StringHash("ArtSkl"))
set BO=LoadStr(O,BN,StringHash("Art"))
endif
endif
if EasterEgg___UnlockEasterEggAbility(Yf,SF,x,BN) then
set ZS=LoadInteger(O,BN,StringHash("Menu"))
set ZT=LoadInteger(O,ZS,StringHash("Menu"))
if EasterEgg___UnlockEasterEggAbility(Yf,SF,ZS,ZS) then
set ZU=EasterEgg___UnlockEasterEggAbility(Yf,SF,ZT,ZT)
endif
endif
set BO=null
set C3=null
set Yf=null
set SF=null
endfunction
function EggResource___RecycleFloatingTextTags takes integer Bq,integer Br returns nothing
local integer Bs=Bq
loop
exitwhen Bs==Br
call DestroyTextTag(Bp[Bs])
set Bp[Bs]=null
set Bs=Bs+1
endloop
endfunction
function EggResource___ShowText takes unit i,string Bj,real Bk,real Bl,real Bm,player Bn returns nothing
local force Bo
local location h
local integer BB=LoadInteger(O,100,776)
if i==null then
set i=null
set Bn=null
return
endif
set Bo=CreateForce()
call SaveInteger(O,100,776,BB+1)
set h=GetUnitLoc(i)
set Bp[BB]=CreateTextTagLocBJ(Bj,h,0,10,Bk,Bl,Bm,0)
call ForceAddPlayer(Bo,Bn)
call SetTextTagLifespanBJ(Bp[BB],3)
call SetTextTagPermanentBJ(Bp[BB],false)
call SetTextTagFadepointBJ(Bp[BB],2)
call SetTextTagVelocityBJ(Bp[BB],40,90)
call ShowTextTagForceBJ(false,Bp[BB],bj_FORCE_ALL_PLAYERS)
call ShowTextTagForceBJ(true,Bp[BB],Bo)
if BB==100 then
call EggResource___RecycleFloatingTextTags(0,100)
elseif BB==200 then
call EggResource___RecycleFloatingTextTags(101,200)
call SaveInteger(O,100,776,0)
endif
call RemoveLocation(h)
call DestroyForce(Bo)
set Bo=null
set h=null
set i=null
set Bn=null
endfunction
function EggResource___AddKingSacrificeBonus takes unit Be,integer BW,integer BX returns nothing
local real Bf=GetUnitLifePercent(Be)
local integer Bg=GetUnitAbilityLevel(Be,BX)
call SetUnitState(Be,UNIT_STATE_MAX_LIFE,GetUnitState(Be,UNIT_STATE_MAX_LIFE)+BW)
call SetUnitLifePercentBJ(Be,Bf)
if Bg==0 then
call UnitAddAbility(Be,BX)
call UnitMakeAbilityPermanent(Be,true,BX)
else
call SetUnitAbilityLevel(Be,BX,Bg+1)
endif
set Be=null
endfunction
function EggResource___EggResource takes unit Bc,integer BT returns nothing
local integer BU=BY[BT]
local integer BV=BZ[BT]
local integer BW=Ba[BT]
local integer BX=Bb[BT]
local player h=GetOwningPlayer(Bc)
call SetPlayerState(h,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(h,PLAYER_STATE_RESOURCE_GOLD)+BU)
call SetPlayerState(h,PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(h,PLAYER_STATE_RESOURCE_LUMBER)+BV)
if IsUnitAlly(Bc,GetOwningPlayer(Bd)) then
call EggResource___AddKingSacrificeBonus(Bd,BW,BX)
elseif IsUnitAlly(Bc,GetOwningPlayer(Bh)) then
call EggResource___AddKingSacrificeBonus(Bh,BW,BX)
endif
call SetPlayerUnitAvailableBJ(GetUnitTypeId(Bc),false,h)
call DisplayTimedTextToPlayer(h,0,0,7.,"你献祭了一个彩蛋,获得大量资源")
if Bi>0 then
call EggResource___ShowText(Bc,"+"+I2S(BU),100.,77.,0.,h)
endif
call GroupRemoveUnit(Bt[GetConvertedPlayerId(h)],Bc)
call GroupRemoveUnit(Bu,Bc)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl",GetUnitX(Bc),GetUnitY(Bc)))
call RemoveUnit(Bc)
call TriggerExecute(Bv)
set Bc=null
set h=null
endfunction
function EggResource___GetEggSacrificeLevel takes integer BF returns integer
if BF==$41315534 then
return 1
elseif BF==$41315535 then
return 2
elseif BF==$41315536 then
return 3
endif
return 0
endfunction
function EggResource___SkillClickAction takes nothing returns nothing
local integer BT=EggResource___GetEggSacrificeLevel(GetSpellAbilityId())
local unit Bc=GetTriggerUnit()
if BT>0 then
call EggResource___EggResource(Bc,BT)
endif
set Bc=null
endfunction
function EggResource___InitEggResourceLevel takes integer BT,integer BU,integer BV,integer BW,integer BX returns nothing
set BY[BT]=BU
set BZ[BT]=BV
set Ba[BT]=BW
set Bb[BT]=BX
endfunction
function EggResource___Init takes nothing returns nothing
local trigger t=CreateTrigger()
call EggResource___InitEggResourceLevel(1,600,2000,5000,$41315541)
call EggResource___InitEggResourceLevel(2,1000,3500,8000,$41315542)
call EggResource___InitEggResourceLevel(3,2000,8000,15000,$41315543)
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddAction(t,function EggResource___SkillClickAction)
set t=null
endfunction
