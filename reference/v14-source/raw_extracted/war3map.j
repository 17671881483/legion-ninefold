call DoNothing()
call TriggerRegisterAnyUnitEventBJ(cd,EVENT_PLAYER_UNIT_ISSUED_ORDER)
call TriggerAddCondition(cd,Condition(function Trig_orderLimitConditions))
call TriggerAddAction(cd,function Trig_orderLimitActions)
endfunction
