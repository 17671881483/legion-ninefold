loop
set D6=FirstOfGroup(Uz)
exitwhen D6==null
if IsUnitEnemy(D6,h) then
call UnitDamageTargetBJ(i,D6,GetUnitState(D6,UNIT_STATE_MAX_LIFE)*.025,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
