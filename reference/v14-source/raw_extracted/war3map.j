function AlexstraszaShareLifeAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),1)
local unit Om=LoadUnitHandle(O,GetHandleId(t),2)
local real Pv=0
if GetTriggerEventId()==EVENT_UNIT_DEATH or IsUnitType(Bc,UNIT_TYPE_DEAD) or IsUnitType(Om,UNIT_TYPE_DEAD) then
if GetTriggerUnit()==Bc then
call SetUnitState(Om,UNIT_STATE_MAX_LIFE,LoadReal(O,GetHandleId(t),3))
call SetUnitLifePercentBJ(Om,100)
elseif GetTriggerUnit()==Om then
call KillUnit(Bc)
endif
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
elseif GetTriggerEventId()==EVENT_UNIT_DAMAGED then
set Pv=(GetUnitState(Bc,UNIT_STATE_LIFE)+GetUnitState(Om,UNIT_STATE_LIFE))/2
call SetUnitState(Bc,UNIT_STATE_LIFE,Pv)
call SetUnitState(Om,UNIT_STATE_LIFE,Pv)
else
endif
set Bc=null
set Om=null
endfunction
function AlexstraszaShareLife takes unit Bc,unit Om returns nothing
local trigger t=CreateTrigger()
local real Qe=GetUnitState(Bc,UNIT_STATE_MAX_LIFE)+GetUnitState(Om,UNIT_STATE_MAX_LIFE)
call SaveReal(O,GetHandleId(t),3,GetUnitState(Om,UNIT_STATE_MAX_LIFE))
call SetUnitState(Bc,UNIT_STATE_MAX_LIFE,Qe)
call SetUnitState(Bc,UNIT_STATE_LIFE,GetUnitState(Bc,UNIT_STATE_MAX_LIFE))
call SetUnitState(Om,UNIT_STATE_MAX_LIFE,Qe)
call SetUnitState(Om,UNIT_STATE_LIFE,GetUnitState(Om,UNIT_STATE_MAX_LIFE))
call SaveAgentHandle(O,GetHandleId(t),1,Bc)
call SaveAgentHandle(O,GetHandleId(t),2,Om)
call TriggerRegisterUnitEvent(t,Bc,EVENT_UNIT_DAMAGED)
call TriggerRegisterUnitEvent(t,Om,EVENT_UNIT_DAMAGED)
call TriggerRegisterUnitEvent(t,Bc,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,Om,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,.03,true)
call TriggerAddAction(t,function AlexstraszaShareLifeAction)
set Bc=null
set Om=null
set t=null
endfunction
