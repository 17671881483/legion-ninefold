function ArthasTheLightOfTheKingAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
local unit Ki=LoadUnitHandle(O,GetHandleId(t),2)
local real Pm=LoadReal(O,GetHandleId(t),3)
local real QY=LoadReal(O,GetHandleId(t),1)
local real DK=GetTriggerExecCount(t)*.04
local group DG
local unit D6
local real FF
local real FG
if GetTriggerEventId()==EVENT_GAME_TIMER_EXPIRED then
set Pm=Pm+7
set FF=GetUnitX(Bc)+CosBJ(Pm)*200
set FG=GetUnitY(Bc)+SinBJ(Pm)*200
call SetUnitPosition(Ki,FF,FG)
set DG=SelectRangeAlly(Bc,FF,FG,300)
call SaveReal(O,GetHandleId(t),3,Pm)
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
call SetUnitLifeBJ(D6,GetUnitState(D6,UNIT_STATE_LIFE)+40)
endloop
call DestroyGroup(DG)
if DK>=QY then
call KillUnit(Ki)
endif
set DG=null
else
call SetUnitState(Bc,ConvertUnitState(32),GetUnitState(Bc,ConvertUnitState(32))-10)
call DestroyEffect(LoadEffectHandle(O,GetHandleId(t),3))
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
endif
set t=null
set Bc=null
set Ki=null
endfunction
function ArthasTheLightOfTheKing takes unit Bc returns nothing
local unit Ki
local real Pm=0
local integer y=0
local integer QK=3
local real DK=6
local real FF
local real FG
local trigger t
loop
exitwhen y>=QK
set Pm=y*360/QK
set FF=GetUnitX(Bc)+CosBJ(Pm)*200
set FG=GetUnitY(Bc)+SinBJ(Pm)*200
set Ki=CreateUnit(GetOwningPlayer(Bc),Pn,FF,FG,270)
call SetUnitState(Bc,ConvertUnitState(32),GetUnitState(Bc,ConvertUnitState(32))+10)
set t=CreateTrigger()
call SaveUnitHandle(O,GetHandleId(t),0,Bc)
call SaveReal(O,GetHandleId(t),1,DK)
call SaveUnitHandle(O,GetHandleId(t),2,Ki)
call SaveReal(O,GetHandleId(t),3,Pm)
call SaveEffectHandle(O,GetHandleId(t),3,AddSpecialEffectTarget(ArthasModel("LJQ_AlsaceBright_WZZG.mdx","Abilities\\Spells\\Human\\InnerFire\\InnerFireTarget.mdl"),Ki,"chest"))
call TriggerRegisterDeathEvent(t,Bc)
call TriggerRegisterDeathEvent(t,Ki)
call TriggerRegisterTimerEvent(t,.04,true)
call TriggerAddAction(t,function ArthasTheLightOfTheKingAction)
set y=y+1
endloop
set Bc=null
set t=null
set Ki=null
endfunction
function ArthasShider takes unit Bc,unit Om returns nothing
