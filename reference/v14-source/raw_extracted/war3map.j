function Trig_LimitConditions takes nothing returns boolean
return LoadBoolean(O,10,GetUnitTypeId(GetTriggerUnit()))
endfunction
function Buding_Limit takes integer D7,integer D8,integer D9 returns nothing
local unit i=GetTriggerUnit()
local player h=GetOwningPlayer(i)
local group gU=YDWEGetUnitsOfPlayerAndTypeIdNull(h,D7)
local group gV=null
local unit D6
if CountUnitsInGroup(gU)>=D9 then
set gV=YDWEGetUnitsOfPlayerAndTypeIdNull(h,D8)
loop
set D6=FirstOfGroup(gV)
exitwhen D6==null
call GroupRemoveUnit(Bu,D6)
call GroupRemoveUnit(Jk,D6)
call TriggerExecute(Bv)
call GroupRemoveUnit(gV,D6)
call RemoveUnit(D6)
set D6=null
endloop
call DestroyGroup(gV)
endif
call DestroyGroup(gU)
set D6=null
set gV=null
set gU=null
set h=null
set i=null
endfunction
function Trig_AttackTrigegrConditions takes nothing returns boolean
local integer x=GetUnitTypeId(GetTriggerUnit())
local integer dk=GetUnitTypeId(GetAttacker())
return LoadInteger(Q,x,x)==x or LoadInteger(Q,dk,dk)==dk or LoadStr(Q,dk,10000)!=null
endfunction
function AttackTriggerCastCyclone takes unit Pf,unit Om returns nothing
local unit Ki
local group Uz
local unit D6
call SetUnitManaBJ(Pf,GetUnitState(Pf,UNIT_STATE_MANA)-17)
call YDWESetUnitAbilityState(Pf,$53303036,1,5)
set Ki=CreateUnit(GetOwningPlayer(Pf),Pn,GetUnitX(Om),GetUnitY(Om),0)
call GroupAddUnit(JW,Ki)
call SetUnitUserData(Ki,GetUnitUserData(Pf))
call GroupAddUnit(JH[GetUnitUserData(Pf)],Ki)
call UnitAddType(Ki,UNIT_TYPE_SUMMONED)
call YDWETimerRemoveUnit(5,Ki)
set Uz=CreateGroup()
call GroupEnumUnitsInRange(Uz,GetUnitX(Om),GetUnitY(Om),200,null)
loop
set D6=FirstOfGroup(Uz)
exitwhen D6==null
call GroupRemoveUnit(Uz,D6)
if IsUnitEnemy(D6,GetOwningPlayer(Pf)) then
call UnitRemoveAbility(Ki,$53303036)
call UnitAddAbility(Ki,$53303036)
call IssueTargetOrder(Ki,"cyclone",D6)
endif
set D6=null
endloop
call DestroyGroup(Uz)
set D6=null
set Uz=null
set Ki=null
set Om=null
set Pf=null
endfunction
function AttackTriggerHydraAttack takes unit Pf,integer Dm returns nothing
local group Uz
local unit D6
if LoadInteger(O,GetHandleId(Pf),StringHash("A0TB"))==2 then
call IssueImmediateOrderById(Pf,851972)
set Uz=CreateGroup()
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(Pf),$6530304F,GetUnitX(Pf),GetUnitY(Pf),0)
call GroupAddUnit(JW,bj_lastCreatedUnit)
call SetUnitUserData(bj_lastCreatedUnit,GetUnitUserData(Pf))
call GroupAddUnit(JH[GetUnitUserData(Pf)],bj_lastCreatedUnit)
call UnitAddType(bj_lastCreatedUnit,UNIT_TYPE_SUMMONED)
call SaveUnitHandle(O,GetHandleId(bj_lastCreatedUnit),7804,Pf)
call SetUnitState(bj_lastCreatedUnit,UNIT_STATE_LIFE,10000)
call GroupEnumUnitsInRange(Uz,GetUnitX(Pf),GetUnitY(Pf),450,null)
call YDWETimerRemoveUnit(6,bj_lastCreatedUnit)
loop
set D6=FirstOfGroup(Uz)
exitwhen Dm==3 or D6==null
call GroupRemoveUnit(Uz,D6)
if IsUnitEnemy(D6,GetOwningPlayer(Pf)) then
set Dm=Dm+1
call UnitRemoveAbility(bj_lastCreatedUnit,$41305443)
call UnitAddAbility(bj_lastCreatedUnit,$41305443)
call IssueTargetOrderById(bj_lastCreatedUnit,852527,D6)
endif
set D6=null
endloop
call SaveInteger(O,GetHandleId(Pf),StringHash("A0TB"),0)
call DestroyGroup(Uz)
set Uz=null
else
call SaveInteger(O,GetHandleId(Pf),StringHash("A0TB"),LoadInteger(O,GetHandleId(Pf),StringHash("A0TB"))+1)
endif
set D6=null
set Pf=null
endfunction
function Trig_AttackTrigegrActions takes nothing returns nothing
local unit Ki=null
local unit i=GetTriggerUnit()
local integer x=GetUnitTypeId(i)
local unit Pf=GetAttacker()
local integer YY=0
local location a7=null
local location dl=null
if GetUnitAbilityLevel(Pf,$41304443)>0 then
if GetRandomPercentageBJ()<=18 then
call UnitAddAbility(Pf,$41304443)
call SetUnitAbilityLevel(Pf,$41304443,2)
endif
endif
if GetUnitAbilityLevel(i,$41305438)>0 and OrderId2String(GetUnitCurrentOrder(i))!="fanofknives" then
call IssueImmediateOrder(i,"fanofknives")
elseif GetUnitAbilityLevel(Pf,$41305438)>0 and OrderId2String(GetUnitCurrentOrder(Pf))!="fanofknives" then
call IssueImmediateOrder(Pf,"fanofknives")
endif
if GetUnitAbilityLevel(Pf,$4130494B)>0 and LoadInteger(O,GetHandleId(Pf),$4130494B)>0 then
set YY=LoadInteger(O,GetHandleId(Pf),$4130494B)-1
call SaveInteger(O,GetHandleId(Pf),$4130494B,YY)
if YY==1 then
call UnitRemoveAbility(Pf,$4130494C)
endif
endif
if x==$6831384A or x==$68304A53 and GetUnitState(i,UNIT_STATE_LIFE)<=2. then
call KillUnit(i)
endif
if GetUnitTypeId(i)==$6E30304B and GetUnitState(Pf,UNIT_STATE_MANA)>=20. then
call DisableTrigger(GetTriggeringTrigger())
call IssueTargetOrder(Pf,"frostnova",i)
call EnableTrigger(GetTriggeringTrigger())
elseif GetUnitTypeId(i)==$68303259 then
call IssueTargetOrder(Pf,"entanglingroots",i)
elseif GetUnitTypeId(Pf)==$68304F53 then
call IssueTargetOrder(Pf,"slow",i)
elseif GetUnitAbilityLevel(Pf,$53303036)>0 and GetUnitState(Pf,UNIT_STATE_MANA)>=17 and LoadTimerHandle(O,GetHandleId(Pf),$53303036)==null then
call AttackTriggerCastCyclone(Pf,i)
elseif GetUnitAbilityLevel(Pf,$41305442)>0 then
call AttackTriggerHydraAttack(Pf,YY)
elseif GetUnitTypeId(Pf)==$68303838 or GetUnitTypeId(Pf)==$68305349 then
call IssueImmediateOrder(Pf,"stomp")
elseif GetUnitTypeId(Pf)==$68303842 and UnitHasBuffBJ(Pf,$42303259)==false then
call SetUnitInvulnerable(Pf,false)
elseif GetUnitTypeId(Pf)==$68303255 and GetUnitManaPercent(Pf)==100. then
call IssueImmediateOrderById(Pf,852164)
elseif GetUnitTypeId(Pf)==$6830344D or GetUnitTypeId(Pf)==$68305039 or GetUnitTypeId(Pf)==$6830344E or GetUnitTypeId(Pf)==$6E323035 or GetUnitTypeId(Pf)==$68303647 or GetUnitTypeId(Pf)==$68313647 or GetUnitTypeId(Pf)==$6E315332 or GetUnitTypeId(Pf)==$6E315334 then
if GetUnitStateSwap(UNIT_STATE_MANA,Pf)>=4. and UnitHasBuffBJ(Pf,$4230304F)==false and UnitHasBuffBJ(Pf,$4230315A)==false and UnitHasBuffBJ(Pf,$42305233)==false and UnitHasBuffBJ(Pf,$42315230)==false then
if GetUnitTypeId(Pf)!=$6E315332 and GetUnitTypeId(Pf)!=$6E315334 then
if GetUnitAbilityLevel(Pf,$41305233)!=0 then
call UnitRemoveAbility(Pf,$41305233)
call UnitAddAbility(Pf,$41305233)
elseif GetUnitAbilityLevel(Pf,$41315230)!=0 then
call UnitRemoveAbility(Pf,$41315230)
call UnitAddAbility(Pf,$41315230)
endif
endif
call IssueImmediateOrderById(Pf,852589)
if GetUnitTypeId(Pf)==$6E315332 then
set a7=GetUnitLoc(i)
set dl=OffsetLocation(a7,1.,1.)
call IssuePointOrderLoc(Pf,"attack",dl)
call RemoveLocation(dl)
call RemoveLocation(a7)
set a7=null
set dl=null
endif
endif
elseif GetUnitTypeId(Pf)==$68304344 and GetUnitStateSwap(UNIT_STATE_MANA,Pf)>=3. then
set Pb=GetUnitLoc(Pf)
call CreateNUnitsAtLoc(1,$75303036,Player(-1+GetUnitUserData(Pf)),Pb,bj_UNIT_FACING)
set Nr=bj_lastCreatedUnit
if GetUnitLifePercent(Pf)<=30. then
call UnitAddAbility(Nr,$4130414D)
call IssueTargetOrderById(Nr,852101,Pf)
call SetUnitManaBJ(Pf,0.)
else
if GetUnitLifePercent(Pf)<=50. then
call UnitAddAbility(Nr,$41303841)
call IssueTargetOrderById(Nr,852101,Pf)
call SetUnitManaBJ(Pf,0.)
else
if GetUnitLifePercent(Pf)<=70. then
call UnitAddAbility(Nr,$4130414E)
call IssueTargetOrderById(Nr,852101,Pf)
call SetUnitManaBJ(Pf,0.)
endif
endif
endif
call UnitApplyTimedLifeBJ(2.,$42544C46,Nr)
call RemoveLocation(Pb)
elseif GetUnitTypeId(Pf)==$68303342 or GetUnitTypeId(Pf)==$68304F43 then
if UnitHasBuffBJ(Pf,$42303133)==false and GetRandomInt(1,R2I(100))<=30 then
call UnitRemoveAbility(Pf,$41305241)
call UnitResetCooldown(Pf)
call UnitAddAbility(Pf,$41305241)
call IssueTargetOrder(Pf,"frenzy",Pf)
call ResetUnitAnimation(Pf)
set Pb=GetUnitLoc(Pf)
call CreateNUnitsAtLoc(1,$75303036,Player(-1+GetUnitUserData(Pf)),Pb,bj_UNIT_FACING)
set Nr=bj_lastCreatedUnit
call UnitAddAbility(Nr,$41303256)
call IssueTargetOrderById(Nr,852066,Pf)
call UnitApplyTimedLifeBJ(2.,$42544C46,Nr)
call RemoveLocation(Pb)
endif
elseif GetUnitAbilityLevel(Pf,$4130364F)>0 then
if GetUnitStateSwap(UNIT_STATE_MANA,Pf)==GetUnitStateSwap(UNIT_STATE_MAX_MANA,Pf) then
call SetWidgetLife(Pf,GetUnitStateSwap(UNIT_STATE_LIFE,Pf)+80)
call SetUnitManaBJ(Pf,0)
set Pb=GetUnitLoc(Pf)
call DestroyEffect(AddSpecialEffectLoc("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl",Pb))
call RemoveLocation(Pb)
else
call SetUnitManaBJ(Pf,GetUnitStateSwap(UNIT_STATE_MANA,Pf)+1)
endif
elseif GetUnitTypeId(i)==$68303832 then
if GetUnitLifePercent(i)<=10 then
call UnitAddAbility(i,$41303650)
call IssueImmediateOrderById(i,852100)
endif
elseif GetUnitTypeId(Pf)==$6E303037 then
call IssueTargetOrderById(Pf,852587,i)
elseif GetUnitTypeId(Pf)==$68303330 and GetUnitAbilityLevelSwapped($41303555,Pf)==0 then
call UnitAddAbility(i,$41303555)
call UnitAddAbility(i,$41303556)
elseif GetUnitTypeId(Pf)==$6E305342 then
call UnitAddAbility(i,$41305339)
call UnitAddAbility(i,$41305330)
elseif GetUnitTypeId(Pf)==$6830365A then
if GetRandomInt(1,R2I(100))<=20 and UnitHasBuffBJ(Pf,$42303239)==false then
call IssueImmediateOrderById(Pf,852100)
endif
elseif GetUnitTypeId(Pf)==$68303734 and GetUnitManaPercent(Pf)==100. then
call IssueImmediateOrderById(Pf,852096)
