call GroupAddUnit(JH[GetUnitUserData(i)],bj_lastCreatedUnit)
call UnitAddType(bj_lastCreatedUnit,UNIT_TYPE_SUMMONED)
call YDWETimerRemoveUnit(2,bj_lastCreatedUnit)
call SaveUnitHandle(O,GetHandleId(bj_lastCreatedUnit),122,bj_lastCreatedUnit)
