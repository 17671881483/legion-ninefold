function GarroshShieldWallAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
local unit Pf=LoadUnitHandle(O,GetHandleId(t),1)
local real Pv=LoadReal(O,GetHandleId(t),2)
if GetTriggerEventId()==EVENT_UNIT_DAMAGED then
if GetUnitAbilityLevel(Pf,Ql)==0 then
call UnitAddAbility(Bc,Ql)
call UnitAddAbility(Pf,Ql)
endif
if not HaveSavedReal(O,GetHandleId(t),2) then
set Pv=100
endif
if Pv-GetUnitLifePercent(Bc)>=2 then
set Pv=GetUnitLifePercent(Bc)
call SaveReal(O,GetHandleId(t),2,Pv)
call SetUnitAbilityLevel(Bc,Ql,GetUnitAbilityLevel(Bc,Ql)+1)
call SetUnitAbilityLevel(Pf,Ql,GetUnitAbilityLevel(Pf,Ql)+1)
endif
else
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
endif
set t=null
set Bc=null
set Pf=null
endfunction
