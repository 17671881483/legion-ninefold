function PhoenixShotAction takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer Pq=GetHandleId(t)
local real Q5=LoadReal(O,Pq,0)
local unit Bc=LoadUnitHandle(O,Pq,2)
local real FF=LoadReal(O,Pq,3)
local real FG=LoadReal(O,Pq,4)
local real Pm=LoadReal(O,Pq,5)
local real aM=LoadReal(O,Pq,6)+10
local group aN=LoadGroupHandle(O,Pq,133)
local real Qv=FF+CosBJ(Pm+aM)*Q5
local real Qw=FG+SinBJ(Pm+aM)*Q5
local group DG
local unit D6
local string QM="LJQ_AO02HZY_W02.mdx"
if GetTriggerEventId()==EVENT_UNIT_DEATH or aM>=360 or IsTerrainPathable(Qv,Qw,PATHING_TYPE_WALKABILITY) or not RectContainsCoords(GetPlayerRect(ConvertedPlayer(GetUnitUserData(Bc))),Qv,Qw) then
call DestroyEffect(LoadEffectHandle(O,Pq,1))
call SetUnitVertexColor(Bc,255,255,255,255)
call SetUnitPathing(Bc,true)
call DestroyGroup(aN)
call PauseUnit(Bc,false)
call FlushChildHashtable(O,Pq)
call DestroyTrigger(t)
else
call SaveReal(O,Pq,6,aM)
call SetUnitX(Bc,Qv)
call SetUnitY(Bc,Qw)
call SetUnitFacing(Bc,Pm+aM-90)
set DG=SelectRange(Bc,Qv,Qw,200+25)
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
if not IsUnitInGroup(D6,aN) then
call GroupAddUnit(aN,D6)
call UnitDamageTargetBJ(Bc,D6,75,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
call LoopDamageRange(Bc,225,GetUnitX(D6),GetUnitY(D6),10,1,7)
if LoadBoolean(O,GetHandleId(Bc),$68305757) then
set QM="LJQ_AO02HZY_W02_Blue.mdx"
endif
call YDWETimerDestroyEffect(7,AddSpecialEffect(QM,GetUnitX(D6),GetUnitY(D6)))
endif
call GroupRemoveUnit(DG,D6)
endloop
call DestroyGroup(DG)
set DG=null
endif
set t=null
set Bc=null
set aN=null
return false
endfunction
function PhoenixShot takes unit Bc,real Qv,real Qw returns nothing
local trigger t=CreateTrigger()
local integer Pq=GetHandleId(t)
local real FF=GetUnitX(Bc)
local real FG=GetUnitY(Bc)
local string QM="LJQ_AO02HZY_W01.mdx"
local real Pm=Atan2BJ(Qw-FG,Qv-FF)
local real Q5=RMaxBJ(300,GetDisFromUnitAndPos(Bc,Qv,Qw))
call TriggerRegisterTimerEvent(t,.02,true)
call TriggerRegisterUnitEvent(t,Bc,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function PhoenixShotAction))
call SaveReal(O,Pq,0,Q5)
if LoadBoolean(O,GetHandleId(Bc),$68305757) then
set QM="LJQ_AO02HZY_W01_Blue.mdx"
endif
call SaveAgentHandle(O,Pq,1,AddSpecialEffectTarget(QM,Bc,"origin"))
call SaveUnitHandle(O,Pq,2,Bc)
call SaveReal(O,Pq,3,FF+CosBJ(Pm)*Q5)
call SaveReal(O,Pq,4,FG+SinBJ(Pm)*Q5)
call SaveReal(O,Pq,5,Pm)
call SaveGroupHandle(O,Pq,133,CreateGroup())
call PauseUnit(Bc,true)
call SetUnitPathing(Bc,false)
call SetUnitVertexColor(Bc,255,255,255,50)
set t=null
set Bc=null
endfunction
function PhoenixFlamestrikeActionChangeAction takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer Pq=GetHandleId(t)
local unit Bc=LoadUnitHandle(O,Pq,2)
local unit Om=LoadUnitHandle(O,Pq,17)
local unit Ki=LoadUnitHandle(O,Pq,393)
local real FF=GetUnitX(Om)
local real FG=GetUnitY(Om)
local real Pm=GetAngle(GetUnitX(Ki),GetUnitY(Ki),FF,FG)
if GetTriggerEventId()==EVENT_UNIT_DEATH or IsUnitType(Om,UNIT_TYPE_DEAD) then
call ShowUnit(Ki,false)
call FlushChildHashtable(O,Pq)
call DestroyTrigger(t)
else
call SetUnitFacing(Ki,Pm)
call SetUnitPosition(Ki,GetUnitX(Ki)+CosBJ(Pm),GetUnitY(Ki)+SinBJ(Pm))
if GetDist(GetUnitX(Ki),GetUnitY(Ki),FF,FG)<50 then
call UnitDamageTargetBJ(Bc,Om,102,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
call KillUnit(Ki)
call ShowUnit(Ki,false)
endif
endif
set t=null
set Bc=null
set Om=null
set Ki=null
return false
endfunction
function PhoenixFlamestrikeActionChange takes unit Bc,unit Ki,unit Om returns nothing
local trigger t=CreateTrigger()
local integer Pq=GetHandleId(t)
local group DG
if Bc==Om or Om==null or IsUnitType(Om,UNIT_TYPE_DEAD) or IsUnitType(Ki,UNIT_TYPE_DEAD) then
call KillUnit(Ki)
call ShowUnit(Ki,false)
else
call SetUnitPathing(Ki,false)
call SetUnitVertexColor(Ki,255,255,255,255)
call TriggerRegisterTimerEvent(t,.02,true)
call TriggerRegisterUnitEvent(t,Bc,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,Om,EVENT_UNIT_DEATH)
call TriggerRegisterUnitEvent(t,Ki,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function PhoenixFlamestrikeActionChangeAction))
call SaveUnitHandle(O,Pq,2,Bc)
call SaveUnitHandle(O,Pq,17,Om)
call SaveUnitHandle(O,Pq,393,Ki)
endif
set t=null
set Bc=null
set Ki=null
set Om=null
set DG=null
endfunction
function PhoenixFlamestrikeAction takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer Pq=GetHandleId(t)
local integer y=LoadInteger(O,Pq,34)
local unit Bc=LoadUnitHandle(O,Pq,2)
local real aR=GetUnitX(Bc)
local real aS=GetUnitY(Bc)
local unit aO=LoadUnitHandle(O,Pq,393)
local unit RO=LoadUnitHandle(O,Pq,394)
local unit aP=LoadUnitHandle(O,Pq,395)
local unit aQ=LoadUnitHandle(O,Pq,396)
local unit Om=LoadUnitHandle(O,Pq,0)
local real FF
local real FG
local real KI=-1*360*.02/4
local real Pm
local real aT
local real aM=LoadReal(O,Pq,685)
local real aU
local integer Q5=800
if .02*GetTriggerEvalCount(t)>=5 and GetTriggerEventId()==EVENT_GAME_TIMER_EXPIRED then
if aO!=null and IsUnitType(aO,UNIT_TYPE_DEAD)==false then
call PhoenixFlamestrikeActionChange(Bc,aO,Bc)
endif
if RO!=null and IsUnitType(RO,UNIT_TYPE_DEAD)==false then
call PhoenixFlamestrikeActionChange(Bc,RO,Bc)
endif
if aP!=null and IsUnitType(aP,UNIT_TYPE_DEAD)==false then
call PhoenixFlamestrikeActionChange(Bc,aP,Bc)
endif
if aQ!=null and IsUnitType(aQ,UNIT_TYPE_DEAD)==false then
call PhoenixFlamestrikeActionChange(Bc,aQ,Bc)
endif
call FlushChildHashtable(O,Pq)
call DestroyTrigger(t)
elseif I2R(R2I(.02*GetTriggerEvalCount(t)))==.02*I2R(GetTriggerEvalCount(t)) and GetTriggerEventId()==EVENT_GAME_TIMER_EXPIRED then
if not IsUnitType(aO,UNIT_TYPE_DEAD) and aO!=null then
call PhoenixFlamestrikeActionChange(Bc,aO,Om)
call RemoveSavedHandle(O,Pq,393)
elseif not IsUnitType(RO,UNIT_TYPE_DEAD) and RO!=null then
call PhoenixFlamestrikeActionChange(Bc,RO,Om)
call RemoveSavedHandle(O,Pq,394)
elseif not IsUnitType(aP,UNIT_TYPE_DEAD) and aP!=null then
call PhoenixFlamestrikeActionChange(Bc,aP,Om)
call RemoveSavedHandle(O,Pq,395)
elseif not IsUnitType(aQ,UNIT_TYPE_DEAD) and aQ!=null then
call PhoenixFlamestrikeActionChange(Bc,aQ,Om)
call RemoveSavedHandle(O,Pq,396)
call FlushChildHashtable(O,Pq)
call DestroyTrigger(t)
endif
else
set y=y+1
call SaveInteger(O,Pq,34,y)
if aO!=null and IsUnitType(aO,UNIT_TYPE_DEAD)==false then
set aT=360*4/4.
set Pm=aT+KI*y
set FF=aR+200*Cos(Pm*bj_DEGTORAD)
set FG=aS+200*Sin(Pm*bj_DEGTORAD)
call SetUnitFacing(aO,Pm-90)
call SetUnitPosition(aO,FF,FG)
endif
if RO!=null and IsUnitType(RO,UNIT_TYPE_DEAD)==false then
set aT=360*3/4.
set Pm=aT+KI*y
set FF=aR+200*Cos(Pm*bj_DEGTORAD)
set FG=aS+200*Sin(Pm*bj_DEGTORAD)
call SetUnitFacing(RO,Pm-90)
call SetUnitPosition(RO,FF,FG)
endif
if aP!=null and IsUnitType(aP,UNIT_TYPE_DEAD)==false then
set aT=360*2/4.
set Pm=aT+KI*y
set FF=aR+200*Cos(Pm*bj_DEGTORAD)
set FG=aS+200*Sin(Pm*bj_DEGTORAD)
call SetUnitFacing(aP,Pm-90)
call SetUnitPosition(aP,FF,FG)
endif
if aQ!=null and IsUnitType(aQ,UNIT_TYPE_DEAD)==false then
set aT=360*1/4.
set Pm=aT+KI*y
set FF=aR+200*Cos(Pm*bj_DEGTORAD)
set FG=aS+200*Sin(Pm*bj_DEGTORAD)
call SetUnitFacing(aQ,Pm-90)
call SetUnitPosition(aQ,FF,FG)
endif
if y>Q5 or GetTriggerEventId()==EVENT_WIDGET_DEATH then
if aO!=null and IsUnitDead(aO)==false then
call PhoenixFlamestrikeActionChange(Bc,aO,Bc)
endif
if RO!=null and IsUnitDead(RO)==false then
call PhoenixFlamestrikeActionChange(Bc,RO,Bc)
endif
if aP!=null and IsUnitDead(aP)==false then
call PhoenixFlamestrikeActionChange(Bc,aP,Bc)
endif
if aQ!=null and IsUnitDead(aQ)==false then
call PhoenixFlamestrikeActionChange(Bc,aQ,Bc)
endif
call FlushChildHashtable(O,Pq)
call DestroyTrigger(t)
else
set aM=RMinBJ(.25+.75*(I2R(y)/500.),1)
set aU=.25+(1-.2)*2.5
call SetUnitScale(aO,aU,aU,aU)
call SetUnitScale(RO,aU,aU,aU)
call SetUnitScale(aP,aU,aU,aU)
call SetUnitScale(aQ,aU,aU,aU)
if y>Q5-200 then
if ModuloInteger(y,10)==0 or ModuloInteger(y,10)==1 or ModuloInteger(y,10)==2 or ModuloInteger(y,10)==3 or ModuloInteger(y,10)==4 then
call SetUnitVertexColor(aO,255,0,0,255)
call SetUnitVertexColor(RO,255,0,0,255)
call SetUnitVertexColor(aP,255,0,0,255)
call SetUnitVertexColor(aQ,255,0,0,255)
else
call SetUnitVertexColor(aO,255,255,255,255)
call SetUnitVertexColor(RO,255,255,255,255)
call SetUnitVertexColor(aP,255,255,255,255)
call SetUnitVertexColor(aQ,255,255,255,255)
endif
endif
endif
endif
set t=null
set Bc=null
set aO=null
set RO=null
set aP=null
set aQ=null
set Om=null
return false
endfunction
function PhoenixFlamestrike takes unit Bc,unit Om returns nothing
local trigger t=CreateTrigger()
local integer Pq=GetHandleId(t)
local real FF
local real FG
local unit aO
local unit RO
local unit aP
local unit aQ
local integer x=$65303147
if LoadBoolean(O,GetHandleId(Bc),$68305757) then
call SetUnitTypeModel(x,"firespirit_Blue01.mdx",null)
else
call SetUnitTypeModel(x,"firespirit_2.mdx",null)
endif
set FF=GetUnitX(Bc)+200*Cos(bj_DEGTORAD*360*4/4.*-1.)
set FG=GetUnitY(Bc)+200*Sin(bj_DEGTORAD*360*4/4.*-1.)
set aO=CreateUnit(GetOwningPlayer(Bc),x,FF,FG,360*4/4.*-1.)
set FF=GetUnitX(Bc)+200*Cos(bj_DEGTORAD*360*3/4.*-1.)
set FG=GetUnitY(Bc)+200*Sin(bj_DEGTORAD*360*3/4.*-1.)
set RO=CreateUnit(GetOwningPlayer(Bc),x,FF,FG,360*3/4.*-1.)
set FF=GetUnitX(Bc)+200*Cos(bj_DEGTORAD*360*2/4.*-1.)
set FG=GetUnitY(Bc)+200*Sin(bj_DEGTORAD*360*2/4.*-1.)
set aP=CreateUnit(GetOwningPlayer(Bc),x,FF,FG,360*2/4.*-1.)
set FF=GetUnitX(Bc)+200*Cos(bj_DEGTORAD*360*1/4.*-1.)
set FG=GetUnitY(Bc)+200*Sin(bj_DEGTORAD*360*1/4.*-1.)
set aQ=CreateUnit(GetOwningPlayer(Bc),x,FF,FG,360*1/4.*-1.)
call TriggerRegisterTimerEvent(t,.02,true)
call TriggerRegisterDeathEvent(t,Bc)
call TriggerAddCondition(t,Condition(function PhoenixFlamestrikeAction))
call SaveUnitHandle(O,Pq,0,Om)
call SaveUnitHandle(O,Pq,2,Bc)
call SaveUnitHandle(O,Pq,393,aO)
call SaveUnitHandle(O,Pq,394,RO)
call SaveUnitHandle(O,Pq,395,aP)
call SaveUnitHandle(O,Pq,396,aQ)
set Bc=null
set aO=null
set RO=null
set aP=null
set aQ=null
set t=null
set Om=null
endfunction
function PhoenixReviveAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
local unit Ki=LoadUnitHandle(O,GetHandleId(t),1)
local integer y=LoadInteger(O,GetHandleId(t),2)+1
local group DG
local unit D6
local integer BF=0
local string QM
local boolean KH=LoadBoolean(O,GetHandleId(t),3)
if GetTriggerEventId()==EVENT_GAME_TIMER_EXPIRED then
set QM="Phoenix.mdx"
if KH then
set QM="Phoenix_Blue.mdx"
endif
call SetUnitTypeModel($6830565A,QM,null)
call KillUnit(Ki)
set BF=GetUnitUserData(Ki)
set Bc=CreateUnit(GetOwningPlayer(Ki),$6830565A,GetUnitX(Ki),GetUnitY(Ki),GetUnitFacing(Ki))
if KH then
call SaveBoolean(O,GetHandleId(Bc),$68305757,true)
endif
call SetUnitColor(Bc,GetPlayerColor(ConvertedPlayer(BF)))
call GroupAddUnit(JW,Bc)
call GroupAddUnit(JH[BF],Bc)
call SetUnitUserData(Bc,BF)
call RemoveUnit(Ki)
if y<2 then
call SaveUnitHandle(O,GetHandleId(t),0,Bc)
call SaveInteger(O,GetHandleId(t),2,y)
call UnitAddAbility(Bc,$41315345)
call TriggerRegisterUnitEvent(t,Bc,EVENT_UNIT_DEATH)
else
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
endif
elseif GetUnitAbilityLevel(Bc,$41315345)>0 then
set QM="Phoenix2.mdl"
if KH then
set QM="Phoenix2_Blue.mdx"
endif
call SetUnitTypeModel($68305659,QM,null)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\MarkOfChaos\\MarkOfChaosTarget.mdl",GetUnitX(Bc),GetUnitY(Bc)))
set DG=SelectRange(Bc,GetUnitX(Bc),GetUnitY(Bc),400)
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
call UnitDamageTargetBJ(Bc,D6,102,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\MarkOfChaos\\MarkOfChaosTarget.mdl",GetUnitX(D6),GetUnitY(D6)))
endloop
call DestroyGroup(DG)
set DG=null
set Bi=GetUnitUserData(Bc)
set Ki=CreateUnit(GetOwningPlayer(Bc),$68305659,GetUnitX(Bc),GetUnitY(Bc),GetUnitFacing(Bc))
call GroupAddUnit(JW,Ki)
call GroupAddUnit(JH[Bi],Ki)
call SetUnitUserData(Ki,GetUnitUserData(Bc))
call SaveUnitHandle(O,GetHandleId(t),1,Ki)
call RemoveUnit(Bc)
call TriggerRegisterTimerEvent(t,3,false)
else
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
endif
set t=null
set Bc=null
set Ki=null
endfunction
function PhoenixRevive takes unit Bc returns nothing
local trigger t=CreateTrigger()
if GetUnitTypeId(Bc)==$68305757 then
call SaveBoolean(O,GetHandleId(t),3,true)
call SaveBoolean(O,GetHandleId(Bc),$68305757,true)
endif
call SaveAgentHandle(O,GetHandleId(t),0,Bc)
call TriggerRegisterUnitEvent(t,Bc,EVENT_UNIT_DEATH)
call TriggerAddAction(t,function PhoenixReviveAction)
set t=null
set Bc=null
endfunction
function NewGuldanSetOwner takes unit i,unit Qf returns nothing
local unit Ki
local integer gC=GetUnitTypeId(Qf)
local real gE=GetUnitX(Qf)
local real gH=GetUnitY(Qf)
local real gI=GetUnitState(Qf,UNIT_STATE_LIFE)
local real gJ=GetUnitState(Qf,UNIT_STATE_MANA)
call RemoveUnit(Qf)
set Ki=CreateUnit(GetOwningPlayer(i),gC,gE,gH,0)
call SetUnitLifeBJ(Ki,gI)
call SetUnitManaBJ(Ki,gJ)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Charm\\CharmTarget.mdl",Ki,"origin"))
call UnitAddType(Ki,UNIT_TYPE_GIANT)
call UnitAddType(Ki,UNIT_TYPE_SUMMONED)
call SetUnitOwner(Ki,GetOwningPlayer(i),true)
call SetUnitUserData(Ki,GetUnitUserData(i))
call IssuePointOrder(Ki,"attack",GetPlayerStartLocationX(Player(GetUnitUserData(i)-1)),GetPlayerStartLocationY(Player(GetUnitUserData(i)-1)))
call SetUnitColor(Ki,GetPlayerColor(Player(GetUnitUserData(i)-1)))
call GroupAddUnit(JH[GetUnitUserData(i)],Ki)
call GroupAddUnit(JW,Ki)
call SaveBoolean(O,GetHandleId(Ki),$4131514C,true)
set i=null
set Qf=null
set Ki=null
endfunction
function NewGuldanEvilEnergyArrowCollideTimerFinish takes nothing returns nothing
local unit Bc=GetChargeSource()
local group Uz=LoadGroupHandle(O,GetHandleId(Bc),$4131514C)
call DestroyGroup(Uz)
set Uz=null
set Bc=null
endfunction
function NewGuldanEvilEnergyArrowCollideTimerCallback takes nothing returns nothing
local unit Bc=GetChargeSource()
local unit Ki=GetChargeDummy()
local group DG=SelectRange(Bc,GetUnitX(Ki),GetUnitY(Ki),200)
local group Uz=LoadGroupHandle(O,GetHandleId(Bc),$4131514C)
local unit D6=null
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
if not IsUnitInGroup(D6,Uz) then
call UnitDamageTarget(Bc,D6,101,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,null)
call GroupAddUnit(Uz,D6)
endif
call GroupRemoveUnit(DG,D6)
endloop
call DestroyGroup(DG)
set D6=null
set Uz=null
set Ki=null
set DG=null
set Bc=null
endfunction
function NewGuldanEvilEnergyArrowCollideTimer takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer BQ=GetHandleId(t)
local unit Bc=LoadUnitHandle(O,BQ,0)
local real FF=LoadReal(O,BQ,1)
local real FG=LoadReal(O,BQ,2)
local real Pm=Atan2BJ(FG-GetUnitY(Bc),FF-GetUnitX(Bc))
local string QM="Abilities\\Spells\\Other\\BlackArrow\\BlackArrowMissile.mdl"
local unit Ki=CreateUnit(GetOwningPlayer(Bc),Pn,GetUnitX(Bc),GetUnitY(Bc),Pm)
local real DK=.2
call SaveGroupHandle(O,GetHandleId(Bc),$4131514C,CreateGroup())
call YDWETimerDestroyEffect(DK,AddSpecialEffectTarget(QM,Ki,"chest"))
call YDWETimerRemoveUnit(DK,Ki)
call ChargeDistance(Bc,Ki,Pm,800,DK,"NewGuldanEvilEnergyArrowCollideTimerCallback","NewGuldanEvilEnergyArrowCollideTimerFinish")
call FlushChildHashtable(O,BQ)
call DestroyTimer(t)
set t=null
set Bc=null
set Ki=null
set QM=null
endfunction
function NewGuldanEvilShootEnergyArrow takes unit Bc,real FF,real FG,integer aV returns nothing
local timer t=CreateTimer()
call SaveUnitHandle(O,GetHandleId(t),0,Bc)
call SaveReal(O,GetHandleId(t),1,FF)
call SaveReal(O,GetHandleId(t),2,FG)
call TimerStart(t,1*(aV-1),false,function NewGuldanEvilEnergyArrowCollideTimer)
set Bc=null
set t=null
endfunction
function NewGuldanEvilEnergyArrow takes unit Bc,real FF,real FG returns nothing
local integer BB=0
if IsUnitType(Bc,UNIT_TYPE_ANCIENT) then
set Bc=null
return
endif
loop
exitwhen BB>=3
set BB=BB+1
call NewGuldanEvilShootEnergyArrow(Bc,FF,FG,BB)
endloop
set Bc=null
endfunction
function NewGuldanAcidRainDamage takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer BQ=GetHandleId(t)
local unit Bc=LoadUnitHandle(O,BQ,0)
local real FF=LoadReal(O,BQ,1)
local real FG=LoadReal(O,BQ,2)
local integer Ez=LoadInteger(O,BQ,3)
local group DG=SelectRange(Bc,FF,FG,400)
local unit D6=null
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
if IsUnitEnemy(D6,GetOwningPlayer(Bc)) then
call UnitDamageTarget(Bc,D6,26,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,null)
endif
call GroupRemoveUnit(DG,D6)
endloop
set Ez=Ez-1
call SaveInteger(O,BQ,3,Ez)
if Ez<=0 then
call DestroyEffect(LoadEffectHandle(O,BQ,4))
call FlushChildHashtable(O,BQ)
call DestroyTimer(t)
endif
call DestroyGroup(DG)
set D6=null
set DG=null
set t=null
set Bc=null
endfunction
function NewGuldanBladeMasterAcidRain takes unit Bc,real FF,real FG returns nothing
local timer t
if IsUnitType(Bc,UNIT_TYPE_ANCIENT) then
set Bc=null
set t=null
return
endif
set t=CreateTimer()
call SaveUnitHandle(O,GetHandleId(t),0,Bc)
call SaveReal(O,GetHandleId(t),1,FF)
call SaveReal(O,GetHandleId(t),2,FG)
call SaveInteger(O,GetHandleId(t),3,16)
call SaveAgentHandle(O,GetHandleId(t),4,AddSpecialEffect("LJQ_Rain01_Green.mdx",FF,FG))
call TimerStart(t,1.,true,function NewGuldanAcidRainDamage)
set Bc=null
set t=null
endfunction
function NewGuldanAbsorbLife takes unit Bc,real FF,real FG returns real
local real aW=0.
local group aX=SelectRange(Bc,FF,FG,400)
local unit aZ=null
local real aa
local location Z8=GetUnitLoc(Bc)
local real aY=GetLocationZ(Z8)+GetUnitFlyHeight(Bc)+100
local real ab
call RemoveLocation(Z8)
loop
set aZ=FirstOfGroup(aX)
exitwhen aZ==null
set aa=GetUnitState(aZ,UNIT_STATE_LIFE)*.3
call SetUnitState(aZ,UNIT_STATE_LIFE,GetUnitState(aZ,UNIT_STATE_LIFE)-aa)
set aW=aW+aa
call GroupRemoveUnit(aX,aZ)
set Z8=GetUnitLoc(aZ)
set ab=GetLocationZ(Z8)+GetUnitFlyHeight(aZ)+100
call RemoveLocation(Z8)
call YDWETimerDestroyLightning(.2,AddLightningEx("DRAB",false,GetUnitX(Bc),GetUnitY(Bc),aY,GetUnitX(aZ),GetUnitY(aZ),ab))
endloop
call DestroyGroup(aX)
set aZ=null
set aX=null
set Bc=null
set Z8=null
return aW
endfunction
function NewGuldanHealAllies takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer BQ=GetHandleId(t)
local unit Bc=LoadUnitHandle(O,BQ,0)
local real FF=LoadReal(O,BQ,1)
local real FG=LoadReal(O,BQ,2)
local real aW=LoadReal(O,BQ,3)
local integer Ez=LoadInteger(O,BQ,4)
local group ac=SelectRangeAlly(Bc,FF,FG,600)
local unit af=null
local integer ad=CountUnitsInGroup(ac)
local real ae=LoadReal(O,BQ,5)
if ad>0 then
set ae=ae/ad
loop
set af=FirstOfGroup(ac)
exitwhen af==null
call SetUnitState(af,UNIT_STATE_LIFE,GetUnitState(af,UNIT_STATE_LIFE)+ae)
call GroupRemoveUnit(ac,af)
if Bc!=af then
call YDWETimerDestroyEffect(1,AddSpecialEffectTarget("Abilities\\Spells\\Other\\Drain\\DrainCaster.mdl",Bc,"origin"))
endif
endloop
endif
call DestroyGroup(ac)
set Ez=Ez-1
call SaveInteger(O,BQ,4,Ez)
if Ez<=0 then
call DestroyEffect(LoadEffectHandle(O,BQ,6))
call FlushChildHashtable(O,BQ)
call DestroyTimer(t)
endif
set af=null
set ac=null
set t=null
set Bc=null
endfunction
function NewGuldanBladeMasterLifeDrain takes unit Bc returns nothing
local real FF=GetUnitX(Bc)
local real FG=GetUnitY(Bc)
local real aW
local timer t
local integer DK=6
if IsUnitType(Bc,UNIT_TYPE_ANCIENT) then
set Bc=null
set t=null
return
endif
set t=CreateTimer()
set aW=NewGuldanAbsorbLife(Bc,FF,FG)
call SaveUnitHandle(O,GetHandleId(t),0,Bc)
call SaveReal(O,GetHandleId(t),1,FF)
call SaveReal(O,GetHandleId(t),2,FG)
call SaveReal(O,GetHandleId(t),3,aW)
call SaveInteger(O,GetHandleId(t),4,DK)
call SaveReal(O,GetHandleId(t),5,aW/DK)
call SaveEffectHandle(O,GetHandleId(t),6,AddSpecialEffectTarget("Abilities\\Spells\\Other\\Drain\\DrainCaster.mdl",Bc,"origin"))
call TimerStart(t,1.,true,function NewGuldanHealAllies)
set Bc=null
set t=null
endfunction
function BlademasterDrawAKnifeAndChop takes unit Bc returns nothing
local group DG=SelectRange(Bc,GetUnitX(Bc),GetUnitY(Bc),300)
local unit D6
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
call UnitDamageTargetBJ(Bc,D6,5*GetUnitState(Bc,ConvertUnitState(18)),ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
endloop
call SetUnitLifePercentBJ(Bc,GetUnitLifePercent(Bc)+75)
call YDWETimerDestroyEffect(1,AddSpecialEffect("LJQ_BDZ01_RED.mdx",GetUnitX(Bc),GetUnitY(Bc)))
call DestroyGroup(DG)
set DG=null
set Bc=null
endfunction
function BlademasterCriticalStrikeTimer takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
local integer BF=LoadInteger(O,GetHandleId(t),1)
if Bc!=null and BF!=0 then
call UnitAddAbility(Bc,BF)
call UnitMakeAbilityPermanent(Bc,true,BF)
if LoadTimerHandle(O,GetHandleId(Bc),BF)==t then
call RemoveSavedHandle(O,GetHandleId(Bc),BF)
endif
endif
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTimer(t)
set t=null
set Bc=null
endfunction
function BlademasterCriticalStrike takes unit Bc returns nothing
local integer BF=$41315145
local timer t
if Bc!=null and GetUnitAbilityLevel(Bc,BF)>0 and not IsUnitIllusion(Bc) and not HaveSavedHandle(O,GetHandleId(Bc),BF) then
call UnitRemoveAbility(Bc,BF)
set t=CreateTimer()
call SaveAgentHandle(O,GetHandleId(t),0,Bc)
call SaveInteger(O,GetHandleId(t),1,BF)
call SaveTimerHandle(O,GetHandleId(Bc),BF,t)
call TimerStart(t,9,false,function BlademasterCriticalStrikeTimer)
set t=null
endif
set Bc=null
endfunction
function BlademasterBladeStormTimer takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
local real FF=GetUnitX(Bc)
local real FG=GetUnitY(Bc)
local integer Ez=LoadInteger(O,GetHandleId(t),1)
local group DG=SelectRange(Bc,FF,FG,200)
local unit D6
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
call UnitDamageTarget(Bc,D6,137,true,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
endloop
call DestroyGroup(DG)
set Ez=Ez-1
call SaveInteger(O,GetHandleId(t),1,Ez)
if Ez<=0 then
call SaveBoolean(O,GetHandleId(Bc),$41315144,false)
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTimer(t)
call AddUnitAnimationProperties(Bc,"spin",false)
call UnitRemoveAbility(Bc,aw)
else
call TimerStart(t,1,false,function BlademasterBladeStormTimer)
endif
set Bc=null
set t=null
set DG=null
endfunction
function BlademasterBladeStorm takes unit Bc returns nothing
local timer t
local integer y=LoadInteger(O,GetHandleId(Bc),$41315144)+1
if y>=15 and not LoadBoolean(O,GetHandleId(Bc),$41315144) then
call SaveInteger(O,GetHandleId(Bc),$41315144,y-15)
call SaveBoolean(O,GetHandleId(Bc),$41315144,true)
call AddUnitAnimationProperties(Bc,"spin",true)
set t=CreateTimer()
call SaveUnitHandle(O,GetHandleId(t),0,Bc)
call SaveInteger(O,GetHandleId(t),1,4)
call TimerStart(t,0,false,function BlademasterBladeStormTimer)
call UnitAddAbility(Bc,aw)
set t=null
elseif not LoadBoolean(O,GetHandleId(Bc),$41315144) then
call SaveInteger(O,GetHandleId(Bc),$41315144,y)
endif
set Bc=null
endfunction
function BladeMasterSwordFireFireTimer takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit Om=LoadUnitHandle(O,GetHandleId(t),0)
local unit Bc=LoadUnitHandle(O,GetHandleId(t),1)
local integer Ez=LoadInteger(O,GetHandleId(t),2)
call UnitDamageTarget(Bc,Om,72,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,null)
set Ez=Ez-1
call SaveInteger(O,GetHandleId(t),2,Ez)
if Ez<=0 then
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTimer(t)
endif
set Om=null
set Bc=null
set t=null
endfunction
function BladeMasterSwordFireTimer takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
local unit Ki=LoadUnitHandle(O,GetHandleId(t),1)
local real Pm=LoadReal(O,GetHandleId(t),2)
local real Qx=LoadReal(O,GetHandleId(t),3)
local real FF=GetUnitX(Ki)
local real FG=GetUnitY(Ki)
local real QT=200*.03
local real ID=Cos(Pm*bj_DEGTORAD)*QT
local real IF=Sin(Pm*bj_DEGTORAD)*QT
local real ah=FF+ID
local real ai=FG+IF
local group DG=SelectRange(Bc,ah,ai,200)
local group ag=LoadGroupHandle(O,GetHandleId(t),4)
local unit D6=null
local timer aj=null
call SetUnitPosition(Ki,ah,ai)
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
if not IsUnitInGroup(D6,ag) then
call UnitDamageTarget(Bc,D6,225,true,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC,null)
set aj=CreateTimer()
call SaveUnitHandle(O,GetHandleId(aj),0,D6)
call SaveUnitHandle(O,GetHandleId(aj),1,Bc)
call SaveInteger(O,GetHandleId(aj),2,5)
call TimerStart(aj,1.,true,function BladeMasterSwordFireFireTimer)
call GroupAddUnit(ag,D6)
endif
endloop
call DestroyGroup(DG)
set Qx=Qx-QT
if Qx>0. then
call SaveReal(O,GetHandleId(t),3,Qx)
else
call RemoveUnit(Ki)
call DestroyGroup(ag)
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTimer(t)
endif
set Ki=null
set D6=null
set DG=null
set ag=null
set aj=null
set Bc=null
set t=null
endfunction
function BladeMasterSwordFire takes unit Bc,real Pm returns nothing
local real Qx=1000.
local unit Ki=CreateUnit(GetOwningPlayer(Bc),Pn,GetUnitX(Bc),GetUnitY(Bc),Pm)
local group ag=CreateGroup()
local timer t=CreateTimer()
local effect DE=AddSpecialEffect("LJQ_JS_JQB01.mdx",GetUnitX(Bc),GetUnitY(Bc))
call EXEffectMatRotateZ(DE,Pm)
call YDWETimerDestroyEffect(1,DE)
call SaveUnitHandle(O,GetHandleId(t),0,Bc)
call SaveUnitHandle(O,GetHandleId(t),1,Ki)
call SaveReal(O,GetHandleId(t),2,Pm)
call SaveReal(O,GetHandleId(t),3,Qx)
call SaveGroupHandle(O,GetHandleId(t),4,ag)
call TimerStart(t,.03,true,function BladeMasterSwordFireTimer)
set Bc=null
set Ki=null
set ag=null
set t=null
set DE=null
endfunction
function BlademasterClassTimerAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
local group DG=SelectRange(Bc,GetUnitX(Bc),GetUnitY(Bc),400)
local unit Qf
if CountUnitsInGroup(DG)>0 then
set Qf=GroupPickRandomUnit(DG)
call UnitDamageTargetBJ(Bc,Qf,999999,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
else
set Qf=GetKillingUnit()
endif
if Qf!=null and IsUnitAliveBJ(Qf) then
call KillUnit(Qf)
endif
call DestroyGroup(DG)
if Bc!=null then
call RemoveSavedHandle(O,GetHandleId(Bc),$41315149)
endif
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
set Qf=null
set t=null
set DG=null
set Bc=null
endfunction
function BlademasterClassTimer takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer BF=LoadInteger(O,GetHandleId(t),1)
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
local group DG=YDWEGetUnitsOfPlayerAndTypeIdNull(GetOwningPlayer(Bc),BF)
local unit D6
local trigger El
if CountUnitsInGroup(DG)>0 then
call UnitAddAbility(Bc,$41315149)
call UnitMakeAbilityPermanent(Bc,true,$41315149)
if not HaveSavedHandle(O,GetHandleId(Bc),$41315149) then
set El=CreateTrigger()
call SaveAgentHandle(O,GetHandleId(El),0,Bc)
call SaveTriggerHandle(O,GetHandleId(Bc),$41315149,El)
call TriggerRegisterUnitEvent(El,Bc,EVENT_UNIT_DEATH)
call TriggerAddAction(El,function BlademasterClassTimerAction)
endif
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
call UnitAddAbility(D6,$41315149)
call UnitMakeAbilityPermanent(D6,true,$41315149)
if not HaveSavedHandle(O,GetHandleId(D6),$41315149) then
set El=CreateTrigger()
call SaveAgentHandle(O,GetHandleId(El),0,D6)
call SaveTriggerHandle(O,GetHandleId(D6),$41315149,El)
call TriggerRegisterUnitEvent(El,D6,EVENT_UNIT_DEATH)
call TriggerAddAction(El,function BlademasterClassTimerAction)
endif
endloop
endif
call DestroyGroup(DG)
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTimer(t)
set DG=null
set t=null
set El=null
set Bc=null
endfunction
function BlademasterClass takes unit Bc,integer BF returns nothing
local timer t=CreateTimer()
call SaveAgentHandle(O,GetHandleId(t),0,Bc)
call SaveInteger(O,GetHandleId(t),1,BF)
call TimerStart(t,1,false,function BlademasterClassTimer)
set t=null
set Bc=null
endfunction
function GetRandomX takes real FF,real Pm,real Q5 returns real
return FF+CosBJ(Pm)*Q5
endfunction
function GetRandomY takes real FG,real Pm,real Q5 returns real
return FG+SinBJ(Pm)*Q5
endfunction
function MalygosArcaneMissilesCallback takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer BQ=GetHandleId(t)
local unit Ki=LoadUnitHandle(O,BQ,1)
local unit Bc=LoadUnitHandle(O,BQ,0)
local effect DE=LoadEffectHandle(O,GetHandleId(Ki),StringHash("effect"))
local group DG=SelectRange(Bc,GetUnitX(Ki),GetUnitY(Ki),250)
local unit D6
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
call UnitDamageTargetBJ(Bc,D6,137,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
endloop
call DestroyGroup(DG)
call DestroyEffect(AddSpecialEffect("LJQ_MLGS_A2.MDX",GetUnitX(Ki),GetUnitY(Ki)))
call DestroyEffect(DE)
call FlushChildHashtable(O,GetHandleId(Ki))
call RemoveUnit(Ki)
call FlushChildHashtable(O,BQ)
call DestroyTimer(t)
set DG=null
set DE=null
set Ki=null
set Bc=null
set t=null
set D6=null
endfunction
function MalygosArcaneMissiles takes unit Bc,real FF,real FG returns nothing
