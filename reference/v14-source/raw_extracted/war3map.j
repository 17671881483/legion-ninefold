set h=null
set i=null
return DJ
endfunction
function BoxGiftGetTechGoldCost takes player h,integer fC returns integer
local integer BT=LoadInteger(O,GetHandleId(h),fC)
if BT<=0 then
set BT=GetPlayerTechCount(h,fC,true)+1
endif
set h=null
return S2I(LoadStr(B,fC,StringHash("goldbase")))+IMaxBJ(BT-1,0)*S2I(LoadStr(B,fC,StringHash("goldmod")))
endfunction
function BoxGiftGetTechWoodCost takes player h,integer fC returns integer
local integer BT=LoadInteger(O,GetHandleId(h),fC)
if BT<=0 then
set BT=GetPlayerTechCount(h,fC,true)+1
endif
set h=null
return S2I(LoadStr(B,fC,StringHash("lumberbase")))+IMaxBJ(BT-1,0)*S2I(LoadStr(B,fC,StringHash("lumbermod")))
endfunction
function BoxGiftTryConsumeBuildFreeForTech takes player h,integer fC returns boolean
local integer BU=BoxGiftGetTechGoldCost(h,fC)
local integer BV=BoxGiftGetTechWoodCost(h,fC)
local boolean DJ=BoxGiftTryConsumeBuildFreeWithCost(h,BU,BV)
set h=null
return DJ
endfunction
function BoxGiftApplyManualUpgradeFinish takes unit Y6,integer ZL,unit ZM,integer ZN,player h,integer ZE returns nothing
local integer Dt=StringHash("box_manual_upgrade_finish")
call FlushChildHashtable(O,Dt)
call SaveUnitHandle(O,Dt,StringHash("old_unit"),Y6)
call SaveInteger(O,Dt,StringHash("old_type"),ZL)
call SaveUnitHandle(O,Dt,StringHash("new_unit"),ZM)
call SaveInteger(O,Dt,StringHash("new_type"),ZN)
call SavePlayerHandle(O,Dt,StringHash("player"),h)
call SaveInteger(O,Dt,StringHash("user_data"),ZE)
call ExecuteFunc("BoxGiftApplyManualUpgradeFinishExecute")
set Y6=null
set ZM=null
set h=null
endfunction
function YDWEDelayedSuspendDecayNull takes nothing returns nothing
local group fE
local group fF
set fE=bj_suspendDecayBoneGroup
set fF=bj_suspendDecayFleshGroup
set bj_suspendDecayBoneGroup=CreateGroup()
set bj_suspendDecayFleshGroup=CreateGroup()
call ForGroup(fF,function YDWEDelayedSuspendDecayStopAnimEnumNull)
call ForGroup(fE,function YDWEDelayedSuspendDecayStopAnimEnumNull)
call TriggerSleepAction(bj_CORPSE_MAX_DEATH_TIME)
call ForGroup(fF,function YDWEDelayedSuspendDecayFleshEnumNull)
call ForGroup(fE,function YDWEDelayedSuspendDecayBoneEnumNull)
call TriggerSleepAction(.05)
call ForGroup(fF,function YDWEDelayedSuspendDecayStopAnimEnumNull)
call DestroyGroup(fE)
call DestroyGroup(fF)
set fE=null
set fF=null
endfunction
