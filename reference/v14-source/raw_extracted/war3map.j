call SaveAgentHandle(O,GetHandleId(t),2,AddSpecialEffectTarget("Abilities\\Spells\\Orc\\TrollBerserk\\HeadhunterWEAPONSLeft.mdl",Bc,"right hand"))
call TriggerRegisterTimerEvent(t,15,false)
call TriggerRegisterDeathEvent(t,Bc)
call TriggerAddAction(t,function IllidanDemonicFrenzyActionAction)
call FlushChildHashtable(O,GetHandleId(Eb))
call DestroyTrigger(Eb)
else
call DestroyTrigger(t)
endif
set Bc=null
set t=null
