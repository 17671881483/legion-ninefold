function ClearCityHalo takes unit Bc returns nothing
call DestroyEffect(LoadEffectHandle(O,GetHandleId(Bc),1))
set Bc=null
endfunction
function ClearHalo takes unit Bc returns nothing
call DestroyEffect(LoadEffectHandle(O,GetPlayerId(GetOwningPlayer(Bc)),100869))
call YDWERPGSetKey(GetOwningPlayer(Bc),"last_aura_ability_id",0)
set Bc=null
endfunction
function city_halo takes string Kv returns nothing
local unit i=GetTriggerUnit()
call DestroyEffect(LoadEffectHandle(O,GetHandleId(i),1))
call SaveEffectHandle(O,GetHandleId(i),1,AddSpecialEffectTarget(Kv,i,"origin"))
set i=null
set Kv=null
endfunction
function A0M5Timer takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer BQ=GetHandleId(t)
local effect bk=LoadEffectHandle(O,BQ,1)
call DestroyEffect(bk)
call FlushChildHashtable(O,BQ)
call DestroyTimer(t)
set t=null
set bk=null
endfunction
function Ah00Action takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit i=LoadUnitHandle(O,GetHandleId(t),1)
call DestroyEffect(LoadEffectHandle(O,GetHandleId(t),2))
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
set i=null
set t=null
endfunction
function Bianconeri_pet takes integer BF returns nothing
local player h=GetOwningPlayer(GetTriggerUnit())
local integer BB=GetPlayerId(h)+1
local unit ch=CreateUnit(h,BF,GetUnitX(EG[BB]),GetUnitY(EG[BB]),0)
call RemoveUnit(LoadUnitHandle(O,BB,StringHash("pet")))
call SaveUnitHandle(O,BB,StringHash("pet"),ch)
call IssueTargetOrder(ch,"move",EG[BB])
call ClearSelectionForPlayer(h)
call SelectUnitAddForPlayer(EG[BB],h)
set ch=null
set h=null
endfunction
function SetPlayerHeroTitle takes player h,unit i,string QM returns nothing
call DestroyEffect(LoadEffectHandle(O,GetPlayerId(h),100867))
call SaveStr(O,GetPlayerId(h),100867,QM)
call SaveEffectHandle(O,GetPlayerId(h),100867,AddSpecialEffectTarget(QM,EG[GetConvertedPlayerId(h)],"overhead"))
set h=null
set i=null
set QM=null
endfunction
function DestroyTimerFunction takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer BQ=GetHandleId(t)
local integer cl=LoadInteger(O,BQ,0)
local integer RI=LoadInteger(O,BQ,1)
if cl!=0 and RI!=0 and LoadTimerHandle(O,cl,RI)==t then
call RemoveSavedHandle(O,cl,RI)
endif
call FlushChildHashtable(O,BQ)
call DestroyTimer(t)
set t=null
endfunction
function StartMallAllabilityCooldown takes player h,integer BF returns nothing
local timer t=CreateTimer()
local integer BQ=GetHandleId(t)
call SaveInteger(O,BQ,0,GetHandleId(h))
call SaveInteger(O,BQ,1,BF)
call TimerStart(t,30,false,function DestroyTimerFunction)
call SaveTimerHandle(O,GetHandleId(h),BF,t)
set t=null
set h=null
endfunction
function ApplyRegisteredMallAbility takes integer BF,player h,unit i returns boolean
if HaveSavedString(S,BF,StringHash("file")) then
call T_effect(i,LoadStr(S,BF,StringHash("file")))
set h=null
set i=null
return true
endif
if HaveSavedString(R,BF,StringHash("file")) then
call Aura_Skin(h,LoadStr(R,BF,StringHash("file")),i)
set h=null
set i=null
return true
endif
if HaveSavedString(T,BF,StringHash("file")) then
call SetHomeModel(LoadUnitHandle(T,GetHandleId(i),StringHash("home")),LoadStr(T,BF,StringHash("file")))
set h=null
set i=null
return true
endif
set h=null
set i=null
return false
endfunction
