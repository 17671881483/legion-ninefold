function IsLivingPlayer takes player h returns boolean
return GetPlayerSlotState(h)==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(h)==MAP_CONTROL_USER
endfunction
function GetLiveingPlayerSizeForce takes nothing returns boolean
