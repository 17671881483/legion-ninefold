function n04S_Skills takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit i=LoadUnitHandle(O,GetHandleId(t),1)
local real Pm=LoadReal(O,GetHandleId(t),3)
local real FF
local real FG
local unit D6
local group Uz
set FF=GetUnitX(i)+CosBJ(Pm)*LoadReal(O,GetHandleId(t),4)
set FG=GetUnitY(i)+SinBJ(Pm)*LoadReal(O,GetHandleId(t),4)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\Impale\\ImpaleMissTarget.mdl",FF,FG))
set Uz=CreateGroup()
call GroupEnumUnitsInRange(Uz,FF,FG,130,null)
loop
set D6=FirstOfGroup(Uz)
exitwhen D6==null
if IsUnitEnemy(D6,GetOwningPlayer(i)) and LoadInteger(O,GetHandleId(t),GetHandleId(D6))!=1 then
call YDWEJumpTimer(D6,0,0.,.5,.03,250.)
call SaveInteger(O,GetHandleId(t),GetHandleId(D6),1)
call UnitDamageTarget(i,D6,35,false,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
call UnitAddAbility(k,$41304F5A)
call SetUnitAbilityLevel(k,$41304F5A,2)
call IssueTargetOrder(k,"thunderbolt",D6)
call UnitRemoveAbility(k,$41304F5A)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\Impale\\ImpaleHitTarget.mdl",GetUnitX(D6),GetUnitY(D6)))
endif
call GroupRemoveUnit(Uz,D6)
set D6=null
endloop
call DestroyGroup(Uz)
call SaveReal(O,GetHandleId(t),4,LoadReal(O,GetHandleId(t),4)+200)
if LoadReal(O,GetHandleId(t),4)>=700 then
call RemoveSavedHandle(O,GetHandleId(i),1)
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTimer(t)
endif
set t=null
set i=null
set Uz=null
endfunction
function HJR_Action takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit i=LoadUnitHandle(O,GetHandleId(t),1)
call PauseUnit(i,false)
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTimer(t)
set i=null
set t=null
endfunction
function MonsterTypeForDesert takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
call UnitAddAbility(Bc,$41313937)
call UnitMakeAbilityPermanent(Bc,true,$41313937)
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTimer(t)
set t=null
set Bc=null
endfunction
