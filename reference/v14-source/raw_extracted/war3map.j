function RegisterAxisaHaloAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer Pr=GetHandleId(t)
local unit Bc=LoadUnitHandle(O,Pr,0)
local real Px=LoadReal(O,Pr,1)
local group DG
local unit D6
if GetTriggerEventId()==EVENT_WIDGET_DEATH then
call FlushChildHashtable(O,Pr)
call DestroyTrigger(t)
else
set DG=SelectRangeAlly(Bc,GetUnitX(Bc),GetUnitY(Bc),Px)
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
if UnitHasBuffBJ(D6,Qu) and D6!=Bc then
if GetUnitAbilityLevel(D6,Qt)==0 then
call UnitAddAbility(D6,Qt)
call UnitMakeAbilityPermanent(D6,true,Qt)
call SetUnitAbilityLevel(D6,Qt,GetUnitAbilityLevel(Bc,Qs))
endif
endif
endloop
call DestroyGroup(DG)
set DG=null
endif
set t=null
set Bc=null
set D6=null
endfunction
function RegisterAxisaHalo takes unit Bc,real Px returns nothing
local trigger t=CreateTrigger()
local integer Pr=GetHandleId(t)
call UnitAddAbility(Bc,Qt)
call UnitMakeAbilityPermanent(Bc,true,Qt)
call SetUnitAbilityLevel(Bc,Qt,GetUnitAbilityLevel(Bc,Qs))
call SaveAgentHandle(O,Pr,0,Bc)
call SaveReal(O,Pr,1,Px)
call TriggerRegisterTimerEvent(t,0,false)
call TriggerRegisterTimerEvent(t,1,true)
call TriggerRegisterDeathEvent(t,Bc)
call TriggerAddAction(t,function RegisterAxisaHaloAction)
set t=null
set Bc=null
endfunction
function AxisaSwapTimer takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer BQ=GetHandleId(t)
local unit Bc=LoadUnitHandle(O,BQ,0)
local group DG=YDWEGetUnitsOfTypeIdAllNull($68304F56)
local unit D6
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
if IsUnitAlly(D6,GetOwningPlayer(Bc)) then
call UnitAddAbility(Bc,$4131434B)
call UnitMakeAbilityPermanent(Bc,true,$4131434B)
elseif IsUnitEnemy(D6,GetOwningPlayer(Bc)) then
call SetUnitAbilityLevel(Bc,Qt,GetUnitAbilityLevel(Bc,Qt)-1)
endif
endloop
call FlushChildHashtable(O,BQ)
call DestroyTimer(t)
call DestroyGroup(DG)
set t=null
set Bc=null
set DG=null
set D6=null
endfunction
