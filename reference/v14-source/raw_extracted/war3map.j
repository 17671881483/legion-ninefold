function RegisterShopLimit takes integer SE,string SF returns integer
set SG[SH]=SE
set SI[SH]=SF
set SH=SH+1
return SH
endfunction
function UnlockShopTechForPlayer takes player h,integer SE,string SF returns nothing
if YDWERPGBillingHasStatus(h,SF) then
call SetPlayerTechResearchedSwap(SE,1,h)
endif
set h=null
set SF=null
endfunction
function UnlockShopTechForAllPlayers takes integer SE,string SF returns nothing
local integer BB=0
loop
call UnlockShopTechForPlayer(Player(BB),SE,SF)
set BB=BB+1
exitwhen BB>=12
endloop
set SF=null
endfunction
function InitAllShopidTimer takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer BQ=GetHandleId(t)
local integer Eq=0
local player h=LoadPlayerHandle(O,BQ,0)
loop
exitwhen Eq>=SH
call UnlockShopTechForPlayer(h,SG[Eq],SI[Eq])
set Eq=Eq+1
endloop
call FlushChildHashtable(O,BQ)
call DestroyTimer(t)
set t=null
set h=null
endfunction
function InitAllShopid takes nothing returns nothing
local integer BB=0
local player h
local timer t
loop
set h=Player(BB)
if IsLivingPlayer(h) then
set t=CreateTimer()
call SaveAgentHandle(O,GetHandleId(t),0,h)
call TimerStart(t,0,false,function InitAllShopidTimer)
endif
exitwhen BB>=11
set BB=BB+1
endloop
set t=null
set h=null
endfunction
