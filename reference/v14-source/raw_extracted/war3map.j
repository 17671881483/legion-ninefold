call SaveUnitHandle(W,GetHandleId(Bc),StringHash("pet"),Ki)
call SaveUnitHandle(W,GetHandleId(Ki),StringHash("pet"),Bc)
set Bc=null
set Ki=null
endfunction
function RegisterPetPage takes integer w,integer BF returns nothing
local integer x=LoadInteger(B,BF,StringHash("SpecialArt"))
local integer cv=LoadInteger(B,BF,StringHash("Requires"))
local string cw=LoadStr(B,BF,StringHash("Shopid"))
local integer BB=0
if x>0 then
call SaveBoolean(O,BF,StringHash("pet_skill"),true)
loop
if YDWERPGBillingHasStatus(Player(BB),cw) then
call SetPlayerTechResearchedSwap(cv,1,Player(BB))
endif
set BB=BB+1
exitwhen BB>=12
endloop
endif
call SaveBoolean(W,StringHash("pet"),w,true)
set BB=1
loop
if LoadInteger(W,StringHash("page"+I2S(w)),BB)==0 then
call SaveInteger(W,StringHash("page"+I2S(w)),BB,BF)
exitwhen true
endif
set BB=BB+1
endloop
endfunction
function Trig_PetChangeActions takes nothing returns nothing
local unit Bc=GetTriggerUnit()
local integer BF=GetSpellAbilityId()
local unit Ki=LoadUnitHandle(W,GetHandleId(Bc),StringHash("pet"))
if BF==$41305845 then
call ChangePetPage(Bc,Ki)
endif
if Ki!=null then
if BF==$41305851 then
call PetBackPage(Bc)
elseif BF==$41305852 then
call PetNextPage(Bc)
endif
endif
set Ki=null
set Bc=null
endfunction
function InitTrig_PetChange takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddAction(t,function Trig_PetChangeActions)
set t=null
endfunction
function ConstructorGetPageStateKey takes integer cV returns integer
if cV==$65303053 then
return 11111
elseif cV==$65303055 then
return 11112
endif
return 0
endfunction
function ConstructorGetMaxPage takes integer cV returns integer
if cV==$65303053 then
return LoadInteger(O,100011,99)
elseif cV==$65303055 then
return LoadInteger(O,100012,100)
endif
return 0
endfunction
function ConstructorSetPage takes unit ZS,integer w returns boolean
local integer cV=GetUnitTypeId(ZS)
local integer ZQ=ConstructorGetPageStateKey(cV)
local integer cY=ConstructorGetMaxPage(cV)
local integer cZ=GetHandleId(ZS)
local integer cI
local integer ca=1
local integer RI
local string cW=null
if ZQ==0 or cY<=0 then
set ZS=null
return false
endif
if w<1 or w>cY then
set w=1
endif
if cV==$65303053 then
set cW="constructor"
else
set cW="constructor_1"
endif
set cI=StringHash(cW+I2S(w))
loop
exitwhen ca>10
set RI=LoadInteger(O,cZ,ca)
if RI!=0 then
call UnitRemoveAbility(ZS,RI)
endif
set ca=ca+1
endloop
set ca=1
loop
exitwhen ca>10
set RI=LoadInteger(O,cI,ca)
if RI!=0 then
call UnitAddAbility(ZS,RI)
endif
call SaveInteger(O,cZ,ca,RI)
set ca=ca+1
endloop
call SaveInteger(O,cZ,ZQ,w)
set cW=null
set ZS=null
return true
endfunction
function ConstructorChangePage takes unit ZS,integer cK returns nothing
local integer cV=GetUnitTypeId(ZS)
local integer ZQ=ConstructorGetPageStateKey(cV)
local integer cY=ConstructorGetMaxPage(cV)
local integer w=LoadInteger(O,GetHandleId(ZS),ZQ)
if ZQ==0 or cY<=0 then
set ZS=null
return
endif
if w<1 or w>cY then
set w=1
else
set w=w+cK
if w>cY then
set w=1
elseif w<1 then
set w=cY
endif
endif
call ConstructorSetPage(ZS,w)
set ZS=null
endfunction
function ConstructorOpenMenu takes unit W8,integer RI returns nothing
local player h=GetOwningPlayer(W8)
local integer PH=GetPlayerId(h)
local integer cV=0
local integer cX
local unit ZS=null
local string cW=null
if RI==$41305850 then
set cV=$65303053
set cW="constructor"
elseif RI==$41304B54 then
set cV=$65303055
set cW="constructor_1"
endif
if ConstructorGetMaxPage(cV)<=0 then
set cW=null
set W8=null
set h=null
return
endif
set cX=StringHash(cW)
set ZS=LoadUnitHandle(O,PH,cX)
if GetUnitTypeId(ZS)==0 then
set ZS=CreateUnit(h,cV,-4500.,8000.,0)
call SaveUnitHandle(O,PH,cX,ZS)
endif
if ConstructorSetPage(ZS,1) then
call SaveUnitHandle(O,GetHandleId(h),StringHash("u"),W8)
call SelectUnitForPlayerSingle(ZS,h)
endif
set cW=null
set ZS=null
set W8=null
set h=null
endfunction
function Trig_eggsConditions takes nothing returns boolean
local integer RI=GetSpellAbilityId()
local integer cV=GetUnitTypeId(GetTriggerUnit())
if RI==$41305850 or RI==$41304B54 then
return true
endif
return cV==$65303053 or cV==$65303055 and RI==$41305851 or RI==$41305852
endfunction
function Trig_eggsActions takes nothing returns nothing
local unit i=GetTriggerUnit()
local integer RI=GetSpellAbilityId()
if RI==$41305850 or RI==$41304B54 then
call ConstructorOpenMenu(i,RI)
elseif RI==$41305851 then
call ConstructorChangePage(i,-1)
elseif RI==$41305852 then
call ConstructorChangePage(i,1)
endif
set i=null
endfunction
function InitTrig_eggs takes nothing returns nothing
set cU=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(cU,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(cU,Condition(function Trig_eggsConditions))
call TriggerAddAction(cU,function Trig_eggsActions)
endfunction
function Trig_Legion_1Actions takes nothing returns nothing
local unit i=null
local player h=null
local integer BB=0
loop
set h=Player(BB)
if LoadUnitHandle(O,GetHandleId(h),StringHash("h0JR"))!=null then
set i=LoadUnitHandle(O,GetHandleId(h),StringHash("h0JR"))
if LoadInteger(O,GetHandleId(h),StringHash("HP200"))>0 then
call YDWEGeneralBounsSystemUnitSetBonus(i,0,0,200*LoadInteger(O,GetHandleId(h),StringHash("HP200")))
endif
if LoadInteger(O,GetHandleId(h),StringHash("HP50"))>0 then
call YDWEGeneralBounsSystemUnitSetBonus(i,0,0,50*LoadInteger(O,GetHandleId(h),StringHash("HP50")))
endif
if LoadInteger(O,GetHandleId(h),StringHash("Speed1"))>0 then
call UnitAddAbility(i,$41304A32)
call SetUnitAbilityLevel(i,$41304A32,LoadInteger(O,GetHandleId(h),StringHash("Speed1")))
endif
if LoadInteger(O,GetHandleId(h),StringHash("Speed3"))>0 then
call UnitAddAbility(i,$41304A33)
call SetUnitAbilityLevel(i,$41304A33,LoadInteger(O,GetHandleId(h),StringHash("Speed3")))
endif
if LoadInteger(O,GetHandleId(h),StringHash("Attack20"))>0 then
call YDWEGeneralBounsSystemUnitSetBonus(i,3,0,20*LoadInteger(O,GetHandleId(h),StringHash("Attack20")))
endif
if LoadInteger(O,GetHandleId(h),StringHash("Attack5"))>0 then
call YDWEGeneralBounsSystemUnitSetBonus(i,3,0,5*LoadInteger(O,GetHandleId(h),StringHash("Attack5")))
endif
endif
exitwhen BB>=9
set BB=BB+1
endloop
endfunction
function InitTrig_Legion_1 takes nothing returns nothing
set RR=CreateTrigger()
call TriggerAddAction(RR,function Trig_Legion_1Actions)
endfunction
function Command_actionTimer takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer BQ=GetHandleId(t)
local unit i=LoadUnitHandle(O,BQ,1)
local string cc=LoadStr(O,BQ,2)
call SetUnitAnimation(i,cc)
call FlushChildHashtable(O,BQ)
call DestroyTimer(t)
set t=null
set i=null
set cc=null
endfunction
function StartCommandActionAnimation takes unit i,string cc returns nothing
local timer t=CreateTimer()
local integer BQ=GetHandleId(t)
call SaveUnitHandle(O,BQ,1,i)
call SaveStr(O,BQ,2,cc)
call TimerStart(t,0,false,function Command_actionTimer)
set t=null
set i=null
set cc=null
endfunction
function Trig_Command_actionActions takes nothing returns nothing
local integer BB=GetPlayerId(GetOwningPlayer(GetTriggerUnit()))+1
local unit W8=EG[BB]
local integer x=GetUnitTypeId(W8)
if x==$55413230 then
call StartCommandActionAnimation(W8,"Spell")
elseif x==$55413237 then
call StartCommandActionAnimation(W8,"spell alternate one")
elseif x==$55413238 or x==$55413339 then
call StartCommandActionAnimation(W8,"spell Two")
elseif x==$55413334 then
call StartCommandActionAnimation(W8,"spell three")
elseif x==$55413239 or x==$55413236 or x==$55413330 or x==$55413331 or x==$55413234 or x==$55413336 or x==$55413335 then
call StartCommandActionAnimation(W8,"spell")
endif
set W8=null
endfunction
function InitTrig_Command_action takes nothing returns nothing
set cb=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(cb,EVENT_PLAYER_UNIT_CONSTRUCT_START)
call TriggerAddAction(cb,function Trig_Command_actionActions)
endfunction
function Trig_orderLimitConditions takes nothing returns boolean
return IsUnitType(GetTriggerUnit(),UNIT_TYPE_ANCIENT)==true
endfunction
function Trig_orderLimitActions takes nothing returns nothing
call DisableTrigger(GetTriggeringTrigger())
if GetIssuedOrderIdBJ()==String2OrderIdBJ("spiritofvengeance") then
call IssueImmediateOrder(GetTriggerUnit(),"stop")
else
endif
call EnableTrigger(GetTriggeringTrigger())
endfunction
