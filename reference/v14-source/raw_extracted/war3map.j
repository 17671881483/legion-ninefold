local trigger t=GetChargeTrigger()
local group Uz=LoadGroupHandle(O,GetHandleId(t),StringHash("tags"))
call DestroyEffect(DE)
call DestroyGroup(Uz)
call FlushChildHashtable(O,GetHandleId(Ki))
call RemoveUnit(Ki)
set Ki=null
set DE=null
set Uz=null
