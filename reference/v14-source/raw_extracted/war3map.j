function PlayerLoadSaveItemTimer takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit Kg=LoadUnitHandle(O,GetHandleId(t),0)
local player h=GetOwningPlayer(Kg)
local integer BB=LoadInteger(O,GetHandleId(t),1)
local integer Bj=LoadInteger(O,GetHandleId(t),2)
local integer BF
set BF=YDWERPGGetKey(GetOwningPlayer(Kg),"last_skin_ability_id")
if BF>0 and GetPlayerTechCountSimple(LoadInteger(B,BF,StringHash("Requires")),h)>0 then
set Kg=Hero_Skin(h,LoadInteger(O,BF,777),Kg)
elseif Kf[Bj]==$75303054 and YDWERPGBillingHasStatus(GetOwningPlayer(Kg),"90350") or YDWERPGBillingHasStatus(GetOwningPlayer(Kg),"90351") then
set Kg=YDWEReplaceUnitBJNull(Kg,$55413332,3)
else
set Kg=YDWEReplaceUnitBJNull(Kg,Kf[Bj],3)
endif
set BF=YDWERPGGetKey(GetOwningPlayer(Kg),"last_wings_ability_id")
if BF>0 then
if GetPlayerTechCountSimple(LoadInteger(B,BF,StringHash("Requires")),h)>0 then
call Wings_Skin(h,LoadStr(O,BF,778),Kg)
endif
endif
set BF=YDWERPGGetKey(GetOwningPlayer(Kg),"last_aura_ability_id")
if BF>0 then
if GetPlayerTechCountSimple(LoadInteger(B,BF,StringHash("Requires")),h)>0 then
call Aura_Skin(h,LoadStr(R,BF,StringHash("file")),Kg)
endif
endif
set BF=YDWERPGGetKey(GetOwningPlayer(Kg),"last_t_eff_ability_id")
if BF>0 then
if GetPlayerTechCountSimple(LoadInteger(B,BF,StringHash("Requires")),h)>0 then
call T_effect(Kg,LoadStr(S,BF,StringHash("file")))
endif
endif
set EG[BB]=Kg
call SuspendHeroXP(Kg,true)
call SetHeroStr(Kg,0,true)
call SetHeroAgi(Kg,0,true)
call SetHeroInt(Kg,0,true)
call SetHeroInt(Kg,0,true)
call UnitAddAbility(EG[BB],$41303834)
if GetLocalPlayer()==h then
call ClearSelection()
call SelectUnit(EG[BB],true)
endif
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTimer(t)
set t=null
set Kg=null
endfunction
function new_G_ModeHP_Prophet takes integer BB returns nothing
local player h=Player(BB-1)
local integer Bj=1
local integer array CT
local timer EP
local integer array FM
local string array FJ
local timer t
set Bj=1
loop
exitwhen Bj>I7[1]
call SetPlayerTechMaxAllowed(h,KK[Bj],0)
set Bj=Bj+1
