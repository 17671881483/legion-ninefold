call YDWETimerDestroyEffect(3,AddSpecialEffectTarget(ArthasModel("LJQ_AlsaceBright_SSBL.mdx","Abilities\\Spells\\Human\\DivineShield\\DivineShieldTarget.mdl"),Om,"chest"))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\ReviveHuman\\ReviveHuman.mdl",GetUnitX(Om),GetUnitY(Om)))
call UnitRemoveBuffs(Om,true,false)
set Bc=null
set Om=null
endfunction
function ArthasShiderRange takes unit Bc returns nothing
