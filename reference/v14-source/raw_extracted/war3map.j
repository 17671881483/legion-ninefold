function Trig_mainmyActions takes nothing returns nothing
local integer BB
call ForForce(GetPlayersAll(),function Combat_Action)
call main2()
set BB=1
loop
exitwhen BB>4
call SetPlayerAllianceStateBJ(ConvertedPlayer(BB),Player(0),bj_ALLIANCE_ALLIED)
call SetPlayerAllianceStateBJ(ConvertedPlayer(BB),Player(1),bj_ALLIANCE_ALLIED)
call SetPlayerAllianceStateBJ(ConvertedPlayer(BB),Player(2),bj_ALLIANCE_ALLIED)
call SetPlayerAllianceStateBJ(ConvertedPlayer(BB),Player(3),bj_ALLIANCE_ALLIED)
set BB=BB+1
endloop
set BB=5
loop
exitwhen BB>8
call SetPlayerAllianceStateBJ(ConvertedPlayer(BB),Player(4),bj_ALLIANCE_ALLIED)
call SetPlayerAllianceStateBJ(ConvertedPlayer(BB),Player(5),bj_ALLIANCE_ALLIED)
call SetPlayerAllianceStateBJ(ConvertedPlayer(BB),Player(6),bj_ALLIANCE_ALLIED)
call SetPlayerAllianceStateBJ(ConvertedPlayer(BB),Player(7),bj_ALLIANCE_ALLIED)
set BB=BB+1
endloop
call ExecuteFunc("InitBoxHide")
endfunction
function InitTrig_mainmy takes nothing returns nothing
set Dr=CreateTrigger()
call TriggerAddAction(Dr,function Trig_mainmyActions)
call EXInitGameLog("Legion")
endfunction
function Trig_TimerDistActions takes nothing returns nothing
call DisplayTimedTextToForce(GetPlayersAll(),10.,YDWETranslate("|cFFFF3333温馨提示：|r|cFFFFFF00军团加入战报举报系统与平台举报系统。平台会根据ID检查是否使用脚本，并作出封号处理|r"))
call DisplayTimedTextToForce(GetPlayersAll(),10.,"|cFFFF3333温馨提示：|r|cFFFFFF00若你游戏经常游戏内存不足,崩溃等可以 使用OpenGl方式启动模式[若不会可以加群咨询管理]|r")
endfunction
function InitTrig_TimerDist takes nothing returns nothing
set YI=CreateTrigger()
call TriggerRegisterTimerEventPeriodic(YI,600.)
call TriggerAddAction(YI,function Trig_TimerDistActions)
endfunction
function PlayerVIPSo takes integer h,integer BF,integer Yx returns nothing
if not LoadBoolean(O,h,BF) then
call SaveInteger(O,h,Yx,LoadInteger(O,h,Yx)+1)
call SaveBoolean(O,h,BF,true)
endif
endfunction
function SizeTimer takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer BF=GetHandleId(t)
local real N6=LoadReal(O,BF,StringHash("size"))
local unit i=LoadUnitHandle(O,BF,StringHash("unit"))
call SetUnitScale(i,N6,N6,N6)
call FlushChildHashtable(O,BF)
call DestroyTimer(t)
set t=null
set i=null
endfunction
function CheckEggWhiteCondition takes unit Bc,integer x returns nothing
local player h=GetOwningPlayer(Bc)
if LoadUnitHandle(O,GetHandleId(Bc),x)==null then
call SaveUnitHandle(O,GetHandleId(Bc),x,CreateUnit(GetOwningPlayer(Bc),x,-4500.,8000.,0))
endif
set Bc=null
set h=null
endfunction
function RegisterBudingLimitThread takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer BF=GetHandleId(t)
local integer x=LoadInteger(O,BF,0)
local integer Tp=LoadInteger(O,BF,1)
local integer y=LoadInteger(O,BF,2)
local integer BB=0
local player h
if y>0 then
loop
set h=Player(BB)
call SetPlayerTechMaxAllowedSwap(x,y,h)
if Tp>0 then
call SaveAgentHandle(X,GetHandleId(h),x,CreateUnit(h,Tp,-4500.,8000.,bj_UNIT_FACING))
endif
exitwhen BB>=12
set BB=BB+1
endloop
endif
call FlushChildHashtable(O,BF)
call DestroyTimer(t)
set t=null
set h=null
endfunction
function RegisterBudingLimit takes integer x,integer Tp,integer y returns nothing
local timer t=CreateTimer()
local integer BF=GetHandleId(t)
call SaveInteger(O,x,StringHash("limitid"),Tp)
call SaveInteger(O,x,StringHash("count"),y)
call SaveInteger(O,BF,0,x)
call SaveInteger(O,BF,1,Tp)
call SaveInteger(O,BF,2,y)
call TimerStart(t,1,false,function RegisterBudingLimitThread)
set t=null
endfunction
function RegisterBudingLimitEx takes integer x,integer Tp,integer y returns nothing
call SaveBoolean(O,x,StringHash("limitid_ex"),true)
call RegisterBudingLimit(x,Tp,y)
endfunction
function RegisterSimpleLimit takes integer x,integer y returns nothing
local timer t=CreateTimer()
local integer BF=GetHandleId(t)
call SaveInteger(O,BF,0,x)
call SaveInteger(O,BF,2,y)
call TimerStart(t,1,false,function RegisterBudingLimitThread)
set t=null
endfunction
function BuildingLimit takes unit i,integer x,player h,integer BB,integer BF returns nothing
local group DG
local integer y
local group Uz
if LoadBoolean(O,GetHandleId(i),StringHash("limitid_ex")) then
call BuildingLimitRemoveGroupForUnit(i,LoadInteger(O,GetHandleId(i),StringHash("base_id")),h)
if not LoadBoolean(O,x,StringHash("limitid_ex")) then
call RemoveSavedBoolean(O,GetHandleId(i),StringHash("limitid_ex"))
endif
if LoadInteger(O,x,StringHash("count"))>0 then
call SaveInteger(O,GetHandleId(i),StringHash("base_id"),x)
endif
endif
if not LoadBoolean(O,GetHandleId(i),StringHash("limitid_ex")) and LoadInteger(O,GetHandleId(i),StringHash("base_id"))>0 then
set BF=LoadInteger(O,GetHandleId(i),StringHash("base_id"))
if LoadInteger(O,BF,StringHash("limitid"))==0 then
set DG=LoadGroupHandle(X,BF,GetHandleId(h))
if BF!=x and LoadInteger(O,x,StringHash("count"))>0 then
call GroupRemoveUnit(DG,i)
call SaveInteger(O,GetHandleId(i),StringHash("base_id"),x)
endif
set Uz=YDWEGetUnitsOfPlayerAndTypeIdNull(h,BF)
set y=IMaxBJ(0,LoadInteger(O,BF,StringHash("count"))-CountUnitsInGroup(DG)+CountUnitsInGroup(Uz))
call DestroyGroup(Uz)
call SetPlayerTechMaxAllowedSwap(BF,y,h)
endif
endif
if LoadInteger(O,x,StringHash("count"))>0 then
set DG=LoadGroupHandle(X,x,GetHandleId(h))
if DG==null then
set DG=YDWEGetUnitsOfPlayerAndTypeIdNull(h,x)
call SaveAgentHandle(X,x,GetHandleId(h),DG)
endif
call GroupAddUnit(DG,i)
if LoadBoolean(O,x,StringHash("limitid_ex")) then
call SaveBoolean(O,GetHandleId(i),StringHash("limitid_ex"),true)
endif
if CountUnitsInGroup(DG)>=LoadInteger(O,x,StringHash("count")) then
if LoadInteger(O,x,StringHash("limitid"))==0 then
call SetPlayerTechMaxAllowedSwap(x,0,h)
elseif LoadUnitHandle(X,GetHandleId(h),x)!=null then
call RemoveUnit(LoadUnitHandle(X,GetHandleId(h),x))
endif
elseif LoadInteger(O,x,StringHash("limitid"))==0 then
set Uz=YDWEGetUnitsOfPlayerAndTypeIdNull(h,x)
set y=IMaxBJ(0,LoadInteger(O,x,StringHash("count"))-CountUnitsInGroup(DG)+CountUnitsInGroup(Uz))
call DestroyGroup(Uz)
call SetPlayerTechMaxAllowedSwap(x,y,h)
endif
if LoadInteger(O,GetHandleId(i),StringHash("base_id"))==0 then
call SaveInteger(O,GetHandleId(i),StringHash("base_id"),x)
endif
endif
set DG=null
set i=null
set Uz=null
set h=null
endfunction
