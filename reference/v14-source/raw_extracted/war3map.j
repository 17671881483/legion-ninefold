function A_SushuiTutorial takes nothing returns nothing
if GetEventPlayerChatString()=="-xs" or GetEventPlayerChatString()=="-tutorial" or GetEventPlayerChatString()=="-tutorial on" or GetEventPlayerChatString()=="-tutorial open" then
set O2[GetConvertedPlayerId(GetTriggerPlayer())]=true
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,15.,YDWETranslate("|cFF99CC00[认知教程] |r您好，欢迎使用军团战争的认知教程。接下来的每个回合准备时间，我们都将向您介绍游戏的一部分。"))
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,17.,YDWETranslate("|cFF99CC00[认知教程] |r我们强烈建议每名玩家至少观看一次本教程。不轮您的实力如何，都会从本教程中获得一定帮助。"))
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,19.,YDWETranslate("|cFF99CC00[认知教程] |r您可以随时通过输入-tutorial xx (1-30)来重新或预先查看设定波数的教程提示。"))
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,21.,Fd[0])
else
if StringLength(GetEventPlayerChatString())==12 and SubStringBJ(GetEventPlayerChatString(),1,10)=="-tutorial " and S2I(SubStringBJ(GetEventPlayerChatString(),11,12))>9 and S2I(SubStringBJ(GetEventPlayerChatString(),11,12))<29 then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,30.,Fd[S2I(SubStringBJ(GetEventPlayerChatString(),11,12))])
else
if StringLength(GetEventPlayerChatString())==11 and SubStringBJ(GetEventPlayerChatString(),1,10)=="-tutorial " and S2I(SubStringBJ(GetEventPlayerChatString(),11,11))>0 and S2I(SubStringBJ(GetEventPlayerChatString(),11,12))<10 then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,30.,Fd[S2I(SubStringBJ(GetEventPlayerChatString(),11,11))])
else
if GetEventPlayerChatString()=="-xs off" or GetEventPlayerChatString()=="-tutorial off" or GetEventPlayerChatString()=="-tutorial close" then
set O2[GetConvertedPlayerId(GetTriggerPlayer())]=false
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,20.,Fd[31])
else
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,20.,Fd[32])
endif
endif
endif
endif
endfunction
