else
if YDWERPGBillingHasStatus(Player(BB),"20082152") or YDWERPGBillingHasStatus(Player(BB),"20082165") or YDWERPGBillingHasStatus(Player(BB),"100001") then
call SetPlayerTechMaxAllowedSwap($52303047,0,Player(BB))
call SetPlayerTechMaxAllowedSwap($52303131,0,Player(BB))
call SetPlayerTechMaxAllowedSwap($52303848,1,Player(BB))
else
call SetPlayerTechMaxAllowedSwap($52303047,5,Player(BB))
call SetPlayerTechMaxAllowedSwap($52303131,0,Player(BB))
call SetPlayerTechMaxAllowedSwap($52303848,0,Player(BB))
endif
endif
if YDWERPGBillingHasStatus(Player(BB),"20082152") or YDWERPGBillingHasStatus(Player(BB),"20082165") or YDWERPGBillingHasStatus(Player(BB),"100001") then
call AdjustPlayerStateBJ(5,Player(BB),PLAYER_STATE_RESOURCE_FOOD_CAP)
endif
exitwhen BB>=11
set BB=BB+1
endloop
endfunction
