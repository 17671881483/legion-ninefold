set Ki=null
endfunction
function SuperMusketeerAntitankGrenadeTimerAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer Pr=GetHandleId(t)
local unit Bc=LoadUnitHandle(O,Pr,0)
local unit Ki=LoadUnitHandle(O,Pr,1)
local group DG=null
local unit D6
local boolean RF=GetTriggerEventId()==EVENT_UNIT_TARGET_IN_RANGE and IsUnitEnemy(GetTriggerUnit(),GetOwningPlayer(Bc))
if GetTriggerEventId()==EVENT_WIDGET_DEATH or GetTriggerEventId()==EVENT_GAME_TIMER_EXPIRED or RF then
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl",GetUnitX(Ki),GetUnitY(Ki)))
if RF then
set DG=SelectRange(Bc,GetUnitX(Ki),GetUnitY(Ki),300)
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
call UnitDamageTargetBJ(Bc,D6,137,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
endloop
endif
call DestroyEffect(LoadEffectHandle(O,Pr,2))
call FlushChildHashtable(O,Pr)
call DestroyTrigger(t)
call RemoveUnit(Ki)
endif
if DG!=null then
call DestroyGroup(DG)
endif
set DG=null
set t=null
set Bc=null
set Ki=null
set D6=null
endfunction
function SuperMusketeerAntitankGrenadeTimer takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer BQ=GetHandleId(t)
local unit Bc=LoadUnitHandle(O,BQ,0)
local real FF=LoadReal(O,BQ,1)
local real FG=LoadReal(O,BQ,2)
local group DG=SelectRange(Bc,FF,FG,300)
local unit Ki
local trigger El
if CountUnitsInGroup(DG)>0 then
call AoeDamage(Bc,FF,FG,300,137,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl",FF,FG))
else
set El=CreateTrigger()
call SaveUnitHandle(O,GetHandleId(El),0,Bc)
set Ki=CreateUnit(GetOwningPlayer(Bc),Pn,FF,FG,270)
call SaveUnitHandle(O,GetHandleId(El),1,Ki)
call SaveAgentHandle(O,GetHandleId(El),2,AddSpecialEffectTarget("LJQ_viphackbuteer01_W.mdx",Ki,"chest"))
call TriggerRegisterDeathEvent(El,Bc)
call TriggerRegisterUnitInRange(El,Ki,200,null)
call TriggerRegisterTimerEvent(El,6,false)
call TriggerAddAction(El,function SuperMusketeerAntitankGrenadeTimerAction)
set El=null
set Ki=null
endif
call DestroyGroup(DG)
call DestroyEffect(LoadEffectHandle(O,BQ,3))
call FlushChildHashtable(O,BQ)
call DestroyTimer(t)
set t=null
set Bc=null
set DG=null
endfunction
function SuperMusketeerAntitankGrenade takes unit Bc,real FF,real FG returns nothing
local real QN
local real Pm
local integer BB=0
local real Qv
local real Qw
local timer t
local real DK=.2
local unit Ki
local integer BF
local player h
local rect D1
local integer Oo=0
loop
exitwhen BB>=4 or Oo>=40
set Oo=Oo+1
set QN=GetRandomReal(0,600)
set Pm=GetRandomReal(0,360)
set Qv=FF+CosBJ(Pm)*QN
set Qw=FG+SinBJ(Pm)*QN
set BF=GetUnitUserData(Bc)
if BF>0 then
set h=ConvertedPlayer(BF)
set D1=LoadRectHandle(O,GetHandleId(h),StringHash("building_rect"))
else
set Bc=null
set t=null
set Ki=null
set h=null
set D1=null
return
endif
if RectContainsCoords(D1,Qv,Qw) or not RectContainsUnit(D1,Bc) then
set Ki=CreateUnit(GetOwningPlayer(Bc),Pn,GetUnitX(Bc),GetUnitY(Bc),Pm)
call UnitApplyTimedLife(Ki,$42487765,DK)
call YDWEFlyEnable(Ki)
call YDWEJumpTimer(Ki,Atan2BJ(Qw-GetUnitY(Bc),Qv-GetUnitX(Bc)),GetDisFromUnitAndPos(Ki,Qv,Qw),DK,.03,300)
set t=CreateTimer()
call SaveAgentHandle(O,GetHandleId(t),0,Bc)
call SaveReal(O,GetHandleId(t),1,Qv)
call SaveReal(O,GetHandleId(t),2,Qw)
call SaveAgentHandle(O,GetHandleId(t),3,AddSpecialEffectTarget("LJQ_viphackbuteer01_W.mdx",Ki,"chest"))
call TimerStart(t,DK,false,function SuperMusketeerAntitankGrenadeTimer)
set BB=BB+1
endif
endloop
set Bc=null
set t=null
set Ki=null
set h=null
set D1=null
endfunction
function SuperMusketeerAtkChargeback takes nothing returns nothing
local unit Ki=GetChargeDummy()
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",GetUnitX(Ki),GetUnitY(Ki)))
set Ki=null
endfunction
function SuperMusketeerAtk takes unit Bc,unit Om returns nothing
local integer y=LoadInteger(O,GetHandleId(Bc),b6)+1
if GetUnitAbilityLevel(Bc,b6)>0 and y<=15 then
call SaveInteger(O,GetHandleId(Bc),b6,y)
call UnitDamageTargetBJ(Bc,Om,35,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
if not IsUnitType(Om,UNIT_TYPE_DEAD) then
call ChargeDistance(Om,Om,GetAngleFromUnit(Bc,Om),170,.2,"SuperMusketeerAtkChargeback",null)
endif
if y>=15 then
call UnitRemoveAbility(Bc,b6)
endif
endif
set Bc=null
set Om=null
endfunction
function NagaTrgRegisterIncome takes unit i returns nothing
local integer Dt=0
if i!=null then
set Dt=GetHandleId(i)
if not LoadBoolean(O,Dt,StringHash("naga_farmer_income_active")) then
call SaveBoolean(O,Dt,StringHash("naga_farmer_income_active"),true)
call NagaFarmer_AddGold(i)
endif
endif
set i=null
endfunction
function NagaTrgSaveIncomeTrigger takes unit i,trigger t returns nothing
if i!=null and t!=null then
call SaveTriggerHandle(O,GetHandleId(i),StringHash("naga_farmer_income_trigger"),t)
endif
set i=null
set t=null
endfunction
function NagaTrgClearIncomeState takes unit i,boolean Yd returns nothing
local trigger t=null
local integer Dt=0
if i!=null then
set Dt=GetHandleId(i)
if Yd then
set t=LoadTriggerHandle(O,Dt,StringHash("naga_farmer_income_trigger"))
if t!=null then
call DestroyTrigger(t)
endif
endif
call RemoveSavedBoolean(O,Dt,StringHash("naga_farmer_income_active"))
call RemoveSavedHandle(O,Dt,StringHash("naga_farmer_income_trigger"))
endif
set t=null
set i=null
endfunction
function NagaTrgUnregisterIncome takes unit i returns nothing
if i!=null and LoadBoolean(O,GetHandleId(i),StringHash("naga_farmer_income_active")) then
call NagaFarmer_SubtractGold(i)
endif
call NagaTrgClearIncomeState(i,false)
set i=null
endfunction
function NagaTrgIncomeEvent takes nothing returns nothing
call NagaTrgUnregisterIncome(GetTriggerUnit())
call DestroyTrigger(GetTriggeringTrigger())
endfunction
function NagaTrgCreateIncomeTrigger takes unit i returns nothing
local trigger t=null
if i!=null and LoadTriggerHandle(O,GetHandleId(i),StringHash("naga_farmer_income_trigger"))==null then
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,i,EVENT_UNIT_UPGRADE_FINISH)
call TriggerRegisterDeathEvent(t,i)
call TriggerAddAction(t,function NagaTrgIncomeEvent)
call NagaTrgSaveIncomeTrigger(i,t)
endif
set t=null
set i=null
endfunction
function NagaTrgApplyManualUpgradeFinish takes unit Y6,integer ZL,player h returns nothing
local player Yf=h
if ZL==$6E303835 and Y6!=null and LoadBoolean(O,GetHandleId(Y6),StringHash("naga_farmer_income_active")) then
if Yf==null then
set Yf=GetOwningPlayer(Y6)
endif
call NagaFarmer_SubtractGoldForPlayer(Yf)
call NagaTrgClearIncomeState(Y6,true)
endif
set Yf=null
set Y6=null
set h=null
endfunction
function Trig_NagaTrgConditions takes nothing returns boolean
return GetUnitTypeId(GetTriggerUnit())==$6E303835
endfunction
function Trig_NagaTrgActions takes nothing returns nothing
call NagaTrgRegisterIncome(GetTriggerUnit())
call NagaTrgCreateIncomeTrigger(GetTriggerUnit())
endfunction
function InitTrig_NagaTrg takes nothing returns nothing
set Ya=CreateTrigger()
call DoNothing()
call TriggerRegisterAnyUnitEventBJ(Ya,EVENT_PLAYER_UNIT_CONSTRUCT_START)
call TriggerAddCondition(Ya,Condition(function Trig_NagaTrgConditions))
call TriggerAddAction(Ya,function Trig_NagaTrgActions)
endfunction
function SuperBlueJayAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer Pr=GetHandleId(t)
local unit Bc=LoadUnitHandle(O,Pr,0)
local group DG
local unit D6
local effect DE
local integer BB=0
if GetTriggerEventId()==EVENT_WIDGET_DEATH then
if Bc!=null and LoadTriggerHandle(O,GetHandleId(Bc),StringHash("SuperBlueJay"))==t then
call RemoveSavedHandle(O,GetHandleId(Bc),StringHash("SuperBlueJay"))
endif
call FlushChildHashtable(O,Pr)
call DestroyTrigger(t)
else
set DG=SelectRange(Bc,GetUnitX(Bc),GetUnitY(Bc),RG)
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null or BB>=RH
set BB=BB+1
call GroupRemoveUnit(DG,D6)
call UnitDamageTargetBJ(Bc,D6,55,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
set DE=AddSpecialEffect("LJQ_Qingfeng.mdx",GetUnitX(Bc),GetUnitY(Bc))
call EXEffectMatRotateZ(DE,Atan2BJ(GetUnitY(D6)-GetUnitY(Bc),GetUnitX(D6)-GetUnitX(Bc)))
call EXSetEffectSize(DE,GetDisFromUnit(Bc,D6)/RG*1.5)
call YDWETimerDestroyEffect(1,DE)
set DE=null
endloop
set D6=null
call DestroyGroup(DG)
set DG=null
endif
set Bc=null
set t=null
endfunction
