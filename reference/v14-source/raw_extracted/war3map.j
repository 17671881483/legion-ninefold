function InitAchievementSystem takes nothing returns nothing
local integer BB=0
local player h=null
local trigger t=CreateTrigger()
local trigger f4=CreateTrigger()
local trigger f5=CreateTrigger()
local trigger f6=CreateTrigger()
local trigger f7=CreateTrigger()
local trigger f8=CreateTrigger()
local trigger f9=CreateTrigger()
local trigger gB=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(f4,EVENT_PLAYER_UNIT_CONSTRUCT_FINISH)
call TriggerAddCondition(f4,Condition(function CreateBuildingCondition))
call TriggerRegisterAnyUnitEventBJ(f5,EVENT_PLAYER_UNIT_UPGRADE_FINISH)
call TriggerAddCondition(f5,Condition(function UpgradeBuildingCondition))
call TriggerRegisterAnyUnitEventBJ(f6,EVENT_PLAYER_UNIT_TRAIN_FINISH)
call TriggerAddAction(f6,function CreateEwspCondition)
call TriggerRegisterAnyUnitEventBJ(f7,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(f7,Condition(function UnitSpellCondition))
call TriggerRegisterAnyUnitEventBJ(f8,EVENT_PLAYER_UNIT_RESEARCH_FINISH)
call TriggerAddCondition(f8,Condition(function UpTechnologyCondition))
call TriggerRegisterAnyUnitEventBJ(f9,EVENT_PLAYER_UNIT_SELL)
call TriggerAddCondition(f9,Condition(function MercenaryCondition))
call YDWESyStemAnyUnitDamagedRegistTrigger(gB)
call TriggerAddAction(gB,function AchievementAnyDamageAction)
loop
exitwhen BB>=12
set h=Player(BB)
call TriggerRegisterPlayerStateEvent(t,h,PLAYER_STATE_RESOURCE_LUMBER,GREATER_THAN_OR_EQUAL,20000.)
set BB=BB+1
endloop
call TriggerAddAction(t,function GetLumbering)
set f6=null
set f5=null
set f4=null
set f7=null
set f8=null
set f9=null
set gB=null
set h=null
set t=null
endfunction
