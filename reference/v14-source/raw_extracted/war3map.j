call UnitAddAbilityByTimer(Bc,aw,DK)
call DestroyEffect(DE)
call SaveAgentHandle(O,GetHandleId(t),0,Bc)
call SaveInteger(O,GetHandleId(t),1,av)
call SaveInteger(O,GetHandleId(Bc),StringHash("PhantomRiderPenetrateToken"),av)
call SetUnitVertexColorBJ(Bc,100,100,100,60)
call TriggerRegisterTimerEvent(t,DK,false)
call TriggerAddAction(t,function PhantomRiderPenetrateAction)
set DE=null
set Bc=null
set t=null
endfunction
