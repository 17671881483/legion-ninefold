function EachMonsterSkillTypeForHero takes unit Bc returns integer
local integer BB=0
loop
if LoadBoolean(O,q[BB],GetUnitTypeId(Bc)) or GetUnitAbilityLevel(Bc,q[BB])>0 then
set Bc=null
return q[BB]
endif
set BB=BB+1
exitwhen BB>=r
endloop
set Bc=null
return 0
endfunction
function BuidingMonsterSkill___RegisterMonsterSkill takes integer s,integer p returns nothing
call SaveBoolean(O,p,s,true)
call SaveInteger(O,s,StringHash("class_skill"),p)
endfunction
function BuidingMonsterSkill___RegisterMonsterSkillType takes integer p returns nothing
set q[r]=p
set r=r+1
endfunction
function ExecuteMonsterSkillInit takes unit Bc,boolean RK returns nothing
local integer p=EachMonsterSkillTypeForHero(Bc)
if p==0 then
set Bc=null
return
endif
if RK then
loop
exitwhen p!=$41313858
set p=q[GetRandomInt(0,r-1)]
endloop
endif
if p==$41313850 then
call UnitAddAbility(Bc,$41313851)
call UnitMakeAbilityPermanent(Bc,true,$41313851)
elseif p==$41313853 then
call UnitAddAbility(Bc,$41313852)
call UnitMakeAbilityPermanent(Bc,true,$41313852)
elseif p==$41313854 then
call UnitAddAbility(Bc,$41313938)
call UnitMakeAbilityPermanent(Bc,true,$41313938)
elseif p==$41313856 then
call UnitAddAbility(Bc,$41313941)
call UnitMakeAbilityPermanent(Bc,true,$41313941)
elseif p==$41313857 then
call UnitAddAbility(Bc,$41313942)
call UnitMakeAbilityPermanent(Bc,true,$41313942)
elseif p==$41313932 then
call UnitAddAbility(Bc,$41313944)
call UnitMakeAbilityPermanent(Bc,true,$41313944)
elseif p==$41313933 then
call UnitAddAbility(Bc,$41313945)
call UnitMakeAbilityPermanent(Bc,true,$41313945)
else
call UnitAddAbility(Bc,p)
call UnitMakeAbilityPermanent(Bc,true,p)
endif
set Bc=null
endfunction
