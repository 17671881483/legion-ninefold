function GarroshGroundBreakingAxeCallBack takes nothing returns nothing
local trigger t=GetChargeTrigger()
local unit Bc=GetChargeSource()
local unit Ki=GetChargeDummy()
local group DG=LoadGroupHandle(O,GetHandleId(t),StringHash("group"))
local group Po=SelectRange(Bc,GetUnitX(Ki),GetUnitY(Ki),300)
local unit D6
if I2R(R2I(GetTriggerExecCount(t)/3))==GetTriggerExecCount(t)/3 then
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl",GetUnitX(Ki),GetUnitY(Ki)))
endif
if IsTerrainPathable(GetUnitX(Ki),GetUnitY(Ki),PATHING_TYPE_WALKABILITY) then
call SaveBoolean(O,GetHandleId(Ki),StringHash("not_path"),true)
endif
if DG==null then
set DG=CreateGroup()
call SaveAgentHandle(O,GetHandleId(t),StringHash("group"),DG)
endif
loop
set D6=FirstOfGroup(Po)
exitwhen D6==null
call GroupRemoveUnit(Po,D6)
if not IsUnitInGroup(D6,DG) then
call UnitDamageTargetBJ(Bc,D6,215,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
call GroupAddUnit(DG,D6)
endif
endloop
call DestroyGroup(Po)
set Bc=null
set Ki=null
set DG=null
set Po=null
endfunction
function GarroshGroundBreakingAxeFinish takes nothing returns nothing
local trigger t=GetChargeTrigger()
local unit Bc=GetChargeSource()
local unit Ki=GetChargeDummy()
local group DG=LoadGroupHandle(O,GetHandleId(t),StringHash("group"))
local real Pm=GetUnitFacing(Ki)
local real DK=.4
call ChargeDistance(Bc,Ki,Pm+180,600,DK,"GarroshGroundBreakingAxeCallBackEx","GarroshGroundBreakingAxeFinishEx")
call DestroyGroup(DG)
set t=null
set DG=null
set Bc=null
set Ki=null
endfunction
function GarroshGroundBreakingAxe takes unit Bc,real FF,real FG returns nothing
local real Pm=Atan2BJ(FG-GetUnitY(Bc),FF-GetUnitX(Bc))
local unit Ki=CreateUnit(GetOwningPlayer(Bc),Pn,GetUnitX(Bc),GetUnitY(Bc),Pm)
local string QM=QL
local effect DE=AddSpecialEffectTarget(QM,Ki,"chest")
local real DK=.4
call ChargeDistance(Bc,Ki,Pm,600,DK,"GarroshGroundBreakingAxeCallBack","GarroshGroundBreakingAxeFinish")
call YDWETimerRemoveUnit(DK*2,Ki)
call YDWETimerDestroyEffect(DK*2,DE)
set Ki=CreateUnit(GetOwningPlayer(Bc),Pn,GetUnitX(Bc),GetUnitY(Bc),Pm+45)
set DE=AddSpecialEffectTarget(QM,Ki,"chest")
call ChargeDistance(Bc,Ki,Pm+45,600,DK,"GarroshGroundBreakingAxeCallBack","GarroshGroundBreakingAxeFinish")
call YDWETimerRemoveUnit(DK*2,Ki)
call YDWETimerDestroyEffect(DK*2,DE)
set Ki=CreateUnit(GetOwningPlayer(Bc),Pn,GetUnitX(Bc),GetUnitY(Bc),Pm-45)
set DE=AddSpecialEffectTarget(QM,Ki,"chest")
call ChargeDistance(Bc,Ki,Pm-45,600,DK,"GarroshGroundBreakingAxeCallBack","GarroshGroundBreakingAxeFinish")
call YDWETimerRemoveUnit(DK*2,Ki)
call YDWETimerDestroyEffect(DK*2,DE)
set Bc=null
set DE=null
set Ki=null
endfunction
