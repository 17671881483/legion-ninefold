function SavisDarkSoulRange takes unit Bc,unit Om,integer QK returns nothing
local group DG=null
local integer y=0
local unit D6
if Bc==null or Om==null or QK<=0 then
set Bc=null
set Om=null
return
endif
set DG=SelectRange(Bc,GetUnitX(Om),GetUnitY(Om),600)
call SavisDarkSoul(Bc,Om)
call GroupRemoveUnit(DG,Om)
set y=1
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null or y>=QK
call SavisDarkSoul(Bc,D6)
call GroupRemoveUnit(DG,D6)
set y=y+1
endloop
call DestroyGroup(DG)
set DG=null
set Bc=null
set D6=null
set Om=null
endfunction
function SavisNightmareBladeAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer Pr=GetHandleId(t)
local unit Bc=LoadUnitHandle(O,Pr,0)
local real FF=LoadReal(O,Pr,1)
local real FG=LoadReal(O,Pr,2)
local group DG=SelectRange(Bc,FF,FG,400)
local real QY=LoadReal(O,Pr,3)
local group Po=LoadGroupHandle(O,Pr,5)
local unit D6
if GetTriggerEventId()==EVENT_GAME_TIMER_EXPIRED then
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
if not IsUnitInGroup(D6,Po) then
call GroupAddUnit(Po,D6)
call UnitDamageTargetBJ(Bc,D6,200,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
endif
endloop
if GetTriggerExecCount(t)>=QY then
call DestroyEffect(LoadEffectHandle(O,Pr,4))
call FlushChildHashtable(O,Pr)
call DestroyTrigger(t)
call DestroyGroup(Po)
endif
else
call DestroyEffect(LoadEffectHandle(O,Pr,4))
call FlushChildHashtable(O,Pr)
call DestroyTrigger(t)
call DestroyGroup(Po)
endif
call DestroyGroup(DG)
set Po=null
set t=null
set Bc=null
set DG=null
set D6=null
endfunction
