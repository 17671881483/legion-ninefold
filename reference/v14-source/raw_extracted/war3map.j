function A_ProtonEvade takes nothing returns nothing
local unit i=GetTriggerUnit()
local integer EB=GetUnitUserData(i)
local real FF=GetUnitX(i)
local real FG=GetUnitY(i)
local real Xd
local real OW
local string Xc="Abilities\\Spells\\Human\\Polymorph\\PolyMorphTarget.mdl"
call DisableTrigger(GetTriggeringTrigger())
if Ss[EB] or Sr[EB] or Sj[EB] then
set Xc="sushuiunit\\vip_e_protontele.mdl"
endif
call SetUnitManaBJ(i,GetUnitState(i,UNIT_STATE_MANA)-40.)
call DestroyEffect(AddSpecialEffect(Xc,FF,FG))
if EB==1 or EB==3 or EB==5 or EB==7 then
set OW=270.
set Xd=FG-340.
if Xd<=3292. then
set Xd=FG+340.
call SetUnitPosition(i,FF,FG)
else
call SetUnitPosition(i,FF,Xd)
endif
else
set OW=90.
set Xd=FG+340.
if Xd>=2340. then
set Xd=FG-340.
call SetUnitPosition(i,FF,FG)
else
call SetUnitPosition(i,FF,Xd)
endif
endif
call SetUnitFacing(i,OW)
call DestroyEffect(AddSpecialEffect(Xc,FF,Xd))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\FaerieDragonInvis\\FaerieDragon_Invis.mdl",i,"origin"))
call EnableTrigger(GetTriggeringTrigger())
set i=null
endfunction
