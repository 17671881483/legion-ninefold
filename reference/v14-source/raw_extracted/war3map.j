function OldcodeApplyManualAncientUpgradeVisual takes unit i,integer x returns nothing
if i!=null and IsUnitType(i,UNIT_TYPE_ANCIENT) then
call SetUnitVertexColorBJ(i,I2R(100),I2R(100),I2R(100),50.)
call SetUnitTimeScalePercent(i,0.)
call ResetUnitAnimation(i)
if x==$68303230 or x==$6E303654 then
call SetUnitVertexColorBJ(i,0.,0.,0.,50.)
endif
if x==$68303632 or x==$68303551 or x==$68303554 then
call SetUnitVertexColorBJ(i,100.,100.,100.,65.)
endif
if x==$68303630 or x==$68313630 then
call SetUnitVertexColorBJ(i,100.,100.,100.,65.)
endif
endif
set i=null
endfunction
function OldcodeApplyManualAncientUpgradeFinish takes unit Y6,integer ZL,unit ZM,integer ZN,player h returns nothing
if Y6!=null then
call GroupRemoveUnit(Bu,Y6)
call GroupRemoveUnit(Jl,Y6)
call GroupRemoveUnit(Jk,Y6)
endif
if ZM!=null and IsUnitType(ZM,UNIT_TYPE_ANCIENT) then
call GroupRemoveUnit(Jl,ZM)
call GroupRemoveUnit(Jk,ZM)
call GroupAddUnit(Bu,ZM)
call OldcodeApplyManualAncientUpgradeVisual(ZM,ZN)
call TriggerExecute(Bv)
endif
set Y6=null
set ZM=null
set h=null
endfunction
function OldcodeApplyU00IManualUpgradeFinish takes integer ZL,unit ZM returns nothing
if ZL==$75303049 and ZM!=null then
call SetUnitVertexColorBJ(ZM,I2R(100),I2R(100),I2R(100),100.)
endif
set ZM=null
endfunction
function OldcodeApplyManualUpgradeFinish takes unit Y6,integer ZL,unit ZM,integer ZN,player h returns nothing
call OldcodeApplyManualFastBuildForUpgrade(ZM,ZN,h)
call OldcodeApplyManualAncientUpgradeFinish(Y6,ZL,ZM,ZN,h)
call OldcodeApplyU00IManualUpgradeFinish(ZL,ZM)
set Y6=null
set ZM=null
set h=null
endfunction
