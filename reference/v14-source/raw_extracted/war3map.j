function A_TirionFordring takes nothing returns nothing
local timer t=null
local real B0=15
call DisableTrigger(GetTriggeringTrigger())
if GetUnitAbilityLevel(GetTriggerUnit(),$41304C52)>0 and GetRandomInt(1,10)<=3 then
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\ReplenishHealth\\ReplenishHealthCasterOverhead.mdl",GetTriggerUnit(),"overhead"))
