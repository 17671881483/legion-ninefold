set Bp[Bs]=null
set Bs=Bs+1
endloop
call SaveInteger(O,100,776,0)
endif
call RemoveLocation(h)
call ForceClear(Bo)
call DestroyForce(Bo)
set Bo=null
set h=null
set i=null
set Bn=null
endfunction
