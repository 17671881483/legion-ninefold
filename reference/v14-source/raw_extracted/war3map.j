function ChargeDistanceCondition takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer Pr=GetHandleId(t)
local real DK=LoadReal(O,Pr,3)
local real QS=LoadReal(O,Pr,1)
local real QN=LoadReal(O,Pr,2)
local string QP=LoadStr(O,Pr,4)
local string QQ=LoadStr(O,Pr,5)
local unit Ki=LoadUnitHandle(O,Pr,6)
local real Pm=LoadReal(O,Pr,7)
local real QT=QS/DK*.04
call SaveReal(O,Pr,10,QT)
if GetTriggerEventId()==EVENT_WIDGET_DEATH then
if QQ!=null then
call ExecuteFunc(QQ)
endif
call FlushChildHashtable(O,Pr)
call DestroyTrigger(t)
elseif GetTriggerEventId()==EVENT_GAME_TIMER_EXPIRED then
if QN+QT>=QS then
if QQ!=null then
call ExecuteFunc(QQ)
endif
call FlushChildHashtable(O,Pr)
call DestroyTrigger(t)
else
call SaveReal(O,Pr,2,QN+QT)
call SetUnitPosition(Ki,GetUnitX(Ki)+CosBJ(Pm)*QT,GetUnitY(Ki)+SinBJ(Pm)*QT)
if QP!=null then
call ExecuteFunc(QP)
endif
endif
endif
set t=null
set Ki=null
set QP=null
set QQ=null
return false
endfunction
function ChargeDistance takes unit Pf,unit Ki,real Pm,real QN,real QO,string QP,string QQ returns trigger
local trigger t=CreateTrigger()
local integer Pr=GetHandleId(t)
call SaveReal(O,Pr,1,QN)
call SaveReal(O,Pr,3,QO)
call SaveStr(O,Pr,4,QP)
call SaveStr(O,Pr,5,QQ)
call SaveAgentHandle(O,Pr,6,Ki)
call SaveReal(O,Pr,7,Pm)
call SaveAgentHandle(O,Pr,9,Pf)
call TriggerRegisterDeathEvent(t,Ki)
call TriggerRegisterTimerEvent(t,0,false)
call TriggerRegisterTimerEvent(t,.04,true)
call TriggerAddCondition(t,Condition(function ChargeDistanceCondition))
set QU=t
set t=null
set Ki=null
set Pf=null
set QP=null
set QQ=null
return QU
endfunction
function GetDist takes real FF,real FG,real Zb,real Zc returns real
local real QR=FF-Zb
local real Cd=FG-Zc
return SquareRoot(QR*QR+Cd*Cd)
endfunction
function GetDisFromUnit takes unit i,unit FC returns real
local real QR=GetUnitY(FC)-GetUnitY(i)
local real Cd=GetUnitX(FC)-GetUnitX(i)
set i=null
set FC=null
return SquareRoot(QR*QR+Cd*Cd)
endfunction
function GetDisFromUnitAndPos takes unit i,real FF,real FG returns real
local real QR=FG-GetUnitY(i)
local real Cd=FF-GetUnitX(i)
set i=null
return SquareRoot(QR*QR+Cd*Cd)
endfunction
function GetAngleFromUnit takes unit i,unit FC returns real
local real FG=GetUnitY(FC)-GetUnitY(i)
local real FF=GetUnitX(FC)-GetUnitX(i)
set i=null
set FC=null
return Atan2BJ(FG,FF)
endfunction
function GetAngle takes real FF,real FG,real Qv,real Qw returns real
return Atan2BJ(Qw-FG,Qv-FF)
endfunction
function ChargeDistanceTargetCondition takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer Pr=GetHandleId(t)
local real DK=LoadReal(O,Pr,3)
local real QS=LoadReal(O,Pr,1)
local real QN=LoadReal(O,Pr,2)
local string QP=LoadStr(O,Pr,4)
local string QQ=LoadStr(O,Pr,5)
local unit Ki=LoadUnitHandle(O,Pr,6)
local real QT=QS/DK*.04
local unit Om=LoadUnitHandle(O,Pr,8)
local real Pm=GetAngleFromUnit(Ki,Om)
if GetTriggerEventId()==EVENT_WIDGET_DEATH then
if QQ!=null then
call ExecuteFunc(QQ)
endif
call FlushChildHashtable(O,Pr)
call DestroyTrigger(t)
elseif GetTriggerEventId()==EVENT_GAME_TIMER_EXPIRED then
if QN+QT>=QS or GetDisFromUnit(Ki,Om)<=QT then
if QQ!=null then
call ExecuteFunc(QQ)
endif
call FlushChildHashtable(O,Pr)
call DestroyTrigger(t)
else
call SaveReal(O,Pr,2,QN+QT)
call SetUnitPosition(Ki,GetUnitX(Ki)+CosBJ(Pm)*QT,GetUnitY(Ki)+SinBJ(Pm)*QT)
if QP!=null then
call ExecuteFunc(QP)
endif
endif
endif
set t=null
set Ki=null
set Om=null
set QP=null
set QQ=null
return false
endfunction
function ChargeDistanceTarget takes unit Pf,unit Ki,unit Om,real QN,real QO,string QP,string QQ returns trigger
local trigger t=CreateTrigger()
local integer Pr=GetHandleId(t)
call SaveReal(O,Pr,1,GetDisFromUnit(Ki,Om))
call SaveReal(O,Pr,3,QO)
call SaveStr(O,Pr,4,QP)
call SaveStr(O,Pr,5,QQ)
call SaveAgentHandle(O,Pr,6,Ki)
call SaveAgentHandle(O,Pr,8,Om)
call SaveAgentHandle(O,Pr,9,Pf)
call TriggerRegisterDeathEvent(t,Ki)
call TriggerRegisterDeathEvent(t,Om)
call TriggerRegisterTimerEvent(t,0,false)
call TriggerRegisterTimerEvent(t,.04,true)
call TriggerAddCondition(t,Condition(function ChargeDistanceTargetCondition))
set QU=t
set Pf=null
set t=null
set Ki=null
set Om=null
set QP=null
set QQ=null
return QU
endfunction
function SetUnitXY takes unit i,real Pm,real QN returns nothing
call SetUnitX(i,GetUnitX(i)+CosBJ(Pm)*QN)
call SetUnitY(i,GetUnitY(i)+SinBJ(Pm)*QN)
set i=null
endfunction
