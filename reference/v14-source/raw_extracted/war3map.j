call SetPlayerTechMaxAllowedSwap($52303131,1,Player(BB))
call SetPlayerTechMaxAllowedSwap($52303848,0,Player(BB))
endif
call SaveStr(O,GetPlayerId(Player(BB)),100868,"wings\\wings_202.mdx")
set SC=StringHash(GetPlayerName(Player(BB)))
