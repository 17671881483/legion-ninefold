elseif GetRandomInt(1,101)<=25 then
call UnitRemoveAbility(i,$41304E37)
call UnitAddAbility(i,$41304E37)
call IssueImmediateOrder(i,"stomp")
endif
elseif GetUnitAbilityLevel(i,$41305441)==1 then
call SaveReal(O,GetHandleId(Qf),GetHandleId(i)+77,LoadReal(O,GetHandleId(Qf),GetHandleId(i)+77)+5)
call UnitDamageTargetBJ(i,Qf,LoadReal(O,GetHandleId(Qf),GetHandleId(i)+77),ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
elseif GetUnitAbilityLevel(i,$41303552)==1 and GetEventDamage()>=GetUnitState(i,ConvertUnitState(21)) then
call UnitAddAbility(k,$41305434)
call IssueTargetOrder(k,"slow",Qf)
call UnitRemoveAbility(k,$41305434)
elseif GetUnitAbilityLevel(i,$41305355)==1 then
if LoadInteger(O,GetHandleId(i),9001)==7 then
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(i),Pn,GetUnitX(i),GetUnitY(i),0)
