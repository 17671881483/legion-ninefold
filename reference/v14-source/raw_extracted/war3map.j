elseif GetUnitTypeId(i)==$68303838 or GetUnitTypeId(i)==$68305349 then
if GetUnitAbilityLevel(i,$41303730)==1 then
call SetUnitState(i,UNIT_STATE_LIFE,GetUnitState(i,UNIT_STATE_LIFE)+GetEventDamage()*.15)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl",i,"origin"))
call UnitRemoveAbility(i,$41303730)
elseif GetRandomReal(0,100)<25 then
call UnitAddAbility(i,$41303730)
endif
elseif GetUnitAbilityLevel(i,$41304C48)>0 and not LoadBoolean(O,GetHandleId(i),2) then
set P8=GetUnitState(Qf,UNIT_STATE_MAX_LIFE)*.15
call UnitDamageTargetBJ(i,Qf,150+P8,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
endif
if IsUnitType(Qf,UNIT_TYPE_GIANT) and UnitHasBuffBJ(Qf,$42303534) then
set P8=GetEventDamage()*.2
set Cd=Condition(function SHzfs)
set Uz=YDWEGetUnitsOfPlayerMatchingNull(GetOwningPlayer(Qf),Cd)
set D6=FirstOfGroup(Uz)
if D6!=null then
call UnitDamageTarget(D6,i,P8,true,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
endif
call DestroyGroup(Uz)
call DestroyBoolExpr(Cd)
endif
call SaveBoolean(O,GetHandleId(i),StringHash("Attack"),false)
endif
set DK=null
set D6=null
set Uz=null
set Ki=null
set Qf=null
set i=null
return false
endfunction
