function TheScreamingWind takes unit Bc,real FF,real FG returns nothing
local real Pm=Atan2BJ(FG-GetUnitY(Bc),FF-GetUnitX(Bc))
local real Qv=GetUnitX(Bc)+CosBJ(Pm+90)*100
local real Qw=GetUnitY(Bc)+SinBJ(Pm+90)*100
local unit Ki
local effect DE
if IsUnitType(Bc,UNIT_TYPE_ANCIENT) then
set DE=null
set Bc=null
set Ki=null
return
endif
set Ki=CreateUnit(GetOwningPlayer(Bc),Pn,Qv,Qw,Pm)
set DE=AddSpecialEffectTarget("Abilities\\Spells\\Other\\Tornado\\TornadoElemental.mdx",Ki,"chest")
call SetUnitVertexColorBJ(Ki,0,0,100,0)
call YDWETimerRemoveUnit(1,Ki)
call YDWETimerDestroyEffect(1,DE)
call YDWEFlyEnable(Ki)
call SetUnitFlyHeight(Ki,100,10000)
call ChargeDistance(Bc,Ki,Pm,800,1,"TheScreamingWindCallBack","TheScreamingWindFinish")
set Qv=GetUnitX(Bc)+CosBJ(Pm-90)*100
set Qw=GetUnitY(Bc)+SinBJ(Pm-90)*100
set Ki=CreateUnit(GetOwningPlayer(Bc),Pn,Qv,Qw,Pm)
set DE=AddSpecialEffectTarget("Abilities\\Spells\\Other\\Tornado\\TornadoElemental.mdx",Ki,"chest")
call SetUnitVertexColorBJ(Ki,0,0,100,0)
call YDWETimerRemoveUnit(1,Ki)
call YDWETimerDestroyEffect(1,DE)
call YDWEFlyEnable(Ki)
call SetUnitFlyHeight(Ki,100,10000)
call ChargeDistance(Bc,Ki,Pm,800,1,"TheScreamingWindCallBack","TheScreamingWindFinish")
set DE=null
set Bc=null
set Ki=null
endfunction
