function InitTrig_UnitDamageActions takes nothing returns boolean
local integer gO=GetUnitTypeId(GetEventDamageSource())
local integer gQ=GetUnitTypeId(GetTriggerUnit())
return LoadInteger(Q,1,gO)==gO or LoadInteger(Q,1,gQ)==gQ or GetUnitAbilityLevel(GetEventDamageSource(),$41313159)>0 or GetUnitAbilityLevel(GetTriggerUnit(),$41313159)>0 or LoadBoolean(O,GetHandleId(GetTriggerUnit()),StringHash("A0J0")) or GetUnitAbilityLevel(GetTriggerUnit(),$41313047)>0 or GetUnitAbilityLevel(GetEventDamageSource(),$41313047)>0 or GetUnitAbilityLevel(GetEventDamageSource(),$41304E53)==1 or LoadBoolean(O,GetHandleId(GetTriggerUnit()),StringHash("immune")) or UnitHasBuffBJ(GetTriggerUnit(),$4273706C)
endfunction
function InitTrig_UnitDamage takes nothing returns nothing
set bU=CreateTrigger()
