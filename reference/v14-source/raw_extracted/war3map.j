function VashjLightningArrow takes unit Bc,real FF,real FG returns nothing
local integer QK=3
local real Pm=Atan2BJ(FG-GetUnitY(Bc),FF-GetUnitX(Bc))
local real BB=0
local real am
local unit Ki
if IsUnitType(Bc,UNIT_TYPE_ANCIENT) then
set Bc=null
return
endif
loop
set am=Pm-45+45*BB
set Ki=CreateUnit(GetOwningPlayer(Bc),Pn,GetUnitX(Bc),GetUnitY(Bc),am)
call SaveAgentHandle(O,GetHandleId(Ki),StringHash("effect"),AddSpecialEffectTarget("LJQ_SDJ02.mdx",Ki,"chest"))
call ChargeDistance(Bc,Ki,am,500,.4,"VashjLightningArrowCharge","VashjLightningArrowCallback")
set BB=BB+1
exitwhen BB>=QK
endloop
set Bc=null
set Ki=null
endfunction
