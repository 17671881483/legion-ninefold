function Trig_CreateUnitHook_Conditions takes nothing returns boolean
return C6
endfunction
function Trig_CreateUnitHookAddPermanentAbility takes unit Bc,integer at returns nothing
call UnitAddAbility(Bc,at)
call UnitMakeAbilityPermanent(Bc,true,at)
set Bc=null
endfunction
function Trig_CreateUnitHookGetBonusAbility takes integer x returns integer
if x==$68305141 then
return $4131544E
elseif x==$68303039 then
return $41315450
elseif x==$6830334F and Dg==20 then
return $41315451
endif
return 0
endfunction
function Trig_CreateUnitHookApplyBonusAbility takes unit Bc,integer x returns nothing
local integer at=Trig_CreateUnitHookGetBonusAbility(x)
if at!=0 then
call Trig_CreateUnitHookAddPermanentAbility(Bc,at)
endif
set Bc=null
endfunction
function Trig_CreateUnitHookIsSapperBonusTarget takes unit Bc returns boolean
local boolean DJ=IsUnitType(Bc,UNIT_TYPE_SAPPER) and not IsUnitType(Bc,UNIT_TYPE_STRUCTURE) and not IsUnitType(Bc,UNIT_TYPE_SUMMONED) and not IsUnitType(Bc,UNIT_TYPE_GIANT) and Dg>5
set Bc=null
return DJ
endfunction
function Trig_CreateUnitHookGetLifeScale takes nothing returns real
if Dg<=10 then
return 1.5
endif
return 3.
endfunction
function Trig_CreateUnitHookApplyLifeScale takes unit Bc returns nothing
local real dx=Trig_CreateUnitHookGetLifeScale()
call SetUnitState(Bc,ConvertUnitState(18),GetUnitState(Bc,ConvertUnitState(18))*dx)
call SetUnitState(Bc,UNIT_STATE_MAX_LIFE,GetUnitState(Bc,UNIT_STATE_MAX_LIFE)*dx)
call SetUnitLifePercentBJ(Bc,100)
set Bc=null
endfunction
function Trig_CreateUnitHookActions takes nothing returns nothing
local unit Bc=GetTriggerUnit()
local integer x=GetUnitTypeId(Bc)
call Trig_CreateUnitHookApplyBonusAbility(Bc,x)
if GetUnitAbilityLevel(Bc,$41315454)>0 then
call X9WoodSkillTwo(Bc)
endif
if Trig_CreateUnitHookIsSapperBonusTarget(Bc) then
call Trig_CreateUnitHookApplyLifeScale(Bc)
endif
set Bc=null
endfunction
function InitTrig_CreateUnitHook takes nothing returns nothing
local trigger t=CreateTrigger()
call YDWETriggerRegisterEnterRectSimpleNull(t,GetWorldBounds())
call TriggerAddCondition(t,Condition(function Trig_CreateUnitHook_Conditions))
call TriggerAddAction(t,function Trig_CreateUnitHookActions)
set t=null
endfunction
