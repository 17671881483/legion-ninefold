local unit Ki=CreateUnit(GetOwningPlayer(Bc),Pn,GetUnitX(Bc),GetUnitY(Bc),Pm)
local effect DE=AddSpecialEffectTarget(ArthasModel("LJQ_AlsaceBright_SGZC.mdx","Abilities\\Spells\\Human\\StormBolt\\StormBoltMissile.mdl"),Ki,"chest")
call SaveAgentHandle(O,GetHandleId(Ki),StringHash("hammerOfTheHolyLightEff"),DE)
