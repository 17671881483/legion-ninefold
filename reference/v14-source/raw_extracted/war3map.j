function AS5 takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer Pq=GetHandleId(t)
local unit Bc=LoadUnitHandle(O,Pq,2)
local group ao=LoadGroupHandle(O,Pq,133)
local effect as
local integer ap=GetTriggerEvalCount(t)
local real FF
local real aq=GetUnitX(Bc)
local real FG
local real ar=GetUnitY(Bc)
local integer BB
local integer EF
local group DG
call EXSetEffectXY(LoadEffectHandle(O,Pq,32),aq,ar)
if ap>20 then
set EF=21*36+(20-ap)*36
set BB=0
loop
exitwhen BB>36
set FF=aq+EF*Cos(360*BB/36*bj_DEGTORAD)
set FG=ar+EF*Sin(360*BB/36*bj_DEGTORAD)
set DG=SelectRange(Bc,FF,FG,100)
call ForGroup(DG,function AN5)
call DestroyGroup(DG)
set DG=null
set BB=BB+1
endloop
else
set EF=ap*36
set BB=0
loop
exitwhen BB>36
set FF=aq+EF*Cos(360*BB/36*bj_DEGTORAD)
set FG=ar+EF*Sin(360*BB/36*bj_DEGTORAD)
set DG=SelectRange(Bc,FF,FG,100)
call ForGroup(DG,function AN5)
call DestroyGroup(DG)
set DG=null
set BB=BB+1
endloop
endif
if ap==40 then
call DestroyGroup(ao)
call DestroyEffect(LoadEffectHandle(O,Pq,32))
call FlushChildHashtable(O,Pq)
call DestroyTrigger(t)
elseif ap==20 then
call GroupClear(ao)
set as=null
endif
set t=null
set ao=null
set Bc=null
set DG=null
return false
endfunction
