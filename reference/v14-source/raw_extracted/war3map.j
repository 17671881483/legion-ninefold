function ec takes nothing returns nothing
call CreateQuestBJ(0,YDWETranslate("概述"),"|cffAA3333概述|r\n	- 通过击败对手的国王获得胜利\n	- 建造士兵每回合参与战斗防守住敌人的进攻\n	|cffAA3333召唤|r\n	- 在你的兵营或者高级兵营召唤雇佣兵\n	- 雇佣兵会花费大量的木材\n	- 召唤的雇佣兵每个回合开始的时候会自动去攻击，不需要你的操控\n	- 回合开始前召唤的雇佣兵仅会于下一回合出现一次\n	|cffAA3333收入|r\n	- 每个回合均会获得同等于收入的金钱\n	- 召唤怪物或者增幅国王可以增加收入\n	- 收入是永久的不会降低\n	|cffAA3333国王|r\n	- 尽可能保护你的国王\n	- 你可以购买增幅给国王增加生命，防御，攻击\n	- 你可以召唤怪物攻击对方的国王\n	- 你可以控制你的国王","ReplaceableTextures\\CommandButtons\\btnmissionicon_up.blp")
call CreateQuestBJ(0,YDWETranslate("命令"),"|cffAA3333反延迟|r\n	- 主机玩家通过输入-delay on 来开启反延迟功能\n	- 通过输入-delay off 关闭它\n	- 数种兵种与该功能冲突：德鲁伊、毒牙、风龙\n	|cffAA3333视角|r\n	- 通过输入-zoom 来调整镜头高度，默认为100\n	- 镜头高度的取值范围为10-350（此数值为百分比）\n	- 通过在取值范围后加任何字符来调整OB视角\n	|cffAA3333掷骰子|r\n	- 通过输入-roll 来掷出骰子\n	- 你也可以通过在-roll 后面添加数字来设定上限\n	|cffAA3333计算器|r\n	- 通过直接输入你想要计算的公式得到结果\n	- 如想要计算130+173则直接输入130+173\n	- 计算器系统仅支持最大4位数与4位数的整数加减乘除的计算\n	- 负号算作一位数字\n	|cffAA3333广播|r\n	- 裁判可以通过输入/a 或/all 使得命令后的文字被广播\n	- 队友之间可以通过/t 或/team 使得命令后的文字队内广播\n	|cffAA3333新手教程|r\n	- 通过输入-xs 或-tutorial 开启新手教程","ReplaceableTextures\\CommandButtons\\btnmissionicon_mid.blp")
call CreateQuestBJ(0,YDWETranslate("更新"),"改动原因：随着更新的不断进行，又来到了推出新种族的时候。沙狐系沙漠族的一级兵，属于较弱的前期过度兵种，以较少的造价可以造成大量的aoe伤害。后续还会继续更新沙漠族的其他强力兵种还请大家多多期待。","ReplaceableTextures\\CommandButtons\\btnmissionicon_red.blp")
call CreateQuestBJ(2,YDWETranslate("|cFFFFFF00彩|r|cFFFFAA00蛋|r|cFFFF5500信|r|cFFFF0000息|r"),"你可能需要|cFFFF6600特殊权限|r才能建造某些彩蛋兵种。\n	|cFFFFFF00普通级权限|r：\n	1. 享受全部兵种皮肤\n	2. 享受游戏内前缀及公示\n	3. 拥有特殊彩蛋的建造权\n	4. 主机优先权\n	5. T怪特效\n	|cFFFF00FF高级权限|r独享：\n	1. 自定义入场公示及前缀\n	2. 全部技能特效\n	3. 国王攻击特效\n	4. 独享激光T怪特效\n	5. 更高主机优先权\n	6. 赞助彩蛋建造权","ReplaceableTextures\\CommandButtons\\btnmissionicon_sigh.blp")
set NM=GetLastCreatedQuestBJ()
call CreateQuestBJ(2,YDWETranslate("六倍怪物"),"加快游戏节奏的模式","ReplaceableTextures\\CommandButtons\\btnmissionicon_green.blp")
call CreateQuestBJ(2,YDWETranslate("|cFF00FF40暴力速战|r"),"娱乐模式","ReplaceableTextures\\CommandButtons\\btnmissionicon_blue.blp")
call CreateQuestBJ(2,YDWETranslate("制作名单"),YDWETranslate("|cFFFFFF00军|r|cFFC6FF00团|r|cFF8EFF00战|r|cFF55FF00争|r|cFF1CFF00T|r|cFF00FF00D|r |cFF00FFFF")+Ky,"ReplaceableTextures\\CommandButtons\\btnmissionicon_book.blp")
endfunction
