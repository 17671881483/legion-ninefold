call TriggerAddAction(bU,function Trig_UnitDamageActions)
endfunction
function Trig_UnitSummonActions takes nothing returns nothing
local unit i=GetTriggerUnit()
local unit Pf=GetSummoningUnit()
local integer x=GetUnitTypeId(i)
if x==$6E30374A then
call VashjSummon(Pf,i)
elseif x==$6830334C then
call SetUnitState(i,ConvertUnitState(18),GetUnitState(i,ConvertUnitState(18))+100)
call SetUnitState(i,ConvertUnitState(32),GetUnitState(i,ConvertUnitState(32))+3)
endif
set i=null
set Pf=null
endfunction
function InitTrig_UnitSummon takes nothing returns nothing
set bt=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(bt,EVENT_PLAYER_UNIT_SUMMON)
call TriggerAddAction(bt,function Trig_UnitSummonActions)
endfunction
function ClawTearDeathFunctionEnum takes nothing returns nothing
local unit Pf=LoadUnitHandle(O,GetHandleId(GetTriggeringTrigger()),1)
call UnitDamageTargetBJ(Pf,GetEnumUnit(),30,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",GetUnitX(GetEnumUnit()),GetUnitY(GetEnumUnit())))
set Pf=null
endfunction
function ClawTearDeathFunction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local group ag=LoadGroupHandle(O,GetHandleId(t),0)
if GetTriggerExecCount(t)>=3 then
call DestroyGroup(ag)
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
else
call ForGroup(ag,function ClawTearDeathFunctionEnum)
endif
set t=null
set ag=null
endfunction
function ClawTearDeath takes unit Pf returns nothing
local trigger t=CreateTrigger()
local group ag=CreateGroup()
local group b0=CreateGroup()
local unit D6
call GroupEnumUnitsInRange(b0,GetUnitX(Pf),GetUnitY(Pf),128,null)
loop
set D6=FirstOfGroup(b0)
exitwhen D6==null
if IsUnitEnemy(D6,GetOwningPlayer(Pf)) then
call GroupAddUnit(ag,D6)
endif
call GroupRemoveUnit(b0,D6)
endloop
call DestroyGroup(b0)
call SaveAgentHandle(O,GetHandleId(t),0,ag)
call SaveAgentHandle(O,GetHandleId(t),1,Pf)
call TriggerRegisterTimerEvent(t,0,false)
call TriggerRegisterTimerEvent(t,1,true)
call TriggerAddAction(t,function ClawTearDeathFunction)
set Pf=null
set t=null
set D6=null
set b0=null
set ag=null
endfunction
