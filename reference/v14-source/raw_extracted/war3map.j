endfunction
function CheckSurrender takes player bH,timer t,timerdialog EF returns nothing
local integer BB=0
local integer N6=0
local integer bI=0
local player h=null
local boolean YY=true
local boolean bJ=true
loop
set h=Player(BB)
set YY=LoadBoolean(O,H2I(h),StringHash("surrenderstate")) or GetPlayerSlotState(h)!=PLAYER_SLOT_STATE_PLAYING
if GetPlayerSlotState(h)==PLAYER_SLOT_STATE_PLAYING then
set bI=bI+1
endif
set bJ=bJ and YY
if LoadBoolean(O,H2I(h),StringHash("surrenderstate")) then
set N6=N6+1
endif
exitwhen BB>=3
set BB=BB+1
endloop
if bJ then
if EF!=null then
call DestroyTimerDialog(EF)
endif
if t!=null then
call FlushChildHashtable(O,H2I(t))
call DestroyTimer(t)
endif
if IsPlayerAlly(GetLocalPlayer(),Player(0)) and IsPlayerAlly(bH,Player(0)) then
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,10,"|cFFFF33CC西方军团"+YDWETranslate("同意投降!|r")+"("+I2S(bI)+"/"+I2S(bI)+")")
endif
call KillUnit(Bd)
set h=null
set bH=null
set t=null
set EF=null
return
else
if IsPlayerAlly(GetLocalPlayer(),Player(0)) and IsPlayerAlly(bH,Player(0)) then
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,10,"|cFFFF33CC西方军团投降进度:|r("+I2S(N6)+"/"+I2S(bI)+")")
endif
endif
set BB=4
set bJ=true
set N6=0
set bI=0
loop
set h=Player(BB)
set YY=LoadBoolean(O,H2I(h),StringHash("surrenderstate")) or GetPlayerSlotState(h)!=PLAYER_SLOT_STATE_PLAYING
if GetPlayerSlotState(h)==PLAYER_SLOT_STATE_PLAYING then
set bI=bI+1
endif
set bJ=bJ and YY
if LoadBoolean(O,H2I(h),StringHash("surrenderstate")) then
set N6=N6+1
endif
exitwhen BB>=7
set BB=BB+1
endloop
if bJ then
if EF!=null then
call DestroyTimerDialog(EF)
endif
if t!=null then
call FlushChildHashtable(O,H2I(t))
call DestroyTimer(t)
endif
if IsPlayerAlly(GetLocalPlayer(),Player(4)) and IsPlayerAlly(bH,Player(4)) then
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,10,"|cFFFF33CC东方军团"+YDWETranslate("同意投降!|r")+"("+I2S(bI)+"/"+I2S(bI)+")")
endif
call KillUnit(Bh)
else
if IsPlayerAlly(GetLocalPlayer(),Player(4)) and IsPlayerAlly(bH,Player(4)) then
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,10,"|cFFFF33CC东方军团投降进度:|r("+I2S(N6)+"/"+I2S(bI)+")")
endif
endif
set h=null
set bH=null
set t=null
set EF=null
endfunction
function SurrenderActionForceAction takes nothing returns nothing
local dialog EF=GetClickedDialog()
local button v=GetClickedButton()
local player h=GetTriggerPlayer()
if LoadButtonHandle(O,H2I(EF),StringHash("yes"))==v then
call SaveBoolean(O,H2I(h),StringHash("surrenderstate"),true)
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,10,"|cFFFF33CC"+GetPlayerName(h)+YDWETranslate("同意投降!|r"))
call CheckSurrender(h,null,null)
else
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,10,"|cFFFF33CC"+GetPlayerName(h)+YDWETranslate("不同意投降!|r"))
endif
set EF=null
set v=null
set h=null
endfunction
function SurrenderActionForce takes nothing returns nothing
local player h=GetEnumPlayer()
local dialog EF=LoadDialogHandle(O,H2I(h),StringHash("surrenderdialog"))
local trigger t=null
local button bF=null
local button bG=null
if EF==null then
set EF=DialogCreate()
call DialogSetMessage(EF,YDWETranslate("是否同意投降?"))
set bF=DialogAddButton(EF,YDWETranslate("确定[Y]"),89)
set bG=DialogAddButton(EF,YDWETranslate("取消[N]"),78)
call SaveDialogHandle(O,H2I(h),StringHash("surrenderdialog"),EF)
call SaveButtonHandle(O,H2I(EF),StringHash("yes"),bF)
call SaveButtonHandle(O,H2I(EF),StringHash("no"),bG)
set t=CreateTrigger()
call TriggerRegisterDialogEventBJ(t,EF)
call TriggerAddAction(t,function SurrenderActionForceAction)
endif
call DialogDisplay(h,EF,true)
set h=null
set EF=null
set t=null
set bF=null
set bG=null
endfunction
function SurrenderAction takes player h returns nothing
local force Bo=CreateForce()
local integer BB=0
loop
if SurrenderActionCondition(Player(BB),h) then
call ForceAddPlayer(Bo,Player(BB))
endif
exitwhen BB>=11
set BB=BB+1
endloop
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,10,"|cFFFF33CC"+GetPlayerName(h)+YDWETranslate("发起了投票表决!|r"))
call ForForce(Bo,function SurrenderActionForce)
call DestroyForce(Bo)
set h=null
set Bo=null
endfunction
