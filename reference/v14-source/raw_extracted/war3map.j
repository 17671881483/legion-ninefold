function A0KQ_Action takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer RN=GetHandleId(t)
local unit i=LoadUnitHandle(O,RN,StringHash("Death_Knight"))
local unit Ki=LoadUnitHandle(O,RN,StringHash("dummy"))
local unit Qf
local group DG=LoadGroupHandle(O,RN,StringHash("Group"))
local group Po=LoadGroupHandle(O,RN,StringHash("TempGroup"))
local real D1=LoadReal(O,RN,StringHash("timer"))
local real FF
local real FG
local player h=LoadPlayerHandle(O,RN,StringHash("P_Id"))
local integer BB=LoadInteger(O,GetHandleId(h),StringHash("Bone_Dragon"))
local unit RO
if D1==1200 then
call DestroyGroup(DG)
call DestroyGroup(Po)
call KillUnit(Ki)
call DestroyTimer(t)
call FlushChildHashtable(O,RN)
else
if Po==null then
set Po=CreateGroup()
call SaveGroupHandle(O,RN,StringHash("TempGroup"),Po)
else
call GroupClear(Po)
endif
set FF=GetUnitX(Ki)+CosBJ(GetUnitFacing(Ki))*80
set FG=GetUnitY(Ki)+SinBJ(GetUnitFacing(Ki))*80
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdl",FF,FG))
call GroupEnumUnitsInRange(Po,FF,FG,300,null)
set RO=CreateUnit(GetOwningPlayer(i),Pn,FF,FG,0)
call UnitAddAbility(RO,$41304B52)
call SetUnitAbilityLevel(RO,$41304B52,BB)
loop
set Qf=FirstOfGroup(Po)
exitwhen Qf==null
if IsUnitEnemy(Qf,GetOwningPlayer(i)) and not IsUnitInGroup(Qf,DG) then
call UnitDamageTargetBJ(i,Qf,50.+50.*I2R(BB),ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
call GroupAddUnit(DG,Qf)
call IssueTargetOrder(RO,"thunderbolt",Qf)
endif
call GroupRemoveUnit(Po,Qf)
endloop
call RemoveUnit(RO)
set Qf=null
call SetUnitX(Ki,FF)
call SetUnitY(Ki,FG)
call SaveReal(O,RN,StringHash("timer"),D1+100)
endif
set RO=null
set Po=null
set t=null
set i=null
set DG=null
set Ki=null
set h=null
endfunction
function Arthas takes nothing returns nothing
local trigger RL=GetTriggeringTrigger()
local unit i=LoadUnitHandle(O,GetHandleId(RL),StringHash("Death_Knight"))
local player h=LoadPlayerHandle(O,GetHandleId(RL),StringHash("P_Id"))
local unit Ki
local timer t
local unit RM
local real D1
local real Pm
local group DG
local group Po
if EVENT_PLAYER_UNIT_DEATH==GetTriggerEventId() then
set RM=GetDyingUnit()
if IsUnitInRange(i,RM,1200) and GetRandomReal(1.,101.)<=5. and not IsUnitInGroup(GetTriggerUnit(),Ju) and not IsUnitType(RM,UNIT_TYPE_HERO) and GetUnitTypeId(RM)!=$65303045 then
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(i),GetUnitTypeId(RM),GetUnitX(RM),GetUnitY(RM),GetUnitFacing(RM))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl",GetUnitX(RM),GetUnitY(RM)))
call GroupAddUnit(JW,bj_lastCreatedUnit)
call SetUnitUserData(bj_lastCreatedUnit,GetUnitUserData(i))
call GroupAddUnit(JH[GetUnitUserData(i)],bj_lastCreatedUnit)
call UnitAddType(bj_lastCreatedUnit,UNIT_TYPE_SUMMONED)
call UnitApplyTimedLife(bj_lastCreatedUnit,$4255616E,4)
endif
elseif EVENT_UNIT_STATE_LIMIT==GetTriggerEventId() then
call FlushChildHashtable(O,GetHandleId(RL))
call DestroyTrigger(GetTriggeringTrigger())
elseif EVENT_UNIT_SPELL_EFFECT==GetTriggerEventId() and GetSpellAbilityId()==$41304B51 then
set DG=CreateGroup()
set Po=CreateGroup()
set Pm=Atan2BJ(GetUnitY(GetSpellTargetUnit())-GetUnitY(GetTriggerUnit()),GetUnitX(GetSpellTargetUnit())-GetUnitX(GetTriggerUnit()))
set Ki=CreateUnit(GetOwningPlayer(i),$65303045,GetUnitX(i),GetUnitY(i),Pm)
set t=CreateTimer()
set D1=0
call TimerStart(t,.04,true,function A0KQ_Action)
call SaveUnitHandle(O,GetHandleId(t),StringHash("Death_Knight"),i)
call SaveUnitHandle(O,GetHandleId(t),StringHash("dummy"),Ki)
call SavePlayerHandle(O,GetHandleId(t),StringHash("P_Id"),h)
call SaveReal(O,GetHandleId(t),StringHash("timer"),D1)
call SaveGroupHandle(O,GetHandleId(t),StringHash("Group"),DG)
call SaveGroupHandle(O,GetHandleId(t),StringHash("TempGroup"),Po)
set DG=null
set Po=null
endif
set RL=null
set i=null
