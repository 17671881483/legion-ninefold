function MaievPink takes unit Bc returns nothing
local timer t=LoadTimerHandle(O,GetHandleId(Bc),$41315458)
local real FF
local real FG
local integer BB=0
local real bZ=200
if GetUnitAbilityLevel(Bc,$41315458)>0 then
loop
set BB=BB+1
set FF=GetUnitX(Bc)+CosBJ(GetUnitFacing(Bc))*-RMaxBJ(32*BB,bZ)
set FG=GetUnitY(Bc)+SinBJ(GetUnitFacing(Bc))*-RMaxBJ(32*BB,bZ)
exitwhen 32*BB>=bZ or IsTerrainPathable(FF,FG,PATHING_TYPE_WALKABILITY)
endloop
if t==null and not IsTerrainPathable(FF,FG,PATHING_TYPE_WALKABILITY) then
set t=CreateTimer()
call SaveUnitHandle(O,GetHandleId(t),0,Bc)
call TimerStart(t,8,false,function MaievPinkTimer)
call SaveAgentHandle(O,GetHandleId(Bc),$41315458,t)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl",GetUnitX(Bc),GetUnitY(Bc)))
call SetUnitX(Bc,FF)
call SetUnitY(Bc,FG)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl",FF,FG))
endif
endif
set t=null
set Bc=null
endfunction
