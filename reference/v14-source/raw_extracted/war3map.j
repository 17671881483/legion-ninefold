call UnitAddAbility(Ki,EachMonsterSkillTypeForHero(Ki))
call UnitMakeAbilityPermanent(Ki,true,EachMonsterSkillTypeForHero(Ki))
call ExecuteMonsterSkillInit(Ki,false)
call EggWhite(Ki,GetUnitTypeId(Ki),h,GetPlayerId(h),GetUnitUserData(Ki))
call SetSkillListState(GetOwningPlayer(Pf),StringHash("box"),false)
call RemoveSkillList(Pf,StringHash("box"))
set Ki=null
endif
else
