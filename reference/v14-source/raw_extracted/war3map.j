if BF==cF then
call ChangeGalo(BF,Bc,Ki)
endif
if Ki!=null then
if BF==$41305851 then
call GaloBackPage(Bc)
elseif BF==$41305852 then
call GaloNextPage(Bc)
endif
endif
set Ki=null
set Bc=null
endfunction
