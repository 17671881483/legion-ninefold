function YDWEJumpTimerLoop takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit Bc=YDWEGetUnitByString(I2S(YDWEH2I(t)),"Hero")
local real Pm=YDWEGetRealByString(I2S(YDWEH2I(t)),"Angle")
local integer Q7=YDWEGetIntegerByString(I2S(YDWEH2I(t)),"steeps")
local integer Q1=YDWEGetIntegerByString(I2S(YDWEH2I(t)),"steepsMax")
local real Q0=YDWEGetRealByString(I2S(YDWEH2I(t)),"heightMax")
local real Q5=YDWEGetRealByString(I2S(YDWEH2I(t)),"dist")
local real Q6=YDWEGetRealByString(I2S(YDWEH2I(t)),"dheig")
local real Q2=YDWEGetRealByString(I2S(YDWEH2I(t)),"OriginHeight")
local real FF=YDWEGetRealByString(I2S(YDWEH2I(t)),"X")
local real FG=YDWEGetRealByString(I2S(YDWEH2I(t)),"Y")
local real Qv=0
local real Qw=0
local real Q9=0
local integer Q8=Q4
local integer Q3=YDWEGetIntegerByString(I2S(YDWEH2I(Bc)),"lvUnitMove")
if Q7<Q1 and Q8>=Q3 then
set Qv=FF+Q7*Q5*Cos(Pm*3.14159/180.)
set Qw=FG+Q7*Q5*Sin(Pm*3.14159/180.)
set Qv=YDWECoordinateX(Qv)
set Qw=YDWECoordinateY(Qw)
call SetUnitX(Bc,Qv)
call SetUnitY(Bc,Qw)
set Q7=Q7+1
call YDWESaveIntegerByString(I2S(YDWEH2I(t)),"steeps",Q7)
set Q9=(-(2*I2R(Q7)*Q6-1)*(2*I2R(Q7)*Q6-1)+1)*Q0+Q2
call SetUnitFlyHeight(Bc,Q9,99999)
call SetUnitFacing(Bc,Pm)
else
call SetUnitFlyHeight(Bc,Q2,99999)
call SetUnitPathing(Bc,true)
call DestroyTimer(t)
call YDWEFlushMissionByString(I2S(YDWEH2I(t)))
call YDWESaveIntegerByString(I2S(YDWEH2I(Bc)),"lvUnitMove",0)
call YDWESyStemAbilityCastingOverTriggerAction(Bc,2)
endif
set t=null
set Bc=null
endfunction
function YDWEJumpTimer takes unit Bc,real Pm,real Qx,real Qy,real Qz,real Q0 returns nothing
local timer t=null
local real FF=GetUnitX(Bc)
local real FG=GetUnitY(Bc)
local integer Q1=R2I(Qy/Qz)
local integer Q7=0
local real Q5=Qx/Q1
local real Q6=1./Q1
local real Q2=GetUnitFlyHeight(Bc)
local integer Q3=YDWEGetIntegerByString(I2S(YDWEH2I(Bc)),"lvUnitMove")
if Q4<=Q3 then
return
endif
set t=CreateTimer()
call YDWESaveIntegerByString(I2S(YDWEH2I(Bc)),"lvUnitMove",Q4)
call YDWEFlyEnable(Bc)
call SetUnitPathing(Bc,false)
call YDWESaveUnitByString(I2S(YDWEH2I(t)),"Hero",Bc)
call YDWESaveRealByString(I2S(YDWEH2I(t)),"OriginHeight",Q2)
call YDWESaveRealByString(I2S(YDWEH2I(t)),"Angle",Pm)
call YDWESaveRealByString(I2S(YDWEH2I(t)),"dist",Q5)
call YDWESaveRealByString(I2S(YDWEH2I(t)),"heightMax",Q0)
call YDWESaveRealByString(I2S(YDWEH2I(t)),"dheig",Q6)
call YDWESaveRealByString(I2S(YDWEH2I(t)),"X",FF)
call YDWESaveRealByString(I2S(YDWEH2I(t)),"Y",FG)
call YDWESaveIntegerByString(I2S(YDWEH2I(t)),"steeps",Q7)
call YDWESaveIntegerByString(I2S(YDWEH2I(t)),"steepsMax",Q1)
call TimerStart(t,Qz,true,function YDWEJumpTimerLoop)
set t=null
endfunction
