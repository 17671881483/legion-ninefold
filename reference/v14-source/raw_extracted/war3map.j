call SetPlayerAbilityAvailable(Player(5),$41303834,false)
call SetPlayerAbilityAvailable(Player(6),$41303834,false)
call SetPlayerAbilityAvailable(Player(7),$41303834,false)
call YDWEPolledWaitNull(1)
call SetPlayerAbilityAvailable(Player(4),$41303834,true)
call SetPlayerAbilityAvailable(Player(5),$41303834,true)
call SetPlayerAbilityAvailable(Player(6),$41303834,true)
call SetPlayerAbilityAvailable(Player(7),$41303834,true)
endif
endfunction
function yA takes real N9 returns nothing
local real OC
local real Kv=TimerGetElapsed(OB)
if Kv<=0 then
set OB=CreateTimer()
call TimerStart(OB,$F4240,false,null)
endif
if N9>0 then
loop
set OC=N9-TimerGetElapsed(OB)+Kv
exitwhen OC<=0
if OC>bj_POLLED_WAIT_SKIP_THRESHOLD then
call TriggerSleepAction(.1*OC)
else
call TriggerSleepAction(bj_POLLED_WAIT_INTERVAL)
endif
endloop
endif
endfunction
