call YDWEAnyUnitDamagedEnumUnit()
call TimerStart(CreateTimer(),40,true,function YDWESyStemAnyUnitDamagedRegistTriggerTimer)
set Ed=CreateTrigger()
call TriggerAddAction(Ed,function YDWEAnyUnitDamagedTriggerAction)
endif
set Ee[Ec]=Eb
set Ec=Ec+1
endfunction
