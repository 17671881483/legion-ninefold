function VashJsporeAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
local real FF=LoadReal(O,GetHandleId(t),1)
local real FG=LoadReal(O,GetHandleId(t),2)
local integer DK=LoadInteger(O,GetHandleId(t),3)
if GetTriggerExecCount(t)>=DK+1 or GetTriggerEventId()==EVENT_WIDGET_DEATH then
call DestroyEffect(LoadEffectHandle(O,GetHandleId(t),4))
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
elseif GetTriggerExecCount(t)==1 then
call TriggerRegisterTimerEvent(t,1,true)
call AoeDamage(Bc,FF,FG,200,99,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
else
call AoeDamage(Bc,FF,FG,200,99,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
endif
set t=null
set Bc=null
endfunction
function VashJspore takes unit Bc returns nothing
local integer QK=3
local real BB=0
local real FF
local real FG
local real al
local real QN
local trigger t
local real Pm=GetUnitFacing(Bc)
if IsUnitType(Bc,UNIT_TYPE_ANCIENT) then
set Bc=null
return
endif
loop
set al=Pm+GetRandomReal(-90,90)
set QN=GetRandomReal(0,500)
set FF=GetUnitX(Bc)+CosBJ(al)*QN
set FG=GetUnitY(Bc)+SinBJ(al)*QN
set t=CreateTrigger()
call SaveAgentHandle(O,GetHandleId(t),0,Bc)
call SaveReal(O,GetHandleId(t),1,FF)
call SaveReal(O,GetHandleId(t),2,FG)
call SaveInteger(O,GetHandleId(t),3,10)
call SaveAgentHandle(O,GetHandleId(t),4,AddSpecialEffect("LJQ_DXBZ.mdx",FF,FG))
call TriggerRegisterTimerEvent(t,1,false)
call TriggerAddAction(t,function VashJsporeAction)
set BB=BB+1
exitwhen BB>=QK
endloop
set Bc=null
set t=null
endfunction
function VashjSummonAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
local unit Ki=LoadUnitHandle(O,GetHandleId(t),1)
if GetTriggerEventId()==EVENT_WIDGET_DEATH or GetTriggerExecCount(t)>=R2I(GetUnitState(Bc,UNIT_STATE_MAX_LIFE)) then
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
else
call SetUnitState(Bc,UNIT_STATE_LIFE,GetUnitState(Bc,UNIT_STATE_LIFE)+5)
call SetUnitState(Bc,UNIT_STATE_MANA,GetUnitState(Bc,UNIT_STATE_MANA)+1.5)
endif
set Bc=null
set Ki=null
set t=null
endfunction
function VashjSummon takes unit Bc,unit Ki returns nothing
