function fire_angle takes nothing returns nothing
local timer Dz=GetExpiredTimer()
local timer t=LoadTimerHandle(O,GetHandleId(Dz),3)
local effect bk=LoadEffectHandle(O,GetHandleId(Dz),1)
local unit i=LoadUnitHandle(O,GetHandleId(Dz),2)
