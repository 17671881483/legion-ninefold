set E8=E6[GetPlayerId(h)+1]
if E8>PP and LoadInteger(O,GetPlayerId(h),StringHash("ticket"))==LoadInteger(O,GetPlayerId(PO),StringHash("ticket")) then
set PP=E8
set PQ=h
endif
exitwhen BB>=E9
set BB=BB+1
endloop
return PQ
endfunction
