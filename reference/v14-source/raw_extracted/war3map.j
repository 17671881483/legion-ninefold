function IllidanDemonicFrenzy takes unit Bc returns nothing
local trigger t=CreateTrigger()
call SaveAgentHandle(O,GetHandleId(t),0,Bc)
call TriggerRegisterUnitLifeEvent(t,Bc,LESS_THAN,GetUnitState(Bc,UNIT_STATE_MAX_LIFE)*.2)
call TriggerAddAction(t,function IllidanDemonicFrenzyAction)
set t=null
set Bc=null
endfunction
function RegisterIllidanAlternateAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit Bc=GetTriggerUnit()
local unit Ki
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\Reincarnation\\ReincarnationTarget.mdl",GetUnitX(Bc),GetUnitY(Bc)))
set Ki=CreateUnit(GetOwningPlayer(Bc),GetUnitTypeId(Bc),GetUnitX(Bc),GetUnitY(Bc),GetUnitFacing(Bc))
call SetUnitManaBJ(Ki,15)
call UnitAddAbility(Ki,Qo)
call UnitMakeAbilityPermanent(Ki,true,Qo)
call SetUnitAbilityLevel(Ki,Qo,GetUnitAbilityLevel(Bc,Qo))
call IllidanDemonicFrenzy(Ki)
call IllidanSoulSteal(LoadUnitHandle(O,GetHandleId(Bc),$41314236),Ki)
call GroupAddUnit(JW,Ki)
call GroupAddUnit(JH[GetUnitUserData(Bc)],Ki)
call SetUnitUserData(Ki,GetUnitUserData(Bc))
call IllidanAlternate(Ki)
call RemoveUnit(Bc)
call DestroyTrigger(t)
else
call DestroyTriggerForTime(t,.5)
endif
set t=null
set Bc=null
set Ki=null
endfunction
function RegisterIllidanAlternate takes unit Bc returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterUnitEvent(t,Bc,EVENT_UNIT_DEATH)
call TriggerRegisterDeathEvent(t,Bc)
call TriggerAddAction(t,function RegisterIllidanAlternateAction)
set t=null
set Bc=null
endfunction
