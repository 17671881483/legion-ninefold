if GetTriggerEventId()==EVENT_GAME_TIMER_EXPIRED then
call SetUnitState(Bc,ConvertUnitState(81),GetUnitState(Bc,ConvertUnitState(81))-1)
call UnitRemoveAbility(Bc,Qq)
endif
call DestroyEffect(LoadEffectHandle(O,GetHandleId(t),1))
call DestroyEffect(LoadEffectHandle(O,GetHandleId(t),2))
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
set t=null
set Bc=null
endfunction
