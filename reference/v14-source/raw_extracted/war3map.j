if IsUnitEnemy(Qf,GetOwningPlayer(i)) then
call UnitDamageTargetBJ(i,Qf,35+GetUnitState(Qf,UNIT_STATE_MAX_LIFE)*.01,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL)
call SetUnitLifeBJ(i,GetUnitState(i,UNIT_STATE_LIFE)+(35+GetUnitState(Qf,UNIT_STATE_MAX_LIFE)*.01)*.05)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Immolation\\ImmolationDamage.mdl",Qf,"origin"))
endif
call GroupRemoveUnit(RP,Qf)
set Qf=null
endloop
call DestroyGroup(RP)
set RP=null
set Qf=null
set i=null
endif
elseif GetTriggerEventId()==EVENT_UNIT_SPELL_FINISH and GetSpellAbilityId()==$41706878 then
if GetUnitTypeId(i)==$6833384A then
set t=CreateTimer()
call TimerStart(t,0,false,function h18J_timer)
call SaveUnitHandle(O,GetHandleId(t),1,i)
call SetUnitState(i,UNIT_STATE_MAX_LIFE,200)
call SetUnitState(i,UNIT_STATE_LIFE,200.)
set t=null
else
call SaveReal(O,GetHandleId(RL),2,LoadReal(O,GetHandleId(RL),2)-500)
call SetUnitState(i,UNIT_STATE_MAX_LIFE,LoadReal(O,GetHandleId(RL),2))
if GetUnitState(i,UNIT_STATE_MAX_LIFE)<=1000 then
call UnitRemoveAbility(i,$41706878)
call SetUnitFlyHeight(i,350.,300.)
endif
endif
else
call KillUnit(i)
endif
set i=null
set RL=null
set t=null
set Qf=null
set RP=null
endfunction
function Phoenix takes unit i returns nothing
local trigger RL=CreateTrigger()
call SaveUnitHandle(O,GetHandleId(RL),1,i)
call SaveReal(O,GetHandleId(RL),2,2000)
call TriggerRegisterTimerEventPeriodic(RL,1)
call TriggerRegisterUnitLifeEvent(RL,i,LESS_THAN,1)
call TriggerRegisterUnitEvent(RL,i,EVENT_UNIT_SPELL_FINISH)
call TriggerAddAction(RL,function Phoenix_Action)
set RL=null
set i=null
endfunction
function h03L_data takes unit i,boolean Cd,boolean UU returns nothing
local unit Ki
if Cd then
call UnitAddAbility(i,$4130584E)
call SaveInteger(O,GetHandleId(i),StringHash("killnum"),LoadInteger(O,GetHandleId(i),StringHash("killnum"))+1)
if UU then
call SaveInteger(O,GetHandleId(i),StringHash("timenum"),LoadInteger(O,GetHandleId(i),StringHash("timenum"))+1)
endif
call SetUnitState(i,UNIT_STATE_MANA,GetUnitState(i,UNIT_STATE_MANA)+1.)
call SetUnitState(i,UNIT_STATE_LIFE,GetUnitState(i,UNIT_STATE_LIFE)+100.)
call YDWEGeneralBounsSystemUnitSetBonus(i,0,0,100)
call YDWEGeneralBounsSystemUnitSetBonus(i,3,0,10)
if LoadInteger(O,GetHandleId(i),StringHash("killnum"))==10 and not LoadBoolean(O,GetHandleId(i),StringHash("one")) then
if GetUnitTypeId(i)==$6830334C then
set Ki=CreateUnit(GetOwningPlayer(i),$6830334B,GetUnitX(i),GetUnitY(i),bj_UNIT_FACING)
elseif GetUnitTypeId(i)==$68305358 then
set Ki=CreateUnit(GetOwningPlayer(i),$68305355,GetUnitX(i),GetUnitY(i),bj_UNIT_FACING)
endif
call GroupAddUnit(JW,Ki)
call SetUnitUserData(Ki,GetUnitUserData(i))
call GroupAddUnit(JH[GetUnitUserData(i)],Ki)
call UnitAddType(Ki,UNIT_TYPE_SUMMONED)
call SaveBoolean(O,GetHandleId(i),StringHash("one"),true)
endif
else
call SaveInteger(O,GetHandleId(i),StringHash("killnum"),LoadInteger(O,GetHandleId(i),StringHash("killnum"))-6)
call SetUnitState(i,UNIT_STATE_MANA,GetUnitState(i,UNIT_STATE_MANA)-6)
call SetUnitState(i,UNIT_STATE_LIFE,GetUnitState(i,UNIT_STATE_LIFE)+1000.)
call YDWEGeneralBounsSystemUnitSetBonus(i,0,1,600)
call YDWEGeneralBounsSystemUnitSetBonus(i,3,1,60)
endif
if LoadInteger(O,GetHandleId(i),StringHash("killnum"))<=15 then
if LoadInteger(O,GetHandleId(i),StringHash("killnum"))<=0 then
call UnitRemoveAbility(i,$4130584E)
else
call SetUnitAbilityLevel(i,$4130584E,LoadInteger(O,GetHandleId(i),StringHash("killnum")))
endif
endif
set Ki=null
set i=null
endfunction
function h03L_Timer takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer Kd=GetHandleId(t)
local unit i=LoadUnitHandle(O,Kd,1)
if i==null or GetUnitState(i,UNIT_STATE_LIFE)<1 then
call FlushChildHashtable(O,Kd)
call DestroyTimer(t)
elseif LoadInteger(O,GetHandleId(i),StringHash("killnum"))<15 then
call h03L_data(i,true,true)
endif
set t=null
set i=null
endfunction
