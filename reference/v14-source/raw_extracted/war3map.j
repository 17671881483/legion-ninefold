set Kc=bj_lastCreatedUnit
call UnitAddAbility(Kc,$41303239)
call IssueImmediateOrderById(Kc,852526)
call UnitApplyTimedLifeBJ(3.,$42544C46,Kc)
call RemoveLocation(Pb)
endif
endfunction
