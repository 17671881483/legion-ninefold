set t=null
endfunction
function RegisterAlexstraszaLifeGrantEvent takes unit Bc,unit Om returns nothing
local trigger t=CreateTrigger()
if LoadBoolean(O,GetHandleId(Om),GetHandleId(Bc)) then
call DestroyTrigger(t)
set Bc=null
set Om=null
set t=null
return
endif
call SaveBoolean(O,GetHandleId(Om),GetHandleId(Bc),true)
call SaveAgentHandle(O,GetHandleId(t),0,Bc)
call SaveAgentHandle(O,GetHandleId(t),1,Om)
call TriggerRegisterUnitLifeEvent(t,Om,LESS_THAN_OR_EQUAL,GetUnitState(Om,UNIT_STATE_MAX_LIFE)*.65)
call TriggerRegisterDeathEvent(t,Bc)
call TriggerRegisterDeathEvent(t,Om)
call TriggerAddAction(t,function RegisterAlexstraszaLifeGrantEventAction)
set Bc=null
set Om=null
set t=null
endfunction
