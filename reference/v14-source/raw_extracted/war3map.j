function LoopDamageAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer BF=GetHandleId(t)
local unit Pf=LoadUnitHandle(O,BF,0)
local unit Om=LoadUnitHandle(O,BF,1)
local real DK=LoadReal(O,BF,2)
local real Zp=LoadReal(O,BF,3)
if GetTriggerEventId()==EVENT_GAME_TIMER_EXPIRED then
call UnitDamageTargetBJ(Pf,Om,LoadReal(O,BF,4),ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
if GetTriggerExecCount(t)*Zp>=DK then
call FlushChildHashtable(O,BF)
call DestroyTrigger(t)
endif
else
call FlushChildHashtable(O,BF)
call DestroyTrigger(t)
endif
set Pf=null
set Om=null
set t=null
endfunction
function LoopDamage takes unit Pf,unit Om,real Tz,real Zp,real DK returns nothing
local trigger t=CreateTrigger()
call SaveUnitHandle(O,GetHandleId(t),0,Pf)
call SaveUnitHandle(O,GetHandleId(t),1,Om)
call SaveReal(O,GetHandleId(t),2,DK)
call SaveReal(O,GetHandleId(t),3,Zp)
call SaveReal(O,GetHandleId(t),4,Tz)
call TriggerRegisterTimerEvent(t,Zp,true)
call TriggerRegisterDeathEvent(t,Om)
call TriggerAddAction(t,function LoopDamageAction)
set Pf=null
set Om=null
set t=null
endfunction
function LoopDamageRangeAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer BF=GetHandleId(t)
local unit Pf=LoadUnitHandle(O,BF,0)
local real Px=LoadReal(O,BF,1)
local real DK=LoadReal(O,BF,2)
local real Zp=LoadReal(O,BF,3)
local unit D6
local group DG
if GetTriggerEventId()==EVENT_GAME_TIMER_EXPIRED then
set DG=SelectRange(Pf,LoadReal(O,BF,5),LoadReal(O,BF,6),Px)
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
call UnitDamageTargetBJ(Pf,D6,LoadReal(O,BF,4),ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
endloop
call DestroyGroup(DG)
set DG=null
if GetTriggerExecCount(t)*Zp>=DK then
call FlushChildHashtable(O,BF)
call DestroyTrigger(t)
endif
else
call FlushChildHashtable(O,BF)
call DestroyTrigger(t)
endif
set Pf=null
set t=null
set D6=null
set DG=null
endfunction
function LoopDamageRange takes unit Pf,real Px,real FF,real FG,real Tz,real Zp,real DK returns nothing
local trigger t=CreateTrigger()
call SaveUnitHandle(O,GetHandleId(t),0,Pf)
call SaveReal(O,GetHandleId(t),1,Px)
call SaveReal(O,GetHandleId(t),2,DK)
call SaveReal(O,GetHandleId(t),3,Zp)
call SaveReal(O,GetHandleId(t),4,Tz)
call SaveReal(O,GetHandleId(t),5,FF)
call SaveReal(O,GetHandleId(t),6,FG)
call TriggerRegisterTimerEvent(t,Zp,true)
call TriggerAddAction(t,function LoopDamageRangeAction)
set Pf=null
set t=null
endfunction
function NazuoOmenOfSummonDeath takes unit Bc returns nothing
local group DG=SelectRange(Bc,GetUnitX(Bc),GetUnitY(Bc),300)
local unit D6
call DestroyEffect(AddSpecialEffect("Units\\NightElf\\Wisp\\WispExplode.mdl",GetUnitX(Bc),GetUnitY(Bc)))
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call LoopDamage(Bc,D6,80,1,5)
call GroupRemoveUnit(DG,D6)
endloop
call DestroyGroup(DG)
set DG=null
set Bc=null
set D6=null
endfunction
