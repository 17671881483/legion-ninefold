function YDWEMultiboardSetItemIconBJNull takes multiboard KR,integer KS,integer KT,string KU returns nothing
local integer KX=0
local integer KY=0
local integer KV=MultiboardGetRowCount(KR)
local integer KW=MultiboardGetColumnCount(KR)
local multiboarditem KZ=null
loop
set KX=KX+1
exitwhen KX>KV
if KT==0 or KT==KX then
set KY=0
loop
set KY=KY+1
exitwhen KY>KW
if KS==0 or KS==KY then
set KZ=MultiboardGetItem(KR,KX-1,KY-1)
call MultiboardSetItemIcon(KZ,KU)
call MultiboardReleaseItem(KZ)
endif
endloop
endif
endloop
set KZ=null
endfunction
