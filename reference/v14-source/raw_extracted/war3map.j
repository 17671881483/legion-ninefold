function Score takes nothing returns nothing
local integer BB=0
local integer Bj=0
local integer Eq=0
loop
exitwhen BB>7
set Eq=GetPlayerScore(Player(BB),PLAYER_SCORE_GOLD_GIVEN)
if Eq>FX[BB] then
set Bj=Eq-FX[BB]
set FX[BB]=Eq
endif
set Eq=GetPlayerScore(Player(BB),PLAYER_SCORE_GOLD_RECEIVED)
if Eq>FY[BB] then
set Bj=Eq-FY[BB]
set FY[BB]=Eq
call SetPlayerState(Player(BB),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(BB),PLAYER_STATE_RESOURCE_GOLD)-Bj)
endif
set Eq=GetPlayerScore(Player(BB),PLAYER_SCORE_LUMBER_GIVEN)
if Eq>FZ[BB] then
set Bj=Eq-FZ[BB]
set FZ[BB]=Eq
endif
set Eq=GetPlayerScore(Player(BB),PLAYER_SCORE_LUMBER_RECEIVED)
if Eq>Fa[BB] then
set Bj=Eq-Fa[BB]
set Fa[BB]=Eq
call SetPlayerState(Player(BB),PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(Player(BB),PLAYER_STATE_RESOURCE_LUMBER)-Bj)
endif
set BB=BB+1
endloop
endfunction
