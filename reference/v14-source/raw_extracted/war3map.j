function UpLumberingHook takes integer DX,player h returns nothing
local integer De
local integer Df
if DX==$52303033 or DX==$52303657 then
set DY[GetConvertedPlayerId(h)]=DY[GetConvertedPlayerId(h)]+1
else
set DZ[GetConvertedPlayerId(h)]=DZ[GetConvertedPlayerId(h)]+1
endif
if Da then
if IsPlayerAlly(h,Player(8)) then
set Db=Db+2
call DisplayTimedTextToForce(GetPlayersAll(),3.,YDWETranslate("|cFFFFCC00[积分]|r |cFFE3E300联盟军团|r研究了一级伐木效率，积分增加了|cFF00FF00+2|r分"))
call MultiboardSetTitleText(BC,YDWETranslate("|cFF99CC00积分|r |cFFFFFF99")+I2S(Db)+"|r：|cFFCC99FF"+I2S(Dc)+"|r")
else
set Dc=Dc+2
call DisplayTimedTextToForce(GetPlayersAll(),3.,YDWETranslate("|cFFFFCC00[积分]|r |cFF0074E8部落军团|r研究了一级伐木效率，积分增加了|cFF00FF00+2|r分"))
call MultiboardSetTitleText(BC,YDWETranslate("|cFF99CC00积分|r |cFFFFFF99")+I2S(Db)+"|r：|cFFCC99FF"+I2S(Dc)+"|r")
endif
endif
call TriggerExecute(DU)
if oldcodefn_Tt(h) then
call SetPlayerTechMaxAllowedSwap($52303048,GetFoodMaxLevel(DX),h)
endif
if DS[GetPlayerId(h)+1]>=7 and GetPlayerTechCount(h,$52303048,true)>=13 and not LoadBoolean(O,GetHandleId(Dd[GetPlayerId(h)+1]),66) then
set De=GetPlayerId(h)+1
if De>=1 and De<=4 then
set De=1
set Df=4
elseif De>=5 and De<=8 then
set De=5
set Df=8
endif
loop
call SaveBoolean(O,GetHandleId(Dd[De]),66,true)
call UnitRemoveAbility(Dd[De],$4130564D)
if Dg>=15 then
call AddUnitToStockBJ($68304F53,Dd[De],1,1)
else
call AddUnitToStockBJ($68304F54,Dd[De],0,0)
call SaveBoolean(O,GetHandleId(Dd[De]),55,true)
endif
exitwhen De>=Df
set De=De+1
endloop
endif
endfunction
