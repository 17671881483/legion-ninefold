call TriggerRegisterPlayerChatEvent(dr,Player(0),"",false)
call TriggerRegisterPlayerChatEvent(dr,Player(1),"",false)
call TriggerRegisterPlayerChatEvent(dr,Player(2),"",false)
call TriggerRegisterPlayerChatEvent(dr,Player(3),"",false)
