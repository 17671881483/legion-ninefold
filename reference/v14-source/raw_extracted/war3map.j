function YDWETimerSystem___NewTaskIndex takes nothing returns integer
local integer Ca=Cl
if Cl<0 then
if Cm>=8000 then
call BJDebugMsg("���ļ�ʱ��������������")
return 8100
else
set Cm=Cm+1
return Cm
endif
endif
set Cl=Cn[Ca]
return Ca
endfunction
function YDWETimerSystem___DeleteTaskIndex takes integer Cx returns nothing
set Cn[Cx]=Cl
set Cl=Cx
endfunction
function YDWETimerSystem___NewTask takes real DK,trigger QD returns integer
local integer Cx=YDWETimerSystem___NewTaskIndex()
local integer Ca=Cj
local integer t=R2I(100.*DK)+Ci
local integer h
set Cw[Cx]=QD
set Cv[Cx]=t
loop
set h=Ck[Ca]
if h<0 or Cv[h]>=t then
set Ck[Ca]=Cx
set Ck[Cx]=h
return Cx
endif
set Ca=h
endloop
return Cx
endfunction
function YDWETimerSystemNewTask takes real DK,trigger QD returns integer
return YDWETimerSystem___NewTask(DK,QD)
