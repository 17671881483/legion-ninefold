call VertigoTarget(Bc,Om,4)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdl",GetUnitX(Om),GetUnitY(Om)))
endif
