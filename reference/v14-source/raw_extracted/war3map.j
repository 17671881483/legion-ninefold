function TiemrEffect takes nothing returns nothing
local timer EP=GetExpiredTimer()
local integer Kd=GetHandleId(EP)
local integer BB=LoadInteger(K,10001,Kd)+6
local real D1=LoadReal(K,10001,Kd)+160
local real EK=LoadReal(K,10002,Kd)
local real EL=LoadReal(K,10003,Kd)
local string FM=LoadStr(K,10001,Kd)
local real EF=360/BB
local real CP=0
call SaveInteger(K,10001,Kd,BB)
call SaveReal(K,10001,Kd,D1)
set CP=1
loop
exitwhen CP>360
call DestroyEffect(AddSpecialEffect(FM,EK+D1*Cos(CP*bj_DEGTORAD),EL+D1*Sin(CP*bj_DEGTORAD)))
set CP=CP+EF
endloop
set BB=LoadInteger(K,10002,Kd)+1
call SaveInteger(K,10002,Kd,BB)
if BB>7 then
call PauseTimer(EP)
call RemoveSavedInteger(K,10001,Kd)
call RemoveSavedReal(K,10001,Kd)
call RemoveSavedString(K,10001,Kd)
call RemoveSavedInteger(K,10002,Kd)
call RemoveSavedReal(K,10002,Kd)
call RemoveSavedReal(K,10003,Kd)
call DestroyTimer(EP)
endif
set EP=null
endfunction
