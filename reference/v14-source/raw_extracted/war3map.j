function DisableEggUnitTypeDialog___LastPageAddButton takes nothing returns nothing
local integer w=BH/BI+1
call DialogAddButton(z[w],"取消",0)
endfunction
function DisableEggUnitTypeDialog___RegisterDialogEggUnitType takes integer BF,string BG,integer y returns nothing
local integer BB=0
local integer w=BH/BI+1
local button v
set BG=GetObjectName(BF)
set v=DialogAddButton(z[w],BG,0)
set BJ[BH]=v
call SaveInteger(O,GetHandleId(v),StringHash("type_id"),BF)
call TriggerRegisterDialogButtonEvent(u,v)
if BH==BI*w-1 then
set z[w+1]=DialogCreate()
call DialogSetMessage(z[w+1],"选择禁用的兵种类型")
set v=DialogAddButton(z[w],"下一页",0)
call SaveInteger(O,GetHandleId(v),StringHash("page"),w)
call TriggerRegisterDialogEvent(u,z[w+1])
call DialogAddButton(z[w],"取消",0)
endif
set BH=BH+1
loop
call SetPlayerTechMaxAllowedSwap(BF,y,Player(BB))
if BF==$68304A4D then
call SetPlayerTechMaxAllowedSwap($68304E50,y,Player(BB))
endif
exitwhen BB>=15
set BB=BB+1
endloop
set BG=null
set v=null
endfunction
function DisableEggUnitTypeDialog___DialogEggUnitTypeAction takes nothing returns nothing
local button v=GetClickedButton()
local player h=GetTriggerPlayer()
local integer BB=0
local integer w=LoadInteger(O,GetHandleId(v),StringHash("page"))
local integer x=LoadInteger(O,GetHandleId(v),StringHash("type_id"))
local integer y=LoadInteger(O,GetHandleId(h),StringHash("ban_count"))-1
if w>0 then
call DialogSetMessage(z[w+1],"选择禁用的兵种类型")
call DialogDisplay(h,z[w+1],true)
elseif x>0 then
call SaveInteger(O,GetHandleId(h),StringHash("ban_count"),y)
if y<=0 then
call SaveBoolean(O,GetHandleId(h),StringHash("ban"),true)
endif
call SaveBoolean(O,x,StringHash("ban"),true)
call DisplayTimedTextToPlayer(h,0,0,10,"禁用"+GetObjectName(x)+"成功,还剩"+I2S(y)+"次禁用")
loop
call SetPlayerTechMaxAllowedSwap(x,0,Player(BB))
if x==$68304A4D then
call SetPlayerTechMaxAllowedSwap($68304E50,0,Player(BB))
endif
exitwhen BB>=15
set BB=BB+1
endloop
call MultiboardDisplay(BC,true)
endif
set v=null
set h=null
endfunction
function DisableEggUnitTypeDialog___RegisterOtherInfomation takes nothing returns nothing
local integer BB=0
loop
call SetPlayerTechMaxAllowedSwap($68304E50,1,Player(BB))
exitwhen BB>=15
set BB=BB+1
endloop
endfunction
function DisableEggUnitTypeDialog___TimeDialogTimeOut takes nothing returns nothing
local timer t=GetExpiredTimer()
local timerdialog BK=LoadTimerDialogHandle(O,GetHandleId(t),0)
call SaveBoolean(O,GetHandleId(Player(0)),StringHash("ban_time_out"),true)
call SaveBoolean(O,GetHandleId(Player(4)),StringHash("ban_time_out"),true)
call TimerDialogDisplay(BK,false)
call DestroyTimerDialog(BK)
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTimer(t)
set t=null
set BK=null
endfunction
function DisableEggUnitTypeDialog___InitTimedDialog takes nothing returns nothing
local timer t=CreateTimer()
local timerdialog BK=CreateTimerDialog(t)
call SaveTimerDialogHandle(O,GetHandleId(t),0,BK)
call TimerDialogSetTitle(BK,"BAN倒计时")
call TimerStart(t,BL,false,function DisableEggUnitTypeDialog___TimeDialogTimeOut)
call TimerDialogSetRealTimeRemaining(BK,BL)
call TimerDialogDisplay(BK,true)
set t=null
set BK=null
endfunction
