function oldcodefn_Bb takes string Xv returns string
local integer QR=1
local integer Cd=StringLength(Xv)
local string Xw=""
loop
exitwhen QR>Cd
if SubString(Xv,QR,QR+1)!="0" or SubString(Xv,QR-1,QR)!="," then
if SubString(Xv,QR,QR+1)=="," then
set Xw=Xw+", "
else
set Xw=Xw+SubString(Xv,QR,QR+1)
endif
endif
set QR=QR+1
endloop
return Xw
endfunction
