call SetUnitAbilityLevel(Bc,$4131554B,GetUnitAbilityLevel(Pf,$4131554B))
endif
if GetUnitAbilityLevel(Pf,$4131554D)>0 then
call SetUnitAbilityLevel(Bc,$4131554D,GetUnitAbilityLevel(Pf,$4131554D))
endif
if GetUnitAbilityLevel(Pf,$4131554E)>0 then
call SetUnitAbilityLevel(Bc,$4131554E,GetUnitAbilityLevel(Pf,$4131554E))
endif
if GetUnitAbilityLevel(Pf,$4131554F)>0 then
call SetUnitAbilityLevel(Bc,$4131554F,GetUnitAbilityLevel(Pf,$4131554F))
endif
if GetUnitAbilityLevel(Pf,$41315659)>0 then
call ArthasHolyLight(Bc)
endif
if GetUnitAbilityLevel(Pf,$41305657)>0 then
if GetUnitTypeId(Bc)==$68305742 then
call YDWESetUnitAbilityDataString(Bc,$41305657,1,209,"LJQ_Aesara01_A.mdx")
else
call YDWESetUnitAbilityDataString(Bc,$41305657,1,209,"Abilities\\Weapons\\MoonPriestessMissile\\MoonPriestessMissile.mdl")
endif
endif
if GetUnitAbilityLevel(Pf,$41315045)>0 then
call UnitAddAbility(Bc,$41315045)
call UnitMakeAbilityPermanent(Bc,true,$41315045)
call YDWESetUnitAbilityDataReal(Bc,$41315045,1,108,I2R(LoadInteger(O,GetHandleId(Pf),$41315045)))
call SetUnitAbilityLevel(Bc,$41315045,2)
call SetUnitAbilityLevel(Bc,$41315045,1)
endif
set RJ=EachMonsterSkillTypeForHero(Pf)
if RJ>0 then
call UnitAddAbility(Bc,RJ)
call UnitMakeAbilityPermanent(Bc,true,RJ)
call ExecuteMonsterSkillInit(Bc,true)
endif
if GetUnitAbilityLevel(Pf,$41314346)>0 then
call SetUnitAbilityLevel(Bc,$41314346,GetUnitAbilityLevel(Pf,$41314346))
endif
set Bc=null
set Pf=null
endfunction
function PassiveSkillJJC takes unit Pf,unit Bc returns nothing
if GetUnitAbilityLevel(Bc,$4131554E)>0 then
call UnitRemoveAbility(Bc,$4131554E)
endif
set Bc=null
set Pf=null
endfunction
function PassiveSkillNoArg takes nothing returns nothing
local unit Bc=UT
local integer x=Bi
local unit Pf=bj_lastCreatedUnit
call PassiveSkill(Bc,x,Pf)
set Bc=null
set Pf=null
endfunction
function PassiveSkillNoArgJJC takes nothing returns nothing
local unit Bc=Kc
local integer x=Mk[Bi]
local unit Pf=Nr
call PassiveSkillJJC(Pf,Bc)
if Bc!=null and x>0 then
call UnitRemoveAbility(Bc,$4131374C)
call UnitRemoveAbility(Bc,$41315134)
call PassiveSkill(Bc,x,Pf)
endif
set Bc=null
set Pf=null
endfunction
function SetMallAbilityPage takes hashtable cG,unit Ki,integer w returns nothing
local integer cH=LoadInteger(cG,GetHandleId(Ki),StringHash("page"))
local integer BF
local integer BB=1
local integer cI=0
if cH>0 then
set cI=StringHash("page"+I2S(cH))
loop
set BF=LoadInteger(cG,cI,BB)
exitwhen BF==0
call UnitRemoveAbility(Ki,BF)
set BB=BB+1
endloop
endif
set BB=1
set cI=StringHash("page"+I2S(w))
loop
set BF=LoadInteger(cG,cI,BB)
exitwhen BF==0
call UnitAddAbility(Ki,BF)
set BB=BB+1
endloop
call SaveInteger(cG,GetHandleId(Ki),StringHash("page"),w)
set Ki=null
set cG=null
endfunction
function MallAbilityGetMaxPage takes hashtable cG,string cJ returns integer
local integer N5=0
local integer cL=StringHash(cJ)
loop
if LoadBoolean(cG,cL,N5+1) then
set N5=N5+1
else
exitwhen true
endif
endloop
set cG=null
set cJ=null
return N5
endfunction
function ChangeMallAbilityPage takes hashtable cG,string cJ,unit Ki,integer cK returns integer
local integer cH=LoadInteger(cG,GetHandleId(Ki),StringHash("page"))
local integer cM=0
local integer cL=StringHash(cJ)
if LoadBoolean(cG,cL,cH+cK) then
set cM=cH+cK
elseif cK>0 then
set cM=1
else
set cM=MallAbilityGetMaxPage(cG,cJ)
endif
call SetMallAbilityPage(cG,Ki,cM)
set Ki=null
set cG=null
set cJ=null
return cM
endfunction
function RegisterMallAbilityPage takes hashtable cG,string cJ,integer w,integer BF,string QM returns nothing
local integer BB=1
local integer cI=StringHash("page"+I2S(w))
call SaveStr(cG,BF,StringHash("file"),QM)
call SaveBoolean(cG,StringHash(cJ),w,true)
loop
if LoadInteger(cG,cI,BB)==0 then
call SaveInteger(cG,cI,BB,BF)
exitwhen true
endif
set BB=BB+1
endloop
set cG=null
set cJ=null
set QM=null
endfunction
