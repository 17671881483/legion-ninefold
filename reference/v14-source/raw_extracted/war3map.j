function YDWEGeneralBounsSystem__UnitClearBonus takes unit i,integer Dj returns nothing
local integer BB=CM[Dj+1]-1
loop
exitwhen BB<CM[Dj]
call UnitRemoveAbility(i,CQ[BB])
set BB=BB-1
endloop
call YDWESaveIntegerByString(I2S(YDWEH2I(i)),"bonusType"+I2S(Dj),0)
endfunction
function YDWEGeneralBounsSystem__SetUnitMaxState takes unit i,integer Dj,real Dm returns boolean
local integer Do=R2I(Dm)
local integer Dp=0
local unitstate Dn
local integer BB=CM[Dj+1]-2
if Dm>65535 or Dm<=0 then
call BJDebugMsg("输入数据无效")
return false
endif
if Dj==0 then
set Dn=UNIT_STATE_MAX_LIFE
elseif Dj==1 then
set Dn=UNIT_STATE_MAX_MANA
else
call BJDebugMsg("无效状态")
return false
endif
set Do=Do-R2I(GetUnitState(i,Dn))
call YDWESaveIntegerByString(I2S(YDWEH2I(i)),"bonusType"+I2S(Dj),Do+YDWEGetIntegerByString(I2S(YDWEH2I(i)),"bonusType"+I2S(Dj)))
if Do>0 then
set Dp=3
elseif Do<0 then
set Dp=2
set Do=-Do
else
return false
endif
loop
exitwhen BB<CM[Dj]
if Do>=CR[BB] then
call UnitAddAbility(i,CQ[BB])
call SetUnitAbilityLevel(i,CQ[BB],Dp)
call UnitRemoveAbility(i,CQ[BB])
set Do=Do-CR[BB]
endif
set BB=BB-1
endloop
return true
endfunction
function YDWEGeneralBounsSystem__UnitSetBonus takes unit i,integer Dj,integer Dl returns boolean
local integer BB
if Dl==0 then
call YDWEGeneralBounsSystem__UnitClearBonus(i,Dj)
return false
endif
if Dl<CV[Dj] or Dl>CU[Dj] then
call BJDebugMsg("BonusSystem Error: Bonus too high or low ("+I2S(Dl)+")")
return false
elseif Dj<0 or Dj>=Dq then
call BJDebugMsg("BonusSystem Error: Invalid bonus type ("+I2S(Dj)+")")
return false
endif
call YDWESaveIntegerByString(I2S(YDWEH2I(i)),"bonusType"+I2S(Dj),Dl)
if Dl<0 then
set Dl=CU[Dj]+Dl+1
call UnitAddAbility(i,CQ[CM[Dj+1]-1])
call UnitMakeAbilityPermanent(i,true,CQ[CM[Dj+1]-1])
else
call UnitRemoveAbility(i,CQ[CM[Dj+1]-1])
endif
set BB=CM[Dj+1]-2
loop
exitwhen BB<CM[Dj]
if Dl>=CR[BB] then
call UnitAddAbility(i,CQ[BB])
call UnitMakeAbilityPermanent(i,true,CQ[BB])
set Dl=Dl-CR[BB]
else
call UnitRemoveAbility(i,CQ[BB])
endif
set BB=BB-1
endloop
if not YDWEGetBooleanByString(I2S(YDWEH2I(i)),"bonusMark") then
call YDWESaveBooleanByString(I2S(YDWEH2I(i)),"bonusMark",true)
set CY=CY+1
set CZ[CY]=i
endif
return true
endfunction
function YDWEGeneralBounsSystem__UnitGetBonus takes unit i,integer Dj returns integer
return YDWEGetIntegerByString(I2S(YDWEH2I(i)),"bonusType"+I2S(Dj))
endfunction
function YDWEGeneralBounsSystem__AddUnitMaxState takes unit i,integer Dj,real Dm returns boolean
local unitstate Dn
if Dj==0 then
set Dn=UNIT_STATE_MAX_LIFE
elseif Dj==1 then
set Dn=UNIT_STATE_MAX_MANA
else
return false
endif
return YDWEGeneralBounsSystem__SetUnitMaxState(i,Dj,Dm+GetUnitState(i,Dn))
endfunction
function YDWEGeneralBounsSystem__UnitAddBonus takes unit i,integer Dj,integer Dl returns boolean
return YDWEGeneralBounsSystem__UnitSetBonus(i,Dj,YDWEGeneralBounsSystem__UnitGetBonus(i,Dj)+Dl)
endfunction
function YDWEGeneralBounsSystem__FlushUnits takes nothing returns nothing
local integer BB=CY
local string Ca
loop
exitwhen BB<1
if GetUnitTypeId(CZ[BB])==0 then
set Ca=I2S(YDWEH2I(CZ[BB]))
call YDWESaveIntegerByString(Ca,"bonusType0",0)
call YDWESaveIntegerByString(Ca,"bonusType1",0)
call YDWESaveIntegerByString(Ca,"bonusType2",0)
call YDWESaveIntegerByString(Ca,"bonusType3",0)
call YDWESaveBooleanByString(Ca,"bonusMark",false)
set CZ[BB]=CZ[CY]
set CZ[CY]=null
set CY=CY-1
endif
set BB=BB-1
endloop
endfunction
function YDWEUnitSetBonus takes unit i,integer Dj,integer Dl returns nothing
if Dj==0 or Dj==1 then
call YDWEGeneralBounsSystem__SetUnitMaxState(i,Dj,Dl)
else
call YDWEGeneralBounsSystem__UnitSetBonus(i,Dj,Dl)
endif
endfunction
function YDWEUnitAddBonus takes unit i,integer Dj,integer Dl returns nothing
if Dj==0 or Dj==1 then
call YDWEGeneralBounsSystem__AddUnitMaxState(i,Dj,Dl)
else
call YDWEGeneralBounsSystem__UnitAddBonus(i,Dj,Dl)
endif
endfunction
function YDWEGeneralBounsSystemUnitSetBonus takes unit i,integer Dj,integer Dk,integer Dl returns nothing
if Dk==0 then
call YDWEUnitAddBonus(i,Dj,Dl)
elseif Dk==1 then
call YDWEUnitAddBonus(i,Dj,0-Dl)
else
call YDWEUnitSetBonus(i,Dj,Dl)
endif
endfunction
function YDWEGeneralBounsSystemUnitGetBonus takes unit i,integer Dj returns integer
return YDWEGetIntegerByString(I2S(YDWEH2I(i)),"bonusType"+I2S(Dj))
endfunction
function YDWEGeneralBounsSystem__InitializeAbilitys takes nothing returns nothing
local integer BB=0
local integer CP=0
set CM[0]=0
set CM[1]=15
set CM[2]=30
set CM[3]=43
set CM[4]=67
set CN[0]=15
set CN[1]=15
set CN[2]=13
set CN[3]=24
loop
exitwhen BB>9
set CO[BB]=48+CP
set CP=CP+1
set BB=BB+1
endloop
set CP=0
loop
exitwhen BB>26
set CO[BB]=97+CP
set CP=CP+1
set BB=BB+1
endloop
set BB=0
set CP=0
loop
exitwhen CP>CN[0]-1
set CQ[BB]=$59446C30-48+CO[CP]
set BB=BB+1
set CP=CP+1
endloop
set CP=0
loop
exitwhen CP>CN[1]-1
set CQ[BB]=$59446D30-48+CO[CP]
set BB=BB+1
set CP=CP+1
endloop
set CP=0
loop
exitwhen CP>CN[2]-1
set CQ[BB]=$59446330-48+CO[CP]
set BB=BB+1
set CP=CP+1
endloop
set CP=0
loop
exitwhen CP>CN[3]-1
set CQ[BB]=$59446230-48+CO[CP]
set BB=BB+1
set CP=CP+1
endloop
endfunction
function YDWEGeneralBounsSystem__Initialize takes nothing returns nothing
local integer BB=1
local unit i
local integer CT=0
local integer CS=0
call YDWEGeneralBounsSystem__InitializeAbilitys()
loop
set BB=1
set CR[CS]=1
loop
set CR[CS+1]=CR[CS]*2
set CS=CS+1
set BB=BB+1
exitwhen BB==CN[CT]
endloop
set CU[CT]=CR[CS]-1
set CV[CT]=-CR[CS]
set CS=CS+1
set CT=CT+1
exitwhen CT>=4
endloop
if CW then
set i=CreateUnit(Player(15),CX,0,0,0)
set BB=0
loop
exitwhen BB==CM[5]
call UnitAddAbility(i,CQ[BB])
set BB=BB+1
endloop
call RemoveUnit(i)
set i=null
endif
call TimerStart(CreateTimer(),10,true,function YDWEGeneralBounsSystem__FlushUnits)
endfunction
function YDWELifeChange takes unit i,integer Dk,integer ey,integer BF returns nothing
local integer QR
local integer Cd
local integer IT
local integer EF
local integer ex=BF
if Dk==1 then
set ey=-ey
elseif Dk==2 then
set ey=ey-R2I(GetUnitState(i,UNIT_STATE_MAX_LIFE))
endif
if ey>99999 then
set ey=99999
endif
if ey<-99999 then
set ey=-99999
endif
if ey<0 then
set QR=2
set ey=-ey
else
set QR=7
endif
set Cd=0
loop
exitwhen Cd==5
set IT=ey-ey/10*10
set EF=0
loop
exitwhen EF==IT
call UnitAddAbility(i,ex)
call SetUnitAbilityLevel(i,ex,QR)
call UnitRemoveAbility(i,ex)
set EF=EF+1
endloop
set ey=ey/10
set QR=QR+1
set Cd=Cd+1
endloop
endfunction
function YDWEManaChange takes unit i,integer Dk,integer ey,integer BF returns nothing
local integer QR
local integer Cd
local integer IT
local integer EF
local integer ex=BF
if Dk==1 then
set ey=-ey
elseif Dk==2 then
set ey=ey-R2I(GetUnitState(i,UNIT_STATE_MAX_MANA))
endif
if ey>99999 then
set ey=99999
endif
if ey<-99999 then
set ey=-99999
endif
if ey<0 then
set QR=2
set ey=-ey
else
set QR=7
endif
set Cd=0
loop
exitwhen Cd==5
set IT=ey-ey/10*10
set EF=0
loop
exitwhen EF==IT
call UnitAddAbility(i,ex)
call SetUnitAbilityLevel(i,ex,QR)
call UnitRemoveAbility(i,ex)
set EF=EF+1
endloop
set ey=ey/10
set QR=QR+1
set Cd=Cd+1
endloop
endfunction
function YDWEGetItemOfTypeFromUnitBJNull takes unit Kn,integer YB returns item
