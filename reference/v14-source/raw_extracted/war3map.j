function GroupCheckDeathEnum takes nothing returns nothing
local unit i=GetEnumUnit()
if IsUnitType(i,UNIT_TYPE_DEAD) or IsUnitDeadBJ(i) then
call GroupRemoveUnit(QF,i)
endif
set i=null
endfunction
function GroupCheckDeath takes group DG returns nothing
set QF=DG
call ForGroup(DG,function GroupCheckDeathEnum)
set DG=null
endfunction
function BuildingLimitRemoveGroupForUnit takes unit i,integer x,player h returns nothing
local group DG=LoadGroupHandle(X,x,GetHandleId(h))
local integer y
local integer U1
local integer Uy
local integer U0
local group Uz
if DG==null then
set i=null
set h=null
return
endif
call GroupRemoveUnit(DG,i)
call GroupCheckDeath(DG)
set Uy=LoadInteger(O,x,StringHash("count"))
if CountUnitsInGroup(DG)<Uy then
if LoadInteger(O,x,StringHash("limitid"))==0 then
set Uz=YDWEGetUnitsOfPlayerAndTypeIdNull(h,x)
call GroupRemoveUnit(Uz,i)
set U0=CountUnitsInGroup(Uz)
set U1=CountUnitsInGroup(DG)-U0
set y=Uy-U1
call DestroyGroup(Uz)
call SetPlayerTechMaxAllowedSwap(x,y,h)
set Uz=null
elseif LoadUnitHandle(X,GetHandleId(h),x)==null then
call SaveAgentHandle(X,GetHandleId(h),x,CreateUnit(h,LoadInteger(O,x,StringHash("limitid")),-4500.,8000.,bj_UNIT_FACING))
endif
endif
set DG=null
set Uz=null
set i=null
set h=null
endfunction
function IsUnitTypePlayerBuilding takes integer BF,player h returns boolean
local integer BB=1
loop
if LoadInteger(O,GetHandleId(h),StringHash("building_type")+BB)==BF then
set h=null
return true
endif
exitwhen BB>=6
set BB=BB+1
endloop
set h=null
return false
endfunction
function SellHook takes unit i,player h,integer BF returns boolean
if LoadBoolean(O,GetHandleId(i),StringHash("limitid_ex")) then
call BuildingLimitRemoveGroupForUnit(i,BF,h)
set i=null
set h=null
return true
elseif LoadInteger(O,GetHandleId(i),StringHash("base_id"))>0 then
call BuildingLimitRemoveGroupForUnit(i,LoadInteger(O,GetHandleId(i),StringHash("base_id")),h)
set i=null
set h=null
return true
endif
set i=null
set h=null
return false
endfunction
function Hero_Skin takes player h,integer BF,unit Kh returns unit
local integer BB=GetPlayerId(h)+1
local integer FL=GetUnitAbilityLevel(EG[BB],$41305654)
local unit Ki=CreateUnit(GetOwningPlayer(EG[BB]),BF,GetUnitX(EG[BB]),GetUnitY(EG[BB]),bj_UNIT_STATE_METHOD_MAXIMUM)
local real D1=YDWEGetUnitAbilityState(EG[BB],$4130595A,1)
local real Kj=YDWEGetUnitAbilityState(EG[BB],$41303530,1)
if GetUnitAbilityLevel(EG[BB],$41313337)>0 then
call UnitAddAbility(Ki,$41313337)
call UnitMakeAbilityPermanent(Ki,true,$41313337)
endif
if GetUnitAbilityLevel(EG[BB],$4131335A)>0 then
call UnitAddAbility(Ki,$4131335A)
call UnitMakeAbilityPermanent(Ki,true,$4131335A)
endif
call RemoveUnit(EG[BB])
if LoadBoolean(O,80801,22) then
call UnitRemoveAbility(Ki,$4130564F)
endif
call DestroyEffect(LoadEffectHandle(O,GetPlayerId(GetOwningPlayer(Kh)),100867))
call SelectUnitForPlayerSingle(Ki,GetOwningPlayer(EG[BB]))
set EG[BB]=Ki
call SaveEffectHandle(O,GetPlayerId(GetOwningPlayer(Kh)),100867,AddSpecialEffectTarget(LoadStr(O,GetPlayerId(GetOwningPlayer(Kh)),100867),EG[BB],"overhead"))
call SaveEffectHandle(O,GetPlayerId(GetOwningPlayer(Kh)),100868,AddSpecialEffectTarget(LoadStr(O,GetPlayerId(GetOwningPlayer(Kh)),100868),EG[BB],"chest"))
call SaveEffectHandle(O,GetPlayerId(GetOwningPlayer(Kh)),100869,AddSpecialEffectTarget(LoadStr(O,GetPlayerId(GetOwningPlayer(Kh)),100869),EG[BB],"origin"))
call SuspendHeroXP(EG[BB],true)
call SetHeroStr(EG[BB],0,true)
call SetHeroAgi(EG[BB],0,true)
call SetHeroInt(EG[BB],0,true)
if LoadInteger(O,GetPlayerId(GetOwningPlayer(EG[BB])),707)!=1 then
call UnitAddAbility(EG[BB],$41303834)
endif
if H3[BB]==false then
call UnitAddAbility(Ki,$41303834)
endif
if FL!=0 then
call UnitAddAbility(Ki,$41305654)
if FL==2 then
call SetUnitAbilityLevel(Ki,$41305654,2)
endif
endif
call TriggerExecute(Kk)
call SetPlayerAbilityAvailable(GetOwningPlayer(Kh),$41305537,false)
if BF==$55413135 or BF==$55413331 then
call SetPlayerAbilityAvailable(h,$41305537,true)
endif
if BF==$55413230 or BF==$55413135 or BF==$55413331 or BF==$55413335 then
call SetPlayerAbilityAvailable(GetOwningPlayer(Kh),$41305537,true)
if BF==$55413230 and GetOwningPlayer(Kh)==GetLocalPlayer() then
call YDWESetUnitAbilityDataString(Kh,$41305537,1,204,"replaceabletextures\\commandbuttons\\BTNb145")
elseif BF==$55413135 and GetOwningPlayer(Kh)==GetLocalPlayer() then
call YDWESetUnitAbilityDataString(Kh,$41305537,1,204,"replaceabletextures\\commandbuttons\\BTNb146")
elseif BF==$55413335 and GetOwningPlayer(Kh)==GetLocalPlayer() then
call YDWESetUnitAbilityDataString(Kh,$41305537,1,204,"replaceabletextures\\commandbuttons\\BTNbb8")
endif
endif
call YDWESetUnitAbilityState(Ki,$4130595A,1,D1)
call YDWESetUnitAbilityState(Ki,$41303530,1,Kj)
call IssueTargetOrder(LoadUnitHandle(O,BB,StringHash("pet")),"move",EG[BB])
set BB=GetPlayerId(GetOwningPlayer(Ki))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Charm\\CharmTarget.mdl",FH[BB],FI[BB]))
call SetUnitPosition(Ki,FH[BB],FI[BB])
if GetLocalPlayer()==GetOwningPlayer(Ki) then
call PanCameraToTimed(FH[BB],FI[BB],0)
endif
set h=null
set Kh=null
return Ki
endfunction
function Wings_Skin takes player h,string Kv,unit Kh returns nothing
local integer BB=GetPlayerId(h)+1
set Kh=EG[GetConvertedPlayerId(h)]
call DestroyEffect(LoadEffectHandle(O,GetPlayerId(GetOwningPlayer(Kh)),100868))
call SaveStr(O,GetPlayerId(GetOwningPlayer(Kh)),100868,Kv)
call SaveEffectHandle(O,GetPlayerId(GetOwningPlayer(Kh)),100868,AddSpecialEffectTarget(LoadStr(O,GetPlayerId(GetOwningPlayer(Kh)),100868),EG[BB],"chest"))
call DestroyEffect(EV[BB])
call SelectUnitForPlayerSingle(EG[BB],GetOwningPlayer(EG[BB]))
set EV[BB]=null
set h=null
set Kh=null
endfunction
function Aura_Skin takes player h,string Kv,unit Kh returns nothing
local integer BB=GetPlayerId(h)+1
set Kh=EG[GetConvertedPlayerId(h)]
if GetSpellAbilityId()>0 then
call YDWERPGSetKey(h,"last_aura_ability_id",GetSpellAbilityId())
endif
call DestroyEffect(LoadEffectHandle(O,GetPlayerId(GetOwningPlayer(Kh)),100869))
call SaveStr(O,GetPlayerId(GetOwningPlayer(Kh)),100869,Kv)
call SaveEffectHandle(O,GetPlayerId(GetOwningPlayer(Kh)),100869,AddSpecialEffectTarget(LoadStr(O,GetPlayerId(GetOwningPlayer(Kh)),100869),EG[BB],"origin"))
call DestroyEffect(EY[BB])
set EY[BB]=null
set h=null
set Kh=null
endfunction
function T_effect takes unit i,string Kv returns nothing
local integer BB=GetPlayerId(GetTriggerPlayer())+1
if GetSpellAbilityId()>0 then
call YDWERPGSetKey(GetOwningPlayer(i),"last_t_eff_ability_id",GetSpellAbilityId())
endif
call DestroyEffect(LoadEffectHandle(O,GetPlayerId(GetOwningPlayer(i)),100870))
call SaveStr(O,GetPlayerId(GetOwningPlayer(i)),100870,Kv)
call DestroyEffect(AddSpecialEffect(Kv,GetUnitX(EG[BB]),GetUnitY(EG[BB])))
set i=null
endfunction
function Group_cen takes code VE,integer BF returns nothing
call GroupEnumUnitsOfType(E,UnitId2String(BF),null)
call ForGroup(E,VE)
call GroupClear(E)
endfunction
function surface_xb takes integer BB,integer TR returns boolean
if (LoadReal(Q,8889,BB)+I2R(TR*32)<-5590 and LoadReal(Q,8889,BB)+I2R(TR*32)>-5700) or (LoadReal(Q,8889,BB)+I2R(TR*32)<-1354 and LoadReal(Q,8889,BB)+I2R(TR*32)>-1500) or (LoadReal(Q,8889,BB)+I2R(TR*32)<1449 and LoadReal(Q,8889,BB)+I2R(TR*32)>1349) or (LoadReal(Q,8889,BB)+I2R(TR*32)>5578 and LoadReal(Q,8889,BB)+I2R(TR*32)<5698) then
return true
endif
return false
endfunction
function surface_yb takes integer TR returns boolean
if (2399+I2R(TR*32)>=2399 and 2399+I2R(TR*32)<=2500) or (2399+I2R(TR*32)>=3144 and 2399+I2R(TR*32)<=3527) then
return true
endif
return false
endfunction
function surface takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer TQ=GetHandleId(t)
local integer BB=LoadInteger(O,TQ,10)
local integer TR=LoadInteger(O,TQ,11)
if LoadInteger(O,TQ,1)==4 then
call SetTerrainType(-5696,2399,$4974626B,-1,1,1)
call SetTerrainType(-5696,3232,$4974626B,-1,1,1)
call SetTerrainType(-1354,2399,$4974626B,-1,1,1)
call SetTerrainType(-1354,3232,$4974626B,-1,1,1)
call SetTerrainType(1349,3232,$59626C6D,-1,1,1)
call SetTerrainType(1349,2399,$59626C6D,-1,1,1)
call SetTerrainType(5678,3232,$59626C6D,-1,1,1)
call SetTerrainType(5678,2399,$59626C6D,-1,1,1)
call SetTerrainType(-5696,2399,$4974626B,-1,1,1)
call DestroyTimer(t)
endif
if BB<=39 then
if LoadInteger(O,TQ,1)<2 then
call SetTerrainType(LoadReal(Q,8889,LoadInteger(O,TQ,1))+I2R(BB*30),2399+I2R(TR*32),$59626C6D,-1,1,1)
else
call SetTerrainType(LoadReal(Q,8889,LoadInteger(O,TQ,1))+I2R(BB*30),2399+I2R(TR*32),$4974626B,-1,1,1)
endif
if surface_xb(LoadInteger(O,TQ,1),BB) and surface_yb(TR) then
else
call SetTerrainPathable(LoadReal(Q,8889,LoadInteger(O,TQ,1))+I2R(BB*32),2399+I2R(TR*32),PATHING_TYPE_BUILDABILITY,false)
endif
call SaveInteger(O,TQ,10,LoadInteger(O,TQ,10)+1)
set BB=LoadInteger(O,TQ,10)
endif
if BB>=39 then
call SaveInteger(O,TQ,11,LoadInteger(O,TQ,11)+1)
call SaveInteger(O,TQ,10,0)
set TR=LoadInteger(O,TQ,11)
endif
if (TR>=28 and LoadInteger(O,TQ,1)==0) or (TR>=28 and LoadInteger(O,TQ,1)==1) or (TR>=28 and LoadInteger(O,TQ,1)==2) or (TR>=28 and LoadInteger(O,TQ,1)==3) or (TR>=28 and LoadInteger(O,TQ,1)==4) then
call SaveInteger(O,TQ,11,0)
call SaveInteger(O,TQ,1,LoadInteger(O,TQ,1)+1)
endif
set t=null
endfunction
