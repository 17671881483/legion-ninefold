function InitSurrendConditionTimer takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer BQ=H2I(t)
local timerdialog EF=LoadTimerDialogHandle(O,BQ,StringHash("dialog"))
local player h=LoadPlayerHandle(O,BQ,StringHash("player"))
local player D6=null
local integer BB=0
loop
set D6=Player(BB)
if IsPlayerAlly(h,D6) then
call DisplayTimedTextToPlayer(D6,0,0,10,YDWETranslate("|cFFFF33CC我方投票表决未通过!"))
call SaveBoolean(O,H2I(D6),StringHash("surrenderstate"),false)
endif
exitwhen BB==7
set BB=BB+1
endloop
if h!=null then
call RemoveSavedHandle(O,H2I(h),StringHash("surrendertimer"))
endif
if EF!=null then
call DestroyTimerDialog(EF)
endif
call FlushChildHashtable(O,BQ)
call DestroyTimer(t)
set D6=null
set t=null
set EF=null
set h=null
endfunction
function SurrendStartVote takes player dS,player dT,string dU returns nothing
local timer t=LoadTimerHandle(O,H2I(dT),StringHash("surrendertimer"))
local timerdialog EF=null
if t==null then
set t=CreateTimer()
if IsPlayerAlly(GetLocalPlayer(),dS) then
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,10,YDWETranslate("|cFFFF33CC我方玩家发起投降投票，如果同意请输入/TX或者-gg,如果不同意可不输入.己方阵营投票全部通过此局结束."))
endif
call TimerStart(t,30,false,function InitSurrendConditionTimer)
set EF=CreateTimerDialogBJ(t,YDWETranslate(dU))
call SaveTimerHandle(O,H2I(dT),StringHash("surrendertimer"),t)
call SaveTimerDialogHandle(O,H2I(t),StringHash("dialog"),EF)
call SavePlayerHandle(O,H2I(t),StringHash("player"),dT)
else
set EF=LoadTimerDialogHandle(O,H2I(t),StringHash("dialog"))
endif
call TimerDialogDisplayForPlayerBJ(IsPlayerAlly(GetLocalPlayer(),dS),EF,GetLocalPlayer())
call SaveBoolean(O,H2I(dS),StringHash("surrenderstate"),true)
call CheckSurrender(dS,t,EF)
set EF=null
set t=null
set dT=null
set dS=null
set dU=null
endfunction
function InitSurrendCondition takes nothing returns boolean
local player h=GetTriggerPlayer()
local boolean dR=LoadBoolean(O,H2I(h),StringHash("surrenderstate"))
if Dg>=10 then
if not dR then
if IsPlayerAlly(h,Player(0)) then
call SurrendStartVote(h,Player(0),"西方军团投票表决倒计时")
elseif IsPlayerAlly(h,Player(4)) then
call SurrendStartVote(h,Player(4),"东方军团投票表决倒计时")
endif
else
call DisplayTimedTextToPlayer(h,0,0,10,YDWETranslate("|cFFFF33CC你已经同意了投降"))
endif
else
call DisplayTimedTextToPlayer(h,0,0,10,YDWETranslate("|cFFFF33CC第⑩波以后怪物才可以使用该指令!"))
endif
set h=null
return false
endfunction
function InitTrig_surrend takes nothing returns nothing
local trigger t=CreateTrigger()
local integer BB=0
loop
call TriggerRegisterPlayerChatEvent(t,Player(BB),"-gg",true)
call TriggerRegisterPlayerChatEvent(t,Player(BB),"/tx",true)
set BB=BB+1
exitwhen BB>=8
endloop
call TriggerAddCondition(t,Condition(function InitSurrendCondition))
set t=null
endfunction
function Trig_showHelpModFunc001A takes nothing returns nothing
local destructable EF=GetEnumDestructable()
local player h=GetTriggerPlayer()
local boolean KH=LoadBoolean(O,GetHandleId(h),StringHash("showHelpMod"))
if GetDestructableTypeId(EF)==$58546D70 and GetLocalPlayer()==h then
call ShowDestructable(EF,KH)
endif
set EF=null
set h=null
endfunction
function Trig_showHelpModActions takes nothing returns nothing
local string Nc=GetEventPlayerChatString()
local player h=GetTriggerPlayer()
local rect gS=GetPlayerRect(h)
local boolean gT=Nc=="-show"
if gS==null then
set Nc=null
set h=null
return
endif
if gT or Nc=="-off" then
call SaveBoolean(O,GetHandleId(h),StringHash("showHelpMod"),gT)
call EnumDestructablesInRectAll(gS,function Trig_showHelpModFunc001A)
endif
set Nc=null
set h=null
set gS=null
endfunction
function ShowHelpModEnum takes nothing returns nothing
local destructable EF=GetEnumDestructable()
if GetDestructableTypeId(EF)==$58546D70 then
call ShowDestructable(EF,false)
endif
set EF=null
endfunction
function InitTrig_showHelpMod takes nothing returns nothing
endfunction
function BuildingLimitInitWorld takes nothing returns nothing
local group DG=YDWEGetUnitsInRectAllNull(GetWorldBounds())
local unit D6
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
if GetUnitAbilityLevel(D6,$41314254)>0 and GetPlayerTechCountSimple($52304330,GetOwningPlayer(D6))==0 then
call UnitRemoveAbility(D6,$41314254)
call UnitAddAbility(D6,$41314256)
call UnitMakeAbilityPermanent(D6,true,$41314256)
endif
endloop
call DestroyGroup(DG)
call DestroyTimer(GetExpiredTimer())
set DG=null
endfunction
function h0OJ_ClearTargetIfFar takes trigger RL,unit i returns nothing
local unit Om=LoadUnitHandle(O,GetHandleId(RL),2)
if Om!=null and not IsUnitInRange(i,Om,600) then
call SaveUnitHandle(O,GetHandleId(RL),2,null)
call SaveBoolean(O,GetHandleId(RL),3,false)
endif
set Om=null
set RL=null
set i=null
endfunction
function h0OJ_SelectAttackTarget takes unit i returns unit
local group Uz=CreateGroup()
local unit D6
local unit Om=null
call GroupEnumUnitsInRange(Uz,GetUnitX(i),GetUnitY(i),700,null)
loop
set D6=FirstOfGroup(Uz)
exitwhen D6==null
call GroupRemoveUnit(Uz,D6)
if IsUnitEnemy(D6,GetOwningPlayer(i)) and GetUnitState(D6,UNIT_STATE_LIFE)>1 then
if Om==null or GetUnitState(D6,ConvertUnitState(21))>=GetUnitState(Om,ConvertUnitState(21)) then
set Om=D6
endif
endif
set D6=null
endloop
call DestroyGroup(Uz)
set Uz=null
set i=null
return Om
endfunction
function h0OJ_Action takes nothing returns boolean
local trigger RL=GetTriggeringTrigger()
local unit i=LoadUnitHandle(O,GetHandleId(RL),1)
local unit cB=null
if GetTriggerEventId()==EVENT_GAME_TIMER_EXPIRED then
call SaveInteger(O,GetHandleId(RL),100,LoadInteger(O,GetHandleId(RL),100)+1)
if LoadInteger(O,GetHandleId(RL),100)==7 then
call RemoveUnit(i)
call FlushChildHashtable(O,GetHandleId(i))
call FlushChildHashtable(O,GetHandleId(RL))
call DestroyTrigger(RL)
set RL=null
set i=null
return false
endif
call h0OJ_ClearTargetIfFar(RL,i)
if not LoadBoolean(O,GetHandleId(RL),3) then
set cB=h0OJ_SelectAttackTarget(i)
if cB!=null then
call IssueTargetOrder(i,"attack",cB)
call SaveUnitHandle(O,GetHandleId(RL),2,cB)
call SaveBoolean(O,GetHandleId(RL),3,true)
endif
set cB=null
endif
endif
if GetTriggerEventId()==EVENT_PLAYER_UNIT_DEATH then
if GetTriggerUnit()==LoadUnitHandle(O,GetHandleId(RL),2) then
call SaveBoolean(O,GetHandleId(RL),3,false)
endif
endif
set RL=null
set i=null
return false
endfunction
function BartizanLife takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit i=LoadUnitHandle(O,GetHandleId(t),0)
local real DK=LoadReal(O,GetHandleId(t),1)-1
call UnitApplyTimedLife(i,$42544C46,DK)
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
set t=null
set i=null
endfunction
function BartizanAttackAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit i=LoadUnitHandle(O,GetHandleId(t),0)
local unit Om=GetTriggerUnit()
local group DG
local unit D6
local unit dh=null
if GetTriggerEventId()==EVENT_WIDGET_DEATH then
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
elseif GetAttacker()==i then
set DG=SelectRange(i,GetUnitX(i),GetUnitY(i),GetUnitState(i,ConvertUnitState(22)))
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
if dh==null or GetUnitState(D6,ConvertUnitState(18))>GetUnitState(dh,ConvertUnitState(18)) then
set dh=D6
endif
if dh!=D6 then
call DisableTrigger(t)
call IssueTargetOrder(i,"attack",Om)
call EnableTrigger(t)
endif
endloop
call DestroyGroup(DG)
endif
set t=null
set i=null
set Om=null
set DG=null
set dh=null
endfunction
function Trig_MallAllabilityActions2 takes nothing returns nothing
local integer BF=GetSpellAbilityId()
local player h=GetTriggerPlayer()
local unit i=GetTriggerUnit()
local real FF=GetSpellTargetX()
local real FG=GetSpellTargetY()
local unit Qf=GetSpellTargetUnit()
local timer t
local unit Ki
if BF==$41305537 and not LoadBoolean(O,GetHandleId(i),StringHash("alte")) then
call AddUnitAnimationProperties(i,"alternate",true)
call SaveBoolean(O,GetHandleId(i),StringHash("alte"),true)
elseif BF==$41305537 and LoadBoolean(O,GetHandleId(i),StringHash("alte")) then
call AddUnitAnimationProperties(i,"alternate",false)
call SaveBoolean(O,GetHandleId(i),StringHash("alte"),false)
elseif BF==$41305543 then
set Ki=CreateUnit(h,Pn,FF,FG,270)
call UnitApplyTimedLife(Ki,$42487765,8)
call UnitAddAbility(Ki,$4131384A)
call UnitRemoveAbility(i,$41305543)
call UnitAddAbility(i,$4130554C)
elseif BF==$41305650 or BF==$41305651 or BF==$41305652 or BF==$41305653 then
call SetPlayerAbilityAvailable(GetOwningPlayer(GetTriggerUnit()),$4130564F,false)
if BF==$41305650 then
if GetUnitAbilityLevel(i,$41305654)==0 then
call UnitAddAbility(i,$41305654)
else
call SetUnitAbilityLevel(i,$41305654,2)
endif
call SaveReal(O,GetPlayerId(GetOwningPlayer(i)),StringHash("甲"),LoadReal(O,GetPlayerId(GetOwningPlayer(i)),StringHash("甲"))+1)
elseif BF==$41305651 then
call AdjustPlayerStateBJ(150,GetOwningPlayer(i),PLAYER_STATE_RESOURCE_GOLD)
elseif BF==$41305652 then
call AdjustPlayerStateBJ(300,GetOwningPlayer(i),PLAYER_STATE_RESOURCE_LUMBER)
elseif BF==$41305653 then
set E4[1+GetPlayerId(GetTriggerPlayer())]=E4[1+GetPlayerId(GetTriggerPlayer())]+20
call TriggerExecute(Lh)
endif
elseif BF==$41305547 then
endif
set t=null
set Qf=null
set h=null
set i=null
set Ki=null
endfunction
