call PauseUnit(i,false)
call DestroyGroup(b1)
call SaveInteger(O,GetHandleId(t),100,0)
call DestroyEffect(bk)
call FlushChildHashtable(O,GetHandleId(Dz))
call DestroyTimer(Dz)
endif
set t=null
set Dz=null
set i=null
set bk=null
set Uz=null
set b1=null
set D6=null
