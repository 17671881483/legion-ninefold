call UnitAddAbility(Om,$41313342)
call UnitMakeAbilityPermanent(Om,true,$41313339)
call UnitMakeAbilityPermanent(Om,true,$41313342)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl",GetUnitX(Om),GetUnitY(Om)))
else
