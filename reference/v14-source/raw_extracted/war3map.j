if Bc!=null and LoadInteger(O,GetHandleId(Bc),StringHash("PhantomRiderPenetrateToken"))==av then
call SetUnitVertexColorBJ(Bc,100,100,100,0)
call RemoveSavedInteger(O,GetHandleId(Bc),StringHash("PhantomRiderPenetrateToken"))
endif
call FlushChildHashtable(O,BF)
call DestroyTrigger(t)
set Bc=null
set t=null
endfunction
function PhantomRiderPenetrate takes unit Bc returns nothing
