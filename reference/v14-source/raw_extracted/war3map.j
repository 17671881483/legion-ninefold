set SY[BB]=LoadStr(K,StringHash("legion_gs"),SC)
set SZ[BB]=LoadStr(K,StringHash("R00G"),SC)
set Sa[BB]=LoadStr(K,StringHash("Store"),SC)
set Sb[BB]=LoadStr(K,StringHash("Buisr"),SC)
if StringLength(LoadStr(K,StringHash("AllFunc"),SC))>1 then
set SW[BB]="001/"
set SX[BB]="001/"
set SY[BB]="001/"
set SZ[BB]="001/"
set Sa[BB]="001/"
set Sb[BB]="001/"
