function FrostControlAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
local real FF=LoadReal(O,GetHandleId(t),1)
local real FG=LoadReal(O,GetHandleId(t),2)
local real Qv
local real Qw
local real a5
local real Pm
local real y=0
local group DG
local unit D6
set DG=SelectRange(Bc,FF,FG,800)
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
call UnitDamageTargetBJ(Bc,D6,225/5,ATTACK_TYPE_MELEE,DAMAGE_TYPE_MAGIC)
endloop
call DestroyGroup(DG)
loop
exitwhen y>=2
set y=y+1
set a5=GetRandomReal(0,600)
set Pm=GetRandomDirectionDeg()
set Qv=FF+CosBJ(Pm)*a5
set Qw=FG+SinBJ(Pm)*a5
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Blizzard\\BlizzardTarget.mdl",Qv,Qw))
endloop
if GetTriggerExecCount(t)*.2>=3 then
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
endif
set t=null
set Bc=null
set DG=null
set D6=null
endfunction
function FrostControl takes unit Bc,real FF,real FG returns nothing
local trigger t
if IsUnitType(Bc,UNIT_TYPE_ANCIENT) then
set t=null
set Bc=null
return
endif
set t=CreateTrigger()
call SaveAgentHandle(O,GetHandleId(t),0,Bc)
call SaveReal(O,GetHandleId(t),1,FF)
call SaveReal(O,GetHandleId(t),2,FG)
call TriggerRegisterTimerEvent(t,.2,true)
call TriggerAddAction(t,function FrostControlAction)
set t=null
set Bc=null
endfunction
