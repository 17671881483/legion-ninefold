function h0JITimer takes nothing returns nothing
local timer t=GetExpiredTimer()
local group DG=LoadGroupHandle(O,H2I(t),StringHash("group"))
local group gR=CreateGroup()
local integer N6=0
local unit D6=null
call GroupAddGroup(DG,gR)
loop
set D6=FirstOfGroup(gR)
if IsUnitDeadBJ(D6) then
call GroupRemoveUnit(gR,D6)
endif
exitwhen D6==null
call GroupRemoveUnit(gR,D6)
endloop
call DestroyGroup(gR)
set N6=CountUnitsInGroup(DG)
if N6==0 then
call FlushChildHashtable(O,H2I(t))
call DestroyTimer(t)
call DestroyGroup(DG)
endif
set t=null
set gR=null
set N6=0
endfunction
