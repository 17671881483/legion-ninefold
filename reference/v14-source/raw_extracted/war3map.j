function GetRandomTarget takes real Px,real FF,real FG,unit Pf returns unit
local unit D6
local group DG=CreateGroup()
local group Po=CreateGroup()
call GroupEnumUnitsInRange(DG,FF,FG,Px,null)
if Pf==null then
call GroupAddGroup(DG,Po)
else
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
if IsUnitEnemy(D6,GetOwningPlayer(Pf)) then
call GroupAddUnit(Po,D6)
endif
call GroupRemoveUnit(DG,D6)
endloop
endif
set D6=GroupPickRandomUnit(Po)
call DestroyGroup(Po)
call DestroyGroup(DG)
set DG=null
set Po=null
set Pf=null
set a2=D6
set D6=null
return a2
endfunction
function UnitAddAbilityByTimerTimer takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer Pr=GetHandleId(t)
local unit i=LoadUnitHandle(O,Pr,StringHash("unit"))
local integer RI=LoadInteger(O,Pr,StringHash("ability_id"))
call UnitRemoveAbility(i,RI)
call RemoveSavedHandle(O,GetHandleId(i),RI+StringHash("addabilityid"))
call FlushChildHashtable(O,Pr)
call DestroyTrigger(t)
set i=null
set t=null
endfunction
function UnitAddAbilityByTimer takes unit i,integer RI,real DK returns boolean
local trigger t=LoadTriggerHandle(O,GetHandleId(i),RI+StringHash("addabilityid"))
local integer Pq=GetHandleId(t)
local boolean Cd=false
if t!=null then
call FlushChildHashtable(O,Pq)
call DestroyTrigger(t)
else
call UnitAddAbility(i,RI)
endif
set t=CreateTrigger()
set Pq=GetHandleId(t)
call TriggerRegisterTimerEvent(t,DK,false)
call TriggerRegisterDeathEvent(t,i)
call TriggerAddAction(t,function UnitAddAbilityByTimerTimer)
call SaveInteger(O,GetHandleId(t),StringHash("ability_id"),RI)
call SaveUnitHandle(O,GetHandleId(t),StringHash("unit"),i)
call SaveAgentHandle(O,GetHandleId(i),RI+StringHash("addabilityid"),t)
set i=null
set t=null
return Cd
endfunction
function UnitAddAbilityForTime takes unit i,integer BF,real DK returns boolean
local boolean Cd=UnitAddAbilityByTimer(i,BF,DK)
set i=null
return Cd
endfunction
function SetTargetAttackFormAbility takes unit Pf,unit Om,integer Ph returns nothing
local unit Ki=CreateUnit(GetOwningPlayer(Pf),$65303057,GetUnitX(Om),GetUnitY(Om),270)
call SetUnitUserData(Ki,GetUnitUserData(Pf))
call GroupAddUnit(JH[GetUnitUserData(Pf)],Ki)
call UnitAddType(Ki,UNIT_TYPE_SUMMONED)
call UnitAddAbility(Ki,Ph)
call IssueTargetOrder(Ki,"attack",Om)
call UnitApplyTimedLife(Ki,$42487765,5)
set Pf=null
set Om=null
set Ki=null
endfunction
function SelectRange takes unit Pf,real FF,real FG,real Px returns group
local group DG=CreateGroup()
local group Om=CreateGroup()
local unit D6=null
call GroupEnumUnitsInRange(DG,FF,FG,Px,null)
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
if IsUnitEnemy(D6,GetOwningPlayer(Pf)) and not IsUnitType(D6,UNIT_TYPE_DEAD) and GetUnitAbilityLevel(D6,$4176756C)==0 then
call GroupAddUnit(Om,D6)
endif
call GroupRemoveUnit(DG,D6)
endloop
call DestroyGroup(DG)
set DG=null
set D6=null
set Pf=null
set Py=Om
set Om=null
return Py
endfunction
