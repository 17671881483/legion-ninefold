local effect DE=AddSpecialEffectTarget(ArthasModel("units\\undead\\FrostWyrm\\FrostWyrm.mdl","Abilities\\Weapons\\FrostWyrmMissile\\FrostWyrmMissile.mdl"),Ki,"chest")
local trigger t=ChargeDistance(Bc,Ki,Pm,1500,5,"ArthasSindragosaCallback","ArthasSindragosaFinish")
call SaveAgentHandle(O,GetHandleId(t),StringHash("effect"),DE)
