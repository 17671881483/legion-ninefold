function RegisterNumberData___Init takes nothing returns nothing
call RegisterNumberData___RegisterVipLevelZero()
call RegisterNumberData___RegisterVipLevelTwo()
endfunction
function YDTriggerSaveLoadSystem__Init takes nothing returns nothing
set CD=InitHashtable()
set CE=InitHashtable()
endfunction
function YDWE11Platform___IsLivingPlayer takes player h returns boolean
return GetPlayerSlotState(h)==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(h)==MAP_CONTROL_USER
endfunction
function YDWE11Platform___GetLivingfPlayer takes nothing returns player
local integer BB=0
loop
exitwhen YDWE11Platform___IsLivingPlayer(Player(BB)) or BB>=11
set BB=BB+1
endloop
return Player(BB)
endfunction
function YDWE11Platform___InitGC takes nothing returns boolean
local player h=YDWE11Platform___GetLivingfPlayer()
if GetLocalPlayer()==h then
call StoreInteger(CF,"Global","RoomFlag",GetStoredInteger(CF,"Global","RoomFlag"))
call StoreInteger(CF,"Global","Enable",GetStoredInteger(CF,"Global","Enable"))
call StoreInteger(CF,"-","-",$59445745)
endif
call TriggerSyncStart()
if GetLocalPlayer()==h then
call SyncStoredInteger(CF,"Global","RoomFlag")
call SyncStoredInteger(CF,"Global","Enable")
call SyncStoredInteger(CF,"-","-")
endif
call StoreInteger(CF,"Global","RoomFlag",0)
call StoreInteger(CF,"Global","Enable",0)
call StoreInteger(CF,"-","-",0)
call TriggerSyncReady()
loop
if $59445745==GetStoredInteger(CF,"-","-") then
return true
endif
call TriggerSleepAction(.2)
endloop
return true
endfunction
function YDWEPlatformIsInRoom takes nothing returns boolean
loop
exitwhen CG
call TriggerSleepAction(.2)
endloop
return GetStoredInteger(CF,"Global","RoomFlag")==$40000000
endfunction
function YDWEPlatformIsInPlatform takes nothing returns boolean
loop
exitwhen CG
call TriggerSleepAction(.2)
endloop
return GetStoredInteger(CF,"Global","Enable")==1
endfunction
function YDWE11Platform___Init takes nothing returns nothing
set CF=InitGameCache("@11CONF")
set CG=false
set CG=YDWE11Platform___InitGC()
endfunction
function YDWEGetUnitAbilityState takes unit i,integer EC,integer ED returns real
return EXGetAbilityState(EXGetUnitAbility(i,EC),ED)
endfunction
function YDWEGetUnitAbilityDataInteger takes unit i,integer EC,integer CC,integer EE returns integer
return EXGetAbilityDataInteger(EXGetUnitAbility(i,EC),CC,EE)
