call UnitDamageTargetBJ(Bc,Om,GetUnitState(Om,ConvertUnitState(20))*.7,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
set Bc=null
set Om=null
endfunction
