function AllBuildingStartApplyVipLimit takes unit i returns nothing
local integer x=GetUnitTypeId(i)
local player h=GetOwningPlayer(i)
if x==$68323032 then
call SetPlayerTechMaxAllowedSwap($68323032,5,h)
call SetPlayerTechMaxAllowedSwap($68304C57,0,h)
call SetPlayerTechMaxAllowedSwap($68305038,0,h)
call SetPlayerTechMaxAllowedSwap($68305136,0,h)
elseif x==$68304C57 then
call SetPlayerTechMaxAllowedSwap($68304C57,5,h)
call SetPlayerTechMaxAllowedSwap($68323032,0,h)
call SetPlayerTechMaxAllowedSwap($68305038,0,h)
call SetPlayerTechMaxAllowedSwap($68305136,0,h)
elseif x==$68305038 then
call SetPlayerTechMaxAllowedSwap($68305038,5,h)
call SetPlayerTechMaxAllowedSwap($68323032,0,h)
call SetPlayerTechMaxAllowedSwap($68304C57,0,h)
call SetPlayerTechMaxAllowedSwap($68305136,0,h)
elseif x==$68305136 then
call SetPlayerTechMaxAllowedSwap($68305038,0,h)
call SetPlayerTechMaxAllowedSwap($68323032,0,h)
call SetPlayerTechMaxAllowedSwap($68304C57,0,h)
call SetPlayerTechMaxAllowedSwap($68305136,5,h)
endif
set h=null
set i=null
endfunction
function AllBuildingStartApplyEggWhiteEx takes unit i,integer x,integer BF,boolean Yt returns nothing
local player h=GetOwningPlayer(i)
call EggWhiteEx(i,x,h,GetPlayerId(h),BF,Yt)
set h=null
set i=null
endfunction
function AllBuildingStartApplyEggWhite takes unit i,integer x,integer BF returns nothing
call AllBuildingStartApplyEggWhiteEx(i,x,BF,EVENT_PLAYER_UNIT_CONSTRUCT_FINISH==GetTriggerEventId()==true)
set i=null
endfunction
function AllBuildingStartApplyBuildUpgradeFinish takes unit i,boolean Yt,boolean dW returns nothing
local integer x=0
local integer BF=0
if i!=null then
if dW then
call Limit_D()
endif
if Yt or dW then
set x=GetUnitTypeId(i)
set BF=GetUnitUserData(i)
call AllBuildingStartApplyEggWhiteEx(i,x,BF,Yt)
endif
endif
set i=null
endfunction
function AllBuildingStartApplyManualUpgradeFinishByUnit takes unit i,integer x,integer BF returns nothing
if i!=null then
call AllBuildingStartApplyVipLimit(i)
call EasterBuildingCreate(i)
call Limit_D()
call AllBuildingStartApplyEggWhiteEx(i,x,BF,false)
endif
set i=null
endfunction
function Trig_EggWhiteActions takes nothing returns nothing
local unit i=GetTriggerUnit()
local integer x=0
call EasterBuildingCreate(i)
if EVENT_PLAYER_UNIT_UPGRADE_START==GetTriggerEventId() then
call AllBuildingStartApplyVipLimit(i)
endif
call AllBuildingStartApplyBuildUpgradeFinish(i,EVENT_PLAYER_UNIT_CONSTRUCT_FINISH==GetTriggerEventId()==true,EVENT_PLAYER_UNIT_UPGRADE_FINISH==GetTriggerEventId()==true)
if GetTriggerEventId()==EVENT_PLAYER_UNIT_RESEARCH_FINISH then
set x=GetResearched()
call AllBuildingStartApplyEggWhite(i,x,0)
endif
if GetTriggerEventId()==EVENT_PLAYER_UNIT_TRAIN_START and GetTrainedUnitType()==$65303033 then
call BoxGiftTryConsumeBuildFreeWithCost(GetOwningPlayer(i),GetUnitGoldCost($65303033),GetUnitWoodCost($65303033))
endif
if GetTriggerEventId()==EVENT_PLAYER_UNIT_TRAIN_FINISH then
set i=GetTrainedUnit()
set x=GetUnitTypeId(i)
call AllBuildingStartApplyEggWhite(i,x,0)
endif
set i=null
endfunction
function Trig_Ban_WallConditions takes nothing returns boolean
return GetUnitTypeId(GetTriggerUnit())==$6E303444
endfunction
function Trig_Ban_WallActions takes nothing returns nothing
call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,YDWETranslate("该处禁止建造石墙"))
call GroupRemoveUnit(Jw,GetTriggerUnit())
call GroupRemoveUnit(Jx,GetTriggerUnit())
call IssueImmediateOrderById(GetTriggerUnit(),851976)
call YDWETimerRemoveUnit(1,GetTriggerUnit())
endfunction
function InitTrig_AllBuildingStart takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_UPGRADE_START)
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_CONSTRUCT_FINISH)
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_CONSTRUCT_START)
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_UPGRADE_FINISH)
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_RESEARCH_START)
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_RESEARCH_FINISH)
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_TRAIN_START)
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_TRAIN_FINISH)
call TriggerAddAction(t,function Trig_EggWhiteActions)
set t=CreateTrigger()
set dX=Rect(4960.,2112.,6272.,3520.)
set dY=Rect(-6272.,2080.,-4960.,3520.)
set dZ=Rect(-2080.,2112.,-768.,3520.)
set da=Rect(768.,2112.,2080.,3520.)
call YDWETriggerRegisterEnterRectSimpleNull(t,dX)
call YDWETriggerRegisterEnterRectSimpleNull(t,da)
call YDWETriggerRegisterEnterRectSimpleNull(t,dZ)
call YDWETriggerRegisterEnterRectSimpleNull(t,dY)
call TriggerAddCondition(t,Condition(function Trig_Ban_WallConditions))
call TriggerAddAction(t,function Trig_Ban_WallActions)
set t=null
endfunction
function BuildingSummonResetAbility takes unit Pf,integer at returns nothing
call UnitRemoveAbility(Pf,at)
call UnitAddAbility(Pf,at)
set Pf=null
endfunction
function BuildingSummonRegisterBartizanLife takes unit Ki,real DK returns nothing
local trigger RL=CreateTrigger()
call SaveUnitHandle(O,GetHandleId(RL),0,Ki)
call SaveReal(O,GetHandleId(RL),1,DK)
call TriggerRegisterTimerEvent(RL,1.,false)
call TriggerAddAction(RL,function BartizanLife)
set RL=null
set Ki=null
endfunction
function BuildingSummonRegisterBartizanAttack takes unit Ki returns nothing
local trigger RL=CreateTrigger()
call SaveUnitHandle(O,GetHandleId(RL),0,Ki)
call TriggerRegisterDeathEvent(RL,Ki)
call TriggerRegisterAnyUnitEventBJ(RL,EVENT_PLAYER_UNIT_ATTACKED)
call TriggerAddAction(RL,function BartizanAttackAction)
set RL=null
set Ki=null
endfunction
function BuildingSummonCreateBartizan takes player h,real FF,real FG,real de,real DK returns nothing
local unit Ki=CreateUnit(h,$68304F4A,FF,FG,270)
call GroupAddUnit(JW,Ki)
call SetUnitUserData(Ki,GetPlayerId(h)+1)
call GroupAddUnit(JH[GetUnitUserData(Ki)],Ki)
call SetUnitState(Ki,ConvertUnitState(18),GetUnitState(Ki,ConvertUnitState(18))+de)
call BuildingSummonRegisterBartizanLife(Ki,DK)
call BuildingSummonRegisterBartizanAttack(Ki)
set Ki=null
set h=null
endfunction
function BuildingSummonHandleFireSupport takes player h,unit i,real FF,real FG returns nothing
local unit Pf=LoadUnitHandle(O,GetHandleId(h),GetUnitTypeId(i))
local integer y=LoadInteger(O,GetHandleId(h),$41305547)
local integer BU=0
local integer BV=0
local real de
local real DK
call RemoveUnit(i)
if RectContainsCoords(GetPlayerRect(h),FF,FG) then
if y==0 then
set BV=150+Dg*20
set de=I2R(Dg*12)
set DK=7
else
set BV=2000
set BU=300
set de=50+I2R(Dg*12)
set DK=10
endif
if GetPlayerState(h,PLAYER_STATE_RESOURCE_LUMBER)>=BV and GetPlayerState(h,PLAYER_STATE_RESOURCE_GOLD)>=BU then
if y==0 and not BD then
call UnitRemoveAbility(Pf,$41305547)
call UnitAddAbility(Pf,$4130554B)
elseif y>=1 then
call UnitRemoveAbility(Pf,$41305547)
call UnitAddAbility(Pf,$4130554B)
endif
call SaveInteger(O,GetHandleId(h),$41305547,y+1)
call SetPlayerStateBJ(h,PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(h,PLAYER_STATE_RESOURCE_LUMBER)-BV)
call SetPlayerStateBJ(h,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(h,PLAYER_STATE_RESOURCE_GOLD)-BU)
call BuildingSummonCreateBartizan(h,FF,FG,de,DK)
else
call BuildingSummonResetAbility(Pf,$41305547)
call DisplayTextToPlayer(h,0,0,YDWETranslate("火力支援需要")+I2S(BV)+YDWETranslate("木材"))
call DisplayTextToPlayer(h,0,0,YDWETranslate("火力支援需要")+I2S(BU)+YDWETranslate("金币"))
endif
else
call DisplayTimedTextToPlayer(h,0,0,10,"请在自己的区域内建造")
call BuildingSummonResetAbility(Pf,$41305547)
endif
set Pf=null
set h=null
set i=null
endfunction
function BuildingSummonHandleWatchTower takes player h,unit i,real FF,real FG returns nothing
local unit Pf=LoadUnitHandle(O,GetHandleId(h),GetUnitTypeId(i))
local unit Ki
call RemoveUnit(i)
if RectContainsCoords(GetPlayerRect(h),FF,FG) then
set Ki=CreateUnit(h,$68304F49,FF,FG,270)
call SetUnitUserData(Ki,GetPlayerId(h)+1)
call AddUnitAnimationProperties(Ki,"upgrade",true)
call RemoveAbilityForTimer(Pf,.5,$41314254)
call RemoveAbilityForTimer(i,.5,$41314254)
else
call DisplayTimedTextToPlayer(h,0,0,10,"请在自己的区域内建造")
call BuildingSummonResetAbility(Pf,$41314254)
endif
set Ki=null
set Pf=null
set h=null
set i=null
endfunction
function Trig_BuildingSummonActions takes nothing returns nothing
local player h=GetTriggerPlayer()
local unit i=GetConstructingStructure()
local integer x=GetUnitTypeId(i)
local real FF=GetUnitX(i)
local real FG=GetUnitY(i)
if x==$68304F4A then
call BuildingSummonHandleFireSupport(h,i,FF,FG)
elseif x==$68304F49 then
call BuildingSummonHandleWatchTower(h,i,FF,FG)
endif
set i=null
set h=null
endfunction
