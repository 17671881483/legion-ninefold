endfunction
function BoxGiftCountPlayerLimitUsedEnum takes nothing returns nothing
local unit i=GetEnumUnit()
local integer Dt=StringHash("box_train_limit_count")
local unit Y6=LoadUnitHandle(O,Dt,StringHash("old_unit"))
local integer Y9=LoadInteger(O,Dt,StringHash("limit_type"))
local boolean ZB=LoadBoolean(O,Y9,StringHash("limitid_ex"))
if i!=null and i!=Y6 and not IsUnitType(i,UNIT_TYPE_DEAD) and not IsUnitDeadBJ(i) then
if GetUnitTypeId(i)==Y9 or (not ZB and LoadInteger(O,GetHandleId(i),StringHash("base_id"))==Y9) then
call SaveInteger(O,Dt,StringHash("count"),LoadInteger(O,Dt,StringHash("count"))+1)
endif
endif
set i=null
set Y6=null
endfunction
function BoxGiftCountPlayerLimitUsed takes player h,unit Y6,integer Y9 returns integer
local integer Dt=StringHash("box_train_limit_count")
local group DG=null
local group Uz=null
local integer DJ=0
local integer ZD=0
if h!=null and Y9!=0 then
call FlushChildHashtable(O,Dt)
call SaveUnitHandle(O,Dt,StringHash("old_unit"),Y6)
call SaveInteger(O,Dt,StringHash("limit_type"),Y9)
call SaveInteger(O,Dt,StringHash("count"),0)
set DG=LoadGroupHandle(X,Y9,GetHandleId(h))
if DG!=null then
call GroupCheckDeath(DG)
call ForGroup(DG,function BoxGiftCountPlayerLimitUsedEnum)
set DJ=LoadInteger(O,Dt,StringHash("count"))
endif
call SaveInteger(O,Dt,StringHash("count"),0)
set Uz=YDWEGetUnitsOfPlayerAllNull(h)
if Uz!=null then
call ForGroup(Uz,function BoxGiftCountPlayerLimitUsedEnum)
set ZD=LoadInteger(O,Dt,StringHash("count"))
if ZD>DJ then
set DJ=ZD
endif
call DestroyGroup(Uz)
endif
call FlushChildHashtable(O,Dt)
endif
set h=null
set Y6=null
set DG=null
set Uz=null
return DJ
endfunction
function BoxGiftIsUpgradeLimitReady takes player h,unit Y6,integer Y4 returns boolean
local boolean Y7=HaveSavedInteger(O,Y4,StringHash("count"))
local integer Uy=0
local integer Y8=0
local boolean DJ=true
if h==null then
set DJ=false
elseif Y7 then
set Uy=LoadInteger(O,Y4,StringHash("count"))
set Y8=BoxGiftCountPlayerLimitUsed(h,Y6,Y4)
if Y8>=Uy then
set DJ=false
endif
endif
set h=null
set Y6=null
return DJ
endfunction
function BoxGiftGetImmediateUpgradeTargetCount takes integer Y0 returns integer
return LoadInteger(O,Y0,StringHash("box_train_select_count"))
endfunction
function BoxGiftGetImmediateUpgradeTargetByIndex takes integer Y0,integer Cx returns integer
return LoadInteger(O,Y0,StringHash("box_train_select_"+I2S(Cx)))
endfunction
function BoxGiftGetImmediateUpgradeTargetId takes player h,integer Y0 returns integer
local integer BB=1
local integer y=BoxGiftGetImmediateUpgradeTargetCount(Y0)
local integer Y4=0
loop
exitwhen BB>y or Y4!=0
set Y4=BoxGiftGetImmediateUpgradeTargetByIndex(Y0,BB)
if not BoxGiftIsUpgradeTechReady(h,Y4) then
set Y4=0
endif
set BB=BB+1
endloop
set h=null
return Y4
endfunction
function BoxGiftIsTrainTarget takes player h,unit Pf,unit Om returns boolean
local boolean DJ=false
if BoxGiftIsOwnedAlive(h,Om) and Om!=Pf then
if not IsUnitType(Om,UNIT_TYPE_HERO) then
set DJ=true
endif
endif
set h=null
set Pf=null
set Om=null
return DJ
endfunction
function BoxGiftIsImmediateUpgradeTarget takes integer Y0,integer Y4 returns boolean
local integer BB=1
local integer y=BoxGiftGetImmediateUpgradeTargetCount(Y0)
loop
exitwhen BB>y
if BoxGiftGetImmediateUpgradeTargetByIndex(Y0,BB)==Y4 then
return true
endif
set BB=BB+1
endloop
return false
endfunction
function BoxGiftTryUpgradeTargetUnitNowByType takes unit Pf,unit Om,integer Y4 returns boolean
local player h=null
local integer Y0=0
local integer BU=0
local integer BV=0
local integer ZE=0
local boolean ZF=false
local boolean ZG=false
local boolean ZH=false
local boolean ZI=false
local boolean ZJ=false
local boolean ZK=false
local unit Ys=null
local boolean DJ=false
if Pf==null then
set Om=null
return false
endif
set h=GetOwningPlayer(Pf)
if Om!=null then
set Y0=GetUnitTypeId(Om)
endif
if not BoxGiftIsTrainTarget(h,Pf,Om) then
call DisplayTimedTextToPlayer(h,0,0,10,"必须选择你自己的非英雄单位!!!")
elseif Y4==0 or not BoxGiftIsImmediateUpgradeTarget(Y0,Y4) then
call DisplayTimedTextToPlayer(h,0,0,10,"该单位没有可用的兵种训练升级路径!!!")
elseif GetUnitAbilityLevel(Pf,Oh)<=0 then
call DisplayTimedTextToPlayer(h,0,0,10,"兵种训练奖励已失效，请重新获取奖励。")
elseif not BoxGiftIsUpgradeTechReady(h,Y4) then
call DisplayTimedTextToPlayer(h,0,0,10,"升级目标的科技限制条件未满足，无法进行兵种训练!!!")
elseif not BoxGiftIsUpgradeLimitReady(h,Om,Y4) then
call DisplayTimedTextToPlayer(h,0,0,10,"目标兵种数量已达上限，无法进行兵种训练!!!")
else
set BU=GetUnitGoldCost(Y4)*40/100
set BV=GetUnitWoodCost(Y4)*40/100
if GetPlayerState(h,PLAYER_STATE_RESOURCE_GOLD)<BU or GetPlayerState(h,PLAYER_STATE_RESOURCE_LUMBER)<BV then
call DisplayTimedTextToPlayer(h,0,0,10,"资源不足：需要"+I2S(BU)+"金币 "+I2S(BV)+"木材")
else
set ZE=GetUnitUserData(Om)
set ZF=GetUnitAbilityLevel(Om,QC)>0
set ZG=IsUnitType(Om,UNIT_TYPE_STRUCTURE)
set ZH=IsUnitInGroup(Om,Bt[1+GetPlayerId(h)])
set ZI=IsUnitInGroup(Om,Bu)
set ZJ=IsUnitInGroup(Om,Jl)
set ZK=IsUnitInGroup(Om,Jk)
call AdjustPlayerStateBJ(-BU,h,PLAYER_STATE_RESOURCE_GOLD)
call AdjustPlayerStateBJ(-BV,h,PLAYER_STATE_RESOURCE_LUMBER)
call GroupRemoveUnit(Bt[1+GetPlayerId(h)],Om)
call GroupRemoveUnit(Bu,Om)
call GroupRemoveUnit(Jl,Om)
call GroupRemoveUnit(Jk,Om)
set Ys=YDWEReplaceUnitBJNull(Om,Y4,1)
if Ys==null then
if ZH then
call GroupAddUnit(Bt[1+GetPlayerId(h)],Om)
endif
if ZI then
call GroupAddUnit(Bu,Om)
endif
if ZJ then
call GroupAddUnit(Jl,Om)
endif
if ZK then
call GroupAddUnit(Jk,Om)
endif
call BoxGiftRefundResource(h,BU,BV)
call DisplayTimedTextToPlayer(h,0,0,10,"兵种训练失败，请重新选择目标。")
else
call SetUnitUserData(Ys,ZE)
if ZG then
call GroupAddUnit(Bt[1+GetPlayerId(h)],Ys)
endif
call GroupAddUnit(Bu,Ys)
if ZF then
call UnitAddAbility(Ys,QC)
call UnitMakeAbilityPermanent(Ys,true,QC)
endif
call BoxGiftApplyManualUpgradeFinish(Om,Y0,Ys,Y4,h,ZE)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl",GetUnitX(Ys),GetUnitY(Ys)))
call DisplayTimedTextToPlayer(h,0,0,10,"兵种训练完成：消耗"+I2S(BU)+"金币 "+I2S(BV)+"木材，目标单位已立即升级1次。")
set DJ=true
endif
endif
endif
set h=null
set Pf=null
set Om=null
set Ys=null
return DJ
endfunction
function BoxGiftCloseUpgradeDialog takes player h,dialog EF returns nothing
local integer BB=1
local integer Y2=0
local integer y=0
local button v=null
local trigger t=null
local timer Y3=null
if EF!=null then
set Y2=GetHandleId(EF)
set y=LoadInteger(O,Y2,StringHash("box_train_button_count"))
set t=LoadTriggerHandle(O,Y2,StringHash("box_train_trigger"))
set Y3=LoadTimerHandle(O,Y2,StringHash("box_train_timeout"))
if h!=null then
call DialogDisplay(h,EF,false)
endif
loop
exitwhen BB>y
set v=LoadButtonHandle(O,Y2,StringHash("box_train_button_"+I2S(BB)))
if v!=null then
call FlushChildHashtable(O,GetHandleId(v))
endif
set BB=BB+1
endloop
call FlushChildHashtable(O,Y2)
call DialogDestroy(EF)
if t!=null then
call DestroyTrigger(t)
endif
if Y3!=null then
call FlushChildHashtable(O,GetHandleId(Y3))
call DestroyTimer(Y3)
endif
endif
set h=null
set EF=null
set v=null
set t=null
set Y3=null
endfunction
function BoxGiftUpgradeDialogTimeout takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer BQ=GetHandleId(t)
local dialog EF=LoadDialogHandle(O,BQ,StringHash("box_train_dialog"))
local player h=LoadPlayerHandle(O,BQ,StringHash("box_train_player"))
call BoxGiftCloseUpgradeDialog(h,EF)
set t=null
set EF=null
set h=null
endfunction
function BoxGiftTrainUpgradeDialogAction takes nothing returns nothing
local button v=GetClickedButton()
local player h=GetTriggerPlayer()
local dialog EF=LoadDialogHandle(O,GetHandleId(v),StringHash("box_train_dialog"))
local unit Pf=null
local unit Om=null
local integer Y4=LoadInteger(O,GetHandleId(v),StringHash("box_train_next_type"))
if EF!=null then
set Pf=LoadUnitHandle(O,GetHandleId(EF),StringHash("box_train_source"))
set Om=LoadUnitHandle(O,GetHandleId(EF),StringHash("box_train_target"))
if BoxGiftTryUpgradeTargetUnitNowByType(Pf,Om,Y4) then
call BoxGiftConsumeBoxReward(Pf)
endif
call BoxGiftCloseUpgradeDialog(h,EF)
endif
set v=null
set h=null
set EF=null
set Pf=null
set Om=null
endfunction
function BoxGiftShowUpgradeDialog takes unit Pf,unit Om returns nothing
local player h=GetOwningPlayer(Pf)
local integer Y0=GetUnitTypeId(Om)
local integer y=BoxGiftGetImmediateUpgradeTargetCount(Y0)
local integer BB=1
local integer Y4=0
local dialog EF=DialogCreate()
local trigger t=CreateTrigger()
local button v=null
local integer Y2=GetHandleId(EF)
local timer Y3=CreateTimer()
call DialogSetMessage(EF,"选择兵种训练升级分支")
call SaveUnitHandle(O,Y2,StringHash("box_train_source"),Pf)
call SaveUnitHandle(O,Y2,StringHash("box_train_target"),Om)
call SaveTriggerHandle(O,Y2,StringHash("box_train_trigger"),t)
call SaveInteger(O,Y2,StringHash("box_train_button_count"),y)
call SaveTimerHandle(O,Y2,StringHash("box_train_timeout"),Y3)
call SaveDialogHandle(O,GetHandleId(Y3),StringHash("box_train_dialog"),EF)
call SavePlayerHandle(O,GetHandleId(Y3),StringHash("box_train_player"),h)
call TimerStart(Y3,30.,false,function BoxGiftUpgradeDialogTimeout)
call TriggerAddAction(t,function BoxGiftTrainUpgradeDialogAction)
call TriggerRegisterDialogEvent(t,EF)
loop
exitwhen BB>y
set Y4=BoxGiftGetImmediateUpgradeTargetByIndex(Y0,BB)
set v=DialogAddButton(EF,GetObjectName(Y4),0)
call SaveDialogHandle(O,GetHandleId(v),StringHash("box_train_dialog"),EF)
call SaveInteger(O,GetHandleId(v),StringHash("box_train_next_type"),Y4)
call SaveButtonHandle(O,Y2,StringHash("box_train_button_"+I2S(BB)),v)
set BB=BB+1
endloop
call DialogDisplay(h,EF,true)
set h=null
set Pf=null
set Om=null
set EF=null
set t=null
set v=null
set Y3=null
endfunction
function BoxGiftTryUpgradeTargetUnitNow takes unit Pf,unit Om returns boolean
local player h=GetOwningPlayer(Pf)
local integer Y0=GetUnitTypeId(Om)
local integer Y1=BoxGiftGetImmediateUpgradeTargetCount(Y0)
local integer Y4=0
local boolean DJ=false
if Y1<=0 then
call DisplayTimedTextToPlayer(h,0,0,10,"该单位没有可用的兵种训练升级路径!!!")
elseif Y1>1 then
call BoxGiftShowUpgradeDialog(Pf,Om)
else
set Y4=BoxGiftGetImmediateUpgradeTargetByIndex(Y0,1)
set DJ=BoxGiftTryUpgradeTargetUnitNowByType(Pf,Om,Y4)
endif
set h=null
set Pf=null
set Om=null
return DJ
endfunction
function BoxGiftClearSwapTarget takes unit Pf returns nothing
call UnitRemoveAbility(Pf,ZZ)
call RemoveSavedHandle(O,GetHandleId(Pf),StringHash("box_swap_first"))
set Pf=null
endfunction
function BoxClickAction takes unit Pf,unit Om,integer BN returns nothing
local player h=GetOwningPlayer(Pf)
local rect D1
local real FF=GetSpellTargetX()
local real FG=GetSpellTargetY()
local real Zb=0.
local real Zc=0.
local unit Ki
local integer BU
local integer BV
local group DG
local unit D6
local unit Za
local integer Y0
local integer Dt=0
if BN==N4 then
set Dt=BoxGetActiveSkillListKey(Pf)
if Dt==0 or Dg>13 then
call DisplayTimedTextToPlayer(h,0,0,10,"当前没有可重铸奖励。")
elseif EXNetUseItem(h,Yq,1) then
call RemoveSkillList(Pf,Dt)
call BoxRollSkillList(Pf,Dt,3)
call BoxRefreshReforgeAbility(Pf)
call DestroyEffect(AddSpecialEffect("az.mdx",GetUnitX(Pf),GetUnitY(Pf)))
else
call DisplayTimedTextToPlayer(h,0,0,10,"军需重铸令不足，无法重铸。")
endif
elseif BN==$41313331 then
if UpFarm(h) then
call SetSkillListState(GetOwningPlayer(Pf),StringHash("box"),false)
call RemoveSkillList(Pf,StringHash("box"))
else
call DisplayTimedTextToPlayer(h,0,0,10,"农场等级已满!!!")
endif
elseif BN==$41313430 then
if UpLumbering(h) then
