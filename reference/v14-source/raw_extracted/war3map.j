call RemoveSavedHandle(O,GetHandleId(t),StringHash("effect"))
call DestroyEffect(AddSpecialEffect(ArthasModel("LJQ_AlsaceDark_SWCR02.mdx","Abilities\\Spells\\Undead\\DeathCoil\\DeathCoilSpecialArt.mdl"),GetUnitX(Om),GetUnitY(Om)))
set t=null
set DE=null
set Ki=null
