set bF=DialogAddButton(EF,"yes",0)
set bG=DialogAddButton(EF,"no",0)
call SaveButtonHandle(O,H2I(EF),StringHash("yes"),bF)
call SaveButtonHandle(O,H2I(EF),StringHash("no"),bG)
set Eb=CreateTrigger()
call TriggerRegisterDialogEvent(Eb,EF)
call TriggerAddAction(Eb,IT)
else
set bF=LoadButtonHandle(O,H2I(EF),StringHash("yes"))
set bG=LoadButtonHandle(O,H2I(EF),StringHash("no"))
endif
call SaveTimerHandle(O,H2I(EF),StringHash("timer"),t)
call SaveTimerDialogHandle(O,H2I(t),StringHash("dialog"),BK)
call SavePlayerHandle(O,H2I(t),StringHash("player"),h)
call SavePlayerHandle(O,H2I(EF),StringHash("escape"),TL)
call SavePlayerHandle(O,H2I(t),StringHash("escape"),TL)
call DialogDisplay(h,EF,true)
set h=null
set EF=null
set bF=null
set bG=null
set Eb=null
set IT=null
set BK=null
set t=null
endfunction
