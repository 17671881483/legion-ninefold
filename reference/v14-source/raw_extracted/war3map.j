call SaveInteger(O,GetHandleId(t),2,BF)
call TriggerRegisterTimerEvent(t,1,true)
call TriggerRegisterUnitEvent(t,Bc,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function DeathAuraCondition))
set t=null
set Bc=null
endfunction
function KelThuzadsChainsMoveCondition takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer Pg=GetHandleId(t)
local unit Bc=LoadUnitHandle(O,Pg,1)
local unit i=LoadUnitHandle(O,Pg,2)
local unit Om=LoadUnitHandle(O,Pg,3)
local real FF=LoadReal(O,Pg,4)
local real FG=LoadReal(O,Pg,5)
local lightning Pk=LoadLightningHandle(O,Pg,6)
local lightning Pl=LoadLightningHandle(O,Pg,7)
local real Pm
if GetTriggerEventId()==EVENT_GAME_TIMER_EXPIRED then
if Pk!=null then
if IsUnitInRangeXY(i,FF,FG,100) then
call PauseUnit(i,false)
call DestroyLightning(Pk)
call RemoveSavedHandle(O,Pg,6)
call UnitDamageTarget(Bc,i,300,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_WHOKNOWS)
else
set Pm=Atan2BJ(FG-GetUnitY(i),FF-GetUnitX(i))
call SetUnitPosition(i,GetUnitX(i)+CosBJ(Pm)*60,GetUnitY(i)+SinBJ(Pm)*60)
call MoveLightning(Pk,false,GetUnitX(i),GetUnitY(i),FF,FG)
call VertigoTarget(Bc,i,3)
endif
endif
if Pl!=null then
if IsUnitInRangeXY(Om,FF,FG,100) then
call PauseUnit(Om,false)
call DestroyLightning(Pl)
call RemoveSavedHandle(O,Pg,7)
call UnitDamageTarget(Bc,Om,300,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_WHOKNOWS)
call VertigoTarget(Bc,Om,3)
else
set Pm=Atan2BJ(FG-GetUnitY(Om),FF-GetUnitX(Om))
call SetUnitPosition(Om,GetUnitX(Om)+CosBJ(Pm)*60,GetUnitY(Om)+SinBJ(Pm)*60)
call MoveLightning(Pl,false,GetUnitX(Om),GetUnitY(Om),FF,FG)
endif
endif
if LoadLightningHandle(O,Pg,6)==null and LoadLightningHandle(O,Pg,7)==null then
call FlushChildHashtable(O,Pg)
call DestroyTrigger(t)
endif
else
if GetTriggerUnit()==i then
call PauseUnit(i,false)
call DestroyLightning(Pk)
call RemoveSavedHandle(O,Pg,6)
call UnitDamageTarget(Bc,i,300,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_WHOKNOWS)
endif
if GetTriggerUnit()==Om then
call PauseUnit(Om,false)
call DestroyLightning(Pl)
call RemoveSavedHandle(O,Pg,7)
call UnitDamageTarget(Bc,Om,300,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_WHOKNOWS)
endif
if LoadLightningHandle(O,Pg,6)==null and LoadLightningHandle(O,Pg,7)==null then
call FlushChildHashtable(O,Pg)
call DestroyTrigger(t)
endif
endif
set Bc=null
set i=null
set Om=null
set t=null
set Pk=null
set Pl=null
return false
endfunction
function KelThuzadsChainsMove takes unit Bc,unit i,unit Om returns nothing
local trigger t=CreateTrigger()
local integer Pg=GetHandleId(t)
local real FF=(GetUnitX(i)+GetUnitX(Om))/2
local real FG=(GetUnitY(i)+GetUnitY(Om))/2
local lightning Pk=AddLightning("AFOD",false,GetUnitX(i),GetUnitY(i),FF,FG)
local lightning Pl=AddLightning("AFOD",false,GetUnitX(Om),GetUnitY(Om),FF,FG)
call PauseUnit(i,true)
call PauseUnit(Om,true)
call SaveAgentHandle(O,Pg,1,Bc)
call SaveAgentHandle(O,Pg,2,i)
call SaveAgentHandle(O,Pg,3,Om)
call SaveReal(O,Pg,4,FF)
call SaveReal(O,Pg,5,FG)
call SaveLightningHandle(O,Pg,6,Pk)
call SaveLightningHandle(O,Pg,7,Pl)
call TriggerRegisterTimerEvent(t,.04,true)
call TriggerRegisterDeathEvent(t,i)
call TriggerRegisterDeathEvent(t,Om)
call TriggerAddCondition(t,Condition(function KelThuzadsChainsMoveCondition))
set Bc=null
set i=null
set Om=null
set t=null
endfunction
function KelThuzadsChainsCondition takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer Pg=GetHandleId(t)
local unit Bc=LoadUnitHandle(O,Pg,1)
local unit Om
local unit D6
local group DG
local integer Ph=LoadInteger(O,Pg,2)
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call UnitRemoveAbility(Bc,Pi)
call FlushChildHashtable(O,Pg)
call DestroyTrigger(t)
elseif GetTriggerEventId()==EVENT_GAME_TIMER_EXPIRED then
call UnitAddAbility(Bc,Pi)
call UnitMakeAbilityPermanent(Bc,true,Pi)
elseif GetEventDamageSource()==Bc and YDWEIsEventAttackDamage() and GetUnitAbilityLevel(Bc,Pi)>0 and GetUnitAbilityLevel(Bc,Ph)>0 then
call UnitRemoveAbility(Bc,Pi)
call UnitRemoveAbility(Bc,$42303731)
call TriggerRegisterTimerEvent(t,3,false)
set Om=GetTriggerUnit()
set DG=CreateGroup()
call GroupEnumUnitsInRange(DG,GetUnitX(Om),GetUnitY(Om),500,null)
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
if GetUnitAbilityLevel(D6,$4176756C)==0 and IsUnitEnemy(D6,GetOwningPlayer(Bc)) and Om!=D6 and not IsUnitType(D6,UNIT_TYPE_DEAD) and not IsUnitInRange(D6,Om,100) then
call UnitDamageTarget(Bc,D6,GetEventDamage(),false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_WHOKNOWS)
call KelThuzadsChainsMove(Bc,D6,Om)
exitwhen true
endif
endloop
call DestroyGroup(DG)
set DG=null
set D6=null
endif
set t=null
set Bc=null
set Om=null
return false
endfunction
function KelThuzadsChains takes unit Bc,integer Ph returns nothing
local trigger t=CreateTrigger()
call SaveAgentHandle(O,GetHandleId(t),1,Bc)
call SaveInteger(O,GetHandleId(t),2,Ph)
call UnitAddAbility(Bc,Pi)
call UnitMakeAbilityPermanent(Bc,true,Pi)
call YDWESyStemAnyUnitDamagedRegistTrigger(t)
call TriggerRegisterUnitEvent(t,Bc,EVENT_UNIT_DEATH)
call TriggerAddCondition(t,Condition(function KelThuzadsChainsCondition))
set t=null
set Bc=null
endfunction
function KelThuzadsAmuletboxCondition takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer Pg=GetHandleId(t)
local unit Bc=LoadUnitHandle(O,GetHandleId(t),1)
local unit Ki
local integer Pp=LoadInteger(O,GetHandleId(Bc),StringHash("number"))-1
if GetEventDamage()<GetUnitState(Bc,UNIT_STATE_LIFE) or GetUnitState(Bc,UNIT_STATE_LIFE)<=0 then
set Bc=null
set t=null
return false
endif
if Pp>=0 then
set Bi=GetUnitUserData(Bc)
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\NightElf\\EntBirthTarget\\EntBirthTarget.mdl",GetUnitX(Bc),GetUnitY(Bc)))
call SaveInteger(O,GetHandleId(Bc),StringHash("number"),Pp)
set Ki=CreateUnit(GetOwningPlayer(Bc),$6830435A,GetUnitX(Bc),GetUnitY(Bc),GetUnitFacing(Bc))
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\NightElf\\EntBirthTarget\\EntBirthTarget.mdl",GetUnitX(Ki),GetUnitY(Ki)))
call GroupAddUnit(JW,Ki)
call GroupAddUnit(JH[Bi],Ki)
call SetUnitUserData(Ki,GetUnitUserData(Bc))
call UnitAddType(Ki,UNIT_TYPE_SUMMONED)
set Ki=CreateUnit(GetOwningPlayer(Bc),$6830434C,GetUnitX(Bc),GetUnitY(Bc),GetUnitFacing(Bc))
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\NightElf\\EntBirthTarget\\EntBirthTarget.mdl",GetUnitX(Ki),GetUnitY(Ki)))
call GroupAddUnit(JW,Ki)
call GroupAddUnit(JH[Bi],Ki)
call SetUnitUserData(Ki,GetUnitUserData(Bc))
call UnitAddType(Ki,UNIT_TYPE_SUMMONED)
set Ki=CreateUnit(GetOwningPlayer(Bc),$6830434C,GetUnitX(Bc),GetUnitY(Bc),GetUnitFacing(Bc))
call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\NightElf\\EntBirthTarget\\EntBirthTarget.mdl",GetUnitX(Ki),GetUnitY(Ki)))
call GroupAddUnit(JW,Ki)
call GroupAddUnit(JH[Bi],Ki)
call SetUnitUserData(Ki,GetUnitUserData(Bc))
call UnitAddType(Ki,UNIT_TYPE_SUMMONED)
set Ki=null
if Pp<=0 then
call RemoveAbilityForTimer(Bc,1.01,$41305A55)
call FlushChildHashtable(O,Pg)
call DestroyTrigger(t)
endif
else
call SaveInteger(O,GetHandleId(Bc),StringHash("number"),Pp)
endif
set Bc=null
set t=null
return false
endfunction
