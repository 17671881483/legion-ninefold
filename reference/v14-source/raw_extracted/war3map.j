function AnduinTerrifyingSoul takes unit Bc,real FF,real FG returns nothing
local real Pm=GetAngle(GetUnitX(Bc),GetUnitY(Bc),FF,FG)
local integer N5=6
local integer BB=0
local unit Ki
local real Qv
local real Qw
local real Q5=250
local trigger t
local group DG
if IsUnitType(Bc,UNIT_TYPE_ANCIENT) then
set Bc=null
return
endif
loop
exitwhen BB>=N5
set Qv=GetUnitX(Bc)+CosBJ(360/N5*BB)*Q5
set Qw=GetUnitY(Bc)+SinBJ(360/N5*BB)*Q5
set Ki=CreateUnit(GetOwningPlayer(Bc),Pn,Qv,Qw,Pm)
set t=ChargeDistance(Bc,Ki,Pm,800,.4,"AnduinTerrifyingSoulCallback","AnduinTerrifyingSoulCallbackFinish")
set DG=CreateGroup()
if GetUnitTypeId(Bc)==$68305842 then
call SaveEffectHandle(O,GetHandleId(t),StringHash("effect"),AddSpecialEffectTarget("Bjladyayqs01_Spell01.mdx",Ki,"chest"))
else
call SaveEffectHandle(O,GetHandleId(t),StringHash("effect"),AddSpecialEffectTarget("units\\undead\\Shade\\Shade.mdx",Ki,"chest"))
endif
call SaveGroupHandle(O,GetHandleId(t),StringHash("group"),DG)
set DG=null
set BB=BB+1
endloop
set Bc=null
set t=null
set Ki=null
set DG=null
endfunction
