function YDWEReplaceUnitBJNull takes unit Kn,integer Ko,integer Kp returns unit
local unit Kr=Kn
local unit Ks
local boolean Kq
local integer Cx
local item Ku
local real Kt
if Kn==null then
set bj_lastReplacedUnit=Kn
return bj_lastReplacedUnit
endif
set Kq=IsUnitHidden(Kr)
call ShowUnit(Kr,false)
if Ko==$75676F6C then
set Ks=CreateBlightedGoldmine(GetOwningPlayer(Kr),GetUnitX(Kr),GetUnitY(Kr),GetUnitFacing(Kr))
else
set Ks=CreateUnit(GetOwningPlayer(Kr),Ko,GetUnitX(Kr),GetUnitY(Kr),GetUnitFacing(Kr))
endif
if Kp==bj_UNIT_STATE_METHOD_RELATIVE then
if GetUnitState(Kr,UNIT_STATE_MAX_LIFE)>0 then
set Kt=GetUnitState(Kr,UNIT_STATE_LIFE)/GetUnitState(Kr,UNIT_STATE_MAX_LIFE)
call SetUnitState(Ks,UNIT_STATE_LIFE,Kt*GetUnitState(Ks,UNIT_STATE_MAX_LIFE))
endif
if GetUnitState(Kr,UNIT_STATE_MAX_MANA)>0 and GetUnitState(Ks,UNIT_STATE_MAX_MANA)>0 then
set Kt=GetUnitState(Kr,UNIT_STATE_MANA)/GetUnitState(Kr,UNIT_STATE_MAX_MANA)
call SetUnitState(Ks,UNIT_STATE_MANA,Kt*GetUnitState(Ks,UNIT_STATE_MAX_MANA))
endif
elseif Kp==bj_UNIT_STATE_METHOD_ABSOLUTE then
call SetUnitState(Ks,UNIT_STATE_LIFE,GetUnitState(Kr,UNIT_STATE_LIFE))
if GetUnitState(Ks,UNIT_STATE_MAX_MANA)>0 then
call SetUnitState(Ks,UNIT_STATE_MANA,GetUnitState(Kr,UNIT_STATE_MANA))
endif
elseif Kp==bj_UNIT_STATE_METHOD_DEFAULTS then
elseif Kp==bj_UNIT_STATE_METHOD_MAXIMUM then
call SetUnitState(Ks,UNIT_STATE_LIFE,GetUnitState(Ks,UNIT_STATE_MAX_LIFE))
call SetUnitState(Ks,UNIT_STATE_MANA,GetUnitState(Ks,UNIT_STATE_MAX_MANA))
else
endif
call SetResourceAmount(Ks,GetResourceAmount(Kr))
if IsUnitType(Kr,UNIT_TYPE_HERO) and IsUnitType(Ks,UNIT_TYPE_HERO) then
call SetHeroXP(Ks,GetHeroXP(Kr),false)
set Cx=0
loop
set Ku=UnitItemInSlot(Kr,Cx)
if Ku!=null then
call UnitRemoveItem(Kr,Ku)
call UnitAddItem(Ks,Ku)
endif
set Cx=Cx+1
exitwhen Cx>=bj_MAX_INVENTORY
endloop
endif
if Kq then
call KillUnit(Kr)
call RemoveUnit(Kr)
else
call RemoveUnit(Kr)
endif
set bj_lastReplacedUnit=Ks
set Kr=null
set Ks=null
set Ku=null
return bj_lastReplacedUnit
endfunction
