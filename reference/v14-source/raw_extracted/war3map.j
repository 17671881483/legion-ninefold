function RandomSetGoldBoxPlayerForIndex takes integer Bj,integer DE returns player
local integer BB=Bj
local player h=null
local player array Bo
local integer y=0
loop
set h=ConvertedPlayer(BB)
if IsLivingPlayer(h) then
set Bo[y]=h
set y=y+1
endif
exitwhen BB>=DE
set BB=BB+1
endloop
if y>0 then
set h=Bo[GetRandomInt(0,y-1)]
else
return null
endif
return h
endfunction
