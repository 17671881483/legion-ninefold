function TheScreamingWindCallBack takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local group DG=LoadGroupHandle(O,GetHandleId(t),StringHash("group"))
local unit Bc=GetChargeSource()
local unit Ki=GetChargeDummy()
local group b0=SelectRange(Bc,GetUnitX(Ki),GetUnitY(Ki),400)
local unit D6
local unit RO
local timer El
if DG==null then
set DG=CreateGroup()
call SaveAgentHandle(O,GetHandleId(t),StringHash("group"),DG)
endif
loop
set D6=FirstOfGroup(b0)
exitwhen D6==null
call GroupRemoveUnit(b0,D6)
if not IsUnitInGroup(D6,DG) then
call GroupAddUnit(DG,D6)
call UnitDamageTargetBJ(Bc,D6,150,ATTACK_TYPE_MELEE,DAMAGE_TYPE_MAGIC)
set RO=CreateUnit(GetOwningPlayer(Bc),Pn,GetUnitX(D6),GetUnitY(D6),0)
call UnitApplyTimedLife(RO,$42487765,.1)
call UnitAddAbility(RO,$53303037)
call IssueTargetOrder(RO,"cyclone",D6)
set El=CreateTimer()
call SaveUnitHandle(O,GetHandleId(El),0,Bc)
call SaveUnitHandle(O,GetHandleId(El),1,D6)
call TimerStart(El,3,false,function TheScreamingWindCallBackTimer)
set El=null
endif
endloop
call DestroyGroup(b0)
set Bc=null
set DG=null
set Ki=null
set t=null
set b0=null
endfunction
