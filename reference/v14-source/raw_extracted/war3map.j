function wG takes nothing returns boolean
return GetOwningPlayer(GetLeavingUnit())==Player(0) and IsUnitType(GetLeavingUnit(),UNIT_TYPE_UNDEAD) and PN==false
endfunction
function zG takes nothing returns boolean
return GetOwningPlayer(GetLeavingUnit())==Player(1) and IsUnitType(GetLeavingUnit(),UNIT_TYPE_UNDEAD) and PN==false
endfunction
function eh takes nothing returns boolean
return GetOwningPlayer(GetLeavingUnit())==Player(2) and IsUnitType(GetLeavingUnit(),UNIT_TYPE_UNDEAD) and PN==false
endfunction
function rh takes nothing returns boolean
return GetOwningPlayer(GetLeavingUnit())==Player(3) and IsUnitType(GetLeavingUnit(),UNIT_TYPE_UNDEAD) and PN==false
endfunction
function nh takes nothing returns boolean
return GetOwningPlayer(GetLeavingUnit())==Player(4) and IsUnitType(GetLeavingUnit(),UNIT_TYPE_UNDEAD) and PN==false
endfunction
function oldcodefn_Xh takes nothing returns boolean
return GetOwningPlayer(GetLeavingUnit())==Player(5) and IsUnitType(GetLeavingUnit(),UNIT_TYPE_UNDEAD) and PN==false
endfunction
function OC5F_Ih takes nothing returns boolean
return GetOwningPlayer(GetLeavingUnit())==Player(6) and IsUnitType(GetLeavingUnit(),UNIT_TYPE_UNDEAD) and PN==false
endfunction
function oldcodefn_bh takes nothing returns boolean
return GetOwningPlayer(GetLeavingUnit())==Player(7) and IsUnitType(GetLeavingUnit(),UNIT_TYPE_UNDEAD) and PN==false
endfunction
function OC5F_WG takes nothing returns nothing
local unit i=GetLeavingUnit()
local integer BB=GetPlayerId(GetOwningPlayer(i))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Charm\\CharmTarget.mdl",FH[BB],FI[BB]))
call SetUnitPosition(i,FH[BB],FI[BB])
call DisplayTimedTextToPlayer(Player(BB),0,0,4.,YDWETranslate("请不要离开你的区域!"))
if GetLocalPlayer()==GetOwningPlayer(i) then
call PanCameraToTimed(FH[BB],FI[BB],0)
endif
set i=null
endfunction
function Kazami_Kazuki_Limit takes boolean Cd returns nothing
if not Cd then
set TS=Rect(-6336.,2304.,-3968.,5568.)
set TT=Rect(-6336.,64.,-3936.,3296.)
set TU=Rect(-3136.,2336.,-704.,5568.)
set TV=Rect(-3104.,64.,-704.,3296.)
set TW=Rect(704.,2336.,3104.,5568.)
set TX=Rect(704.,64.,3104.,3296.)
set TY=Rect(3968.,2336.,6336.,5568.)
set TZ=Rect(3968.,64.,6336.,3296.)
else
set TS=Rect(-6336.,2504.,-3968.,5568.)
set TT=Rect(-6336.,64.,-3936.,3196.)
set TU=Rect(-3136.,2536.,-704.,5568.)
set TV=Rect(-3104.,64.,-704.,3196.)
set TW=Rect(704.,2536.,3104.,5568.)
set TX=Rect(704.,64.,3104.,3196.)
set TY=Rect(3968.,2536.,6336.,5568.)
set TZ=Rect(3968.,64.,6336.,3196.)
endif
set Ta=CreateTrigger()
call YDWETriggerRegisterLeaveRectSimpleNull(Ta,TS)
call TriggerAddCondition(Ta,Condition(function wG))
call TriggerAddAction(Ta,function OC5F_WG)
set Tb=CreateTrigger()
call YDWETriggerRegisterLeaveRectSimpleNull(Tb,TT)
call TriggerAddCondition(Tb,Condition(function zG))
call TriggerAddAction(Tb,function OC5F_WG)
set Tc=CreateTrigger()
call YDWETriggerRegisterLeaveRectSimpleNull(Tc,TU)
call TriggerAddCondition(Tc,Condition(function eh))
call TriggerAddAction(Tc,function OC5F_WG)
set Td=CreateTrigger()
call YDWETriggerRegisterLeaveRectSimpleNull(Td,TV)
call TriggerAddCondition(Td,Condition(function rh))
call TriggerAddAction(Td,function OC5F_WG)
set Te=CreateTrigger()
call YDWETriggerRegisterLeaveRectSimpleNull(Te,TW)
call TriggerAddCondition(Te,Condition(function nh))
call TriggerAddAction(Te,function OC5F_WG)
set Tf=CreateTrigger()
call YDWETriggerRegisterLeaveRectSimpleNull(Tf,TX)
call TriggerAddCondition(Tf,Condition(function oldcodefn_Xh))
call TriggerAddAction(Tf,function OC5F_WG)
set Tg=CreateTrigger()
call YDWETriggerRegisterLeaveRectSimpleNull(Tg,TY)
call TriggerAddCondition(Tg,Condition(function OC5F_Ih))
call TriggerAddAction(Tg,function OC5F_WG)
set Th=CreateTrigger()
call YDWETriggerRegisterLeaveRectSimpleNull(Th,TZ)
call TriggerAddCondition(Th,Condition(function oldcodefn_bh))
call TriggerAddAction(Th,function OC5F_WG)
set Ti[0]=TS
set Ti[1]=TT
set Ti[2]=TU
set Ti[3]=TV
set Ti[4]=TW
set Ti[5]=TX
set Ti[6]=TY
set Ti[7]=TZ
endfunction
