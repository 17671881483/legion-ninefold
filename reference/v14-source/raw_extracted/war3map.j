call GroupClear(LoadGroupHandle(O,GetHandleId(i),420))
call DestroyGroup(LoadGroupHandle(O,GetHandleId(i),420))
elseif GetUnitAbilityLevel(i,$41305056)==1 then
if GetUnitState(Qf,UNIT_STATE_MAX_LIFE)*.15<=400. then
call UnitDamageTargetBJ(i,Qf,GetUnitState(Qf,UNIT_STATE_MAX_LIFE)*.15,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
else
call UnitDamageTargetBJ(i,Qf,400,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
