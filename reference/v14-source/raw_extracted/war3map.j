function SetEasterEggPage takes unit Ki,integer w,string cS returns nothing
local integer cH=LoadInteger(O,GetHandleId(Ki),StringHash(cS+"page"))
local integer BF
local integer BB=1
if cH>0 then
loop
set BF=LoadInteger(O,StringHash(cS+"page"+I2S(cH)),BB)
if BF>0 then
call UnitRemoveAbility(Ki,BF)
else
exitwhen true
endif
set BB=BB+1
endloop
endif
set BB=1
loop
set BF=LoadInteger(O,StringHash(cS+"page"+I2S(w)),BB)
exitwhen BF==0
call UnitAddAbility(Ki,BF)
set BB=BB+1
endloop
call SaveInteger(O,GetHandleId(Ki),StringHash(cS+"page"),w)
set Ki=null
endfunction
function EasterEggGetMaxPage takes string cS returns integer
local integer N5=0
loop
if LoadBoolean(O,StringHash(cS),N5+1) then
set N5=N5+1
else
exitwhen true
endif
endloop
return N5
endfunction
function EasterEggNextPage takes unit Ki,string cS returns integer
local integer cH=LoadInteger(O,GetHandleId(Ki),StringHash(cS+"page"))
local integer cM=0
if LoadBoolean(O,StringHash(cS),cH+1) then
set cM=cH+1
else
set cM=1
endif
call SetEasterEggPage(Ki,cM,cS)
set Ki=null
return cM
endfunction
function EasterEggBackPage takes unit Ki,string cS returns integer
local integer cH=LoadInteger(O,GetHandleId(Ki),StringHash(cS+"page"))
local integer cM=0
if LoadBoolean(O,StringHash(cS),cH-1) then
set cM=cH-1
else
set cM=EasterEggGetMaxPage(cS)
endif
call SetEasterEggPage(Ki,cM,cS)
set Ki=null
return cM
endfunction
function ChangeEasterEgg takes unit Bc,unit Ki,string cS returns nothing
local real FF=-4500.
local real FG=8000.
local integer BF=LoadInteger(O,StringHash(cS),StringHash("dummy"))
if Ki==null then
set Ki=CreateUnit(GetOwningPlayer(Bc),BF,FF,FG,0)
endif
call SelectUnitForPlayerSingle(Ki,GetOwningPlayer(Bc))
call SetEasterEggPage(Ki,1,cS)
call SaveUnitHandle(O,GetHandleId(Bc),StringHash(cS),Ki)
call SaveUnitHandle(O,GetHandleId(Ki),StringHash(cS),Bc)
set Bc=null
set Ki=null
endfunction
function RegisterEasterEggPage takes integer w,integer BF,string cS returns nothing
local integer BB=1
call SaveBoolean(O,StringHash(cS),w,true)
loop
if LoadInteger(O,StringHash(cS+"page"+I2S(w)),BB)==0 then
call SaveInteger(O,StringHash(cS+"page"+I2S(w)),BB,BF)
exitwhen true
endif
set BB=BB+1
endloop
endfunction
function Trig_EasterEggFuncActions takes nothing returns nothing
local unit Bc=GetTriggerUnit()
local integer BF=GetSpellAbilityId()
local integer BB=0
local string cS=null
if BF==$41304954 then
call ChangeEasterEgg(Bc,LoadUnitHandle(O,GetHandleId(Bc),StringHash("vip_level_0")),"vip_level_0")
elseif BF==$41304955 then
call ChangeEasterEgg(Bc,LoadUnitHandle(O,GetHandleId(Bc),StringHash("vip_level_1")),"vip_level_1")
elseif BF==$41304956 then
call ChangeEasterEgg(Bc,LoadUnitHandle(O,GetHandleId(Bc),StringHash("vip_level_2")),"vip_level_2")
endif
loop
set cS="vip_level_"+I2S(BB)
if LoadUnitHandle(O,GetHandleId(Bc),StringHash(cS))!=null then
if BF==$41305851 then
call EasterEggBackPage(Bc,cS)
elseif BF==$41305852 then
call EasterEggNextPage(Bc,cS)
endif
endif
exitwhen BB>=2
set BB=BB+1
endloop
set cS=null
set Bc=null
endfunction
function InitTrig_EasterEggFunc takes nothing returns nothing
call SaveInteger(O,StringHash("vip_level_0"),StringHash("dummy"),$65303039)
call SaveInteger(O,StringHash("vip_level_1"),StringHash("dummy"),$65303041)
call SaveInteger(O,StringHash("vip_level_2"),StringHash("dummy"),$65303042)
set cR=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(cR,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddAction(cR,function Trig_EasterEggFuncActions)
endfunction
