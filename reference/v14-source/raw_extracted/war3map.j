call SetUnitState(Om,UNIT_STATE_MANA,GetUnitState(Om,UNIT_STATE_MANA)-5)
call SetUnitState(Ei,UNIT_STATE_MANA,GetUnitState(Ei,UNIT_STATE_MANA)+5)
call YDWETimerDestroyEffect(3,AddSpecialEffectTarget("Abilities\\Spells\\Other\\Drain\\ManaDrainTarget.mdl",Om,"overhead"))
endif
call GroupRemoveUnit(aX,Om)
set Om=FirstOfGroup(aX)
endloop
call DestroyGroup(aX)
set aX=null
set Ei=null
set Om=null
endfunction
function PhantomAssassinAtkAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer Pr=GetHandleId(t)
local unit Bc=LoadUnitHandle(O,Pr,0)
local unit Om=LoadUnitHandle(O,Pr,1)
local real FF=LoadReal(O,Pr,2)
local real FG=LoadReal(O,Pr,3)
local real Pm=LoadReal(O,Pr,4)
local real Qv=GetUnitX(Om)+CosBJ(Pm)*200
local real Qw=GetUnitY(Om)+SinBJ(Pm)*200
if GetTriggerExecCount(t)>=4 then
call EXSetUnitFacing(Bc,Pm)
call SetUnitFacing(Bc,Pm)
call SetUnitPosition(Bc,FF,FG)
call FlushChildHashtable(O,Pr)
call DestroyTrigger(t)
else
call SetUnitAnimation(Bc,"attack")
call SetUnitPosition(Bc,Qv,Qw)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Stampede\\StampedeMissile.mdl",GetUnitX(Om),GetUnitY(Om)))
if LoadEffectHandle(O,Pr,5)!=null then
call YDWETimerDestroyEffect(.2,LoadEffectHandle(O,Pr,5))
call RemoveSavedHandle(O,Pr,5)
endif
call UnitDamageTargetBJ(Bc,Om,101*(.5+.5*GetTriggerExecCount(t)),ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
endif
set t=null
set Bc=null
set Om=null
endfunction
function PhantomAssassinAtkTimer takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer BQ=GetHandleId(t)
local unit Bc=LoadUnitHandle(O,BQ,0)
call RemoveSavedHandle(O,GetHandleId(Bc),$4131504E)
call FlushChildHashtable(O,BQ)
call DestroyTimer(t)
set Bc=null
set t=null
endfunction
function PhantomAssassinAtk takes unit Bc,unit Om returns nothing
local effect DE
local real Pm=GetAngleFromUnit(Bc,Om)
local real b5=GetAngleFromUnit(Om,Bc)
local real FF=GetUnitX(Bc)
local real FG=GetUnitY(Bc)
local trigger t=CreateTrigger()
local real Qd=15
local timer Qi=LoadTimerHandle(O,GetHandleId(Bc),$4131504E)
if Qi==null then
set Qi=CreateTimer()
call SaveUnitHandle(O,GetHandleId(Qi),0,Bc)
call TimerStart(Qi,Qd,false,function PhantomAssassinAtkTimer)
call SaveTimerHandle(O,GetHandleId(Bc),$4131504E,Qi)
set Qi=null
else
set Qi=null
set t=null
set Bc=null
set Om=null
set DE=null
return
endif
set DE=AddSpecialEffectTarget("Abilities\\Spells\\Items\\ClarityPotion\\ClarityTarget.mdl",Bc,"chest")
call EXSetUnitFacing(Bc,Pm)
call SetUnitFacing(Bc,b5)
call SetUnitAnimation(Bc,"attack")
call SaveAgentHandle(O,GetHandleId(t),0,Bc)
call SaveAgentHandle(O,GetHandleId(t),1,Om)
call SaveReal(O,GetHandleId(t),2,FF)
call SaveReal(O,GetHandleId(t),3,FG)
call SaveReal(O,GetHandleId(t),4,Pm)
call SaveAgentHandle(O,GetHandleId(t),5,DE)
call TriggerRegisterTimerEvent(t,.6,true)
call TriggerAddAction(t,function PhantomAssassinAtkAction)
set t=null
set Bc=null
set Om=null
set DE=null
endfunction
function VashjLightningArrowChargeAoeAction takes nothing returns nothing
