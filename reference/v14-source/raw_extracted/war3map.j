if N6>0 then
set D6=YDWEGetUnitsOfTypeIdAllNull($68303345)
call GroupAddGroup(D6,DG)
call DestroyGroup(D6)
set D6=YDWEGetUnitsOfTypeIdAllNull($68303346)
call GroupAddGroup(D6,DG)
call DestroyGroup(D6)
call ForGroup(DG,function H0JIAbilityGroup)
else
call DestroyGroup(DG)
endif
set D6=null
set DG=null
endfunction
