function WolfmanDamagedtiemr takes nothing returns nothing
local timer EP=GetExpiredTimer()
local unit EQ=LoadUnitHandle(K,107,GetHandleId(EP))
local unit T7=LoadUnitHandle(K,107,GetHandleId(EQ))
local integer BB=LoadInteger(K,107,GetHandleId(EQ))-1
local integer Bj=90
if IsUnitType(EQ,UNIT_TYPE_DEAD)!=true then
if IsUnitType(EQ,UNIT_TYPE_HERO)==true then
set Bj=100
endif
if GetRandomInt(1,Bj)==88 then
call SetUnitState(EQ,UNIT_STATE_LIFE,1.)
call UnitRemoveAbility(EQ,$41313037)
set BB=-1
endif
if BB>=0 then
call SaveInteger(K,107,GetHandleId(EQ),BB)
call TimerStart(EP,1,false,function WolfmanDamagedtiemr)
else
call UnitRemoveAbility(EQ,$41313037)
call RemoveSavedHandle(K,107,GetHandleId(EP))
call RemoveSavedHandle(K,107,GetHandleId(EQ))
call RemoveSavedInteger(K,107,GetHandleId(EQ))
call DestroyTimer(EP)
endif
call UnitDamageTarget(T7,EQ,GetUnitState(EQ,UNIT_STATE_MAX_LIFE)*.0125,true,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_ENHANCED,WEAPON_TYPE_WHOKNOWS)
else
call RemoveSavedHandle(K,107,GetHandleId(EP))
if EQ!=null then
call RemoveSavedHandle(K,107,GetHandleId(EQ))
call RemoveSavedInteger(K,107,GetHandleId(EQ))
endif
call DestroyTimer(EP)
endif
set EP=null
set EQ=null
set T7=null
endfunction
function WolfmanDamaged takes nothing returns nothing
local unit EQ=GetTriggerUnit()
local unit T7=GetEventDamageSource()
local timer EP
local integer Bj=100
if IsUnitType(EQ,UNIT_TYPE_HERO)==true then
set Bj=200
endif
if GetRandomInt(1,Bj)==88 then
call SetUnitState(EQ,UNIT_STATE_LIFE,1.)
set EQ=null
set T7=null
return
endif
if IsUnitType(EQ,UNIT_TYPE_HERO) and GetRandomReal(1,101)<=3 then
call SetUnitState(EQ,UNIT_STATE_LIFE,1.)
call UnitDamageTarget(T7,EQ,5.32,true,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_ENHANCED,WEAPON_TYPE_WHOKNOWS)
set EQ=null
set T7=null
return
elseif not IsUnitType(EQ,UNIT_TYPE_HERO) and GetRandomReal(1,101)<=8 then
call SetUnitState(EQ,UNIT_STATE_LIFE,1.)
call UnitDamageTarget(T7,EQ,5.32,true,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_ENHANCED,WEAPON_TYPE_WHOKNOWS)
set EQ=null
set T7=null
return
endif
if GetUnitAbilityLevel(EQ,$41313037)!=1 then
set EP=CreateTimer()
call SaveUnitHandle(K,107,GetHandleId(EP),EQ)
call SaveUnitHandle(K,107,GetHandleId(EQ),T7)
call SaveInteger(K,107,GetHandleId(EQ),10)
call TimerStart(EP,1,false,function WolfmanDamagedtiemr)
call UnitAddAbility(EQ,$41313037)
else
call SaveUnitHandle(K,107,GetHandleId(EQ),T7)
call SaveInteger(K,107,GetHandleId(EQ),10)
endif
set EQ=null
set T7=null
set EP=null
endfunction
