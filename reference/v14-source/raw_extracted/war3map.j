function SingedIsHero takes unit Bc returns boolean
local integer BF=GetUnitTypeId(Bc)
return BF==$6E303931 or BF==$6E303932 or BF==$6E303933 or BF==$68305848 or BF==$68305849 or BF==$6830584A
endfunction
function SingedGetLevel takes unit Bc returns integer
local integer BF=GetUnitTypeId(Bc)
if BF==$6E303933 or BF==$6830584A then
return 3
elseif BF==$6E303932 or BF==$68305849 then
return 2
endif
return 1
endfunction
function SingedGetMedicalMistRange takes integer CC returns real
if CC>=3 then
return 500.
elseif CC==2 then
return 400.
endif
return 300.
endfunction
function SingedGetLowestLifeAlly takes unit Bc,real Px returns unit
local group DG=SelectRangeAlly(Bc,GetUnitX(Bc),GetUnitY(Bc),Px)
local unit D6=null
local unit Om=null
local real Ze=101.
local real KI=0.
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
set KI=GetUnitLifePercent(D6)
if KI<Ze then
set Ze=KI
set Om=D6
endif
endloop
call DestroyGroup(DG)
set DG=null
set D6=null
if Om==null then
set Om=Bc
endif
return Om
endfunction
function SingedDestroyTrigger takes trigger t returns nothing
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
set t=null
endfunction
function SingedMedicalCloudAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer Pr=GetHandleId(t)
local unit Bc=LoadUnitHandle(O,Pr,0)
local real FF=LoadReal(O,Pr,1)
local real FG=LoadReal(O,Pr,2)
local real Px=LoadReal(O,Pr,3)
local real Zf=LoadReal(O,Pr,4)
local real P8=LoadReal(O,Pr,5)
local effect DE=LoadEffectHandle(O,Pr,6)
local group DG=CreateGroup()
local unit D6=null
local integer y=LoadInteger(O,Pr,7)+1
if GetTriggerEventId()==EVENT_WIDGET_DEATH or Bc==null then
call DestroyEffect(DE)
call DestroyGroup(DG)
call SingedDestroyTrigger(t)
else
call SaveInteger(O,Pr,7,y)
call GroupEnumUnitsInRange(DG,FF,FG,Px,null)
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
if not IsUnitType(D6,UNIT_TYPE_DEAD) and GetUnitAbilityLevel(D6,$4176756C)==0 then
if IsUnitAlly(D6,GetOwningPlayer(Bc)) then
call SetUnitState(D6,UNIT_STATE_LIFE,GetUnitState(D6,UNIT_STATE_LIFE)+Zf*.2)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIre\\AIreTarget.mdl",D6,"chest"))
elseif IsUnitEnemy(D6,GetOwningPlayer(Bc)) then
call UnitDamageTargetBJ(Bc,D6,P8*.2,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
endif
endif
endloop
call DestroyGroup(DG)
if y>=40 then
call DestroyEffect(DE)
call SingedDestroyTrigger(t)
endif
endif
set t=null
set Bc=null
set DE=null
set DG=null
set D6=null
endfunction
function SingedMedicalCloud takes unit Bc,real FF,real FG,real Px,real Zf,real P8 returns nothing
local trigger t=CreateTrigger()
local integer Pr=GetHandleId(t)
local effect DE=AddSpecialEffect("LJ_YLQW.mdx",FF,FG)
call SaveUnitHandle(O,Pr,0,Bc)
call SaveReal(O,Pr,1,FF)
call SaveReal(O,Pr,2,FG)
call SaveReal(O,Pr,3,Px)
call SaveReal(O,Pr,4,Zf)
call SaveReal(O,Pr,5,P8)
call SaveEffectHandle(O,Pr,6,DE)
call SaveInteger(O,Pr,7,0)
call TriggerRegisterTimerEvent(t,0.,false)
call TriggerRegisterTimerEvent(t,.2,true)
call TriggerRegisterDeathEvent(t,Bc)
call TriggerAddAction(t,function SingedMedicalCloudAction)
set t=null
set Bc=null
set DE=null
endfunction
function SingedCreateMedicalDeathCloud takes unit Bc,unit Om,integer Pr returns nothing
local real FF=LoadReal(O,Pr,9)
local real FG=LoadReal(O,Pr,10)
if Om!=null then
set FF=GetUnitX(Om)
set FG=GetUnitY(Om)
endif
if Bc!=null then
call SingedMedicalCloud(Bc,FF,FG,LoadReal(O,Pr,2),LoadReal(O,Pr,4),LoadReal(O,Pr,5))
endif
set Bc=null
set Om=null
endfunction
function SingedMedicalMistAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer Pr=GetHandleId(t)
local unit Bc=LoadUnitHandle(O,Pr,0)
local unit Om=LoadUnitHandle(O,Pr,1)
local real Px=LoadReal(O,Pr,2)
local real Zf=LoadReal(O,Pr,3)
local real Zg=LoadReal(O,Pr,4)
local real Zh=LoadReal(O,Pr,5)
local effect DE=LoadEffectHandle(O,Pr,6)
local integer QK=LoadInteger(O,Pr,7)
local integer y=LoadInteger(O,Pr,8)
local group DG=null
local unit D6=null
if GetTriggerEventId()==EVENT_WIDGET_DEATH then
if GetTriggerUnit()==Om and Bc!=null then
call SingedCreateMedicalDeathCloud(Bc,Om,Pr)
endif
call DestroyEffect(DE)
call SingedDestroyTrigger(t)
elseif Bc==null or Om==null or IsUnitType(Bc,UNIT_TYPE_DEAD) then
call DestroyEffect(DE)
call SingedDestroyTrigger(t)
elseif IsUnitType(Om,UNIT_TYPE_DEAD) then
call SingedCreateMedicalDeathCloud(Bc,Om,Pr)
call DestroyEffect(DE)
call SingedDestroyTrigger(t)
else
call SaveReal(O,Pr,9,GetUnitX(Om))
call SaveReal(O,Pr,10,GetUnitY(Om))
set y=y+1
call SaveInteger(O,Pr,8,y)
set DG=SelectRangeAlly(Bc,GetUnitX(Om),GetUnitY(Om),Px)
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
call SetUnitState(D6,UNIT_STATE_LIFE,GetUnitState(D6,UNIT_STATE_LIFE)+Zf)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIre\\AIreTarget.mdl",D6,"chest"))
endloop
call DestroyGroup(DG)
if y>=QK then
call DestroyEffect(DE)
call SingedDestroyTrigger(t)
endif
endif
set t=null
set Bc=null
set Om=null
set DE=null
set DG=null
set D6=null
endfunction
function SingedMedicalMist takes unit Bc returns nothing
local integer CC=SingedGetLevel(Bc)
local real Px=SingedGetMedicalMistRange(CC)
local unit Om=SingedGetLowestLifeAlly(Bc,Px)
local real Zf=10.
local real Zg=10.
local real Zh=10.
local integer Ez=5
local trigger t=CreateTrigger()
local integer Pr=GetHandleId(t)
local effect DE=null
if CC==2 then
set Ez=15
elseif CC==3 then
set Ez=15
set Zf=20.
set Zg=15.
set Zh=15.
endif
call SaveUnitHandle(O,Pr,0,Bc)
call SaveUnitHandle(O,Pr,1,Om)
call SaveReal(O,Pr,2,Px)
call SaveReal(O,Pr,3,Zf)
call SaveReal(O,Pr,4,Zg)
call SaveReal(O,Pr,5,Zh)
set DE=AddSpecialEffect("LJ_YLQW.mdx",GetUnitX(Bc),GetUnitY(Bc))
call SaveEffectHandle(O,Pr,6,DE)
call SaveInteger(O,Pr,7,Ez)
call SaveInteger(O,Pr,8,0)
call SaveReal(O,Pr,9,GetUnitX(Om))
call SaveReal(O,Pr,10,GetUnitY(Om))
call TriggerRegisterTimerEvent(t,0.,false)
call TriggerRegisterTimerEvent(t,1.,true)
call TriggerRegisterDeathEvent(t,Bc)
call TriggerRegisterDeathEvent(t,Om)
call TriggerAddAction(t,function SingedMedicalMistAction)
set t=null
set Bc=null
set Om=null
set DE=null
endfunction
function SingedAcidArmorRestore takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer BQ=GetHandleId(t)
local unit Om=LoadUnitHandle(O,BQ,0)
local real Zk=LoadReal(O,BQ,1)
if Om!=null then
call SetUnitState(Om,ConvertUnitState(32),GetUnitState(Om,ConvertUnitState(32))+Zk)
call SaveBoolean(O,GetHandleId(Om),StringHash("SingedAcidArmor"),false)
endif
call FlushChildHashtable(O,BQ)
call DestroyTimer(t)
set t=null
set Om=null
endfunction
function SingedApplyAcidArmor takes unit Om,real Zk returns nothing
local timer t
if Om!=null and not LoadBoolean(O,GetHandleId(Om),StringHash("SingedAcidArmor")) then
call SaveBoolean(O,GetHandleId(Om),StringHash("SingedAcidArmor"),true)
call SetUnitState(Om,ConvertUnitState(32),GetUnitState(Om,ConvertUnitState(32))-Zk)
set t=CreateTimer()
call SaveUnitHandle(O,GetHandleId(t),0,Om)
call SaveReal(O,GetHandleId(t),1,Zk)
call TimerStart(t,2.,false,function SingedAcidArmorRestore)
endif
set t=null
set Om=null
endfunction
function SingedAcidPoolDamage takes unit Bc,real FF,real FG,real P8,real Zk returns nothing
local group DG=null
local unit D6=null
if Bc!=null then
set DG=SelectRange(Bc,FF,FG,325.)
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
call UnitDamageTargetBJ(Bc,D6,P8,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
call SingedApplyAcidArmor(D6,Zk)
endloop
call DestroyGroup(DG)
endif
set DG=null
set D6=null
set Bc=null
endfunction
function SingedAcidPoolAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer Pr=GetHandleId(t)
local unit Bc=LoadUnitHandle(O,Pr,0)
local real FF=LoadReal(O,Pr,1)
local real FG=LoadReal(O,Pr,2)
local real P8=LoadReal(O,Pr,3)
local real Zk=LoadReal(O,Pr,4)
local effect DE=LoadEffectHandle(O,Pr,5)
local integer y=LoadInteger(O,Pr,6)+1
if GetTriggerEventId()==EVENT_WIDGET_DEATH or Bc==null then
call DestroyEffect(DE)
call SingedDestroyTrigger(t)
else
call SaveInteger(O,Pr,6,y)
call SingedAcidPoolDamage(Bc,FF,FG,P8,Zk)
if y>=7 then
call DestroyEffect(DE)
call SingedDestroyTrigger(t)
endif
endif
set t=null
set Bc=null
set DE=null
endfunction
function SingedAcidPool takes unit Bc,real FF,real FG,real P8,real Zk returns nothing
local trigger t=CreateTrigger()
local integer Pr=GetHandleId(t)
call SaveUnitHandle(O,Pr,0,Bc)
call SaveReal(O,Pr,1,FF)
call SaveReal(O,Pr,2,FG)
call SaveReal(O,Pr,3,P8)
call SaveReal(O,Pr,4,Zk)
call SaveEffectHandle(O,Pr,5,AddSpecialEffect("Abilities\\Spells\\Undead\\DeathandDecay\\DeathandDecayTarget.mdl",FF,FG))
call SingedAcidPoolDamage(Bc,FF,FG,P8,Zk)
call SaveInteger(O,Pr,6,1)
call TriggerRegisterTimerEvent(t,1.,true)
call TriggerRegisterDeathEvent(t,Bc)
call TriggerAddAction(t,function SingedAcidPoolAction)
set t=null
set Bc=null
endfunction
function SingedAcidBombTargetAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer Pr=GetHandleId(t)
local unit Bc=LoadUnitHandle(O,Pr,0)
local unit Om=LoadUnitHandle(O,Pr,1)
local real P8=LoadReal(O,Pr,2)
local real Zj=LoadReal(O,Pr,3)
local real Zk=LoadReal(O,Pr,4)
local effect DE=LoadEffectHandle(O,Pr,5)
local integer y=LoadInteger(O,Pr,6)
if GetTriggerEventId()==EVENT_WIDGET_DEATH then
if GetTriggerUnit()==Om and Bc!=null then
call SingedAcidPool(Bc,GetUnitX(Om),GetUnitY(Om),Zj,Zk)
endif
call DestroyEffect(DE)
call SingedDestroyTrigger(t)
elseif Bc==null or Om==null or IsUnitType(Bc,UNIT_TYPE_DEAD) then
call DestroyEffect(DE)
call SingedDestroyTrigger(t)
elseif IsUnitType(Om,UNIT_TYPE_DEAD) then
call SingedAcidPool(Bc,GetUnitX(Om),GetUnitY(Om),Zj,Zk)
call DestroyEffect(DE)
call SingedDestroyTrigger(t)
else
set y=y+1
call SaveInteger(O,Pr,6,y)
call UnitDamageTargetBJ(Bc,Om,P8,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
if y>=5 then
call SingedAcidPool(Bc,GetUnitX(Om),GetUnitY(Om),Zj,Zk)
call DestroyEffect(DE)
call SingedDestroyTrigger(t)
endif
endif
set t=null
set Bc=null
set Om=null
set DE=null
endfunction
function SingedAcidBombTarget takes unit Bc,unit Om,integer CC returns nothing
local trigger t=CreateTrigger()
local integer Pr=GetHandleId(t)
local real P8=10.*I2R(CC)
local real Zj=15.
local real Zk=2.
if CC==2 then
set Zj=25.
set Zk=3.
elseif CC==3 then
set Zj=35.
set Zk=3.
endif
call SaveUnitHandle(O,Pr,0,Bc)
call SaveUnitHandle(O,Pr,1,Om)
call SaveReal(O,Pr,2,P8)
call SaveReal(O,Pr,3,Zj)
call SaveReal(O,Pr,4,Zk)
call SaveEffectHandle(O,Pr,5,AddSpecialEffectTarget("LJQ_sxzd.mdx",Om,"chest"))
call SaveInteger(O,Pr,6,0)
call TriggerRegisterTimerEvent(t,1.,true)
call TriggerRegisterDeathEvent(t,Bc)
call TriggerRegisterDeathEvent(t,Om)
call TriggerAddAction(t,function SingedAcidBombTargetAction)
set t=null
set Bc=null
set Om=null
endfunction
function SingedAcidBomb takes unit Bc returns nothing
local integer CC=SingedGetLevel(Bc)
local group DG=SelectRange(Bc,GetUnitX(Bc),GetUnitY(Bc),1000.)
local unit Om=GroupPickRandomUnit(DG)
if Om!=null then
call SingedAcidBombTarget(Bc,Om,CC)
call GroupRemoveUnit(DG,Om)
endif
set Om=GroupPickRandomUnit(DG)
if Om!=null then
call SingedAcidBombTarget(Bc,Om,CC)
endif
call DestroyGroup(DG)
set DG=null
set Bc=null
set Om=null
endfunction
function SingedNeedMedicalMist takes unit Bc returns boolean
local unit Om=SingedGetLowestLifeAlly(Bc,SingedGetMedicalMistRange(SingedGetLevel(Bc)))
local boolean DJ=Om!=null and GetUnitLifePercent(Om)<99.
set Om=null
set Bc=null
return DJ
endfunction
function SingedHasEnemy takes unit Bc returns boolean
local group DG=SelectRange(Bc,GetUnitX(Bc),GetUnitY(Bc),1000.)
local unit Om=FirstOfGroup(DG)
local boolean DJ=Om!=null
call DestroyGroup(DG)
set DG=null
set Om=null
set Bc=null
return DJ
endfunction
function SingedCanAutoCast takes unit Bc,integer RI,real bf returns boolean
if Bc==null then
return false
endif
return not LoadBoolean(O,GetHandleId(Bc),RI) and GetUnitState(Bc,UNIT_STATE_MANA)>=bf
endfunction
function SingedAutoCast takes unit Bc returns nothing
if not SingedIsHero(Bc) then
set Bc=null
return
endif
if GetUnitAbilityLevel(Bc,Zd)>0 and SingedCanAutoCast(Bc,Zd,8.) and SingedNeedMedicalMist(Bc) and NagaTryAutoCast(Bc,Zd,8.,8.) then
call SingedMedicalMist(Bc)
elseif GetUnitAbilityLevel(Bc,Zi)>0 and SingedCanAutoCast(Bc,Zi,12.) and SingedHasEnemy(Bc) and NagaTryAutoCast(Bc,Zi,12.,11.) then
call SingedAcidBomb(Bc)
endif
set Bc=null
endfunction
function SingedChemicalRageFinish takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer BQ=GetHandleId(t)
local unit Bc=LoadUnitHandle(O,BQ,0)
local integer RI=LoadInteger(O,BQ,1)
local real Zk=LoadReal(O,BQ,2)
if Bc!=null then
call UnitRemoveAbility(Bc,RI)
call SetUnitState(Bc,ConvertUnitState(32),GetUnitState(Bc,ConvertUnitState(32))-Zk)
call SaveBoolean(O,GetHandleId(Bc),StringHash("SingedChemicalRage"),false)
endif
call FlushChildHashtable(O,BQ)
call DestroyTimer(t)
set t=null
set Bc=null
endfunction
function SingedChemicalRage takes unit Bc,real ba returns nothing
local integer CC=SingedGetLevel(Bc)
local integer RI=bb
local real Zk=2.
local timer t
local real bc=GetUnitState(Bc,UNIT_STATE_LIFE)-ba
if not SingedIsHero(Bc) or LoadBoolean(O,GetHandleId(Bc),StringHash("SingedChemicalRage")) then
set Bc=null
return
endif
if bc>GetUnitState(Bc,UNIT_STATE_MAX_LIFE)*.25 then
set Bc=null
return
endif
if CC==2 then
set RI=bd
set Zk=3.
elseif CC==3 then
set RI=be
set Zk=5.
endif
call SaveBoolean(O,GetHandleId(Bc),StringHash("SingedChemicalRage"),true)
call UnitAddAbility(Bc,RI)
call SetUnitState(Bc,ConvertUnitState(32),GetUnitState(Bc,ConvertUnitState(32))+Zk)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\Bloodlust\\BloodlustTarget.mdl",Bc,"overhead"))
set t=CreateTimer()
call SaveUnitHandle(O,GetHandleId(t),0,Bc)
call SaveInteger(O,GetHandleId(t),1,RI)
call SaveReal(O,GetHandleId(t),2,Zk)
call TimerStart(t,5.,false,function SingedChemicalRageFinish)
set t=null
set Bc=null
endfunction
function SingedAlchemyGold takes unit Bc,unit Om returns nothing
local integer CC=1
local integer bw=GetRandomInt(1,100)
local integer BU=0
local integer bx=2
local integer by=5
local integer bz=10
local integer BF=0
local player h=null
if not SingedIsHero(Bc) or Om==null then
set Bc=null
set Om=null
return
endif
if not IsUnitEnemy(Om,GetOwningPlayer(Bc)) then
set Bc=null
set Om=null
return
endif
set CC=SingedGetLevel(Bc)
set BF=GetUnitUserData(Bc)
set h=GetOwningPlayer(Bc)
if CC==2 then
set bx=2
set by=8
set bz=12
elseif CC==3 then
set bx=4
set by=10
set bz=15
endif
if bw<=bx then
set BU=5
elseif bw<=bx+by then
set BU=2
elseif bw<=bx+by+bz then
set BU=1
endif
if BU>0 then
if BF>=1 and BF<=8 then
set h=Player(BF-1)
endif
call AdjustPlayerStateBJ(BU,h,PLAYER_STATE_RESOURCE_GOLD)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl",GetUnitX(Bc),GetUnitY(Bc)))
call OC5F_Eb(Bc,"+"+I2S(BU),100.,77.,0.,h)
endif
set Bc=null
set Om=null
set h=null
endfunction
function YseraIsBattleActiveAbility takes integer RI returns boolean
return RI==Yi or RI==Yj or RI==Yk or RI==Yl
endfunction
function YseraIsDragonActiveAbility takes integer RI returns boolean
return RI==Ym or RI==Yn or RI==Yo
endfunction
function YseraIsActiveAbility takes integer RI returns boolean
return YseraIsBattleActiveAbility(RI) or YseraIsDragonActiveAbility(RI)
endfunction
function YseraCanCastActiveAbility takes unit Bc,integer RI returns boolean
local integer Zl=0
local boolean DJ=true
if Bc==null then
return false
endif
set Zl=GetUnitTypeId(Bc)
if YseraIsBattleActiveAbility(RI) then
set DJ=Zl==Zm
elseif YseraIsDragonActiveAbility(RI) then
set DJ=Zl==Zn
endif
set Bc=null
return DJ
endfunction
function YseraIsAlive takes unit Om returns boolean
if Om==null then
return false
endif
return GetUnitState(Om,UNIT_STATE_LIFE)>.405 and not IsUnitType(Om,UNIT_TYPE_DEAD)
endfunction
function YseraIsEnemyAlive takes unit Pf,unit Om returns boolean
if Pf==null or Om==null then
return false
endif
if not YseraIsAlive(Om) then
return false
endif
if not IsUnitEnemy(Om,GetOwningPlayer(Pf)) then
return false
endif
return GetUnitAbilityLevel(Om,$4176756C)==0
endfunction
function YseraCastBusyReset takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
if Bc!=null then
call SaveBoolean(O,GetHandleId(Bc),StringHash("YseraCastBusy"),false)
call RemoveSavedHandle(O,GetHandleId(Bc),StringHash("YseraCastBusyTimer"))
endif
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTimer(t)
set Bc=null
set t=null
endfunction
function YseraSetCastBusy takes unit Bc,real Ez returns nothing
local timer Zo=null
local timer t=null
if Bc==null or Ez<=0. then
set Bc=null
return
endif
set Zo=LoadTimerHandle(O,GetHandleId(Bc),StringHash("YseraCastBusyTimer"))
if Zo!=null then
call FlushChildHashtable(O,GetHandleId(Zo))
call DestroyTimer(Zo)
endif
set t=CreateTimer()
call SaveBoolean(O,GetHandleId(Bc),StringHash("YseraCastBusy"),true)
call SaveTimerHandle(O,GetHandleId(Bc),StringHash("YseraCastBusyTimer"),t)
call SaveUnitHandle(O,GetHandleId(t),0,Bc)
call TimerStart(t,Ez,false,function YseraCastBusyReset)
set Zo=null
set t=null
set Bc=null
endfunction
function YseraCanSleepTarget takes unit Pf,unit Om returns boolean
if not YseraIsEnemyAlive(Pf,Om) then
return false
endif
return not IsUnitType(Om,UNIT_TYPE_HERO) and not IsUnitType(Om,UNIT_TYPE_STRUCTURE) and not IsUnitType(Om,UNIT_TYPE_SUMMONED)
endfunction
function YseraDistance takes real Qv,real Qw,real Zb,real Zc returns real
local real ID=Zb-Qv
local real IF=Zc-Qw
return SquareRoot(ID*ID+IF*IF)
endfunction
function YseraIsPointInForwardRect takes unit Pf,unit Om,real Ne,real Eo returns boolean
local real Pm=GetUnitFacing(Pf)
local real ID=GetUnitX(Om)-GetUnitX(Pf)
local real IF=GetUnitY(Om)-GetUnitY(Pf)
local real Z2=ID*CosBJ(Pm)+IF*SinBJ(Pm)
local real W9=-ID*SinBJ(Pm)+IF*CosBJ(Pm)
return Z2>=0. and Z2<=Eo and RAbsBJ(W9)<=Ne*.5
endfunction
function YseraMoveSlowRestore takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer BQ=GetHandleId(t)
local unit Om=LoadUnitHandle(O,BQ,0)
local real QT=LoadReal(O,BQ,1)
if Om!=null then
call SetUnitMoveSpeed(Om,QT)
call RemoveSavedHandle(O,GetHandleId(Om),StringHash("YseraMoveSlowTimer"))
endif
call FlushChildHashtable(O,BQ)
call DestroyTimer(t)
set Om=null
set t=null
endfunction
function YseraApplyMoveSlow takes unit Om,real Zu,real Ez returns nothing
local integer Zs=0
local timer Zo=null
local timer t=null
local real QT=0.
if Om==null then
return
endif
if Zu<.1 then
set Zu=.1
endif
set Zs=GetHandleId(Om)
set Zo=LoadTimerHandle(O,Zs,StringHash("YseraMoveSlowTimer"))
if Zo!=null then
set QT=LoadReal(O,GetHandleId(Zo),1)
call FlushChildHashtable(O,GetHandleId(Zo))
call DestroyTimer(Zo)
else
set QT=GetUnitMoveSpeed(Om)
endif
set t=CreateTimer()
call SetUnitMoveSpeed(Om,QT*Zu)
call SaveTimerHandle(O,Zs,StringHash("YseraMoveSlowTimer"),t)
call SaveUnitHandle(O,GetHandleId(t),0,Om)
call SaveReal(O,GetHandleId(t),1,QT)
call TimerStart(t,Ez,false,function YseraMoveSlowRestore)
set Zo=null
set t=null
set Om=null
endfunction
function YseraArmorDeltaRestore takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer BQ=GetHandleId(t)
local unit Om=LoadUnitHandle(O,BQ,0)
local real Zr=LoadReal(O,BQ,1)
local integer Dt=LoadInteger(O,BQ,2)
if Om!=null then
call SetUnitState(Om,ConvertUnitState(32),GetUnitState(Om,ConvertUnitState(32))-Zr)
call RemoveSavedHandle(O,GetHandleId(Om),Dt)
endif
call FlushChildHashtable(O,BQ)
call DestroyTimer(t)
set Om=null
set t=null
endfunction
function YseraApplyArmorDelta takes unit Om,real Zr,real Ez,integer Dt returns nothing
local integer Zs=0
local timer Zo=null
local timer t=null
if Om==null then
return
endif
set Zs=GetHandleId(Om)
set Zo=LoadTimerHandle(O,Zs,Dt)
if Zo!=null then
call FlushChildHashtable(O,GetHandleId(Zo))
call DestroyTimer(Zo)
else
call SetUnitState(Om,ConvertUnitState(32),GetUnitState(Om,ConvertUnitState(32))+Zr)
endif
set t=CreateTimer()
call SaveTimerHandle(O,Zs,Dt,t)
call SaveUnitHandle(O,GetHandleId(t),0,Om)
call SaveReal(O,GetHandleId(t),1,Zr)
call SaveInteger(O,GetHandleId(t),2,Dt)
call TimerStart(t,Ez,false,function YseraArmorDeltaRestore)
set Zo=null
set t=null
set Om=null
endfunction
function YseraApplyDreamCorrosion takes unit Pf,unit Om returns nothing
if GetUnitAbilityLevel(Pf,Zq)>0 and YseraIsEnemyAlive(Pf,Om) then
call YseraApplyArmorDelta(Om,-2.,4.,Zq)
call YDWETimerDestroyEffect(1.,AddSpecialEffectTarget("LJQ_Isira_MJFS.mdx",Om,"origin"))
endif
set Pf=null
set Om=null
endfunction
function YseraDamageTarget takes unit Pf,unit Om,real P8 returns nothing
if YseraIsEnemyAlive(Pf,Om) then
call UnitDamageTargetBJ(Pf,Om,P8,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
call YseraApplyDreamCorrosion(Pf,Om)
endif
set Pf=null
set Om=null
endfunction
function YseraDamageForwardRectEx takes unit Bc,real Ne,real Eo,real P8,real Z1 returns nothing
local group DG=CreateGroup()
local unit D6=null
call GroupEnumUnitsInRange(DG,GetUnitX(Bc),GetUnitY(Bc),Eo+Ne,null)
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
if YseraIsEnemyAlive(Bc,D6) and YseraIsPointInForwardRect(Bc,D6,Ne,Eo) then
call YseraDamageTarget(Bc,D6,P8)
if Z1>0. then
call PauseUnitEx(Bc,D6,Z1)
endif
endif
endloop
call DestroyGroup(DG)
set DG=null
set D6=null
set Bc=null
endfunction
function YseraDamageFixedForwardRect takes unit Bc,real Z3,real Z4,real Pm,real Ne,real Eo,real P8,real Z1 returns nothing
local group DG=CreateGroup()
local unit D6=null
local real ID=0.
local real IF=0.
local real Z2=0.
local real W9=0.
call GroupEnumUnitsInRange(DG,Z3,Z4,Eo+Ne,null)
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
if YseraIsEnemyAlive(Bc,D6) then
set ID=GetUnitX(D6)-Z3
set IF=GetUnitY(D6)-Z4
set Z2=ID*CosBJ(Pm)+IF*SinBJ(Pm)
set W9=-ID*SinBJ(Pm)+IF*CosBJ(Pm)
if Z2>=0. and Z2<=Eo and RAbsBJ(W9)<=Ne*.5 then
call YseraDamageTarget(Bc,D6,P8)
if Z1>0. then
call PauseUnitEx(Bc,D6,Z1)
endif
endif
endif
endloop
call DestroyGroup(DG)
set DG=null
set D6=null
set Bc=null
endfunction
function YseraDreamEntanglePoint takes unit Bc,real FF,real FG returns nothing
local group DG=CreateGroup()
local unit D6=null
call YDWETimerDestroyEffect(4.,AddSpecialEffect("LJQ_Isira_MJCR02.mdx",FF,FG))
call GroupEnumUnitsInRange(DG,FF,FG,180.,null)
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
if YseraIsEnemyAlive(Bc,D6) then
call PauseUnitEx(Bc,D6,4.)
call LoopDamage(Bc,D6,30.,1.,4.)
call YDWETimerDestroyEffect(4.,AddSpecialEffectTarget("LJQ_Isira_MJCR01.mdx",D6,"origin"))
endif
endloop
call DestroyGroup(DG)
set DG=null
set D6=null
set Bc=null
endfunction
function YseraDreamEntangle takes unit Bc,real FF,real FG returns nothing
call YseraSetCastBusy(Bc,4.2)
call YseraDreamEntanglePoint(Bc,FF,FG)
set Bc=null
endfunction
function YseraSleepCurse takes unit Bc returns nothing
local real Pm=GetUnitFacing(Bc)
local real FF=GetUnitX(Bc)+CosBJ(Pm)*480.
local real FG=GetUnitY(Bc)+SinBJ(Pm)*480.
local group DG=CreateGroup()
local unit D6=null
call YseraSetCastBusy(Bc,3.2)
call YDWETimerDestroyEffect(3.,AddSpecialEffect("LJQ_Isira_CSZM01.mdx",FF,FG))
call GroupEnumUnitsInRange(DG,FF,FG,320.,null)
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
if YseraCanSleepTarget(Bc,D6) then
call YseraDamageTarget(Bc,D6,200.)
call PauseUnitEx(Bc,D6,3.)
call YDWETimerDestroyEffect(3.,AddSpecialEffectTarget("LJQ_Isira_CSZM02.mdx",D6,"origin"))
endif
endloop
call DestroyGroup(DG)
set DG=null
set D6=null
set Bc=null
endfunction
function YseraRegisterCreatedUnit takes unit Pf,unit Zw returns nothing
if Pf!=null and Zw!=null then
call GroupAddUnit(JW,Zw)
call SetUnitUserData(Zw,GetUnitUserData(Pf))
if GetUnitUserData(Pf)>0 then
call GroupAddUnit(JH[GetUnitUserData(Pf)],Zw)
endif
call UnitAddType(Zw,UNIT_TYPE_SUMMONED)
endif
set Pf=null
set Zw=null
endfunction
function YseraDragonReturn takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer Pr=GetHandleId(t)
local unit Bc=LoadUnitHandle(O,Pr,0)
local unit Zv=LoadUnitHandle(O,Pr,1)
local real FF=0.
local real FG=0.
local real OW=0.
local real Zx=.1
if LoadBoolean(O,Pr,2) then
set Bc=null
set Zv=null
set t=null
return
endif
call SaveBoolean(O,Pr,2,true)
if Zv!=null then
set FF=GetUnitX(Zv)
set FG=GetUnitY(Zv)
set OW=GetUnitFacing(Zv)
if GetUnitState(Zv,UNIT_STATE_MAX_LIFE)>0. then
set Zx=GetUnitState(Zv,UNIT_STATE_LIFE)/GetUnitState(Zv,UNIT_STATE_MAX_LIFE)
endif
if Zx<.1 then
set Zx=.1
endif
elseif Bc!=null then
set FF=GetUnitX(Bc)
set FG=GetUnitY(Bc)
set OW=GetUnitFacing(Bc)
endif
if Bc!=null then
call SetUnitX(Bc,FF)
call SetUnitY(Bc,FG)
call SetUnitFacing(Bc,OW)
call SetUnitInvulnerable(Bc,false)
call PauseUnit(Bc,false)
call ShowUnit(Bc,true)
call SetUnitState(Bc,UNIT_STATE_LIFE,GetUnitState(Bc,UNIT_STATE_MAX_LIFE)*Zx)
call SaveBoolean(O,GetHandleId(Bc),StringHash("YseraDragonActive"),false)
endif
if Zv!=null then
call RemoveUnit(Zv)
endif
call FlushChildHashtable(O,Pr)
call DestroyTrigger(t)
set Bc=null
set Zv=null
set t=null
endfunction
function YseraAwakeningImpact takes unit Bc,real FF,real FG returns nothing
local group DG=CreateGroup()
local unit D6=null
local real Q5=0.
call YDWETimerDestroyEffect(3.,AddSpecialEffect("LJQ_Isira_SX.mdx",FF,FG))
call GroupEnumUnitsInRange(DG,FF,FG,450.,null)
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
if YseraIsEnemyAlive(Bc,D6) then
set Q5=YseraDistance(FF,FG,GetUnitX(D6),GetUnitY(D6))
if Q5<=250. then
call YseraDamageTarget(Bc,D6,200.)
else
call YseraDamageTarget(Bc,D6,100.)
endif
call PauseUnitEx(Bc,D6,1.5)
call YseraApplyMoveSlow(D6,.65,4.)
endif
endloop
call DestroyGroup(DG)
set DG=null
set D6=null
set Bc=null
endfunction
function YseraAwakening takes unit Bc returns nothing
local unit Zv=null
local trigger t=null
local real FF=GetUnitX(Bc)
local real FG=GetUnitY(Bc)
local real Zt=GetUnitState(Bc,UNIT_STATE_LIFE)/GetUnitState(Bc,UNIT_STATE_MAX_LIFE)
call YseraSetCastBusy(Bc,1.8)
call YseraAwakeningImpact(Bc,FF,FG)
if not LoadBoolean(O,GetHandleId(Bc),StringHash("YseraDragonActive")) then
call SaveBoolean(O,GetHandleId(Bc),StringHash("YseraDragonActive"),true)
set Zv=CreateUnit(GetOwningPlayer(Bc),Zn,FF,FG,GetUnitFacing(Bc))
call YseraRegisterCreatedUnit(Bc,Zv)
call SetUnitState(Zv,UNIT_STATE_LIFE,GetUnitState(Zv,UNIT_STATE_MAX_LIFE)*Zt)
call SetUnitState(Zv,UNIT_STATE_MANA,10.)
call SetUnitInvulnerable(Bc,true)
call PauseUnit(Bc,true)
call ShowUnit(Bc,false)
set t=CreateTrigger()
call SaveUnitHandle(O,GetHandleId(t),0,Bc)
call SaveUnitHandle(O,GetHandleId(t),1,Zv)
call TriggerRegisterTimerEvent(t,16.,false)
call TriggerRegisterDeathEvent(t,Zv)
call TriggerAddAction(t,function YseraDragonReturn)
endif
set Zv=null
set t=null
set Bc=null
endfunction
function YseraMindDisruptAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer Pr=GetHandleId(t)
local unit Bc=LoadUnitHandle(O,Pr,0)
local unit D6=null
local unit Z0=Bc
local integer BB=1
local integer Zy=LoadInteger(O,Pr,10)+1
call SaveInteger(O,Pr,10,Zy)
loop
exitwhen BB>3
set D6=LoadUnitHandle(O,Pr,BB)
if YseraIsEnemyAlive(Bc,D6) then
call YDWETimerDestroyLightning(.25,AddLightningEx("XZRL",false,GetUnitX(Z0),GetUnitY(Z0),GetUnitFlyHeight(Z0)+80.,GetUnitX(D6),GetUnitY(D6),GetUnitFlyHeight(D6)+80.))
call YseraDamageTarget(Bc,D6,90.)
call YseraApplyMoveSlow(D6,.65,1.5)
call YDWETimerDestroyEffect(.75,AddSpecialEffectTarget("LJQ_Isira_XZRL01.mdx",D6,"origin"))
set Z0=D6
endif
set BB=BB+1
endloop
if Zy>=3 or Bc==null or IsUnitType(Bc,UNIT_TYPE_DEAD) then
call FlushChildHashtable(O,Pr)
call DestroyTrigger(t)
endif
set Bc=null
set D6=null
set Z0=null
set t=null
endfunction
function YseraMindDisruptSaveTarget takes trigger t,unit Om returns nothing
local integer Pr=GetHandleId(t)
local integer y=LoadInteger(O,Pr,9)
local integer BB=1
if Om==null or y>=3 then
set t=null
set Om=null
return
endif
loop
exitwhen BB>y
if LoadUnitHandle(O,Pr,BB)==Om then
set t=null
set Om=null
return
endif
set BB=BB+1
endloop
set y=y+1
call SaveInteger(O,Pr,9,y)
call SaveUnitHandle(O,Pr,y,Om)
set t=null
set Om=null
endfunction
function YseraMindDisrupt takes unit Bc,unit Om returns nothing
local trigger t=CreateTrigger()
local group DG=null
local unit D6=null
call YseraSetCastBusy(Bc,3.2)
if not YseraIsEnemyAlive(Bc,Om) then
set DG=SelectRange(Bc,GetUnitX(Bc),GetUnitY(Bc),700.)
set Om=FirstOfGroup(DG)
call DestroyGroup(DG)
set DG=null
endif
if not YseraIsEnemyAlive(Bc,Om) then
call DestroyTrigger(t)
set t=null
set Bc=null
set Om=null
return
endif
call SaveUnitHandle(O,GetHandleId(t),0,Bc)
call YseraMindDisruptSaveTarget(t,Om)
set DG=SelectRange(Bc,GetUnitX(Om),GetUnitY(Om),450.)
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null or LoadInteger(O,GetHandleId(t),9)>=3
call GroupRemoveUnit(DG,D6)
if YseraIsEnemyAlive(Bc,D6) then
call YseraMindDisruptSaveTarget(t,D6)
endif
endloop
call DestroyGroup(DG)
call TriggerRegisterTimerEvent(t,0.,false)
call TriggerRegisterTimerEvent(t,1.,true)
call TriggerAddAction(t,function YseraMindDisruptAction)
set DG=null
set D6=null
set t=null
set Bc=null
set Om=null
endfunction
function YseraMindDestroyAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer Pr=GetHandleId(t)
local unit Bc=LoadUnitHandle(O,Pr,0)
local integer Zy=LoadInteger(O,Pr,1)+1
local real Pm=0.
local effect DE=null
call SaveInteger(O,Pr,1,Zy)
if Bc!=null and not IsUnitType(Bc,UNIT_TYPE_DEAD) then
set Pm=GetUnitFacing(Bc)
set DE=AddSpecialEffect("LJQ_Isira_XZCH01.mdx",GetUnitX(Bc)+CosBJ(Pm)*320.,GetUnitY(Bc)+SinBJ(Pm)*320.)
call EXEffectMatRotateZ(DE,Pm)
call YDWETimerDestroyEffect(.8,DE)
call YseraDamageForwardRectEx(Bc,260.,650.,150.,.5)
endif
if Zy>=4 or Bc==null or IsUnitType(Bc,UNIT_TYPE_DEAD) then
call FlushChildHashtable(O,Pr)
call DestroyTrigger(t)
endif
set Bc=null
set DE=null
set t=null
endfunction
function YseraMindDestroy takes unit Bc returns nothing
local trigger t=CreateTrigger()
call YseraSetCastBusy(Bc,4.2)
call SaveUnitHandle(O,GetHandleId(t),0,Bc)
call TriggerRegisterTimerEvent(t,0.,false)
call TriggerRegisterTimerEvent(t,1.,true)
call TriggerAddAction(t,function YseraMindDestroyAction)
set t=null
set Bc=null
endfunction
function YseraGreenBreathAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer Pr=GetHandleId(t)
local unit Bc=LoadUnitHandle(O,Pr,0)
local integer Zy=LoadInteger(O,Pr,1)+1
local real Z3=LoadReal(O,Pr,2)
local real Z4=LoadReal(O,Pr,3)
local real Pm=LoadReal(O,Pr,4)
local effect DE=LoadEffectHandle(O,Pr,5)
local effect Z7=LoadEffectHandle(O,Pr,6)
call SaveInteger(O,Pr,1,Zy)
if Bc!=null and not IsUnitType(Bc,UNIT_TYPE_DEAD) and Zy<=5 then
call YseraDamageFixedForwardRect(Bc,Z3,Z4,Pm,240.,650.,160.,0.)
endif
if Zy>=6 or Bc==null or IsUnitType(Bc,UNIT_TYPE_DEAD) then
if DE!=null then
call DestroyEffect(DE)
endif
if Z7!=null then
call DestroyEffect(Z7)
endif
call FlushChildHashtable(O,Pr)
call DestroyTrigger(t)
endif
set Bc=null
set DE=null
set Z7=null
set t=null
endfunction
function YseraGreenBreath takes unit Bc returns nothing
local trigger t=CreateTrigger()
local integer Pr=GetHandleId(t)
local real Z3=GetUnitX(Bc)
local real Z4=GetUnitY(Bc)
local real Pm=GetUnitFacing(Bc)
local real Z5=Z3+CosBJ(Pm)*320.
local real Z6=Z4+SinBJ(Pm)*320.
local effect DE=AddSpecialEffect("LJQ_Isira_FCTX01.mdx",Z5,Z6)
local effect Z7=AddSpecialEffect("LJQ_Isira_FCTX02.mdx",Z5,Z6)
call YseraSetCastBusy(Bc,5.2)
call YseraApplyArmorDelta(Bc,60.,5.2,Yn)
call EXEffectMatRotateZ(DE,Pm)
call EXEffectMatRotateZ(Z7,Pm)
call SaveUnitHandle(O,Pr,0,Bc)
call SaveInteger(O,Pr,1,1)
call SaveReal(O,Pr,2,Z3)
call SaveReal(O,Pr,3,Z4)
call SaveReal(O,Pr,4,Pm)
call SaveEffectHandle(O,Pr,5,DE)
call SaveEffectHandle(O,Pr,6,Z7)
call YseraDamageFixedForwardRect(Bc,Z3,Z4,Pm,240.,650.,160.,0.)
call TriggerRegisterTimerEvent(t,1.,true)
call TriggerAddAction(t,function YseraGreenBreathAction)
set t=null
set DE=null
set Z7=null
set Bc=null
endfunction
function YseraPickRandomEnemy takes unit Bc,real Px returns unit
local group DG=SelectRange(Bc,GetUnitX(Bc),GetUnitY(Bc),Px)
local unit D6=null
local unit DJ=null
local integer y=CountUnitsInGroup(DG)
local integer Cx=0
local integer BB=0
if y>0 then
set Cx=GetRandomInt(1,y)
endif
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
if YseraIsEnemyAlive(Bc,D6) then
set BB=BB+1
if BB==Cx then
set DJ=D6
endif
endif
endloop
call DestroyGroup(DG)
set DG=null
set D6=null
set Bc=null
return DJ
endfunction
function YseraNightmareShotAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer Pr=GetHandleId(t)
local unit Bc=LoadUnitHandle(O,Pr,0)
local unit Om=null
local integer y=LoadInteger(O,Pr,1)+1
call SaveInteger(O,Pr,1,y)
if Bc!=null and not IsUnitType(Bc,UNIT_TYPE_DEAD) then
set Om=YseraPickRandomEnemy(Bc,1200.)
if Om!=null then
call YDWETimerDestroyEffect(1.,AddSpecialEffectTarget("LJQ_Isira_MYSJ.mdx",Om,"origin"))
call YseraDamageTarget(Bc,Om,180.)
call YseraApplyMoveSlow(Om,.7,2.)
endif
endif
if y>=6 or Bc==null or IsUnitType(Bc,UNIT_TYPE_DEAD) then
call FlushChildHashtable(O,Pr)
call DestroyTrigger(t)
endif
set Bc=null
set Om=null
set t=null
endfunction
function YseraNightmareShotFinish takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
if Bc!=null then
call SetUnitInvulnerable(Bc,false)
call PauseUnit(Bc,false)
endif
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTimer(t)
set Bc=null
set t=null
endfunction
function YseraNightmareShot takes unit Bc returns nothing
local trigger RL=CreateTrigger()
local timer t=CreateTimer()
call YseraSetCastBusy(Bc,4.2)
call SetUnitInvulnerable(Bc,true)
call PauseUnit(Bc,true)
call SaveUnitHandle(O,GetHandleId(t),0,Bc)
call TimerStart(t,4.,false,function YseraNightmareShotFinish)
call SaveUnitHandle(O,GetHandleId(RL),0,Bc)
call TriggerRegisterTimerEvent(RL,.6,true)
call TriggerAddAction(RL,function YseraNightmareShotAction)
set RL=null
set t=null
set Bc=null
endfunction
function YseraHasEnemyInRange takes unit Bc,real Px returns boolean
local group DG=null
local unit Om=null
local boolean DJ=false
if Bc!=null then
set DG=SelectRange(Bc,GetUnitX(Bc),GetUnitY(Bc),Px)
set Om=FirstOfGroup(DG)
set DJ=Om!=null
call DestroyGroup(DG)
endif
set DG=null
set Om=null
set Bc=null
return DJ
endfunction
function YseraHasForwardEnemy takes unit Bc,real Ne,real Eo returns boolean
local group DG=CreateGroup()
local unit D6=null
local boolean DJ=false
if Bc==null then
call DestroyGroup(DG)
set DG=null
return false
endif
call GroupEnumUnitsInRange(DG,GetUnitX(Bc),GetUnitY(Bc),Eo+Ne,null)
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null or DJ
call GroupRemoveUnit(DG,D6)
if YseraIsEnemyAlive(Bc,D6) and YseraIsPointInForwardRect(Bc,D6,Ne,Eo) then
set DJ=true
endif
endloop
call DestroyGroup(DG)
set DG=null
set D6=null
set Bc=null
return DJ
endfunction
function YseraHasAutoAbility takes unit Bc returns boolean
if GetUnitAbilityLevel(Bc,Yi)>0 then
set Bc=null
return true
endif
if GetUnitAbilityLevel(Bc,Yj)>0 then
set Bc=null
return true
endif
if GetUnitAbilityLevel(Bc,Yk)>0 then
set Bc=null
return true
endif
if GetUnitAbilityLevel(Bc,Yl)>0 then
set Bc=null
return true
endif
if GetUnitAbilityLevel(Bc,Ym)>0 then
set Bc=null
return true
endif
if GetUnitTypeId(Bc)==Zn or GetUnitAbilityLevel(Bc,Yn)>0 then
set Bc=null
return true
endif
if GetUnitAbilityLevel(Bc,Yo)>0 then
set Bc=null
return true
endif
set Bc=null
return false
endfunction
function YseraCanAutoCast takes unit Bc returns boolean
if Bc==null or not YseraIsAlive(Bc) then
set Bc=null
return false
endif
if GetUnitTypeId(Bc)!=Zm and GetUnitTypeId(Bc)!=Zn then
set Bc=null
return false
endif
if GetUnitAbilityLevel(Bc,$4176756C)>0 or LoadBoolean(O,GetHandleId(Bc),StringHash("YseraCastBusy")) or LoadBoolean(O,GetHandleId(Bc),StringHash("YseraEmeraldSleeping")) then
set Bc=null
return false
endif
if not YseraHasAutoAbility(Bc) then
set Bc=null
return false
endif
set Bc=null
return true
endfunction
function YseraAutoCast takes unit Bc returns nothing
local unit Om=null
if not YseraCanAutoCast(Bc) then
set Bc=null
return
endif
if GetUnitAbilityLevel(Bc,Yn)>0 then
if GetUnitAbilityLevel(Bc,Yn)>0 and YseraHasForwardEnemy(Bc,240.,650.) and NagaTryAutoCast(Bc,Yn,10.,14.) then
call YseraGreenBreath(Bc)
elseif GetUnitAbilityLevel(Bc,Ym)>0 and YseraHasForwardEnemy(Bc,260.,650.) and NagaTryAutoCast(Bc,Ym,10.,10.) then
call YseraMindDestroy(Bc)
elseif GetUnitAbilityLevel(Bc,Yo)>0 and YseraHasEnemyInRange(Bc,1200.) and NagaTryAutoCast(Bc,Yo,10.,18.) then
call YseraNightmareShot(Bc)
endif
else
if GetUnitAbilityLevel(Bc,Yk)>0 and not LoadBoolean(O,GetHandleId(Bc),StringHash("YseraDragonActive")) and YseraHasEnemyInRange(Bc,450.) and NagaTryAutoCast(Bc,Yk,20.,35.) then
call YseraAwakening(Bc)
else
set Om=YseraPickRandomEnemy(Bc,700.)
if Om!=null and GetUnitAbilityLevel(Bc,Yl)>0 and NagaTryAutoCast(Bc,Yl,10.,16.) then
call YseraMindDisrupt(Bc,Om)
elseif GetUnitAbilityLevel(Bc,Yj)>0 and YseraHasForwardEnemy(Bc,640.,800.) and NagaTryAutoCast(Bc,Yj,10.,14.) then
call YseraSleepCurse(Bc)
elseif GetUnitAbilityLevel(Bc,Yi)>0 and YseraHasForwardEnemy(Bc,700.,740.) and NagaTryAutoCast(Bc,Yi,10.,10.) then
if Om!=null then
call YseraDreamEntangle(Bc,GetUnitX(Om),GetUnitY(Om))
else
call YseraDreamEntangle(Bc,GetUnitX(Bc)+CosBJ(GetUnitFacing(Bc))*370.,GetUnitY(Bc)+SinBJ(GetUnitFacing(Bc))*370.)
endif
endif
endif
endif
set Om=null
set Bc=null
endfunction
function YseraEmeraldRevivalWake takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
if Bc!=null then
call PauseUnit(Bc,false)
call SetUnitState(Bc,UNIT_STATE_LIFE,GetUnitState(Bc,UNIT_STATE_LIFE)+GetUnitState(Bc,UNIT_STATE_MAX_LIFE)*.25)
call SaveBoolean(O,GetHandleId(Bc),StringHash("YseraEmeraldSleeping"),false)
call YDWETimerDestroyEffect(2.,AddSpecialEffectTarget("LJQ_Isira_FCFS01.mdx",Bc,"origin"))
endif
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTimer(t)
set Bc=null
set t=null
endfunction
function YseraEmeraldRevivalUnlock takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
if Bc!=null then
call SaveBoolean(O,GetHandleId(Bc),StringHash("YseraEmeraldCooldown"),false)
endif
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTimer(t)
set Bc=null
set t=null
endfunction
function YseraOnDamage takes unit Om,unit Pf,real P8 returns real
local integer Zs=0
local integer y=0
local real Qe=0.
local timer bX=null
local timer bY=null
if Om==null or GetUnitAbilityLevel(Om,Qj)<=0 then
set Om=null
set Pf=null
return P8
endif
set Zs=GetHandleId(Om)
if LoadBoolean(O,Zs,StringHash("YseraEmeraldSleeping")) then
set Om=null
set Pf=null
return P8*.2
endif
set Qe=GetUnitState(Om,UNIT_STATE_MAX_LIFE)
set y=LoadInteger(O,Zs,StringHash("YseraEmeraldCount"))
if y<2 and not LoadBoolean(O,Zs,StringHash("YseraEmeraldCooldown")) and GetUnitState(Om,UNIT_STATE_LIFE)-P8<=1. or GetUnitState(Om,UNIT_STATE_LIFE)<=Qe*.3 then
call SaveInteger(O,Zs,StringHash("YseraEmeraldCount"),y+1)
call SaveBoolean(O,Zs,StringHash("YseraEmeraldCooldown"),true)
call SaveBoolean(O,Zs,StringHash("YseraEmeraldSleeping"),true)
call SetUnitState(Om,UNIT_STATE_LIFE,RMaxBJ(1.,Qe*.05))
call PauseUnit(Om,true)
call YDWETimerDestroyEffect(3.,AddSpecialEffectTarget("LJQ_Isira_FCFS02.mdx",Om,"origin"))
set bX=CreateTimer()
call SaveUnitHandle(O,GetHandleId(bX),0,Om)
call TimerStart(bX,3.,false,function YseraEmeraldRevivalWake)
set bY=CreateTimer()
call SaveUnitHandle(O,GetHandleId(bY),0,Om)
call TimerStart(bY,18.,false,function YseraEmeraldRevivalUnlock)
set P8=0.
endif
set bX=null
set bY=null
set Om=null
set Pf=null
return P8
endfunction
function YseraRegisterEmeraldRevival takes unit Bc returns nothing
call SaveInteger(O,GetHandleId(Bc),StringHash("YseraEmeraldCount"),0)
call SaveBoolean(O,GetHandleId(Bc),StringHash("YseraEmeraldCooldown"),false)
call SaveBoolean(O,GetHandleId(Bc),StringHash("YseraEmeraldSleeping"),false)
set Bc=null
endfunction
function YseraDeathAwakening takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer BQ=GetHandleId(t)
local unit Bc=LoadUnitHandle(O,BQ,0)
local unit Zv=null
local integer PH=0
local real FF=0.
local real FG=0.
local real OW=0.
if Bc!=null then
set PH=GetUnitUserData(Bc)
if PH>0 and IsLivingPlayer(ConvertedPlayer(PH)) then
set FF=GetUnitX(Bc)
set FG=GetUnitY(Bc)
set OW=GetUnitFacing(Bc)
set Zv=CreateUnit(GetOwningPlayer(Bc),Zn,FF,FG,OW)
call SetUnitUserData(Zv,PH)
call SetUnitColor(Zv,GetPlayerColor(Player(PH-1)))
call GroupAddUnit(JW,Zv)
call GroupAddUnit(JH[PH],Zv)
call SaveBoolean(O,GetHandleId(Zv),StringHash("YseraDragonActive"),false)
call YseraRegisterEmeraldRevival(Zv)
call YseraAwakeningImpact(Zv,FF,FG)
call IssuePointOrder(Zv,"attack",GetPlayerStartLocationX(Player(PH-1)),GetPlayerStartLocationY(Player(PH-1)))
endif
call RemoveUnit(Bc)
endif
call FlushChildHashtable(O,BQ)
call DestroyTimer(t)
set Bc=null
set Zv=null
set t=null
endfunction
function LifeGiveEnemyCondition takes nothing returns boolean
return IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(GetTriggerUnit()))
endfunction
function LifeGiveAllyCondition takes nothing returns boolean
return IsUnitAlly(GetFilterUnit(),GetOwningPlayer(GetTriggerUnit()))
endfunction
function LifeGive takes unit i,integer Ph returns nothing
local group DG=CreateGroup()
local real FF=GetUnitX(i)
local real FG=GetUnitY(i)
local unit Qf=null
local unit a3=null
local unit D6=null
local real bC=0
local real bD=101
call GroupEnumUnitsInRange(DG,FF,FG,600,Condition(function LifeGiveEnemyCondition))
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
if GetUnitLifePercent(D6)>bC then
set bC=GetUnitLifePercent(D6)
set Qf=D6
endif
call GroupRemoveUnit(DG,D6)
endloop
call DestroyGroup(DG)
if Qf==null then
call UnitRemoveAbility(i,Ph)
call UnitAddAbility(i,Ph)
set DG=null
set i=null
set Qf=null
set a3=null
set D6=null
return
endif
set DG=CreateGroup()
call GroupEnumUnitsInRange(DG,FF,FG,600,Condition(function LifeGiveAllyCondition))
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
if GetUnitLifePercent(D6)<bD then
set bD=GetUnitLifePercent(D6)
set a3=D6
endif
call GroupRemoveUnit(DG,D6)
endloop
call DestroyGroup(DG)
if a3!=null then
call DestroyEffectFromTime(2,AddSpecialEffect("Abilities\\Spells\\Undead\\Darksummoning\\DarkSummonTarget.mdl",FF,FG))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\DarkRitual\\DarkRitualCaster.mdl",GetUnitX(a3),GetUnitY(a3)))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\DarkRitual\\DarkRitualCaster.mdl",GetUnitX(Qf),GetUnitY(Qf)))
call SetUnitState(a3,UNIT_STATE_LIFE,GetUnitState(a3,UNIT_STATE_LIFE)+600)
endif
set DG=null
set i=null
set Qf=null
set a3=null
set D6=null
endfunction
function Trig_Ability_prepareActions takes nothing returns nothing
local integer BF=GetSpellAbilityId()
local unit Ei=GetTriggerUnit()
local unit Qf=GetSpellTargetUnit()
local player Yf=GetOwningPlayer(Ei)
if BF==$4130595A then
call SetUnitUserData(Ei,GetPlayerId(Yf)+1)
if not RectContainsUnit(Z,Qf) and Yf==Player(0) then
call IssueImmediateOrder(Ei,"stop")
elseif not RectContainsUnit(a,Qf) and Yf==Player(1) then
call IssueImmediateOrder(Ei,"stop")
elseif not RectContainsUnit(b,Qf) and Yf==Player(2) then
call IssueImmediateOrder(Ei,"stop")
elseif not RectContainsUnit(c,Qf) and Yf==Player(3) then
call IssueImmediateOrder(Ei,"stop")
elseif not RectContainsUnit(d,Qf) and Yf==Player(4) then
call IssueImmediateOrder(Ei,"stop")
elseif not RectContainsUnit(e,Qf) and Yf==Player(5) then
call IssueImmediateOrder(Ei,"stop")
elseif not RectContainsUnit(f,Qf) and Yf==Player(6) then
call IssueImmediateOrder(Ei,"stop")
elseif not RectContainsUnit(g,Qf) and Yf==Player(7) then
call IssueImmediateOrder(Ei,"stop")
endif
endif
set Ei=null
set Qf=null
set Yf=null
endfunction
function InitTrig_Ability_prepare takes nothing returns nothing
set Ye=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(Ye,EVENT_PLAYER_UNIT_SPELL_CHANNEL)
call TriggerAddAction(Ye,function Trig_Ability_prepareActions)
endfunction
function Trig_ability_realyActions takes nothing returns nothing
local unit i=GetTriggerUnit()
local integer BF=GetSpellAbilityId()
if IsUnitType(i,UNIT_TYPE_ANCIENT) then
if BF==$41315143 or BF==$41325930 or BF==$41325931 or BF==$41325935 or (GetUnitTypeId(i)==Yh and YseraIsActiveAbility(BF)) then
call IssueImmediateOrder(i,"stop")
endif
endif
set i=null
endfunction
function InitTrig_ability_realy takes nothing returns nothing
set Yg=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(Yg,EVENT_PLAYER_UNIT_SPELL_CHANNEL)
call TriggerAddAction(Yg,function Trig_ability_realyActions)
endfunction
function BustShotAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local real FF=LoadReal(O,GetHandleId(t),2)
local real FG=LoadReal(O,GetHandleId(t),3)
local group DG=LoadGroupHandle(O,GetHandleId(t),4)
local unit i=LoadUnitHandle(O,GetHandleId(t),0)
local unit Om=LoadUnitHandle(O,GetHandleId(t),1)
local real Pm=GetRandomDirectionDeg()
local group Po
local real Qv
local real Qw
local unit D6
local unit Ki
if GetTriggerExecCount(t)>=8 then
call SetUnitInvulnerable(i,false)
call SetUnitPosition(i,FF,FG)
call IssueImmediateOrder(i,"stop")
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl",GetUnitX(i),GetUnitY(i)))
call DestroyEffect(LoadEffectHandle(O,GetHandleId(t),5))
call DestroyEffect(LoadEffectHandle(O,GetHandleId(t),6))
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
call DestroyGroup(DG)
else
set Ki=CreateUnit(GetOwningPlayer(i),$6530304A,GetUnitX(i),GetUnitY(i),GetRandomDirectionDeg())
call UnitApplyTimedLife(Ki,$42487765,1.)
set Po=SelectRange(i,GetUnitX(i),GetUnitY(i),200)
if GetTriggerExecCount(t)==1 then
if IsUnitType(Om,UNIT_TYPE_DEAD) then
set D6=null
else
set D6=Om
endif
else
set D6=FirstOfGroup(Po)
endif
call DestroyGroup(Po)
if D6!=null and not IsUnitType(D6,UNIT_TYPE_DEAD) then
call GroupAddUnit(DG,D6)
set Ki=CreateUnit(GetOwningPlayer(i),$6530304A,GetUnitX(D6),GetUnitY(D6),GetRandomDirectionDeg())
call UnitApplyTimedLife(Ki,$42487765,1.)
set Qv=GetUnitX(D6)+CosBJ(Pm)*100
set Qw=GetUnitY(D6)+SinBJ(Pm)*100
if GetDisFromUnitAndPos(i,Qv,Qw)<=2000 then
call SetUnitX(i,Qv)
call SetUnitY(i,Qw)
call SetUnitFacing(i,Atan2BJ(Qw-FG,Qv-FF))
endif
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl",Qv,Qw))
if GetRandomPercentageBJ()<=35 then
call SetUnitAnimation(i,"attack slam")
call UnitAddAbility(i,$41304E42)
call UnitDamageTargetBJ(i,D6,172*2.5,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
else
call SetUnitAnimation(i,"attack")
call UnitDamageTargetBJ(i,D6,172*1,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
endif
endif
set D6=null
set Ki=null
set Po=null
endif
set Om=null
set t=null
set i=null
set DG=null
endfunction
function BustShot takes unit i,unit Om returns nothing
local trigger t=CreateTrigger()
call SetUnitInvulnerable(i,true)
call SaveReal(O,GetHandleId(t),2,GetUnitX(i))
call SaveReal(O,GetHandleId(t),3,GetUnitY(i))
call SaveAgentHandle(O,GetHandleId(t),0,i)
call SaveAgentHandle(O,GetHandleId(t),1,Om)
call SaveAgentHandle(O,GetHandleId(t),4,CreateGroup())
call SaveEffectHandle(O,GetHandleId(t),5,AddSpecialEffectTarget("Abilities\\Weapons\\PhoenixMissile\\Phoenix_Missile.mdl",i,"weapon"))
call SaveEffectHandle(O,GetHandleId(t),6,AddSpecialEffectTarget("Abilities\\Weapons\\IllidanMissile\\IllidanMissile.mdl",i,"weapon"))
call TriggerRegisterTimerEvent(t,0,false)
call TriggerRegisterTimerEvent(t,.3,true)
call TriggerAddAction(t,function BustShotAction)
set i=null
set Om=null
endfunction
function GetZulJinBuilding takes unit Bc returns unit
local integer BF=GetHandleId(Bc)
set Bc=null
return LoadUnitHandle(O,BF,QI)
endfunction
function SuperAxeActionCallBackGroup takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
if not IsUnitType(GetEnumUnit(),UNIT_TYPE_DEAD) then
call UnitDamageTargetBJ(Bc,GetEnumUnit(),250,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
if IsUnitType(GetEnumUnit(),UNIT_TYPE_DEAD) then
if GetUnitAbilityLevel(Bc,QW)==0 then
call UnitAddAbility(Bc,QW)
call UnitMakeAbilityPermanent(Bc,true,QW)
call UnitAddAbility(GetZulJinBuilding(Bc),QW)
call UnitMakeAbilityPermanent(GetZulJinBuilding(Bc),true,QW)
else
call SetUnitAbilityLevel(Bc,QW,GetUnitAbilityLevel(Bc,QW)+1)
call SetUnitAbilityLevel(GetZulJinBuilding(Bc),QW,GetUnitAbilityLevel(GetZulJinBuilding(Bc),QW)+1)
endif
endif
endif
set t=null
set Bc=null
endfunction
function SuperAxeActionCallBack takes nothing returns nothing
local unit Ki=GetChargeDummy()
local unit Bc=GetChargeSource()
local group DG=SelectRange(Bc,GetUnitX(Ki),GetUnitY(Ki),300)
call ForGroup(DG,function SuperAxeActionCallBackGroup)
call DestroyGroup(DG)
set Ki=null
set DG=null
set Bc=null
endfunction
function SuperAxeAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
local unit Om=LoadUnitHandle(O,GetHandleId(t),1)
local unit Ki=LoadUnitHandle(O,GetHandleId(t),2)
local real Pm=LoadReal(O,GetHandleId(t),3)
local group DG=SelectRange(Bc,GetUnitX(Ki),GetUnitY(Ki),200)
call ForGroup(DG,function SuperAxeActionCallBackGroup)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl",GetUnitX(Om),GetUnitY(Om)))
call UnitDamageTargetBJ(Bc,Om,GetUnitState(Om,UNIT_STATE_MAX_LIFE),ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
if IsUnitType(Om,UNIT_TYPE_DEAD) then
if GetUnitAbilityLevel(Bc,QW)==0 then
call UnitAddAbility(Bc,QW)
call UnitMakeAbilityPermanent(Bc,true,QW)
call UnitAddAbility(GetZulJinBuilding(Bc),QW)
call UnitMakeAbilityPermanent(GetZulJinBuilding(Bc),true,QW)
else
call SetUnitAbilityLevel(Bc,QW,GetUnitAbilityLevel(Bc,QW)+1)
call SetUnitAbilityLevel(GetZulJinBuilding(Bc),QW,GetUnitAbilityLevel(Bc,QW))
endif
endif
call DestroyGroup(DG)
call RemoveUnit(Ki)
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
set t=null
set Bc=null
set Ki=null
set Om=null
set DG=null
endfunction
function SuperAxeAction2 takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit Ki=LoadUnitHandle(O,GetHandleId(t),0)
local real DK=1
local real QV=500
call SetUnitFlyHeight(Ki,0,QV/DK)
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
set Ki=null
set t=null
endfunction
function SuperAxe takes unit Bc,unit Om returns nothing
local real Pm=GetAngleFromUnit(Bc,Om)
local unit Ki=CreateUnit(GetOwningPlayer(Bc),$65303131,GetUnitX(Bc),GetUnitY(Bc),Pm)
local effect DE
local real DK=1
local trigger t=CreateTrigger()
local real QV=500
local string QM=QL
if GetUnitTypeId(Bc)==$68305750 then
set QM="LJQ_Zuljin01_Blue_01.mdx"
endif
set DE=AddSpecialEffectTarget(QM,Ki,"chest")
call SetUnitScale(Ki,2,2,2)
call YDWEFlyEnable(Ki)
call YDWETimerDestroyEffect(DK+2,DE)
call ChargeDistanceTarget(Bc,Ki,Om,999999,DK,null,null)
call SetUnitFlyHeight(Ki,QV,QV/DK)
call SaveAgentHandle(O,GetHandleId(t),0,Bc)
call SaveAgentHandle(O,GetHandleId(t),1,Om)
call SaveAgentHandle(O,GetHandleId(t),2,Ki)
call SaveReal(O,GetHandleId(t),3,Pm)
call TriggerRegisterTimerEvent(t,DK,false)
call TriggerAddAction(t,function SuperAxeAction)
set t=CreateTrigger()
call SaveAgentHandle(O,GetHandleId(t),0,Ki)
call TriggerAddAction(t,function SuperAxeAction2)
call TriggerRegisterTimerEvent(t,DK/2,false)
set t=null
set Bc=null
set Om=null
set Ki=null
set DE=null
endfunction
function ZulJinRashAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
local unit Om=LoadUnitHandle(O,GetHandleId(t),1)
if IsUnitType(Om,UNIT_TYPE_DEAD) then
call RemoveSavedHandle(O,GetHandleId(Bc),b8)
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
else
call UnitDamageTargetBJ(Bc,Om,GetUnitState(Om,UNIT_STATE_MAX_LIFE)*.015,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",GetUnitX(Om),GetUnitY(Om)))
if IsUnitType(Om,UNIT_TYPE_DEAD) then
if GetUnitAbilityLevel(Bc,QX)==0 then
call UnitAddAbility(Bc,QX)
call UnitMakeAbilityPermanent(Bc,true,QX)
call UnitAddAbility(GetZulJinBuilding(Bc),QX)
call UnitMakeAbilityPermanent(GetZulJinBuilding(Bc),true,QX)
else
call SetUnitAbilityLevel(Bc,QX,GetUnitAbilityLevel(Bc,QX)+1)
call SetUnitAbilityLevel(GetZulJinBuilding(Bc),QX,GetUnitAbilityLevel(Bc,QX))
endif
call RemoveSavedHandle(O,GetHandleId(Bc),b8)
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
endif
endif
set t=null
set Bc=null
set Om=null
endfunction
function ZulJinRash takes unit Bc,unit Om returns nothing
local trigger t=LoadTriggerHandle(O,GetHandleId(Bc),b8)
if t==null then
set t=CreateTrigger()
call SaveAgentHandle(O,GetHandleId(t),0,Bc)
call SaveAgentHandle(O,GetHandleId(t),1,Om)
call TriggerRegisterTimerEvent(t,.5,true)
call TriggerRegisterTimerEvent(t,0,false)
call TriggerAddAction(t,function ZulJinRashAction)
call SaveTriggerHandle(O,GetHandleId(Bc),b8,t)
endif
set Bc=null
set Om=null
set t=null
endfunction
function ZulJinAttack takes unit Bc,unit Om returns nothing
local unit Ki
if GetRandomPercentageBJ()<=12 then
call UnitAddAbility(Bc,b7)
call IssueTargetOrder(Bc,"ensnare",Om)
call ZulJinRash(Bc,Om)
endif
set Ki=null
set Bc=null
set Om=null
endfunction
function ZulJinRegisterTazDingoAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
if GetTriggerEventId()==EVENT_UNIT_DAMAGED then
if GetEventDamage()>GetUnitState(Bc,UNIT_STATE_LIFE) then
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\NightElf\\BattleRoar\\RoarCaster.mdl",GetUnitX(Bc),GetUnitY(Bc)))
call YDWESetEventDamage(RMinBJ(GetEventDamage(),GetUnitState(Bc,UNIT_STATE_LIFE)-1))
call TriggerRegisterTimerEvent(t,5,false)
endif
else
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
endif
set t=null
set Bc=null
endfunction
function ZulJinRegisterTazDingo takes unit Bc returns nothing
local trigger t=CreateTrigger()
call SaveAgentHandle(O,GetHandleId(t),0,Bc)
call TriggerRegisterUnitEvent(t,Bc,EVENT_UNIT_DAMAGED)
call TriggerAddAction(t,function ZulJinRegisterTazDingoAction)
set Bc=null
set t=null
endfunction
function ZulJinRegisterTazDingoAction2 takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
local group DG=SelectRange(Bc,GetUnitX(Bc),GetUnitY(Bc),500)
local integer QK=3
local integer y=0
local unit D6
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null or y>=QK
call GroupRemoveUnit(DG,D6)
call SuperAxe(Bc,D6)
set y=y+1
endloop
call DestroyGroup(DG)
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
set DG=null
set D6=null
set t=null
set Bc=null
endfunction
function ZulJinRegisterTazDingo2 takes unit Bc returns nothing
local trigger t=CreateTrigger()
call SaveAgentHandle(O,GetHandleId(t),0,Bc)
call TriggerRegisterDeathEvent(t,Bc)
call TriggerAddAction(t,function ZulJinRegisterTazDingoAction2)
set Bc=null
set t=null
endfunction
function DevourSkillAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit Pf=LoadUnitHandle(O,GetHandleId(t),0)
local unit Om=LoadUnitHandle(O,GetHandleId(t),1)
local real QY=LoadReal(O,GetHandleId(t),2)
local real B0=LoadReal(O,GetHandleId(t),3)
local real a9=LoadReal(O,GetHandleId(t),4)
if GetTriggerEventId()==EVENT_WIDGET_DEATH or a9+B0>=QY then
call SetUnitPosition(Om,GetUnitX(Pf),GetUnitY(Pf))
call ShowUnit(Om,true)
call DestroyEffect(AddSpecialEffect("AZ_fuwang01_E1.MDX",GetUnitX(Om),GetUnitY(Om)))
call UnitRemoveAbility(Pf,$41313457)
call UnitAddAbility(Pf,a8)
call UnitMakeAbilityPermanent(Pf,true,a8)
call YDWESetUnitAbilityState(Pf,a8,1,5)
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
else
call SaveReal(O,GetHandleId(t),4,B0+a9)
call UnitDamageTargetBJ(Pf,Om,30,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
endif
set t=null
set Pf=null
set Om=null
endfunction
function DevourSkill takes unit Pf,unit Om,real QY,real B0 returns nothing
local trigger t=null
call YDWETimerDestroyLightning(.2,AddLightningEx("FORK",false,GetUnitX(Pf),GetUnitY(Pf),GetUnitFlyHeight(Pf)+100,GetUnitX(Om),GetUnitY(Om),GetUnitFlyHeight(Om)+100))
call UnitDamageTargetBJ(Pf,Om,99999,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
if IsUnitType(Om,UNIT_TYPE_DEAD) then
call YDWEFlyEnable(Om)
call SetUnitFlyHeight(Om,100000,$F4240)
endif
return
call ShowUnit(Om,false)
call UnitAddAbility(Pf,$41313457)
call TriggerAddAction(t,function DevourSkillAction)
call SaveAgentHandle(O,GetHandleId(t),0,Pf)
call SaveAgentHandle(O,GetHandleId(t),1,Om)
call UnitRemoveAbility(Pf,a8)
call SaveReal(O,GetHandleId(t),2,QY)
call SaveReal(O,GetHandleId(t),3,B0)
call TriggerRegisterTimerEvent(t,QY,false)
call TriggerRegisterTimerEvent(t,B0,true)
call TriggerRegisterDeathEvent(t,Pf)
call TriggerRegisterDeathEvent(t,Om)
set t=null
set Pf=null
set Om=null
endfunction
function DevourSkillActionEx takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit Pf=LoadUnitHandle(O,GetHandleId(t),0)
local unit Om=LoadUnitHandle(O,GetHandleId(t),1)
local real QY=LoadReal(O,GetHandleId(t),2)
local real B0=LoadReal(O,GetHandleId(t),3)
local real a9=LoadReal(O,GetHandleId(t),4)
if GetTriggerEventId()==EVENT_WIDGET_DEATH or a9+B0>=QY then
call SetUnitPosition(Om,GetUnitX(Pf),GetUnitY(Pf))
call ShowUnit(Om,true)
call DestroyEffect(AddSpecialEffect("AZ_fuwang01_E1.MDX",GetUnitX(Om),GetUnitY(Om)))
call UnitRemoveAbility(Pf,$41313457)
call UnitAddAbility(Pf,$41313458)
call UnitMakeAbilityPermanent(Pf,true,$41313458)
call YDWESetUnitAbilityState(Pf,$41313458,1,5)
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
else
call SaveReal(O,GetHandleId(t),4,B0+a9)
call UnitDamageTargetBJ(Pf,Om,30+GetUnitState(Om,UNIT_STATE_MAX_LIFE)*.08,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL)
endif
set t=null
set Pf=null
set Om=null
endfunction
function DevourSkillEx takes unit Pf,unit Om,real QY,real B0 returns nothing
local trigger t=null
call YDWETimerDestroyLightning(.2,AddLightningEx("FORK",false,GetUnitX(Pf),GetUnitY(Pf),GetUnitFlyHeight(Pf)+100,GetUnitX(Om),GetUnitY(Om),GetUnitFlyHeight(Om)+100))
call UnitDamageTargetBJ(Pf,Om,99999,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL)
if IsUnitType(Om,UNIT_TYPE_DEAD) then
call YDWEFlyEnable(Om)
call SetUnitFlyHeight(Om,100000,$F4240)
endif
return
call ShowUnit(Om,false)
call UnitAddAbility(Pf,$41313457)
call TriggerAddAction(t,function DevourSkillActionEx)
call SaveAgentHandle(O,GetHandleId(t),0,Pf)
call SaveAgentHandle(O,GetHandleId(t),1,Om)
call UnitRemoveAbility(Pf,$41313458)
call SaveReal(O,GetHandleId(t),2,QY)
call SaveReal(O,GetHandleId(t),3,B0)
call TriggerRegisterTimerEvent(t,QY,false)
call TriggerRegisterTimerEvent(t,B0,true)
call TriggerRegisterDeathEvent(t,Pf)
call TriggerRegisterDeathEvent(t,Om)
set t=null
set Pf=null
set Om=null
endfunction
function MakeTurret takes unit Pf returns nothing
local unit bB=CreateUnit(GetOwningPlayer(Pf),$6830504F,GetUnitX(Pf),GetUnitY(Pf),0)
set Bi=GetConvertedPlayerId(GetOwningPlayer(Pf))
call UnitApplyTimedLife(bB,$42487765,12)
call GroupAddUnit(JW,bB)
call GroupAddUnit(JH[Bi],bB)
set bB=null
set Pf=null
endfunction
function TurretRageEnumTimer takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit i=LoadUnitHandle(O,GetHandleId(t),0)
call SetUnitInvulnerable(i,false)
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTimer(t)
set t=null
set i=null
endfunction
function TurretRageEnum takes nothing returns nothing
call UnitAddAbilityForTime(GetEnumUnit(),$41313043,5)
endfunction
function TurretRage takes unit Pf returns nothing
local group DG
call MakeTurret(Pf)
set DG=YDWEGetUnitsOfPlayerAndTypeIdNull(GetOwningPlayer(Pf),$6830504F)
call ForGroup(DG,function TurretRageEnum)
call DestroyGroup(DG)
set DG=null
set Pf=null
endfunction
function A0I5Timer takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit i=LoadUnitHandle(O,H2I(t),StringHash("u"))
local unit Qf=LoadUnitHandle(O,H2I(t),StringHash("tag"))
if not UnitHasBuffBJ(Qf,$42303455) or IsUnitDeadBJ(Qf) or IsUnitDeadBJ(i) then
call UnitDamageTargetBJ(i,Qf,90,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(i),Pn,GetUnitX(Qf),GetUnitY(Qf),0)
call SetUnitState(bj_lastCreatedUnit,UNIT_STATE_LIFE,10000)
call UnitAddAbility(bj_lastCreatedUnit,$41304937)
call SetUnitAbilityLevel(bj_lastCreatedUnit,$41304937,1)
call IssueTargetOrder(bj_lastCreatedUnit,"thunderbolt",Qf)
call YDWETimerRemoveUnit(2,bj_lastCreatedUnit)
call FlushChildHashtable(O,H2I(t))
call DestroyTimer(t)
else
call UnitDamageTargetBJ(i,Qf,10,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
endif
set t=null
set i=null
set Qf=null
endfunction
function BOOMA01 takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit i=LoadUnitHandle(O,H2I(t),StringHash("u"))
local unit Qf=LoadUnitHandle(O,H2I(t),StringHash("tag"))
call SaveInteger(O,H2I(Qf),StringHash("7"),LoadInteger(O,H2I(Qf),StringHash("7"))-1)
call UnitDamageTargetBJ(i,Qf,GetUnitState(Qf,UNIT_STATE_MAX_LIFE)*.05,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
if LoadInteger(O,H2I(Qf),StringHash("7"))==0 then
call FlushChildHashtable(O,H2I(t))
call DestroyTimer(t)
endif
endfunction
function timerA0JR takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit i=LoadUnitHandle(O,GetHandleId(t),GetHandleId(t))
call SaveInteger(O,GetHandleId(i),GetHandleId(i),0)
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTimer(t)
set t=null
set i=null
endfunction
function A0JYAction takes nothing returns nothing
local unit Qf=GetTriggerUnit()
local unit Ki=null
local trigger RL=GetTriggeringTrigger()
local unit i=LoadUnitHandle(O,GetHandleId(RL),GetHandleId(RL))
if GetUnitAbilityLevel(GetEventDamageSource(),$41304B32)>0 and GetTriggerEventId()==EVENT_UNIT_DAMAGED then
set Ki=CreateUnit(GetOwningPlayer(i),Pn,GetUnitX(Qf),GetUnitY(Qf),0)
call GroupAddUnit(JW,Ki)
call SetUnitUserData(Ki,GetUnitUserData(i))
call GroupAddUnit(JH[GetUnitUserData(i)],Ki)
call UnitAddType(Ki,UNIT_TYPE_SUMMONED)
call UnitAddAbility(Ki,$41304B30)
call UnitAddAbility(Ki,$41304B31)
call IssueImmediateOrder(Ki,"creepthunderclap")
call IssueImmediateOrder(Ki,"stomp")
call RemoveUnit(Ki)
call FlushChildHashtable(O,GetHandleId(RL))
call DestroyTrigger(RL)
elseif GetTriggerEventId()==EVENT_GAME_TIMER_EXPIRED then
call FlushChildHashtable(O,GetHandleId(RL))
call DestroyTrigger(RL)
endif
set RL=null
set Qf=null
set i=null
set Ki=null
endfunction
function A0LSTimer takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit i=LoadUnitHandle(O,GetHandleId(t),1)
call UnitRemoveAbility(i,$41304C53)
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTimer(t)
set t=null
set i=null
endfunction
function A0NETimer takes nothing returns nothing
local timer t=GetExpiredTimer()
local unit i=LoadUnitHandle(O,GetHandleId(t),1)
local real FF=GetUnitX(i)
local real FG=GetUnitY(i)
local group DG
local unit Qf
set DG=CreateGroup()
call GroupEnumUnitsInRange(DG,FF,FG,450,null)
loop
set Qf=FirstOfGroup(DG)
exitwhen Qf==null
call GroupRemoveUnit(DG,Qf)
if IsUnitAlly(Qf,GetOwningPlayer(i)) then
call SetUnitLifeBJ(Qf,GetUnitState(Qf,UNIT_STATE_LIFE)+(10.+GetUnitState(Qf,UNIT_STATE_MAX_LIFE)*.02))
endif
endloop
call SaveInteger(O,GetHandleId(t),2,LoadInteger(O,GetHandleId(t),2)+1)
call DestroyGroup(DG)
if LoadInteger(O,GetHandleId(t),2)==7 then
call RemoveUnit(i)
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTimer(t)
endif
set t=null
set i=null
set DG=null
set Qf=null
endfunction
function A0NHAction2 takes nothing returns nothing
local trigger RL=GetTriggeringTrigger()
local integer BF=GetHandleId(RL)
local unit i=LoadUnitHandle(O,GetHandleId(RL),70)
local unit Ki
local group DG=CreateGroup()
local real FF=LoadReal(O,GetHandleId(RL),3)
local real FG=LoadReal(O,GetHandleId(RL),4)
local real Qv
local real Qw
local unit Qf
if EVENT_UNIT_DAMAGED==GetTriggerEventId() then
if GetEventDamageSource()==i and GetEventDamage()>0 then
call SaveInteger(O,GetHandleId(RL),77,LoadInteger(O,GetHandleId(RL),77)+1)
if LoadInteger(O,GetHandleId(RL),77)>=8 then
call UnitRemoveAbility(i,$41657468)
call SetUnitX(i,FF)
call SetUnitY(i,FG)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl",GetUnitX(i),GetUnitY(i)))
call DestroyEffect(LoadEffectHandle(O,GetHandleId(RL),1))
call DestroyEffect(LoadEffectHandle(O,GetHandleId(RL),2))
call IssueImmediateOrder(i,"stop")
call UnitAddAbility(i,$41304E4A)
call UnitMakeAbilityPermanent(i,true,$41304E4A)
call UnitRemoveAbility(i,$41304E4A)
