function Hero_wings takes string cx,string cy,string cz,string c0,string c1,string c2,string c3,string c4,string c5,string c6 returns nothing
local integer BB=LoadInteger(O,100012,100)
local integer Dt=StringHash("constructor_1"+I2S(BB))
call SaveStr(O,LoadInteger(O,Dt,1),778,cx)
call SaveStr(O,LoadInteger(O,Dt,2),778,cy)
call SaveStr(O,LoadInteger(O,Dt,3),778,cz)
call SaveStr(O,LoadInteger(O,Dt,4),778,c0)
call SaveStr(O,LoadInteger(O,Dt,5),778,c1)
call SaveStr(O,LoadInteger(O,Dt,6),778,c2)
call SaveStr(O,LoadInteger(O,Dt,7),778,c3)
call SaveStr(O,LoadInteger(O,Dt,8),778,c4)
call SaveStr(O,LoadInteger(O,Dt,9),778,c5)
call SaveStr(O,LoadInteger(O,Dt,10),778,c6)
set cx=null
set cy=null
set cz=null
set c0=null
set c1=null
set c2=null
set c3=null
set c4=null
set c5=null
set c6=null
endfunction
function Hero_wings_registered takes integer D7,integer D8,integer cn,integer co,integer cp,integer cq,integer cr,integer cs,integer ct,integer cu returns nothing
local integer BB=LoadInteger(O,100012,100)+1
local integer Dt=StringHash("constructor_1"+I2S(BB))
call SaveInteger(O,100012,100,BB)
call SaveInteger(O,Dt,1,D7)
call SaveInteger(O,Dt,2,D8)
call SaveInteger(O,Dt,3,cn)
call SaveInteger(O,Dt,4,co)
call SaveInteger(O,Dt,5,cp)
call SaveInteger(O,Dt,6,cq)
call SaveInteger(O,Dt,7,cr)
call SaveInteger(O,Dt,8,cs)
call SaveInteger(O,Dt,9,ct)
call SaveInteger(O,Dt,10,cu)
endfunction
function GetWingsFileAndRegisterShop takes integer BF returns string
local string QM=LoadStr(B,BF,StringHash("SpecialArt"))
local integer cv=LoadInteger(B,BF,StringHash("Requires"))
local string cw=LoadStr(B,BF,StringHash("Shopid"))
if BF==0 then
set QM=null
set cw=null
return null
endif
call UnlockShopTechForAllPlayers(cv,cw)
set cw=null
return QM
endfunction
function Hero_wings_registered_simple takes integer D7,integer D8,integer cn,integer co,integer cp,integer cq,integer cr,integer cs,integer ct,integer cu returns nothing
call Hero_wings_registered(D7,D8,cn,co,cp,cq,cr,cs,ct,cu)
call Hero_wings(GetWingsFileAndRegisterShop(D7),GetWingsFileAndRegisterShop(D8),GetWingsFileAndRegisterShop(cn),GetWingsFileAndRegisterShop(co),GetWingsFileAndRegisterShop(cp),GetWingsFileAndRegisterShop(cq),GetWingsFileAndRegisterShop(cr),GetWingsFileAndRegisterShop(cs),GetWingsFileAndRegisterShop(ct),GetWingsFileAndRegisterShop(cu))
endfunction
