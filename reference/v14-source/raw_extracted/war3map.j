function StartEffect takes nothing returns nothing
local timer EP=GetExpiredTimer()
local integer BB=LoadInteger(K,10001,GetHandleId(EP))-1
local real D1=I2R(GetRandomInt(0,1000))
local real EF=I2R(GetRandomInt(0,360))
local real EK=LoadReal(K,10002,GetHandleId(EP))+D1*Cos(EF*bj_DEGTORAD)
local real EL=LoadReal(K,10003,GetHandleId(EP))+D1*Sin(EF*bj_DEGTORAD)
local string FM=LoadStr(K,10001,GetHandleId(EP))
call DestroyEffect(AddSpecialEffect(FM,EK,EL))
call SaveInteger(K,10001,GetHandleId(EP),BB)
if BB<=0 then
call PauseTimer(EP)
call DestroyTimer(EP)
endif
endfunction
