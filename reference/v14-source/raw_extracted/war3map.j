set SF=CreateUnit(h,$6E303751,GetUnitX(Bc),GetUnitY(Bc),270)
call UnitAddAbility(SF,$41315038)
call UnitAddAbility(SF,$41315039)
call UnitAddAbility(SF,$41315041)
call UnitAddAbility(SF,$41315042)
if Dg>=10 then
call SetUnitAbilityLevel(SF,$41315038,2)
call SetUnitAbilityLevel(SF,$41315039,2)
call SetUnitAbilityLevel(SF,$41315042,2)
endif
if Dg>=14 then
call SetUnitAbilityLevel(SF,$41315038,3)
call SetUnitAbilityLevel(SF,$41315039,3)
call SetUnitAbilityLevel(SF,$41315041,2)
call SetUnitAbilityLevel(SF,$41315042,3)
call UnitAddAbility(SF,$41315043)
endif
endif
set Bc=null
set SF=null
set h=null
endfunction
