function ScreeningsAddForce takes nothing returns nothing
local player h=GetEnumPlayer()
local timer t=null
local timer UJ=null
if IsLivingPlayer(h) then
set UJ=CreateTimer()
call SavePlayerHandle(O,GetHandleId(UJ),StringHash("GameNumber"),h)
call TimerStart(UJ,0,false,function TimerA002)
set UJ=null
if LoadBoolean(O,H2I(h),StringHash("isOneBuilder")) then
set t=CreateTimer()
call SavePlayerHandle(O,GetHandleId(t),StringHash("isOneBuilder"),h)
call TimerStart(t,0,false,function TimerA001)
set t=null
endif
call YDWERPGAddKey(h,YDWETranslate("局数+1"),1)
call EXWriteGameLog(1,"局数+1")
if LoadBoolean(O,H2I(h),StringHash("Leakage")) then
call EXNetStatRemoteData(GetPlayerId(h),"Leakage","1")
else
call EXNetStatRemoteData(GetPlayerId(h),"NotLeakage","1")
endif
endif
set h=null
set t=null
set UJ=null
endfunction
function yF takes nothing returns nothing
local integer BB=GetPlayerId(GetEnumPlayer())+1
set UI[BB]=E6[BB]+E7[BB-1]*10+E4[BB]*8+E5[BB]*5
if UI[BB]>UI[GetPlayerId(UH[1])+1] then
set UH[1]=GetEnumPlayer()
endif
if E7[BB-1]>E7[GetPlayerId(UH[2])] then
set UH[2]=GetEnumPlayer()
endif
if E6[BB]>E6[GetPlayerId(UH[3])+1] then
set UH[3]=GetEnumPlayer()
endif
if E5[BB]>E5[GetPlayerId(UH[4])+1] then
set UH[4]=GetEnumPlayer()
endif
if GetPlayerState(GetEnumPlayer(),PLAYER_STATE_LUMBER_GATHERED)>GetPlayerState(UH[5],PLAYER_STATE_LUMBER_GATHERED) then
set UH[5]=GetEnumPlayer()
endif
if E4[BB]>E4[GetPlayerId(UH[6])+1] then
set UH[6]=GetEnumPlayer()
endif
endfunction
