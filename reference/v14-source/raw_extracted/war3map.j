call RemoveUnit(Om)
call TriggerExecute(Bv)
call Limit_D()
else
call DisplayTimedTextToPlayer(h,0,0,10,"带有不可直接售出标记的单位无法使用拆迁特许令!!!")
endif
elseif BN==$4131335A then
call DestroyEffect(AddSpecialEffect("AZ_fengbaodz_C1.mdx",FF,FG))
set DG=SelectRange(Pf,FF,FG,200)
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call UnitDamageTargetBJ(Pf,D6,200,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
call VertigoTarget(Pf,D6,2)
call GroupRemoveUnit(DG,D6)
endloop
call DestroyGroup(DG)
set DG=null
endif
set Pf=null
set Om=null
set h=null
set D1=null
set Ki=null
set DG=null
set D6=null
set Za=null
endfunction
