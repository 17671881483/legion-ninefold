function PhantomRiderChagreAttackChargeBack takes nothing returns nothing
local unit Ki=GetChargeDummy()
local unit Bc=GetChargeSource()
local group DG=SelectRange(Bc,GetUnitX(Ki),GetUnitY(Ki),250)
local trigger t=GetChargeTrigger()
local group Uz=LoadGroupHandle(O,GetHandleId(t),StringHash("tags"))
local unit D6
if Uz==null then
set Uz=CreateGroup()
call SaveGroupHandle(O,GetHandleId(t),StringHash("tags"),Uz)
endif
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
if not IsUnitInGroup(D6,Uz) then
call GroupAddUnit(Uz,D6)
call UnitDamageTargetBJ(Bc,D6,137,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
if not IsUnitType(D6,UNIT_TYPE_DEAD) then
call VertigoTarget(Bc,D6,1)
endif
endif
endloop
call DestroyGroup(DG)
call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",GetUnitX(Ki),GetUnitY(Ki)))
set Ki=null
set Bc=null
set DG=null
set t=null
set Uz=null
set D6=null
endfunction
function PhantomRiderChagreAttack takes unit Bc,real FF,real FG returns nothing
local real Pm=Atan2BJ(FG-GetUnitY(Bc),FF-GetUnitX(Bc))
local real ax=150
local integer y=7
local real Qv
local real Qw
local integer BB=0
local integer ay=y/2
local real az=GetUnitX(Bc)+CosBJ(Pm-90)*ax*ay
local real a0=GetUnitY(Bc)+SinBJ(Pm-90)*ax*ay
local unit Ki
loop
exitwhen BB>=y
set Qv=az+CosBJ(Pm+90)*150*BB
set Qw=a0+SinBJ(Pm+90)*150*BB
set Ki=CreateUnit(GetOwningPlayer(Bc),Pn,Qv,Qw,Pm)
call SaveAgentHandle(O,GetHandleId(Ki),0,AddSpecialEffectTarget("KnightsofTemplar.mdx",Ki,"chest"))
call ChargeDistance(Bc,Ki,Pm,800,.4,"PhantomRiderChagreAttackChargeBack","PhantomRiderChagreAttackCallBack")
set BB=BB+1
endloop
set Ki=null
set Bc=null
endfunction
