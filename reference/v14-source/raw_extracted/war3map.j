function YDWETimerSystem___Main takes nothing returns nothing
local integer Ca=Cj
loop
set Cu=Ck[Ca]
exitwhen Cu<0 or Ci<Cv[Cu]
call TriggerEvaluate(Cw[Cu])
call YDWETimerSystem___DeleteTaskIndex(Cu)
set Ck[Ca]=Ck[Cu]
endloop
set Ci=Ci+1
endfunction
function YDWETimerSystem___Init takes nothing returns nothing
set Cg=CreateTimer()
set Ch=GetHandleId(Cg)
set Ci=0
set Cj=0
set Ck[0]=-1
set Cl=1
set Cm=1
set Cn[1]=-1
set Co=CreateTrigger()
set Cp=CreateTrigger()
set Cq=CreateTrigger()
set Cr=CreateTrigger()
set Cs=CreateTrigger()
set Ct=CreateTrigger()
call TriggerAddCondition(Co,Condition(function YDWETimerSystem___RemoveUnit_CallBack))
call TriggerAddCondition(Cp,Condition(function YDWETimerSystem___DestroyTimer_CallBack))
call TriggerAddCondition(Cq,Condition(function YDWETimerSystem___RemoveItem_CallBack))
call TriggerAddCondition(Cr,Condition(function YDWETimerSystem___DestroyEffect_CallBack))
call TriggerAddCondition(Cs,Condition(function YDWETimerSystem___DestroyLightning_CallBack))
call TriggerAddCondition(Ct,Condition(function YDWETimerSystem___RunTrigger_CallBack))
call TimerStart(Cg,.01,true,function YDWETimerSystem___Main)
endfunction
function YDWETimerSystemGetRunIndex takes nothing returns integer
return fj
endfunction
function YDWETimerSystem___RunPeriodicTriggerFunction takes nothing returns nothing
local integer RN=GetHandleId(GetExpiredTimer())
local trigger Eb=LoadTriggerHandle(CD,RN,851969)
call SaveInteger(CD,StringHash(I2S(GetHandleId(Eb))),StringHash("RunIndex"),LoadInteger(CD,RN,851970))
if TriggerEvaluate(Eb) then
call TriggerExecute(Eb)
endif
set Eb=null
endfunction
function YDWETimerSystem___RunPeriodicTriggerFunctionByTimes takes nothing returns nothing
local integer RN=GetHandleId(GetExpiredTimer())
local trigger Eb=LoadTriggerHandle(CD,RN,851969)
local integer fl=LoadInteger(CD,RN,851971)
call SaveInteger(CD,StringHash(I2S(GetHandleId(Eb))),StringHash("RunIndex"),LoadInteger(CD,RN,851970))
if TriggerEvaluate(Eb) then
call TriggerExecute(Eb)
endif
set fl=fl-1
if fl>0 then
call SaveInteger(CD,RN,851971,fl)
else
call DestroyTimer(GetExpiredTimer())
call FlushChildHashtable(CD,RN)
endif
set Eb=null
endfunction
function YDWETimerRunPeriodicTrigger takes real Qz,trigger Eb,boolean Cd,integer fl,integer Dv returns nothing
local timer t
local integer RN
local integer Cx=0
if Qz<0 then
return
else
set t=CreateTimer()
set RN=GetHandleId(t)
endif
set fj=fj+1
call SaveTriggerHandle(CD,RN,851969,Eb)
call SaveInteger(CD,RN,851970,fj)
set Cx=LoadInteger(CD,GetHandleId(Eb),$59445453+Dv)
set Cx=Cx+1
call SaveInteger(CD,GetHandleId(Eb),$59445453+Dv,Cx)
call SaveTimerHandle(CD,GetHandleId(Eb),($59445453+Dv)*Cx,t)
if Cd==false then
call SaveInteger(CD,RN,851971,fl)
call TimerStart(t,Qz,true,function YDWETimerSystem___RunPeriodicTriggerFunctionByTimes)
else
call TimerStart(t,Qz,true,function YDWETimerSystem___RunPeriodicTriggerFunction)
endif
set t=null
endfunction
function YDWETimerRunPeriodicTriggerOver takes trigger Eb,integer Dv returns nothing
local integer fm=GetHandleId(Eb)
local integer Cx=LoadInteger(CD,fm,$59445453+Dv)
local timer t
loop
exitwhen Cx<=0
set t=LoadTimerHandle(CD,fm,($59445453+Dv)*Cx)
call DestroyTimer(t)
call FlushChildHashtable(CD,GetHandleId(t))
call RemoveSavedHandle(CD,fm,($59445453+Dv)*Cx)
set Cx=Cx-1
endloop
call RemoveSavedInteger(CD,fm,$59445453+Dv)
set t=null
endfunction
function YDWETryInitRescuableTriggersBJNull takes nothing returns nothing
local integer Cx
if bj_rescueUnitBehavior==null then
set bj_rescueUnitBehavior=CreateTrigger()
set Cx=0
loop
call TriggerRegisterPlayerUnitEvent(bj_rescueUnitBehavior,Player(Cx),EVENT_PLAYER_UNIT_RESCUED,null)
set Cx=Cx+1
exitwhen Cx==bj_MAX_PLAYER_SLOTS
endloop
call TriggerAddAction(bj_rescueUnitBehavior,function YDWETriggerActionUnitRescuedBJNull)
endif
endfunction
function BuildingFrame___getFile takes integer BF returns string
return LoadStr(O,BF,StringHash("file"))
endfunction
function BuildingFrame_IsUpgradeId takes integer BF returns boolean
if BF==Cz then
return true
elseif BF==C0 then
return true
elseif BF==C1 then
return true
endif
return false
endfunction
function BuildingFrame_CheckId takes integer BF returns boolean
return BuildingFrame___getFile(BF)!=null
endfunction
function BuildingFrame___getLevel takes integer BF returns integer
return LoadInteger(O,BF,StringHash("level"))
endfunction
function BuildingFrame___getEffect takes unit C3 returns effect
local integer BF=GetHandleId(C3)
set C3=null
return LoadEffectHandle(O,BF,StringHash("BuildingFrameUIEffect"))
endfunction
function BuildingFrame___getTimer takes unit C3 returns timer
local integer BF=GetHandleId(C3)
set C3=null
return LoadTimerHandle(O,BF,StringHash("BuildingFrameUITimer"))
endfunction
function BuildingFrame___getEffect2 takes unit C3 returns effect
local integer BF=GetHandleId(C3)
set C3=null
return LoadEffectHandle(O,BF,StringHash("BuildingFrameUIEffect2"))
endfunction
function BuildingFrame___getEffect3 takes unit C3 returns effect
local integer BF=GetHandleId(C3)
set C3=null
return LoadEffectHandle(O,BF,StringHash("BuildingFrameUIEffect3"))
endfunction
function BuildingFrame___getTime takes player h,integer x returns real
local real DK=DL
if x==Cy then
return DK
elseif BuildingFrame_IsUpgradeId(x) then
set DK=S2R(LoadStr(B,x,StringHash("timebase")))+RMaxBJ(0,GetPlayerTechCount(h,x,true)-1)*S2R(LoadStr(B,x,StringHash("timemod")))
if DM then
set DK=DK*((100-DN)/100)
else
set DK=DK*((100-DO)/100)
endif
return DK
endif
return .01
endfunction
function BuildingFrame___createEffect takes unit C3,integer x returns effect
local effect DE=null
local real DK=0
local real DP=1
if C3==null or x==0 then
set C3=null
return null
endif
set DE=AddSpecialEffect(BuildingFrame___getFile(x),GetUnitX(C3),GetUnitY(C3))
set DK=BuildingFrame___getTime(GetOwningPlayer(C3),x)
if DK>0 then
set DP=10/DK
endif
call EXSetEffectSize(DE,2)
call EXSetEffectSpeed(DE,DP)
call SaveEffectHandle(O,GetHandleId(C3),StringHash("BuildingFrameUIEffect"),DE)
set DF=BuildingFrame___getEffect(C3)
set C3=null
set DE=null
return DF
endfunction
function BuildingFrame___createEffect2 takes unit C3 returns effect
local effect DE=AddSpecialEffect(DQ,GetUnitX(C3),GetUnitY(C3))
call SaveEffectHandle(O,GetHandleId(C3),StringHash("BuildingFrameUIEffect2"),DE)
call EXSetEffectSize(DE,1.)
set DF=BuildingFrame___getEffect2(C3)
set DE=null
set C3=null
return DF
endfunction
function BuildingFrame___getCount takes unit C3 returns integer
local integer y=LoadInteger(O,GetHandleId(C3),StringHash("BuildingFrameUICount"))
set C3=null
return y
endfunction
function BuildingFrame___setCount takes unit C3,integer y returns nothing
call SaveInteger(O,GetHandleId(C3),StringHash("BuildingFrameUICount"),y)
set C3=null
endfunction
function BuildingFrame___createEffect3 takes unit C3 returns effect
local timer t=BuildingFrame___getTimer(C3)
local integer y=BuildingFrame___getCount(C3)-LoadInteger(O,GetHandleId(t),2)
local effect DE=AddSpecialEffect("LJQ_JT_JDTxjl_0"+I2S(IMinBJ(y,7))+".mdx",GetUnitX(C3),GetUnitY(C3))
call SaveEffectHandle(O,GetHandleId(C3),StringHash("BuildingFrameUIEffect3"),DE)
call EXSetEffectSize(DE,2)
set DF=BuildingFrame___getEffect3(C3)
set DE=null
set t=null
set C3=null
return DF
endfunction
function BuildingFrame___GetTypeIdForCount takes unit C3,integer y returns integer
local integer BF=LoadInteger(O,GetHandleId(C3),StringHash("BuildingFrameUICount"+I2S(y)))
set C3=null
return BF
endfunction
function BuildingFrame___SetTypeIdForCount takes unit C3,integer y,integer x returns nothing
call SaveInteger(O,GetHandleId(C3),StringHash("BuildingFrameUICount"+I2S(y)),x)
set C3=null
endfunction
function BuildingFrame___onTimer takes nothing returns nothing
local timer t
local unit C3
local player h
local effect DE
local integer x
local integer y
set t=GetExpiredTimer()
set C3=LoadUnitHandle(O,GetHandleId(t),0)
set h=GetOwningPlayer(C3)
set DE=BuildingFrame___getEffect(C3)
set x=LoadInteger(O,GetHandleId(t),1)
set y=LoadInteger(O,GetHandleId(t),2)+1
call DestroyEffect(DE)
call DestroyEffect(BuildingFrame___getEffect3(C3))
if x==Cy then
set DR=GetOwningPlayer(C3)
call AdjustPlayerStateBJ(-1,DR,PLAYER_STATE_RESOURCE_FOOD_USED)
call ExecuteFunc("LumberEwspNoArg")
call DisplayTimedTextToPlayer(DR,0,0,10,"已完成小精灵")
elseif BuildingFrame_IsUpgradeId(x) then
call SaveInteger(O,GetHandleId(h),StringHash("tech_loding_lv"),LoadInteger(O,GetHandleId(h),StringHash("tech_loding_lv"))-1)
set DR=h
set DV=x
call ExecuteFunc("LumberTechAddNoArg")
call DisplayTimedTextToPlayer(h,0,0,10,"已完成伐木")
endif
if y<BuildingFrame___getCount(C3) then
set x=BuildingFrame___GetTypeIdForCount(C3,y)
set DE=BuildingFrame___createEffect(C3,x)
call SaveInteger(O,GetHandleId(t),2,y)
call SaveInteger(O,GetHandleId(t),1,x)
call BuildingFrame___createEffect3(C3)
call TimerStart(t,BuildingFrame___getTime(h,x),false,function BuildingFrame___onTimer)
call AddUnitAnimationProperties(C3,"work",true)
else
call AddUnitAnimationProperties(C3,"work",false)
call UnitRemoveAbility(C3,C2)
call DestroyEffect(BuildingFrame___getEffect2(C3))
call BuildingFrame___setCount(C3,0)
call RemoveSavedHandle(O,GetHandleId(C3),StringHash("BuildingFrameUITimer"))
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTimer(t)
endif
set t=null
set C3=null
set DE=null
set h=null
endfunction
function BuildingFrame___startTimer takes unit C3,integer x returns nothing
local timer t=CreateTimer()
call AddUnitAnimationProperties(C3,"work",true)
call BuildingFrame___createEffect(C3,x)
call BuildingFrame___createEffect2(C3)
call SaveAgentHandle(O,GetHandleId(t),0,C3)
call SaveInteger(O,GetHandleId(t),1,x)
call TimerStart(t,BuildingFrame___getTime(GetOwningPlayer(C3),x),false,function BuildingFrame___onTimer)
call SaveAgentHandle(O,GetHandleId(C3),StringHash("BuildingFrameUITimer"),t)
set t=null
set C3=null
endfunction
function BuildingFrame_create takes unit C3,integer x returns nothing
local integer y=BuildingFrame___getCount(C3)
if y==0 then
call BuildingFrame___startTimer(C3,x)
call UnitAddAbility(C3,C2)
call UnitMakeAbilityPermanent(C3,true,C2)
endif
call BuildingFrame___SetTypeIdForCount(C3,y,x)
call BuildingFrame___setCount(C3,y+1)
call DestroyEffect(BuildingFrame___getEffect3(C3))
call BuildingFrame___createEffect3(C3)
set C3=null
endfunction
function BuildingFrame___clear takes unit C3 returns nothing
local timer t=BuildingFrame___getTimer(C3)
call RemoveSavedInteger(O,GetHandleId(C3),StringHash("BuildingFrameUICount"))
if t!=null then
call AddUnitAnimationProperties(C3,"work",false)
call UnitRemoveAbility(C3,C2)
call DestroyEffect(BuildingFrame___getEffect(C3))
call DestroyEffect(BuildingFrame___getEffect2(C3))
call RemoveSavedHandle(O,GetHandleId(C3),StringHash("BuildingFrameUITimer"))
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTimer(t)
endif
set C3=null
set t=null
endfunction
function BuildingFrame___close takes unit C3 returns nothing
local integer y=BuildingFrame___getCount(C3)
local timer t=BuildingFrame___getTimer(C3)
local integer C4=0
local integer x=BuildingFrame___GetTypeIdForCount(C3,y-1)
local player h=GetOwningPlayer(C3)
local integer BT=LoadInteger(O,GetHandleId(h),x)-1
local integer BU=S2I(LoadStr(B,x,StringHash("goldbase")))+IMaxBJ(BT-1,0)*S2I(LoadStr(B,x,StringHash("goldmod")))
local integer BV=S2I(LoadStr(B,x,StringHash("lumberbase")))+IMaxBJ(BT-1,0)*S2I(LoadStr(B,x,StringHash("lumbermod")))
if t==null then
call RemoveSavedInteger(O,GetHandleId(C3),StringHash("BuildingFrameUICount"))
set C3=null
set h=null
set t=null
return
endif
set C4=LoadInteger(O,GetHandleId(t),2)
if y>0 then
if x==Cy then
call AdjustPlayerStateBJ(50,h,PLAYER_STATE_RESOURCE_GOLD)
call AdjustPlayerStateBJ(-1,h,PLAYER_STATE_RESOURCE_FOOD_USED)
if GetUnitAbilityLevel(C3,C5)==0 then
call UnitAddAbility(C3,C5)
if C6 then
call SetUnitAbilityLevel(C3,C5,C7)
else
call SetUnitAbilityLevel(C3,C5,C8)
endif
else
call SetUnitAbilityLevel(C3,C5,GetUnitAbilityLevel(C3,C5)-1)
endif
else
call AdjustPlayerStateBJ(BU,h,PLAYER_STATE_RESOURCE_GOLD)
call AdjustPlayerStateBJ(BV,h,PLAYER_STATE_RESOURCE_LUMBER)
call SetPlayerTechMaxAllowedSwap(x,GetFoodMaxLevel(x),h)
call SaveInteger(O,GetHandleId(h),x,BT)
call SaveInteger(O,GetHandleId(h),StringHash("tech_loding_lv"),LoadInteger(O,GetHandleId(h),StringHash("tech_loding_lv"))-1)
endif
call DestroyEffect(BuildingFrame___getEffect3(C3))
call BuildingFrame___setCount(C3,y-1)
set y=BuildingFrame___getCount(C3)
if C4>=y then
call BuildingFrame___clear(C3)
else
call BuildingFrame___createEffect3(C3)
endif
endif
set C3=null
set t=null
set h=null
endfunction
function BuildingFrame___BtnClick takes nothing returns nothing
local integer BF=GetSpellAbilityId()
local unit i=GetTriggerUnit()
local player h=GetOwningPlayer(i)
local group DG
local integer y=0
if BF==C2 then
call BuildingFrame___close(i)
elseif BF==C5 then
set DG=YDWEGetUnitsOfPlayerAndTypeIdNull(h,$75303051)
set y=CountUnitsInGroup(DG)
call DestroyGroup(DG)
if y==0 then
call AdjustPlayerStateBJ(50,h,PLAYER_STATE_RESOURCE_GOLD)
call DisplayTimedTextToPlayer(h,0,0,10,"兵力不足")
set i=null
set h=null
set DG=null
return
elseif GetPlayerState(h,PLAYER_STATE_RESOURCE_FOOD_CAP)-GetPlayerState(h,PLAYER_STATE_RESOURCE_FOOD_USED)==0 then
call AdjustPlayerStateBJ(50,h,PLAYER_STATE_RESOURCE_GOLD)
call DisplayTimedTextToPlayer(h,0,0,10,"人口不足")
set i=null
set h=null
set DG=null
return
else
call AdjustPlayerStateBJ(1,h,PLAYER_STATE_RESOURCE_FOOD_USED)
endif
call BoxGiftTryConsumeBuildFreeWithCost(h,50,0)
if (GetUnitAbilityLevel(i,BF)>=C8 and not C6) or (GetUnitAbilityLevel(i,BF)>=C7 and C6) then
call UnitRemoveAbility(i,BF)
else
call SetUnitAbilityLevel(i,BF,GetUnitAbilityLevel(i,BF)+1)
endif
call BuildingFrame_create(i,Cy)
endif
set i=null
set DG=null
set h=null
endfunction
