set FM[2]=LoadInteger(O,GetHandleId(h),StringHash("prophecy2"))
set FM[3]=LoadInteger(O,GetHandleId(h),StringHash("prophecy3"))
set FM[4]=LoadInteger(O,GetHandleId(h),StringHash("prophecy4"))
set FM[5]=LoadInteger(O,GetHandleId(h),StringHash("prophecy5"))
set FM[6]=LoadInteger(O,GetHandleId(h),StringHash("prophecy6"))
if FM[1]==0 then
set FM[1]=1
endif
if FM[2]==0 then
set FM[2]=1
endif
if FM[3]==0 then
set FM[3]=1
endif
if FM[4]==0 then
set FM[4]=1
endif
if FM[5]==0 then
set FM[5]=1
endif
if FM[6]==0 then
set FM[6]=1
endif
if KP[BB-1]==1 and FM[2]!=8 and GetRandomInt(1,10)==10 then
set FM[2]=8
endif
if KQ[BB-1]==1 and FM[6]!=5 and GetRandomInt(1,20)==5 then
set FM[6]=5
endif
if FM[6]!=1 and FM[6]!=12 and FM[6]!=14 and FM[6]!=5 then
if KP[BB-1]==1 and GetRandomInt(1,5)==5 then
set CT[1]=1
set CT[2]=12
set CT[3]=14
set FM[6]=CT[GetRandomInt(1,3)]
endif
endif
call SetPlayerTechMaxAllowed(h,KK[FM[1]],-1)
call SetPlayerTechMaxAllowed(h,KL[FM[2]],-1)
call SetPlayerTechMaxAllowed(h,KM[FM[3]],-1)
call SetPlayerTechMaxAllowed(h,KN[FM[4]],-1)
call SetPlayerTechMaxAllowed(h,KO[FM[5]],-1)
call SetPlayerTechMaxAllowed(h,FS[FM[6]],-1)
set FJ[1]="ReplaceableTextures\\CommandButtons\\BTNSelectHeroOn.blp"
set FJ[2]="ReplaceableTextures\\CommandButtons\\BTNSelectHeroOn.blp"
set FJ[3]="ReplaceableTextures\\CommandButtons\\BTNSelectHeroOn.blp"
set FJ[4]="ReplaceableTextures\\CommandButtons\\BTNSelectHeroOn.blp"
set FJ[5]="ReplaceableTextures\\CommandButtons\\BTNSelectHeroOn.blp"
set FJ[6]="ReplaceableTextures\\CommandButtons\\BTNSelectHeroOn.blp"
call Ladder_SetStat(h,"race01","b"+I2S(1000+FM[1]))
call Ladder_SetStat(h,"race02","b"+I2S(2000+FM[2]))
call Ladder_SetStat(h,"race03","b"+I2S(3000+FM[3]))
call Ladder_SetStat(h,"race04","b"+I2S(4000+FM[4]))
call Ladder_SetStat(h,"race05","b"+I2S(5000+FM[5]))
call Ladder_SetStat(h,"race06","b"+I2S(6000+FM[6]))
set Bj=0
loop
exitwhen Bj>7
if IsPlayerAlly(Player(Bj),h) and GetPlayerTechCount(Player(Bj),$52333036,true)>0 then
if GetLocalPlayer()==Player(Bj) then
set FJ[1]=LoadStr(K,666,KK[FM[1]])
set FJ[2]=LoadStr(K,666,KL[FM[2]])
set FJ[3]=LoadStr(K,666,KM[FM[3]])
set FJ[4]=LoadStr(K,666,KN[FM[4]])
set FJ[5]=LoadStr(K,666,KO[FM[5]])
set FJ[6]=LoadStr(K,666,FS[FM[6]])
endif
endif
set Bj=Bj+1
endloop
call YDWEMultiboardSetItemIconBJNull(BC,8,JB[BB],FJ[1])
call YDWEMultiboardSetItemIconBJNull(BC,9,JB[BB],FJ[2])
call YDWEMultiboardSetItemIconBJNull(BC,10,JB[BB],FJ[3])
call YDWEMultiboardSetItemIconBJNull(BC,11,JB[BB],FJ[4])
call YDWEMultiboardSetItemIconBJNull(BC,12,JB[BB],FJ[5])
call YDWEMultiboardSetItemIconBJNull(BC,13,JB[BB],FJ[6])
call YDWEMultiboardSetItemStyleBJNull(BC,8,JB[BB],false,true)
call YDWEMultiboardSetItemStyleBJNull(BC,9,JB[BB],false,true)
call YDWEMultiboardSetItemStyleBJNull(BC,10,JB[BB],false,true)
call YDWEMultiboardSetItemStyleBJNull(BC,11,JB[BB],false,true)
call YDWEMultiboardSetItemStyleBJNull(BC,12,JB[BB],false,true)
call YDWEMultiboardSetItemStyleBJNull(BC,13,JB[BB],false,true)
set Kc=EG[BB]
if FP[BB-1]!=0 then
if LoadBoolean(O,$45464678,BB) then
set EP=CreateTimer()
if LoadStr(O,GetPlayerId(h),100870)!=null then
call SaveStr(K,10001,GetHandleId(EP),LoadStr(O,GetPlayerId(h),100870))
else
call SaveStr(K,10001,GetHandleId(EP),FR[FP[BB-1]])
endif
call SaveReal(K,10002,GetHandleId(EP),GetUnitX(Kc))
call SaveReal(K,10003,GetHandleId(EP),GetUnitY(Kc))
call TimerStart(EP,.1,true,function TiemrEffect)
endif
endif
call SaveBoolean(O,$45464678,BB,true)
if GetUnitTypeId(Kc)==$65303030 then
set Bj=Ke[BB-1]
if Kf[Bj]==0 then
set Bj=1
endif
set t=CreateTimer()
call SaveUnitHandle(O,GetHandleId(t),0,Kc)
call SaveInteger(O,GetHandleId(t),1,BB)
call SaveInteger(O,GetHandleId(t),2,Bj)
call TimerStart(t,0,false,function PlayerLoadSaveItemTimer)
endif
set EP=null
endfunction
function PlayerClearProphecy takes player h returns nothing
local integer BB=1
local integer KJ=6
loop
call SaveInteger(O,GetHandleId(h),StringHash("prophecy"+I2S(BB)),0)
exitwhen BB>=KJ
set BB=BB+1
endloop
endfunction
function PlayerSetProphecy takes nothing returns nothing
local player h=EXGetTriggerSyncPlayer()
local string Dv=EXGetTriggerSyncData()
local boolean KH=LoadBoolean(O,GetHandleId(h),StringHash("prophecy"))
local integer KJ=6
local integer BB=1
local integer KI=0
call SaveBoolean(O,GetHandleId(h),StringHash("prophecy"),false)
if LoadInteger(O,GetHandleId(h),StringHash("prophecy1"))==0 then
loop
set KI=S2I(SubString(Dv,0,2))
set Dv=SubString(Dv,3,StringLength(Dv))
call SaveInteger(O,GetHandleId(h),StringHash("prophecy"+I2S(BB)),KI)
exitwhen BB>=KJ
set BB=BB+1
endloop
if not KH then
call new_G_ModeHP_Prophet(GetConvertedPlayerId(h))
call PlayerClearProphecy(h)
endif
endif
set h=null
endfunction
function InitPlayerSetProphecy takes nothing returns nothing
local trigger t=CreateTrigger()
call EXTriggerRegisterSyncData(t,"prophecy")
call TriggerAddAction(t,function PlayerSetProphecy)
set t=null
endfunction
function A084HP takes nothing returns nothing
local unit i=GetTriggerUnit()
local integer BB=1
local integer Bj=4
local real Ca=GetUnitState(i,UNIT_STATE_LIFE)
local real EF=GetEventDamage()+100
local real H6=.5
if Ca>EF then
set i=null
return
endif
if i==Bd then
set BB=1
set Bj=4
endif
if i==Bh then
set BB=5
set Bj=8
endif
loop
exitwhen BB>Bj
if H3[BB]==false and GetUnitAbilityLevel(EG[BB],$41303834)==1 then
set H3[BB]=true
call UnitRemoveAbility(EG[BB],$41303834)
if Bd==i and H4 or Bh==i and H5 then
set H6=.6
set H7=YDWETranslate("|r 对国王使用了|cFFFFFF00强化的|r神圣治疗！")
else
set H7=YDWETranslate("|r 对国王使用了神圣治疗！")
endif
call SaveInteger(O,GetPlayerId(GetOwningPlayer(EG[BB])),707,1)
call DisplayTimedTextToForce(GetPlayersAll(),10.,H8[BB]+GetPlayerName(Player(BB-1))+H7)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl",i,"origin"))
call SetUnitState(i,UNIT_STATE_LIFE,GetUnitState(i,UNIT_STATE_LIFE)+GetUnitState(i,UNIT_STATE_MAX_LIFE)*H6)
set i=null
return
endif
set BB=BB+1
endloop
set i=null
endfunction
function CancelSave2 takes nothing returns nothing
local timer t=GetExpiredTimer()
local dialog EF=LoadDialogHandle(K,GetHandleId(t),0)
call DialogDisplay(GetLocalPlayer(),EF,false)
call FlushChildHashtable(K,GetHandleId(t))
call DestroyTimer(t)
call DialogDestroy(EF)
set t=null
set EF=null
return
endfunction
function CancelSave1 takes nothing returns nothing
local dialog EF=DialogCreate()
local timer t=CreateTimer()
call DialogDisplay(GetLocalPlayer(),EF,true)
call SaveDialogHandle(K,GetHandleId(t),0,EF)
call TimerStart(t,0.,false,function CancelSave2)
set t=null
set EF=null
return
endfunction
function InitRecord takes nothing returns nothing
local trigger Eb=CreateTrigger()
local integer BB=0
local timer Ek=CreateTimer()
local timer El=CreateTimer()
local timer Em=CreateTimer()
call TriggerAddCondition(Eb,Condition(function InitTest))
loop
exitwhen BB>11
call TriggerRegisterPlayerChatEvent(Eb,Player(BB),"桐乃必须推京介",true)
set BB=BB+1
endloop
set Eb=CreateTrigger()
call TriggerAddCondition(Eb,Condition(function PlayerBuild))
set BB=0
loop
exitwhen BB>11
call TriggerRegisterPlayerUnitEvent(Eb,Player(BB),EVENT_PLAYER_UNIT_CONSTRUCT_FINISH,null)
call TriggerRegisterPlayerUnitEvent(Eb,Player(BB),EVENT_PLAYER_UNIT_UPGRADE_FINISH,null)
set BB=BB+1
endloop
set Eb=CreateTrigger()
call TriggerAddCondition(Eb,Condition(function PlayerLeaveRecord))
set BB=0
loop
exitwhen BB>11
call TriggerRegisterPlayerEvent(Eb,Player(BB),EVENT_PLAYER_LEAVE)
set BB=BB+1
endloop
set Eb=CreateTrigger()
call TriggerAddCondition(Eb,Condition(function PlayerAction))
set BB=0
loop
exitwhen BB>11
call TriggerRegisterPlayerUnitEvent(Eb,Player(BB),EVENT_PLAYER_UNIT_SELECTED,null)
call TriggerRegisterPlayerUnitEvent(Eb,Player(BB),EVENT_PLAYER_UNIT_DESELECTED,null)
call TriggerRegisterPlayerUnitEvent(Eb,Player(BB),EVENT_PLAYER_UNIT_ISSUED_ORDER,null)
call TriggerRegisterPlayerUnitEvent(Eb,Player(BB),EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER,null)
call TriggerRegisterPlayerUnitEvent(Eb,Player(BB),EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER,null)
set BB=BB+1
endloop
set Eb=CreateTrigger()
call TriggerAddCondition(Eb,Condition(function KickAFK))
set BB=0
loop
exitwhen BB>11
call TriggerRegisterPlayerChatEvent(Eb,Player(BB),"-kickafk",false)
set BB=BB+1
endloop
set BB=0
loop
exitwhen BB>11
call SaveInteger(K,StringHash("Moving_i"),BB,3)
call TriggerRegisterPlayerUnitEvent(M,Player(BB),EVENT_PLAYER_UNIT_CONSTRUCT_START,null)
set BB=BB+1
endloop
call TriggerAddCondition(M,Condition(function Play_Con))
set BB=0
loop
exitwhen BB>11
call TriggerRegisterPlayerUnitEvent(N,Player(BB),EVENT_PLAYER_UNIT_SPELL_EFFECT,null)
set BB=BB+1
endloop
call TriggerAddCondition(N,Condition(function Skills_Con))
set Eb=CreateTrigger()
set BB=0
loop
exitwhen BB>7
call TriggerRegisterPlayerSelectionEventBJ(Eb,Player(BB),true)
set BB=BB+1
endloop
call TriggerAddCondition(Eb,Condition(function chooseConditions))
call TriggerAddAction(Eb,function chooseActions)
set Eb=CreateTrigger()
set BB=0
loop
exitwhen BB>7
call TriggerRegisterPlayerChatEvent(Eb,Player(BB),"-E",false)
call TriggerRegisterPlayerChatEvent(Eb,Player(BB),"-W",false)
call TriggerRegisterPlayerChatEvent(Eb,Player(BB),"-B",false)
call TriggerRegisterPlayerChatEvent(Eb,Player(BB),"-Y",false)
call TriggerRegisterPlayerChatEvent(Eb,Player(BB),"-DZW",false)
call TriggerRegisterPlayerChatEvent(Eb,Player(BB),"SETP",false)
set BB=BB+1
endloop
call TriggerAddAction(Eb,function ModeWingEffe)
set Eb=null
call FlushGameCache(InitGameCache("12.x"))
set Et=InitGameCache("12.x")
call TimerStart(Ek,5.,true,function WritePlayerScoreAuto)
call TimerStart(J,99999,false,null)
call TimerStart(El,60.,true,function KickFunc)
call TimerStart(Em,1.,true,function Score)
set Eu=180
set Ek=null
set El=null
set Em=null
endfunction
function A_Testing_SelectionInfo takes nothing returns nothing
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0.,0,10.,YDWETranslate("|cFFFFCC99[系统]|r |cFFCC99FFUnitType of Selection|r: |cFFFFFF00")+UnitId2StringBJ(GetUnitTypeId(GetTriggerUnit())))
endfunction
function C_Testing_UnitType takes nothing returns boolean
return SubStringBJ(GetEventPlayerChatString(),1,6)=="-test " or SubStringBJ(GetEventPlayerChatString(),1,3)=="-t "
endfunction
function A_Testing_UnitType takes nothing returns nothing
call DoNotSaveReplay()
if SubStringBJ(GetEventPlayerChatString(),1,6)=="-test " then
if SubStringBJ(GetEventPlayerChatString(),8,11)==" on " then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0.,0,10.,YDWETranslate("|cFFFFCC99[系统]|r |cFFCC99FFUnitType-Tester|r: |cFFFFFF00Unit |rhas been |cFF00FF00Allowed |rfor ")+GetPlayerName(ConvertedPlayer(S2I(SubStringBJ(GetEventPlayerChatString(),7,7)))))
call SetPlayerTechMaxAllowedSwap(String2UnitIdBJ(SubStringBJ(GetEventPlayerChatString(),12,StringLength(GetEventPlayerChatString()))),-1,ConvertedPlayer(S2I(SubStringBJ(GetEventPlayerChatString(),7,7))))
else
if SubStringBJ(GetEventPlayerChatString(),8,12)==" off " then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0.,0,10.,YDWETranslate("|cFFFFCC99[系统]|r |cFFCC99FFUnitType-Tester|r: |cFFFFFF00Unit |rhas been |cFFFF0000Limited |rfor ")+GetPlayerName(ConvertedPlayer(S2I(SubStringBJ(GetEventPlayerChatString(),7,7)))))
call SetPlayerTechMaxAllowedSwap(String2UnitIdBJ(SubStringBJ(GetEventPlayerChatString(),13,StringLength(GetEventPlayerChatString()))),0,ConvertedPlayer(S2I(SubStringBJ(GetEventPlayerChatString(),7,7))))
else
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0.,0,10.,YDWETranslate("|cFFFFCC99[系统]|r |cFFCC99FFUnitType-Tester|r: Recieved |cFFFF0000wrong |rcommand."))
endif
endif
else
if SubStringBJ(GetEventPlayerChatString(),1,3)=="-t " then
if SubStringBJ(GetEventPlayerChatString(),5,8)==" on " then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0.,0,10.,YDWETranslate("|cFFFFCC99[系统]|r |cFFCC99FFUnitType-Tester|r: |cFFFFFF00Unit |rhas been |cFF00FF00Allowed |rfor ")+GetPlayerName(ConvertedPlayer(S2I(SubStringBJ(GetEventPlayerChatString(),4,4)))))
call SetPlayerTechMaxAllowedSwap(String2UnitIdBJ(SubStringBJ(GetEventPlayerChatString(),9,StringLength(GetEventPlayerChatString()))),-1,ConvertedPlayer(S2I(SubStringBJ(GetEventPlayerChatString(),4,4))))
else
if SubStringBJ(GetEventPlayerChatString(),5,9)==" off " then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0.,0,10.,YDWETranslate("|cFFFFCC99[系统]|r |cFFCC99FFUnitType-Tester|r: |cFFFFFF00Unit |rhas been |cFFFF0000Limited |rfor ")+GetPlayerName(ConvertedPlayer(S2I(SubStringBJ(GetEventPlayerChatString(),4,4)))))
call SetPlayerTechMaxAllowedSwap(String2UnitIdBJ(SubStringBJ(GetEventPlayerChatString(),10,StringLength(GetEventPlayerChatString()))),0,ConvertedPlayer(S2I(SubStringBJ(GetEventPlayerChatString(),4,4))))
else
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0.,0,10.,YDWETranslate("|cFFFFCC99[系统]|r |cFFCC99FFUnitType-Tester|r: Recieved |cFFFF0000wrong |rcommand."))
endif
endif
else
endif
endif
endfunction
function A_Setting_Function takes nothing returns nothing
call DoNotSaveReplay()
if GetEventPlayerChatString()=="-s" or GetEventPlayerChatString()=="-set" then
call EnableTrigger(Xg)
else
if SubStringBJ(GetEventPlayerChatString(),1,3)=="-s " and SubStringBJ(GetEventPlayerChatString(),4,7)=="heal" and Xh!=null then
call SetUnitLifeBJ(Xh,S2R(SubStringBJ(GetEventPlayerChatString(),9,StringLength(GetEventPlayerChatString()))))
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,5.,"|cFFFFCC00[系统]|r 目标单位的生命值已经设置完成。")
set Xh=null
else
if SubStringBJ(GetEventPlayerChatString(),1,5)=="-set " and SubStringBJ(GetEventPlayerChatString(),6,9)=="heal" and Xh!=null then
call SetUnitLifeBJ(Xh,S2R(SubStringBJ(GetEventPlayerChatString(),11,StringLength(GetEventPlayerChatString()))))
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,5.,"|cFFFFCC00[系统]|r 目标单位的生命值已经设置完成。")
set Xh=null
else
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,10.,"|cFFFFCC00[系统]|r 请输入-s或-set并选中一个单位后再进行单位属性设置。")
endif
endif
endif
endfunction
function A_Setting_Initialization takes nothing returns nothing
call DestroyTrigger(GetTriggeringTrigger())
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=8
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
if false then
endif
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endfunction
function A_Setting_Unit takes nothing returns nothing
set Xh=GetTriggerUnit()
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,5.,YDWETranslate("|cFFFFCC00[系统]|r 一个单位已被选中。"))
call DisableTrigger(GetTriggeringTrigger())
endfunction
function SushuiInitString takes nothing returns nothing
call ForceUIKeyBJ(Player(0),"A")
call ForceUIKeyBJ(Player(1),"A")
call ForceUIKeyBJ(Player(2),"A")
call ForceUIKeyBJ(Player(3),"A")
call ForceUIKeyBJ(Player(4),"A")
call ForceUIKeyBJ(Player(5),"A")
call ForceUIKeyBJ(Player(6),"A")
call ForceUIKeyBJ(Player(7),"A")
call ForceUIKeyBJ(Player(10),"A")
call ForceUIKeyBJ(Player(11),"A")
set Fb[1]=YDWETranslate("|cFFFFCC00[计算器]|r |cFFFF0000您输入的指令有误。|r")
set Fb[2]=YDWETranslate("|cFFFFCC00[计算器]|r |cFFFF0000目前仅支持4位数以内的加减乘除。|r")
set Fb[10]=YDWETranslate("|cFFFFCC00[计算器]|r |cFF00FFFF")
set Fb[11]=YDWETranslate("|cFFFFCC00[计算器]|r 先生，|cFF00FFFF")
set Fb[12]=YDWETranslate("|cFFFFCC00[计算器]|r 是这样的同志，|cFF00FFFF")
set Fb[13]=YDWETranslate("|cFFFFCC00[计算器]|r 你在搞笑吗，|cFF00FFFF")
set Fb[14]=YDWETranslate("|cFFFFCC00[计算器]|r 如果我没算错的话，|cFF00FFFF")
set Fb[15]=YDWETranslate("|cFFFFCC00[计算器]|r 我在吃饭，没功夫帮你好好算，|cFF00FFFF")
set Fb[20]="|r=|cFFFFFF99"
set Fb[21]="|r其实等于|cFFFF99CC"
set Fb[22]="|r正常人都知道是|cFFFF99CC"
set Fb[23]="|r等于|cFFFF99CC"
set Fb[24]="|r应该等于|cFFFF99CC"
set Fb[25]="|r结果可能不是|cFFFF99CC"
set Fb[30]="|r"
set Fb[31]="|r的。"
set Fb[32]="|r的。"
set Fb[33]="|r都不会算。"
set Fb[34]="|r的。"
set Fb[35]="|r。"
set Fc[0]=""
set Fc[1]=YDWETranslate("，|cFFCCFFFF你可真是够小啊。|r")
set Fc[2]=YDWETranslate("，|cFFCCFFFF确实足够大。|r")
set Fd[0]=YDWETranslate("|cFF99CC00[认知教程]|r 您可以随时关闭我，通过输入-tutorial off或-xs off来实现。")
set Fd[1]="|cFF99CC00[认知教程]|r 现在是回合开始前的准备阶段，您需要在自己的区域内建造士兵，如果您是新手，可以建造在横线处上下附近。每个回合开始后，这些建造的士兵将自动变为战士参与战斗。战士的死亡或存活不会影响回合外您建造的士兵本身。如果您并不精确了解每个兵种通过第一回合的能力，我们强烈建议您花光所有的金钱。"
set Fd[2]="|cFF99CC00[认知教程]|r 一个回合中，如果玩家如果没有成功防守住其位置出现的怪物（漏怪），这些怪物将集合向中路前进，最终到达国王。玩家的任务就是以保护己方国王的前提下，消灭对手的国王。回合外的准备阶段是允许您进行阵型的编配，如果您以一个优秀的阵型进行士兵的建造，回合中战士将获得更出色的表现。阵型的搭配和思路，是军团战争的重要的基本功之一。"
set Fd[3]="|cFF99CC00[认知教程]|r 您可能发现了，同样的兵种在不同回合有不同的表现。每个兵种都拥有自己的攻击类型和护甲类型。攻击类型与护甲类型之间存在克制关系，如穿刺攻击会对轻甲造成额外的伤害，而对重甲仅会造成少许伤害。您可以通过鼠标悬停单位面板的攻击类型或防御类型的图标上获得全部的信息。如果您建造不同攻击、护甲类型的兵种将它们搭配在一起，将会有更好的表现。"
set Fd[4]="|cFF99CC00[认知教程]|r 远程怪物由于会先于您建造的战士开始攻击，所以对近战士兵会产生射程压制。但是如果您的士兵也是远程，通常情况下不会出现这种压制效果。远程怪物的强势在于较早发动攻击但如果士兵也是远程会造成后排怪物无法攻击到士兵；近战怪物的强势在于围剿士兵后所有单位几乎同时发动攻击，但近战怪物围剿您的士兵的过程，由于需要时间而浪费掉了不少输出。"
set Fd[5]="|cFF99CC00[认知教程]|r 飞行怪物会免疫绝大多数范围技能的伤害，如献祭、疾病云雾、粉碎击等，但对于拥有溅射攻击、同样是飞行单位的龙族士兵的防御则较差。飞行单位有更快的聚集速度、且碰撞体积较低，往往会对玩家的某一个战士同时攻击（集火），从而带来数量压制的效果。玩家可以学习飞行怪物的这一特性使得自己的战士也去集火敌人，带来更强的集中火力输出的效果。"
set Fd[6]="|cFF99CC00[认知教程]|r 您发现您拥有的资源不只有金钱还有木材了吗？木材在游戏中充当第二资源的角色，您购买国王能力、木材怪物、提升伐木效率时将会使用木材这一资源。每花费一定的木材都会获得相应的收入，每个回合结束时，您将获得等于总收入的金钱作为额外奖励。收入并非一次性有效，只会增加不会减少，自花费木材的那一刻起，您之后的每个回合都会获得这些额外的奖励。"
set Fd[7]="|cFF99CC00[认知教程]|r 木材怪物是指您通过在兵营中花费木材雇佣的怪物。这些怪物会在回合准备阶段、回合中集结，于下一个回合开始阶段同时按数量平均分给对手的每一名玩家。每次购买只会令它们出现一次，并与其他的系统发出的怪物同时进攻对手玩家的国王。木材怪物会花费大量的木材，您可以通过升级伐木效率或生产小精灵从而提高木材的采集速度和采集数量。"
set Fd[8]="|cFF99CC00[认知教程]|r 当您的兵力过低，将没有意外的造成漏怪并且会损失一定的军功（综合评分）。怪物走到中路后将会按照军功扣掉一部分赏金，玩家可以通过点选漏怪单位面板上的状态条查看赏金比例。如果一方所有玩家均漏怪，很有可能使得国王无法承受如此强大的进攻倒下而失败。您可以通过花费木材升级国王的攻击、血量和生命恢复速度。也可以在国王即死时使用神圣治疗。"
set Fd[9]="|cFF99CC00[认知教程]|r 您可以输入-next或者-info xx（xx是1-30的数字）查看下一波或某一波怪物的资料从而提前建造相应攻防克制关系的兵种。比如现在您输入-info 10可以查看到第10回合的怪物是BOSS单位，您现在就可以开始建造防御BOSS单位的兵种了。攻速缓慢、范围伤害的大型高级兵种或生命值极低的近战低级兵种往往在对付BOSS时显得很无力。"
set Fd[10]=YDWETranslate("|cFF99CC00[认知教程]|r 第10回合结束后，双方将进行一场对抗赛，获胜的一方会获得额外的金钱奖励。整个过程会额外的增加游戏时间，所以这个时候生产小精灵、升级伐木效率效果会额外的好。玩家之间搭配不同的光环兵种和英雄会使得团战时友方的其他战士显得异常强大。")
set Fd[11]="|cFF99CC00[认知教程]|r 不知您是否注意到了，团战时双方的兵力与科技信息是相互展示出来的。科技显示方式为x/y（x为小精灵拥有数最多为7，y为伐木效率的等级最高为15），参考其他玩家的兵力与科技对自己的情况作出调整。科技过低的玩家只会获得很少的木材，在其他玩家收入较高、获得额外资源更多的后期您将显得非常乏力。"
set Fd[12]="|cFF99CC00[认知教程]|r 一个优秀的团队都会有一个聪明的指挥，通过团战时观察对手的兵力与科技以及现在在阴影下暗暗显示的敌方兵种类型而确定将木材存留到某一回合一次性同时购买木材怪物（木怪）给予敌人致命的打击。往往一次持续数回合的存储木量的蓄力一击，能获得这一局的最终胜利。当然，对手也不都是吃素的。"
set Fd[13]="|cFF99CC00[认知教程]|r 很多有经验的老玩家会采用单兵（纯兵）玩法：即使用一个兵种作为其全部的士兵进行作战。这样的好处是在单兵克制的系统怪物的回合中有异常出色的表现，通常队友漏掉的怪物也能被该名纯兵玩家全部消灭。但同样的，纯兵玩家也会面临被克制的一回合。混合兵种的玩法使得玩家的兵种在每回合的表现都相对平滑的多。混合兵种同时适合新玩家和有经验的高手。"
set Fd[14]="|cFF99CC00[认知教程]|r 由国王杀死怪物获得的赏金每回合会平分给己方玩家，同时对手的国王会平分给对手玩家相同的赏金作为击溃对手的额外奖励。所以漏怪至国王（见王）是非常吃亏的，或者说打漏对手是非常赚的，即使没有一次性赢得胜利，也会在资源上获得优势。需要注意的是，木材怪物即使到达中路也会获得100%赏金（木怪不参与计算赏金比例）。"
set Fd[15]="|cFF99CC00[认知教程]|r 您发现了吗？高级兵营中有4个木材怪物依然不可以被招募。他们是游戏中最强的4种木材怪物。15回合开始的瞬间，这些木材怪物就可以被招募了。招募他们来击垮对手吧！如果您认为无法承受住对手招募这些木怪后的压力，尽快升级国王吧！低级的国王没有可能在遇到这些木怪的打击时存活。"
set Fd[16]=YDWETranslate("|cFF99CC00[认知教程]|r 不知不觉中，游戏已进入到中期。直到20回合的接下来的数回合，都是游戏的关键回合。通过-info查看每回合怪物的攻防类型来击垮对手吧！注意自己的兵种在哪一回合会被克制，表现最差（虚），提前告知队友并采取相应的措施防止被对手一波带走。")
set Fd[17]="|cFF99CC00[认知教程]|r 第17回合（17波）开始，系统怪物的等价兵力将大大提升，防守成功的难度大大增加。如果您在17波之前就有漏怪的问题，那么我建议您尽快提升自己的兵力吧（补兵力），否则不出意外，您会连续漏怪的（波波漏）。这个时候您不妨与队友商量一下攻打对手哪一波又或是将国王升级到满级（满王）等待数波后再进行战斗。"
set Fd[18]="|cFF99CC00[认知教程]|r 若您足够细心，您会发现17、18、19波的系统怪物分别是3种不同的攻击、护甲类型。总会有一波是某一方最脆弱的一回合。下局如果您发现对手是惧怕普通攻击的中甲纯兵，14、15波连续的两回合的普通攻击会给敌人造成致命的伤害。需要注意的是14回合的系统怪的单体作战能力是高于15波的，但15回合是可以招募终极木怪的，因此指挥玩家需要好好斟酌。"
set Fd[19]="|cFF99CC00[认知教程]|r 如果您成功的坚守住了15-20回合，证明您将进入后期。后期的打法与局势会与中期的节奏明显不同。在选择每回合都招募木怪以获得高收入从而得到更多资源（波波刷）和积攒木材在关键的一波给予敌人致命一击上，您要与队友谨慎决定。积攒木材的打法很有风险，而波波刷的打法也不一定能守住对手的背水一战，只有经验老道的选手才能获得战术上的胜利。"
set Fd[20]="|cFF99CC00[认知教程]|r Boss不同于其他波，仅有3只强力的怪物。单体输出高的单位在Boss回合有极好的表现。但是对手或许会招募许多杂七杂八的木怪，这样就会大大降低您高输出、低攻速兵种的表现能力。但同时由于Boss的移动速度较低，木怪经常会跑到Boss的前面，与Boss移动速度相近的单位还会对Boss进行卡位，减少大量的输出时间，所以Boss波其实很有学问。"
set Fd[21]=YDWETranslate("|cFF99CC00[认知教程]|r 后期中，阵型或许不是特别重要了。但是您依然需要考虑到兵种射程的限制以及前后排的搭配（前排即承受伤害能力强的单位通常为近战，后排则为输出能力高的单位通常为远程）。一个良好的前后排搭配的阵型将比胡乱搭配的阵型综合表现好的多的多。")
set Fd[22]=YDWETranslate("|cFF99CC00[认知教程]|r 光环兵种在后期尤为重要，一个光环士兵的存在就可以为大范围内的团队提升作战能力。如果你的队友建造的位置离中路不远，为他也建造一个你拥有的光环兵吧！他或许会回报你他拥有的光环兵的！")
set Fd[23]=YDWETranslate("|cFF99CC00[认知教程]|r 高级兵种（5级和6级兵种）往往性价比（每金币带来的能力）比普通兵种要低，这是由于后期兵力高到一定程度后，没有过多的好位置供玩家使用了，而高级兵虽然价格很高、但能力大大高于低级兵。那么低级兵是不是该在这个时候被高级兵取代？")
set Fd[24]=YDWETranslate("|cFF99CC00[认知教程]|r 后期的每一波都是关键波，由于魔兽机制问题，地图上的单位数量越多，每个单位的反应速度越慢，这就造成了不可预料的延迟，从而影响了系统怪物真正实力的发挥。选择数量最少的一波进行攻打吧！怪物少而精才是关键。")
set Fd[25]=YDWETranslate("|cFF99CC00[认知教程]|r 更多更全面的攻略、战术、基本功介绍和指导请进入QQ群565091404进行搜索或提问，这里也欢迎您的加入。您也可以在各大网站或11平台了解军团战争的更多动向。")
set Fd[26]=""
set Fd[27]=""
set Fd[28]="|cFF99CC00[认知教程]|r 还能看到这一条教程，证明您有可能会进入加时赛阶段。加时赛就是31波开始后的回合，所有玩家的战士不再每回合都刷新，成功消灭了31波系统怪物后剩余的战士将会集结在一起共同防御32波及之后的系统怪。之后波数的系统怪将源源不断的到来，不再有额外的等待时间，也不会因为某玩家漏怪而延迟下个回合的开始。"
set Fd[29]=YDWETranslate("|cFF99CC00[认知教程]|r 加时赛阶段结束于35波，35波会出现最终Boss，拥有无限复活能力和极高的攻击，但是攻速极慢。国王优先倒下的一方失败。加时赛时，国王变的可以移动，并能参与战斗。加时赛是军团战争最激情的阶段，燃烧吧！少年们！ —— 认知教程到此结束。")
set Fd[30]="|cFF99CC00[认知教程]|r 欢迎您观本教程，认知教程是面向所有玩家、针对新手玩家而撰写的简易文字教程，如果您觉得依然不能正式的开始游戏，我们建议您在单机模式下多次进行本游戏进行大意了解。您也可以通过QQ群565091404，搜索更多的相关攻略。如果您对本教程有任何建议或意见，请反馈给作者|cFF00FFFF|r本人，谢谢！"
set Fd[31]=YDWETranslate("|cFF99CC00[认知教程]|r 您可以随时打开我，通过输入-tutorial on或-xs来实现。")
set Fd[32]=YDWETranslate("|cFF99CC00[认知教程]|r |cFFFF0000您输入的指令有误，请检查是否输入了多余的空格并尝试重新输入。|r")
endfunction
function C_Moving_Triggering takes nothing returns boolean
return IsUnitType(GetTriggerUnit(),UNIT_TYPE_STRUCTURE)==true and GetSpellAbilityId()==$41313138
endfunction
function A_Moving_Triggering takes nothing returns nothing
local unit i=GetSpellAbilityUnit()
local player h=GetOwningPlayer(i)
local integer CT=GetConvertedPlayerId(h)
local real fo=GetUnitX(i)
local real fp=GetUnitY(i)
if N0[CT]==true then
call ShowUnitHide(N1[CT])
call ShowUnitShow(N2[CT])
call PauseUnit(N2[CT],false)
endif
set N2[CT]=i
set fq[CT]=fo
set fr[CT]=fp
set N0[CT]=true
call PauseUnit(i,true)
call ShowUnitHide(i)
call ShowUnitShow(N1[CT])
call SetUnitPosition(N1[CT],fo,fp)
call ClearSelectionForPlayer(h)
call SelectUnitForPlayerSingle(N1[CT],h)
call TriggerSleepAction(.1)
call ForceUIKeyBJ(h,"B")
call TriggerSleepAction(.1)
call ForceUIKeyBJ(h,"Q")
set i=null
set h=null
endfunction
function C_Moving_Finishing takes nothing returns boolean
return GetUnitTypeId(GetConstructingStructure())==$75316D74 or GetUnitTypeId(GetConstructingStructure())==$75303153 or GetUnitTypeId(GetConstructingStructure())==$75303154
endfunction
function A_Moving_Finishing takes nothing returns nothing
local unit i=GetConstructingStructure()
local player h=GetOwningPlayer(i)
local integer CT=GetConvertedPlayerId(h)
local real fo=GetUnitX(i)
local real fp=GetUnitY(i)
if not RectContainsUnit(Ti[CT-1],i) then
call ClearSelectionForPlayer(h)
call DisplayTimedTextToPlayer(h,0,0,5.,"|cFFFFCC00[位移]|r 不能将士兵移动到其他人的阵地中")
call RemoveUnit(i)
return
endif
call RemoveUnit(i)
call SetUnitPosition(N2[CT],fo,fp)
call ShowUnitHide(N1[CT])
call ShowUnitShow(N2[CT])
call PauseUnit(N2[CT],false)
call ClearSelectionForPlayer(h)
call SelectUnitForPlayerSingle(N2[CT],h)
set N0[CT]=false
call UnitRemoveAbility(N2[CT],$41313138)
if not S3 then
set TG[CT]=TG[CT]-1
if TG[CT]<=0 then
call SetPlayerAbilityAvailable(h,$41313138,false)
endif
endif
set i=null
set h=null
endfunction
function C_Moving_Canceling takes nothing returns boolean
return GetUnitTypeId(GetTriggerUnit())==$75316D62 or GetUnitTypeId(GetTriggerUnit())==$75303156 or GetUnitTypeId(GetTriggerUnit())==$75303155 and N0[GetConvertedPlayerId(GetTriggerPlayer())]==true
endfunction
function A_Moving_Canceling takes nothing returns nothing
local integer CT=GetConvertedPlayerId(GetTriggerPlayer())
call ShowUnit(N1[CT],false)
call ShowUnit(N2[CT],true)
call PauseUnit(N2[CT],false)
set N0[CT]=false
endfunction
function A_LumberTimerIncome takes nothing returns nothing
local integer BB=1
loop
exitwhen BB>8
if GetPlayerSlotState(Player(BB-1))==PLAYER_SLOT_STATE_PLAYING then
set Tx[BB]=Tt[BB]/Ts
call AdjustPlayerStateBJ(R2I(Tx[BB]),Player(BB-1),PLAYER_STATE_RESOURCE_LUMBER)
call AdjustPlayerStateBJ(R2I(Tx[BB]),Player(BB-1),PLAYER_STATE_LUMBER_GATHERED)
set Tt[BB]=Tt[BB]-R2I(Tx[BB])
endif
set BB=BB+1
endloop
endfunction
function A_LumberControl takes nothing returns nothing
local real Bj=0
local integer BB=1
local integer Ea=0
local string FM
local string Tu
set BB=1
loop
exitwhen BB>8
if GetPlayerSlotState(Player(BB-1))==PLAYER_SLOT_STATE_PLAYING then
set Bj=DT[BB]*(2+DY[BB]+2.5*DZ[BB])
set Tr[BB]=R2I(Bj*60*2)/Ts
set Tt[BB]=Tt[BB]+Bj
set Tu=I2S(Tr[BB])
set FM="?"
set Ea=0
loop
exitwhen Ea>7
if GetPlayerTechCount(Player(Ea),$52333031,true)==1 and IsPlayerAlly(Player(BB-1),Player(Ea))==true and GetLocalPlayer()==Player(Ea) then
set FM=Tu
endif
set Ea=Ea+1
endloop
call YDWEMultiboardSetItemValueBJNull(BC,7,JB[BB],FM)
endif
set BB=BB+1
endloop
if Da==true then
if Nj==true then
set Tv=8.
set Ts=16
else
set Tv=4.
set Ts=8
endif
else
set Tv=10.
set Ts=20
endif
call StartTimerBJ(KD,false,Tv)
endfunction
function C_SushuiCalcSystemAddition takes nothing returns boolean
return SubStringBJ(GetEventPlayerChatString(),1,1)!="0" and (SubStringBJ(GetEventPlayerChatString(),2,2)=="+" and StringLength(GetEventPlayerChatString())<=6 or SubStringBJ(GetEventPlayerChatString(),3,3)=="+" and StringLength(GetEventPlayerChatString())<=7 or SubStringBJ(GetEventPlayerChatString(),4,4)=="+" and StringLength(GetEventPlayerChatString())<=8 or SubStringBJ(GetEventPlayerChatString(),5,5)=="+" and StringLength(GetEventPlayerChatString())<=9)
endfunction
function A_SushuiCalcSystemAddition takes nothing returns nothing
set H7=GetEventPlayerChatString()
if SubStringBJ(GetEventPlayerChatString(),2,2)=="+" then
set Xj=S2I(SubStringBJ(H7,1,1))
set Xk=S2I(SubStringBJ(H7,3,StringLength(H7)))
set Xl=Xj+Xk
if Xl>-1000 and Xl<10009 and Xl!=Xj and Xl!=Xk then
set Xm=GetRandomInt(1,40)
if Xm<=5 then
set Fb[0]=Fb[10+Xm]+H7+(Fb[20+Xm]+I2S(Xl))+Fb[30+Xm]
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,1.,15.,Fb[0])
else
set Fb[0]=Fb[10]+H7+(Fb[20]+I2S(Xl))+Fb[30]
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,1.,15.,Fb[0])
endif
else
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,1.,15.,Fb[1])
endif
else
if SubStringBJ(GetEventPlayerChatString(),3,3)=="+" then
set Xj=S2I(SubStringBJ(H7,1,2))
set Xk=S2I(SubStringBJ(H7,4,StringLength(H7)))
set Xl=Xj+Xk
if Xl>-1009 and Xl<10099 and Xl!=Xj and Xl!=Xk then
set Xm=GetRandomInt(1,40)
if Xm<=5 then
set Fb[0]=Fb[10+Xm]+H7+(Fb[20+Xm]+I2S(Xl))+Fb[30+Xm]
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,1.,15.,Fb[0])
else
set Fb[0]=Fb[10]+H7+(Fb[20]+I2S(Xl))+Fb[30]
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,1.,15.,Fb[0])
endif
else
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,1.,15.,Fb[1])
endif
else
if SubStringBJ(GetEventPlayerChatString(),4,4)=="+" then
set Xj=S2I(SubStringBJ(H7,1,3))
set Xk=S2I(SubStringBJ(H7,5,StringLength(H7)))
set Xl=Xj+Xk
if Xl>-1099 and Xl<10999 and Xl!=Xj and Xl!=Xk then
set Xm=GetRandomInt(1,40)
if Xm<=5 then
set Fb[0]=Fb[10+Xm]+H7+(Fb[20+Xm]+I2S(Xl))+Fb[30+Xm]
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,1.,15.,Fb[0])
else
set Fb[0]=Fb[10]+H7+(Fb[20]+I2S(Xl))+Fb[30]
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,1.,15.,Fb[0])
endif
else
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,1.,15.,Fb[1])
endif
else
if SubStringBJ(GetEventPlayerChatString(),5,5)=="+" then
set Xj=S2I(SubStringBJ(H7,1,4))
set Xk=S2I(SubStringBJ(H7,6,StringLength(H7)))
set Xl=Xj+Xk
if Xl>-1999 and Xl<19999 and Xk!=0 and Xl!=Xj and Xl!=Xk then
set Xm=GetRandomInt(1,40)
if Xm<=5 then
set Fb[0]=Fb[10+Xm]+H7+(Fb[20+Xm]+I2S(Xl))+Fb[30+Xm]
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,1.,15.,Fb[0])
else
set Fb[0]=Fb[10]+H7+(Fb[20]+I2S(Xl))+Fb[30]
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,1.,15.,Fb[0])
endif
else
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,1.,15.,Fb[1])
endif
else
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,1.,15.,Fb[2])
endif
endif
endif
endif
endfunction
