endif
if StringLength(SX[BB])>1 then
call SetPlayerTechResearched(Player(BB),$52333032,1)
endif
if StringLength(SY[BB])>1 then
call SetPlayerTechResearched(Player(BB),$52333033,1)
endif
if StringLength(SZ[BB])>1 then
call SetPlayerTechResearched(Player(BB),$52333034,1)
endif
if StringLength(Sa[BB])>1 then
call SetPlayerTechResearched(Player(BB),$52333035,1)
endif
if StringLength(Sb[BB])>1 then
call SetPlayerTechResearched(Player(BB),$52333036,1)
endif
endfunction
function SmartU takes unit i returns nothing
local integer BB=GetPlayerId(GetOwningPlayer(i))
local integer Bj=S2I(SubString(ER[BB],6,8))
local effect EZ
if Bj>0 then
call DestroyEffect(AddSpecialEffectTarget(ES[ET[BB]],i,"chest"))
endif
if EU[BB+13]==1000 then
if GetUnitTypeId(i)==$55303054 then
call DestroyEffect(AddSpecialEffectTarget(ES[904],i,"weapon"))
else
call DestroyEffect(AddSpecialEffectTarget(ES[906],i,"origin"))
endif
endif
if EU[BB+25]==100 then
call DestroyEffect(AddSpecialEffectTarget(ES[907],i,"origin"))
endif
if EU[BB+25]==1000 then
call DestroyEffect(AddSpecialEffectTarget(ES[908],i,"weapon"))
endif
if GetHandleId(EV[BB+1])==0 then
call DestroyEffect(AddSpecialEffectTarget(LoadStr(O,GetPlayerId(GetOwningPlayer(i)),100868),i,"chest"))
else
call DestroyEffect(AddSpecialEffectTarget(ES[EW[BB]],i,"chest"))
endif
call DestroyEffect(AddSpecialEffectTarget(ES[EX[BB]],i,"origin"))
if GetHandleId(EY[BB+1])==0 then
set EZ=AddSpecialEffectTarget(LoadStr(O,GetPlayerId(GetOwningPlayer(i)),100869),i,"origin")
else
set EZ=AddSpecialEffectTarget(ES[EX[BB]],i,"origin")
endif
call DestroyEffect(LoadEffectHandle(K,1010,GetHandleId(i)))
call SaveEffectHandle(K,1010,GetHandleId(i),EZ)
call SetUnitOwner(i,Player(PLAYER_NEUTRAL_PASSIVE),false)
set i=null
set EZ=null
endfunction
function TiemrSmart takes nothing returns nothing
local timer EP=GetExpiredTimer()
local unit EQ=LoadUnitHandle(K,11001,GetHandleId(EP))
local integer Ea=LoadInteger(K,11002,GetHandleId(EP))-3
call SaveInteger(K,11002,GetHandleId(EP),Ea)
call SetUnitVertexColor(EQ,255,255,255,Ea)
if Ea>=1 then
call TimerStart(EP,.03,false,function TiemrSmart)
else
call DestroyEffect(LoadEffectHandle(K,1010,GetHandleId(EQ)))
call RemoveUnit(EQ)
call FlushChildHashtable(K,GetHandleId(EP))
call DestroyTimer(EP)
endif
set EP=null
set EQ=null
endfunction
function TiemrSmarFacing takes nothing returns nothing
local timer EP=GetExpiredTimer()
local unit EQ=LoadUnitHandle(K,11001,GetHandleId(EP))
local real EO=LoadReal(K,11001,GetHandleId(EP))
local real EK=LoadReal(K,11002,GetHandleId(EP))
local real EL=LoadReal(K,11003,GetHandleId(EP))
call SetUnitPosition(EQ,EK,EL)
call SetUnitFacing(EQ,EO)
call FlushChildHashtable(K,GetHandleId(EP))
call DestroyTimer(EP)
set EQ=null
set EP=null
endfunction
function Conditions_Smart takes nothing returns boolean
local unit i=GetTriggerUnit()
local integer BB=GetPlayerId(GetOwningPlayer(i))
local boolean EI=EG[BB+1]==i and GetIssuedOrderId()==OrderId("smart") and EH[BB]==1
set i=null
return EI
endfunction
function Actions_Smart takes nothing returns nothing
local unit i=GetTriggerUnit()
local player EJ=GetOwningPlayer(i)
local real EK=GetUnitX(i)
local real EL=GetUnitY(i)
local real EM=GetOrderPointX()
local real EN=GetOrderPointY()
local real EO=bj_RADTODEG*Atan2(EN-EL,EM-EK)
local unit EQ
local timer EP
local integer Ca
if IsVisibleToPlayer(EM,EN,EJ)==false then
set i=null
set EJ=null
return
endif
set EP=CreateTimer()
set Ca=GetHandleId(EP)
set EQ=CreateUnit(EJ,GetUnitTypeId(i),EK,EL,EO)
call SmartU(EQ)
call UnitRemoveType(EQ,UNIT_TYPE_PEON)
call UnitAddAbility(EQ,$416C6F63)
call SetUnitAnimation(EQ,"spell")
call SaveUnitHandle(K,11001,Ca,EQ)
call SaveInteger(K,11002,Ca,255)
call TimerStart(EP,.05,false,function TiemrSmart)
set EP=CreateTimer()
set Ca=GetHandleId(EP)
call SaveUnitHandle(K,11001,Ca,i)
call SaveReal(K,11001,Ca,EO)
call SaveReal(K,11002,Ca,EM)
call SaveReal(K,11003,Ca,EN)
call TimerStart(EP,.04,false,function TiemrSmarFacing)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdl",EK,EL))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\NightElf\\Blink\\BlinkTarget.mdl",EK,EL))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdl",EM,EN))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\NightElf\\Blink\\BlinkTarget.mdl",EM,EN))
set i=null
set EJ=null
set EQ=null
set EP=null
endfunction
