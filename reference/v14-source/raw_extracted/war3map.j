call TriggerRegisterTimerEvent(t,1,true)
call TriggerRegisterTimerEvent(t,0,false)
call TriggerRegisterDeathEvent(t,Bc)
call TriggerAddAction(t,function VashjLightningArrowChargeAoeAction)
