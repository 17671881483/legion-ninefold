call SaveBoolean(O,GetHandleId(Bc),StringHash("ArthasReadyAttackDamage"),false)
call SetUnitLifePercentBJ(Bc,GetUnitLifePercent(Bc)+15)
endif
set Bc=null
set Om=null
endfunction
