call SaveAgentHandle(O,GetHandleId(t),0,Bc)
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_DEATH)
call TriggerRegisterDeathEvent(t,Bc)
call TriggerAddAction(t,function ArthasHolyLightAction)
set t=null
set Bc=null
endfunction
