function RegisterShopIdAndFile takes integer BF returns string
local string QM=LoadStr(B,BF,StringHash("SpecialArt"))
local integer cv=LoadInteger(B,BF,StringHash("Requires"))
local string cw=LoadStr(B,BF,StringHash("Shopid"))
local integer BB=0
loop
if YDWERPGBillingHasStatus(Player(BB),cw) then
call SetPlayerTechResearchedSwap(cv,1,Player(BB))
endif
set BB=BB+1
exitwhen BB>=12
endloop
set cw=null
return QM
endfunction
