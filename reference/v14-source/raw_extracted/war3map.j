function C_ExperiencedSoldierSkill takes nothing returns boolean
return GetUnitTypeId(GetKillingUnit())==$68303238 and GetOwningPlayer(GetKillingUnit())==Player(8) or GetOwningPlayer(GetKillingUnit())==Player(9)
endfunction
function A_ExperiencedSoldierSkill takes nothing returns nothing
local unit Nu=GetKillingUnit()
local integer BF=GetUnitUserData(Nu)
if Sf[0]!=2 and GetRandomInt(1,10)<=6 then
call OC5F_Eb(Nu,"+"+I2S(1),100.,77.,0.,Player(BF-1))
call SetPlayerState(Player(BF-1),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(BF-1),PLAYER_STATE_RESOURCE_GOLD)+1)
set Jh[BF]=Jh[BF]+1
set T1[BF]=T1[BF]+1
if T1[BF]>=125 and T2[BF] and T3[BF] then
call SetPlayerTechMaxAllowed(Player(BF-1),$68323033,1)
call SetPlayerTechResearchedSwap($5230304D,1,Player(BF-1))
endif
else
if Sf[0]==2 and GetRandomInt(1,10)<=3 then
call OC5F_Eb(Nu,"+"+I2S(1),100.,77.,0.,Player(BF-1))
call SetPlayerState(Player(BF-1),PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(Player(BF-1),PLAYER_STATE_RESOURCE_GOLD)+1)
set Jh[BF]=Jh[BF]+1
set T1[BF]=T1[BF]+1
if T1[BF]>=125 and T2[BF] and T3[BF] then
call SetPlayerTechMaxAllowed(Player(BF-1),$68323033,1)
call SetPlayerTechResearchedSwap($5230304D,1,Player(BF-1))
endif
endif
endif
set Nu=null
endfunction
