function Trig_DebugRefreshFoodUnit takes unit Kr,player DH returns nothing
local integer dt=GetConvertedPlayerId(GetOwningPlayer(Kr))
local boolean du=IsUnitSelected(Kr,DH)
local boolean dv=Dd[dt]==Kr
local unit Ks=YDWEReplaceUnitBJNull(Kr,GetUnitTypeId(Kr),bj_UNIT_STATE_METHOD_RELATIVE)
if du then
call SelectUnitForPlayerSingle(Ks,DH)
endif
if dv then
set Dd[dt]=Ks
endif
set Kr=null
set Ks=null
set DH=null
endfunction
function Trig_DebugRefreshFood takes player h returns nothing
local group DG=YDWEGetUnitsOfPlayerAllNull(h)
local unit D6
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
if IsUnitType(D6,UNIT_TYPE_MECHANICAL) then
call Trig_DebugRefreshFoodUnit(D6,h)
endif
endloop
call DestroyGroup(DG)
set DG=null
set D6=null
set h=null
endfunction
function Trig_DebugCreateFoodWorker takes player h returns nothing
if DT[GetConvertedPlayerId(h)]<7 then
call LumberEwsp(CreateUnit(h,$65303033,0,0,270))
else
call DisplayTimedTextToPlayer(h,0,0,10,"小精灵已上限")
endif
set h=null
endfunction
function Trig_DebugPrintYseraTech takes player h returns nothing
call BJDebugMsg("[YseraRequires] player="+GetPlayerName(h))
call BJDebugMsg("[YseraRequires] u004="+I2S(GetPlayerTechCountSimple($75303034,h)))
call BJDebugMsg("[YseraRequires] h220="+I2S(GetPlayerTechCountSimple($68323230,h)))
call BJDebugMsg("[YseraRequires] R2YA="+I2S(GetPlayerTechCountSimple($52325941,h)))
set h=null
endfunction
function Trig_DebugActions takes nothing returns nothing
local string ds=GetEventPlayerChatString()
local player h=GetTriggerPlayer()
if not DM then
set h=null
return
endif
if ds=="-foodfresh" then
call Trig_DebugRefreshFood(h)
elseif ds=="-foodone" then
call Trig_DebugCreateFoodWorker(h)
elseif ds=="debug" or ds=="-debug" then
call Trig_DebugPrintYseraTech(h)
endif
set h=null
endfunction
