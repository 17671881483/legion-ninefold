function BoxGiftIsUpgradeTechReady takes player h,integer Y0 returns boolean
local integer BB=1
local integer y=LoadInteger(O,Y0,StringHash("box_train_upgrade_require_count"))
local integer Y5=0
local boolean DJ=true
loop
exitwhen BB>y or not DJ
set Y5=LoadInteger(O,Y0,StringHash("box_train_upgrade_require_"+I2S(BB)))
if not BoxGiftIsUpgradeRequireReady(h,Y5) then
set DJ=false
