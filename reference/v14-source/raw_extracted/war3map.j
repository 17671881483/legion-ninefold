function NagaAutoCastReset takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer BF=GetHandleId(t)
local unit Bc=LoadUnitHandle(O,BF,StringHash("hero"))
local integer at=LoadInteger(O,BF,StringHash("abilityId"))
if Bc!=null then
call RemoveSavedBoolean(O,GetHandleId(Bc),at)
endif
call FlushChildHashtable(O,BF)
call DestroyTimer(t)
set t=null
set Bc=null
endfunction
function NagaTryAutoCast takes unit Bc,integer at,real bg,real bh returns boolean
local integer bi=0
local timer t=null
if Bc==null then
return false
endif
set bi=GetHandleId(Bc)
if LoadBoolean(O,bi,at) or GetUnitState(Bc,UNIT_STATE_MANA)<bg then
return false
endif
call SaveBoolean(O,bi,at,true)
call SetUnitState(Bc,UNIT_STATE_MANA,GetUnitState(Bc,UNIT_STATE_MANA)-bg)
set t=CreateTimer()
call SaveUnitHandle(O,GetHandleId(t),StringHash("hero"),Bc)
call SaveInteger(O,GetHandleId(t),StringHash("abilityId"),at)
call TimerStart(t,bh,false,function NagaAutoCastReset)
set t=null
return true
endfunction
function NagaApplyShadowStrike takes unit Bc,unit Om,integer at,real au returns nothing
local unit Ki=null
if Bc!=null and Om!=null and not IsUnitType(Om,UNIT_TYPE_DEAD) then
set Ki=CreateUnit(GetOwningPlayer(Bc),Pn,GetUnitX(Om),GetUnitY(Om),GetUnitFacing(Bc))
call SetUnitUserData(Ki,GetUnitUserData(Bc))
call UnitAddAbility(Ki,at)
call UnitApplyTimedLife(Ki,$42487765,au)
call IssueTargetOrder(Ki,"shadowstrike",Om)
endif
set Ki=null
set Bc=null
set Om=null
endfunction
function NagaChieftainDeepCurse takes unit Bc,unit Om returns nothing
