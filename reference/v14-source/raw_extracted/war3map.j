function GetKingUpgradeLimit takes integer V4 returns integer
local integer V5
local integer V6
local integer V7
local integer V8
if V4==$52303030 then
set V5=S9
set V6=Dg
set V7=20
set V8=17
elseif V4==$52303031 then
set V5=TB
set V6=Dg*2
set V7=30
set V8=16
elseif V4==$52303032 then
set V5=TC
set V6=Dg
set V7=20
set V8=16
else
return 0
endif
if Da then
return IMinBJ(V5,V6)
elseif DB then
if Dg<V8 then
return IMinBJ(V5,V7)
endif
endif
return V5
endfunction
