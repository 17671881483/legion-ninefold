function GetIntTimeForStrTime takes string DK returns integer
return S2I(SubStringBJ(DK,1,5))*10000+S2I(SubStringBJ(DK,6,8))*100+S2I(SubStringBJ(DK,9,11))
endfunction
function EscapeGetCurrentTime takes nothing returns integer
local integer DK=0
call EXWriteGameLog(1,"get_time_start")
set DK=GetIntTimeForStrTime(EXNetGetTime())
call EXWriteGameLog(1,"get_time_end")
return DK
endfunction
function EscapeNormalizePunishment takes player h returns integer
local integer TO=YDWERPGGetKey(h,"punishment")
if TO<0 then
set TO=5
call YDWERPGSetKey(h,"punishment",5)
endif
set h=null
return TO
endfunction
function EscapeApplyGoldPunishment takes player h,integer TO returns nothing
local integer BU=GetPlayerState(h,PLAYER_STATE_RESOURCE_GOLD)
call YDWERPGSetKey(h,"punishment",TO-1)
call DisplayTimedTextToPlayer(h,0,0,10,YDWETranslate("|cFFFF33CC由于您最近过早离开游戏,扣除您50金币,请不要过早离开游戏.惩罚次数还剩")+I2S(TO-2)+YDWETranslate("次|r"))
call SetPlayerState(h,PLAYER_STATE_RESOURCE_GOLD,BU-50)
set h=null
endfunction
function EscapeApplyWarning takes player h,integer TO returns nothing
call YDWERPGSetKey(h,"punishment",TO-1)
call DisplayTimedTextFromPlayer(h,0,0,10,YDWETranslate("|cFFFF33CC警告！您上局过早的离开了游戏,如果您今天仍然有过早离开游戏的行为,将会在开局扣除您50金币,请您健康游戏.|r"))
set h=null
endfunction
function EscapeUpdatePlayer takes player h,integer DK returns nothing
local integer TL=YDWERPGGetKey(h,"escape")
local integer TM=YDWERPGGetKey(h,"last_time")
local boolean TN=TM!=DK
local integer TO
call YDWERPGSetKey(h,"last_time",DK)
if TN then
call YDWERPGSetKey(h,"escape",0)
endif
set TO=EscapeNormalizePunishment(h)
if TO>4 then
call EscapeApplyGoldPunishment(h,TO)
elseif TO==1 and TL==1 and TN then
call EscapeApplyWarning(h,TO)
endif
set h=null
endfunction
function EscapeFunc takes nothing returns nothing
local player h
local integer BB=0
local integer DK=EscapeGetCurrentTime()
loop
set h=Player(BB)
if IsLivingPlayer(h) then
call EscapeUpdatePlayer(h,DK)
endif
exitwhen BB>=7
set BB=BB+1
endloop
set h=null
endfunction
function Trig_escapeActions takes nothing returns nothing
call EscapeFunc()
endfunction
function Trig_MonthlyIsBuildFinishEvent takes nothing returns boolean
return EVENT_PLAYER_UNIT_CONSTRUCT_FINISH==GetTriggerEventId()==true or EVENT_PLAYER_UNIT_UPGRADE_FINISH==GetTriggerEventId()==true
endfunction
function Trig_MonthlyAddRecord takes player h,string Dt,integer ZY,integer ZX returns nothing
call YDWERPGAddKey(h,YDWETranslate(Dt),1)
call SaveInteger(Y,ZY,ZX,1)
set h=null
endfunction
function Trig_MonthlyHandleBuildRecord takes player h,integer x,integer ZX returns nothing
if E6[ZX]>=18000 and LoadInteger(Y,7704,ZX)==0 then
call Trig_MonthlyAddRecord(h,"兵力+1",7704,ZX)
elseif x==$68304A51 and LoadInteger(Y,$68304A51,ZX)==0 then
call Trig_MonthlyAddRecord(h,"术士+1",x,ZX)
elseif x==$68304A4B and LoadInteger(Y,$68304A4B,ZX)==0 then
call Trig_MonthlyAddRecord(h,"骷髅+1",x,ZX)
elseif x==$68313849 and LoadInteger(Y,$68313849,ZX)==0 then
call Trig_MonthlyAddRecord(h,"不灭+1",x,ZX)
elseif x==$75316D75 or x==$68323034 or x==$68323031 and LoadInteger(Y,$68323034,ZX)==0 then
call Trig_MonthlyAddRecord(h,"圣龙+1",$68323034,ZX)
elseif x==$68323033 and LoadInteger(Y,$68323033,ZX)==0 then
call Trig_MonthlyAddRecord(h,"佛丁+1",x,ZX)
elseif x==$6830534A and LoadInteger(Y,$6830534A,ZX)==0 then
call Trig_MonthlyAddRecord(h,"女巫+1",x,ZX)
elseif x==$68313035 and LoadInteger(Y,$68313035,ZX)==0 then
call Trig_MonthlyAddRecord(h,"毁灭+1",x,ZX)
elseif x==$68324332 and LoadInteger(Y,$68324332,ZX)==0 then
call Trig_MonthlyAddRecord(h,"尔丹+1",x,ZX)
elseif x==$68315334 and LoadInteger(Y,$68315334,ZX)==0 then
call Trig_MonthlyAddRecord(h,"再造+1",x,ZX)
elseif x==$68315332 and LoadInteger(Y,$68315332,ZX)==0 then
call Trig_MonthlyAddRecord(h,"蓝幽灵+1",x,ZX)
elseif x==$68304A56 and LoadInteger(Y,$68304A56,ZX)==0 then
call Trig_MonthlyAddRecord(h,"玛法+1",x,ZX)
elseif x==$68313032 and LoadInteger(Y,$68313032,ZX)==0 then
call Trig_MonthlyAddRecord(h,"灵魂+1",x,ZX)
elseif x==$6E303053 and LoadInteger(Y,$6E303053,ZX)==0 then
call Trig_MonthlyAddRecord(h,"希尔+1",x,ZX)
elseif x==$6E303054 and LoadInteger(Y,$6E303054,ZX)==0 then
call Trig_MonthlyAddRecord(h,"拉丁+1",x,ZX)
elseif x==$68304A4F or x==$68304F59 and LoadInteger(Y,$68304A4F,ZX)==0 then
call Trig_MonthlyAddRecord(h,"冰弓+1",$68304A4F,ZX)
endif
set h=null
endfunction
function Trig_MonthlyShouldAddFreeRecord takes integer x,integer ZX returns boolean
return (HaveSavedInteger(O,x,StringHash("vip_level")) and LoadInteger(O,x,StringHash("vip_level"))==0) or x==$68315332 or x==$68315334 or x==$68324332 or x==$75316D75 or x==$68323034 or x==$68323031 and LoadInteger(Y,10044,ZX)==0
endfunction
function Trig_MonthlyShouldAddHonorRecord takes integer x,integer ZX returns boolean
return (HaveSavedInteger(O,x,StringHash("vip_level")) and LoadInteger(O,x,StringHash("vip_level"))==2) or x==$6E303547 or x==$6E303054 or x==$68304A4B or x==$68304A4F or x==$68304F59 or x==$68304A51 or x==$68313037 or x==$68313849 or x==$68323033 or x==$68313032 or x==$68313035 and LoadInteger(Y,10055,ZX)==0
endfunction
function Trig_MonthlyApplyUnitRecord takes unit i,boolean ZW returns nothing
local player h=GetOwningPlayer(i)
local integer ZX=GetPlayerId(h)+1
local integer x=GetUnitTypeId(i)
if ZW then
call Trig_MonthlyHandleBuildRecord(h,x,ZX)
endif
if Trig_MonthlyShouldAddFreeRecord(x,ZX) then
call Trig_MonthlyAddRecord(h,"免费+1",10044,ZX)
endif
if Trig_MonthlyShouldAddHonorRecord(x,ZX) then
call Trig_MonthlyAddRecord(h,"荣誉+1",10055,ZX)
endif
set i=null
set h=null
endfunction
function Trig_MonthlyActions takes nothing returns nothing
call Trig_MonthlyApplyUnitRecord(GetTriggerUnit(),Trig_MonthlyIsBuildFinishEvent())
endfunction
function BoxGiftTransferBuildingLimitForUpgrade takes unit Y6,integer ZL,unit ZM,integer ZN,player h returns nothing
local integer ZO=0
local boolean ZP=false
local group DG=null
if Y6!=null and ZM!=null and h!=null then
set ZO=LoadInteger(O,GetHandleId(Y6),StringHash("base_id"))
set ZP=LoadBoolean(O,GetHandleId(Y6),StringHash("limitid_ex"))
if ZO>0 then
if ZP then
call BuildingLimitRemoveGroupForUnit(Y6,ZO,h)
call SaveInteger(O,GetHandleId(ZM),StringHash("base_id"),ZO)
call SaveBoolean(O,GetHandleId(ZM),StringHash("limitid_ex"),true)
else
set DG=LoadGroupHandle(X,ZO,GetHandleId(h))
if DG!=null then
call GroupRemoveUnit(DG,Y6)
call GroupAddUnit(DG,ZM)
call GroupCheckDeath(DG)
endif
call SaveInteger(O,GetHandleId(ZM),StringHash("base_id"),ZO)
endif
elseif LoadInteger(O,ZL,StringHash("count"))>0 then
call BuildingLimitRemoveGroupForUnit(Y6,ZL,h)
endif
endif
set Y6=null
set ZM=null
set h=null
set DG=null
endfunction
function BoxGiftApplyManualUpgradeFinishExecute takes nothing returns nothing
local integer Dt=StringHash("box_manual_upgrade_finish")
local unit Y6=LoadUnitHandle(O,Dt,StringHash("old_unit"))
local integer ZL=LoadInteger(O,Dt,StringHash("old_type"))
local unit ZM=LoadUnitHandle(O,Dt,StringHash("new_unit"))
local integer ZN=LoadInteger(O,Dt,StringHash("new_type"))
local player h=LoadPlayerHandle(O,Dt,StringHash("player"))
local integer ZE=LoadInteger(O,Dt,StringHash("user_data"))
if ZM!=null then
call BoxGiftTransferBuildingLimitForUpgrade(Y6,ZL,ZM,ZN,h)
call OldcodeApplyManualUpgradeFinish(Y6,ZL,ZM,ZN,h)
call NagaTrgApplyManualUpgradeFinish(Y6,ZL,h)
call AllBuildingStartApplyManualUpgradeFinishByUnit(ZM,ZN,ZE)
call AchievementHandleUpgradeBuildingUnit(ZM)
call Trig_MonthlyApplyUnitRecord(ZM,true)
call PlayerBuildForUnit(h,ZM)
endif
call FlushChildHashtable(O,Dt)
set Y6=null
set ZM=null
set h=null
endfunction
function InitTrig_Monthly takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_CONSTRUCT_FINISH)
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_UPGRADE_FINISH)
call TriggerAddAction(t,function Trig_MonthlyActions)
set t=null
endfunction
