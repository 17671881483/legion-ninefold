function LumberTechAdd takes player h,integer x returns nothing
local boolean DW=false
if GetPlayerTechMaxAllowed(h,x)<=GetPlayerTechCountSimple(x,h) then
call SetPlayerTechMaxAllowed(h,x,GetPlayerTechCountSimple(x,h)+1)
set DW=true
endif
call SetPlayerTechResearched(h,x,GetPlayerTechCountSimple(x,h)+1)
call UpLumberingHook(x,h)
if DW or LoadInteger(O,GetHandleId(h),x)>GetFoodMaxLevel(x) then
call SetPlayerTechMaxAllowed(h,x,GetPlayerTechCountSimple(x,h))
endif
set h=null
endfunction
function LumberTechAddNoArg takes nothing returns nothing
call LumberTechAdd(DR,DV)
endfunction
function Trig_BuildingFrameLimitInitActions takes nothing returns nothing
local group DG=YDWEGetUnitsOfTypeIdAllNull($68303233)
local unit D6=FirstOfGroup(DG)
local player h
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
set h=GetOwningPlayer(D6)
if YDWERPGBillingHasStatus(h,"20081785") or YDWERPGBillingHasStatus(h,"20082165") then
call SetPlayerUnitAvailableBJ(Cy,false,h)
call UnitAddAbility(D6,C5)
call UnitMakeAbilityPermanent(D6,true,C5)
endif
endloop
call DestroyGroup(DG)
set DG=null
set D6=null
set h=null
endfunction
function InitTrig_BuildingFrameLimitInit takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterTimerEventSingle(t,5)
call TriggerAddAction(t,function Trig_BuildingFrameLimitInitActions)
set t=null
endfunction
function Trig_BuildingFrameInterFaceActions takes nothing returns nothing
local integer BF=GetResearched()
local player h=GetTriggerPlayer()
local unit i=GetTriggerUnit()
local integer BT=LoadInteger(O,GetHandleId(h),BF)
local integer BU
local integer BV
local group DG
local integer YN
if BuildingFrame_CheckId(BF) and YDWERPGBillingHasStatus(h,"20081785") or YDWERPGBillingHasStatus(h,"20082165") or DM then
call IssueImmediateOrderById(i,851976)
if BT==0 then
set BT=1
endif
set YN=YDWES2Id(LoadStr(B,BF,StringHash("Requires"+I2S(BT))))
if YN>0 then
set DG=YDWEGetUnitsOfPlayerAndTypeIdNull(h,YN)
if CountUnitsInGroup(DG)==0 then
call DestroyGroup(DG)
call DisplayTimedTextToPlayer(h,0,0,10,"兵力不足")
set i=null
set h=null
set DG=null
return
endif
call DestroyGroup(DG)
endif
set DG=null
set BU=S2I(LoadStr(B,BF,StringHash("goldbase")))+IMaxBJ(BT-1,0)*S2I(LoadStr(B,BF,StringHash("goldmod")))
set BV=S2I(LoadStr(B,BF,StringHash("lumberbase")))+IMaxBJ(BT-1,0)*S2I(LoadStr(B,BF,StringHash("lumbermod")))
if GetPlayerState(h,PLAYER_STATE_RESOURCE_GOLD)<BU or GetPlayerState(h,PLAYER_STATE_RESOURCE_LUMBER)<BV then
call DisplayTimedTextToPlayer(h,0,0,10,"资源不足")
set DG=null
set i=null
set h=null
return
else
call AdjustPlayerStateBJ(-BU,h,PLAYER_STATE_RESOURCE_GOLD)
call AdjustPlayerStateBJ(-BV,h,PLAYER_STATE_RESOURCE_LUMBER)
if BuildingFrame_IsUpgradeId(BF) then
call BoxGiftTryConsumeBuildFreeWithCost(h,BU,BV)
endif
endif
if BT>=GetFoodMaxLevel(BF) then
call SetPlayerTechMaxAllowed(h,BF,GetPlayerTechCount(h,BF,true))
endif
call SaveInteger(O,GetHandleId(h),BF,BT+1)
call SaveInteger(O,GetHandleId(h),StringHash("tech_loding_lv"),LoadInteger(O,GetHandleId(h),StringHash("tech_loding_lv"))+1)
call BuildingFrame_create(i,BF)
endif
set i=null
set h=null
set DG=null
endfunction
function InitTrig_BuildingFrameInterFace takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_RESEARCH_START)
call TriggerAddAction(t,function Trig_BuildingFrameInterFaceActions)
set t=null
endfunction
function RegisterSkillList takes integer KH,integer BN returns boolean
local integer D9=LoadInteger(O,KH,StringHash("number"))
call SaveInteger(O,KH,D9,BN)
call SaveInteger(O,KH,StringHash("number"),D9+1)
return D9==0
endfunction
function SkillListGetRandom takes integer KH returns integer
local integer D9=LoadInteger(O,KH,StringHash("number"))
if D9>0 then
return LoadInteger(O,KH,GetRandomInt(0,D9-1))
endif
return 0
endfunction
function SetSkillListState takes player h,integer KH,boolean Dn returns boolean
local integer D9=LoadInteger(O,KH,StringHash("number"))
local integer N3=0
local integer Os=0
if D9<=0 then
set h=null
return false
endif
loop
set Os=LoadInteger(O,KH,N3)
call SetPlayerAbilityAvailable(h,Os,Dn)
exitwhen N3+1==D9
set N3=N3+1
endloop
set h=null
return true
endfunction
function RemoveSkillList takes unit i,integer KH returns boolean
local integer D9=LoadInteger(O,KH,StringHash("number"))
local integer N3=0
local integer Os=0
if D9<=0 then
set i=null
return false
endif
loop
set Os=LoadInteger(O,KH,N3)
call UnitRemoveAbility(i,Os)
exitwhen N3+1==D9
set N3=N3+1
endloop
if KH==StringHash("box") or KH==StringHash("box2") then
call UnitRemoveAbility(i,N4)
endif
set i=null
return true
endfunction
function UpFarm takes player h returns boolean
local integer BF=$68303234
local group DG=YDWEGetUnitsOfPlayerAndTypeIdNull(h,BF)
local integer Yr=0
local boolean Ys=false
loop
exitwhen CountUnitsInGroup(DG)>0 or BF==0
set BF=LoadInteger(O,BF,StringHash("next"))
call DestroyGroup(DG)
set DG=YDWEGetUnitsOfPlayerAndTypeIdNull(h,BF)
endloop
if BF!=0 then
set Yr=LoadInteger(O,BF,StringHash("next"))
if Yr!=0 then
call YDWEReplaceUnitBJNull(FirstOfGroup(DG),Yr,1)
set Ys=true
endif
endif
call DestroyGroup(DG)
set DG=null
set h=null
return Ys
endfunction
function UpLumbering takes player h returns boolean
if GetPlayerTechCount(h,$52303033,true)+LoadInteger(O,GetHandleId(h),StringHash("tech_loding_lv"))>=GetFoodMaxLevel($52303033) then
if GetPlayerTechCount(h,$52303048,true)+LoadInteger(O,GetHandleId(h),StringHash("tech_loding_lv"))>=GetFoodMaxLevel($52303048) then
set h=null
return false
else
call SaveInteger(O,GetHandleId(h),$52303048,LoadInteger(O,GetHandleId(h),$52303048)+1)
call LumberTechAdd(h,$52303048)
endif
else
call SaveInteger(O,GetHandleId(h),$52303033,LoadInteger(O,GetHandleId(h),$52303033)+1)
call LumberTechAdd(h,$52303033)
endif
set h=null
return true
endfunction
function BoxSkillListHasUnitSkill takes unit i,integer KH returns boolean
local integer D9=LoadInteger(O,KH,StringHash("number"))
local integer N3=0
local integer Os=0
loop
exitwhen N3>=D9
set Os=LoadInteger(O,KH,N3)
if GetUnitAbilityLevel(i,Os)>0 then
set i=null
return true
endif
set N3=N3+1
endloop
set i=null
return false
endfunction
function BoxGetActiveSkillListKey takes unit i returns integer
if BoxSkillListHasUnitSkill(i,StringHash("box2")) then
set i=null
return StringHash("box2")
endif
if BoxSkillListHasUnitSkill(i,StringHash("box")) then
set i=null
return StringHash("box")
endif
set i=null
return 0
endfunction
function BoxRefreshReforgeAbility takes unit i returns nothing
if Dg<=13 and BoxGetActiveSkillListKey(i)!=0 then
if GetUnitAbilityLevel(i,N4)==0 then
call UnitAddAbility(i,N4)
endif
else
call UnitRemoveAbility(i,N4)
endif
set i=null
endfunction
function BoxRemoveReforgeAbilityEnum takes nothing returns nothing
call UnitRemoveAbility(GetEnumUnit(),N4)
endfunction
function BoxRemoveReforgeAbilityForAll takes nothing returns nothing
local group DG
local integer N3=0
local integer N5=7
local player h
loop
set h=Player(N3)
set DG=YDWEGetUnitsOfPlayerAndTypeIdNull(h,$6E303630)
call ForGroup(DG,function BoxRemoveReforgeAbilityEnum)
call DestroyGroup(DG)
exitwhen N3>=N5
set N3=N3+1
endloop
set DG=null
set h=null
endfunction
function BoxRollSkillList takes unit Ki,integer Dt,integer D9 returns nothing
local integer BB=0
local integer Oo=0
local integer BN=0
local integer Oq=0
local integer On=LoadInteger(O,Dt,StringHash("number"))
local boolean Op=false
if Ki!=null and IsLivingPlayer(GetOwningPlayer(Ki)) then
loop
set BB=BB+1
set Oo=0
set Op=false
loop
exitwhen Oo>=20 or Op
set BN=SkillListGetRandom(Dt)
exitwhen BN==0
set Op=UnitAddAbility(Ki,BN)
set Oo=Oo+1
endloop
if not Op then
set Oq=0
loop
exitwhen Oq>=On or Op
set BN=LoadInteger(O,Dt,Oq)
if BN!=0 then
set Op=UnitAddAbility(Ki,BN)
endif
set Oq=Oq+1
endloop
endif
exitwhen BB>=D9 or not Op
endloop
endif
set Ki=null
endfunction
function BoxGiftConsumeBoxReward takes unit Pf returns nothing
