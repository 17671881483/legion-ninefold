function QBTimer takes nothing returns nothing
call DestroyTimer(GetExpiredTimer())
call CreateLeaderboardBJ(bj_FORCE_ALL_PLAYERS,YDWETranslate("国王生命值"))
set M4=bj_lastCreatedLeaderboard
call LeaderboardAddItemBJ(Player(8),M4,GetPlayerName(Player(8)),0)
call LeaderboardAddItemBJ(Player(9),M4,GetPlayerName(Player(9)),0)
call LeaderboardDisplayBJ(true,M4)
endfunction
function oldcodefn_QB takes nothing returns nothing
call TimerStart(CreateTimer(),2,false,function QBTimer)
endfunction
function oldcodefn_SB takes nothing returns nothing
set Bi=1+GetPlayerId(GetEnumPlayer())
call CreateFogModifierRectBJ(true,GetEnumPlayer(),FOG_OF_WAR_VISIBLE,GX)
set M5[Bi]=bj_lastCreatedFogModifier
call CreateFogModifierRectBJ(true,GetEnumPlayer(),FOG_OF_WAR_VISIBLE,Gl)
set M6[Bi]=bj_lastCreatedFogModifier
call CreateFogModifierRectBJ(true,GetEnumPlayer(),FOG_OF_WAR_VISIBLE,GY)
set M7[Bi]=bj_lastCreatedFogModifier
endfunction
function tB takes nothing returns nothing
call ForForce(Jc,function oldcodefn_SB)
endfunction
function uB takes nothing returns nothing
call UnitRemoveAbility(GetEnumUnit(),$4152616C)
