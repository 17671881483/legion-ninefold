function OC5F_GN takes nothing returns nothing
local itemtype IL
local integer IM=0
local integer IK=0
local integer IJ
set IJ=1
loop
if bj_stockAllowedPermanent[IJ] then
set IK=IK+1
if GetRandomInt(1,IK)==1 then
set IL=ITEM_TYPE_PERMANENT
set IM=IJ
endif
endif
if bj_stockAllowedCharged[IJ] then
set IK=IK+1
if GetRandomInt(1,IK)==1 then
set IL=ITEM_TYPE_CHARGED
set IM=IJ
endif
endif
if bj_stockAllowedArtifact[IJ] then
set IK=IK+1
if GetRandomInt(1,IK)==1 then
set IL=ITEM_TYPE_ARTIFACT
set IM=IJ
endif
endif
set IJ=IJ+1
exitwhen IJ>10
endloop
if IK==0 then
set IL=null
return
endif
call fN(IL,IM)
set IL=null
endfunction
