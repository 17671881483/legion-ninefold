function YDWEUnitTransform takes unit i,integer EC,integer cj returns nothing
call UnitAddAbility(i,EC)
call EXSetAbilityDataInteger(EXGetUnitAbility(i,EC),1,ck,GetUnitTypeId(i))
call EXSetAbilityAEmeDataA(EXGetUnitAbility(i,EC),GetUnitTypeId(i))
call UnitRemoveAbility(i,EC)
call UnitAddAbility(i,EC)
call EXSetAbilityAEmeDataA(EXGetUnitAbility(i,EC),cj)
call UnitRemoveAbility(i,EC)
endfunction
