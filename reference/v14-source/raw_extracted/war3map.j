call SaveStr(K,StringHash("Title"),SC,YDWETranslate("|cFFFF0000<超|r|cFFFF5500级|r|cFFFFAA00赞|r|cFFFFFF00助>|r"))
call SaveStr(K,StringHash("Describe"),SC,YDWETranslate(" 感谢您对军团战争的支持！"))
