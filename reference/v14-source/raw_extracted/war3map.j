function YDWEIssueHauntOrderAtLocBJNull takes unit e0,location a7 returns boolean
local group DG=null
local unit e1=null
set DG=CreateGroup()
call GroupEnumUnitsInRangeOfLoc(DG,a7,2*bj_CELLWIDTH,filterIssueHauntOrderAtLocBJ)
set e1=FirstOfGroup(DG)
call DestroyGroup(DG)
set DG=null
if e1==null then
return false
endif
set e2=e1
set e1=null
return IssueTargetOrderById(e0,$75676F6C,e2)
endfunction
