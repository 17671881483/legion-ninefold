function YDWEDistanceBetweenUnitAndPoint takes unit QR,location Cd returns real
local real FF=GetUnitX(QR)-GetLocationX(Cd)
local real FG=GetUnitY(QR)-GetLocationY(Cd)
return SquareRoot(FF*FF+FG*FG)
endfunction
function YDWEAngleBetweenUnitAndPoint takes unit QR,location Cd returns real
return bj_RADTODEG*Atan2(GetLocationY(Cd)-GetUnitY(QR),GetLocationX(Cd)-GetUnitX(QR))
endfunction
function YDWEDistanceBetweenUnits takes unit QR,unit Cd returns real
local real FF=GetUnitX(QR)-GetUnitX(Cd)
local real FG=GetUnitY(QR)-GetUnitY(Cd)
return SquareRoot(FF*FF+FG*FG)
endfunction
function YDWEAngleBetweenUnits takes unit QR,unit Cd returns real
return bj_RADTODEG*Atan2(GetUnitY(Cd)-GetUnitY(QR),GetUnitX(Cd)-GetUnitX(QR))
endfunction
function YDWEGetRect takes real FF,real FG,real Ne,real Q9 returns rect
return Rect(FF-Ne*.5,FG-Q9*.5,FF+Ne*.5,FG+Q9*.5)
endfunction
function YDWEFlyEnable takes unit i returns nothing
call UnitAddAbility(i,$416D7266)
call UnitRemoveAbility(i,$416D7266)
endfunction
function YDWEId2S takes integer Dm returns string
local string eU=YP
local string DJ=""
local integer eS=Dm
local integer eR
local integer eQ
set eQ=0
loop
set eR=ModuloInteger(eS,256)
set eS=eS/256
set DJ=SubString(eU,eR,eR+1)+DJ
set eQ=eQ+1
exitwhen eQ==4
endloop
return DJ
endfunction
function YDWES2Id takes string YO returns integer
local string YS=YP
local integer YQ=StringLength(YO)
local integer QR=0
local integer Cd=0
local integer YR=1
local integer DJ=0
loop
exitwhen Cd>YQ-1
set YR=R2I(Pow(256,YQ-1-Cd))
set QR=1
loop
exitwhen QR>255
if SubString(YO,Cd,Cd+1)==SubString(YS,QR,QR+1) then
set DJ=DJ+QR*YR
set QR=256
endif
set QR=QR+1
endloop
set Cd=Cd+1
endloop
return DJ
endfunction
function YDWES2UnitId takes string YO returns integer
