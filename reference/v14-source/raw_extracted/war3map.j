function KelThuzadsAmuletBox takes unit Bc,integer BF returns nothing
local trigger t=CreateTrigger()
local integer Pp=1
local player h=Player(GetUnitUserData(Bc)-1)
local group DG=YDWEGetUnitsOfPlayerAndTypeIdNull(h,$68304D30)
local group Po=YDWEGetUnitsOfPlayerAndTypeIdNull(h,$6E303253)
call GroupAddGroup(Po,DG)
call GroupAddGroup(DG,Po)
if CountUnitsInGroup(DG)>0 then
set Pp=Pp+1
call UnitAddAbility(Bc,$41305A59)
call ForGroup(DG,function KelThuzadsAmuletBoxGroup)
endif
call DestroyGroup(DG)
call DestroyGroup(Po)
call UnitAddAbility(Bc,$41305A55)
call UnitMakeAbilityPermanent(Bc,true,$41305A55)
call SaveInteger(O,GetHandleId(Bc),StringHash("number"),Pp)
call SaveAgentHandle(O,GetHandleId(t),1,Bc)
call SaveInteger(O,GetHandleId(t),2,BF)
call TriggerRegisterUnitEvent(t,Bc,EVENT_UNIT_DAMAGED)
call TriggerAddCondition(t,Condition(function KelThuzadsAmuletboxCondition))
set t=null
set Bc=null
set DG=null
set Po=null
endfunction
function RegisterVarianSkillActionAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
local real Pv=GetUnitLifePercent(Bc)
local group DG
local unit D6
if Pv>=66 then
if GetTriggerExecCount(t)==1 then
call UnitAddAbility(Bc,P5)
call IssueImmediateOrder(Bc,"roar")
else
call UnitRemoveAbility(Bc,P5)
call UnitAddAbility(Bc,P6)
call IssueImmediateOrder(Bc,"howlofterror")
set DG=SelectRange(Bc,GetUnitX(Bc),GetUnitY(Bc),600)
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
call VertigoTargetEx(Bc,D6,1)
endloop
call DestroyGroup(DG)
set DG=null
endif
else
call UnitRemoveAbility(Bc,P5)
call UnitRemoveAbility(Bc,P6)
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
endif
set Bc=null
set t=null
endfunction
function FullyArmedAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
if GetTriggerEventId()==EVENT_UNIT_DEATH then
call DestroyEffect(LoadEffectHandle(O,GetHandleId(t),1))
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
else
call DamageAoe(Bc,GetUnitX(Bc),GetUnitY(Bc),300,150*.04,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
if .04*GetTriggerExecCount(t)>=3 then
call DestroyEffect(LoadEffectHandle(O,GetHandleId(t),1))
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
endif
endif
set Bc=null
set t=null
endfunction
function AngryDoubleBladesAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
call SaveBoolean(O,GetHandleId(Bc),StringHash("angry double blades battle"),false)
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
set Bc=null
set t=null
endfunction
function RegisterVarianSkillActionCallBackAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
call SetUnitInvulnerable(Bc,false)
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
set t=null
set Bc=null
endfunction
function RegisterVarianSkillActionCallBack takes unit Bc,unit Om returns nothing
local trigger t=CreateTrigger()
call UnitAddAbility(Bc,$4131315A)
call IssueTargetOrder(Bc,"attack",Om)
call VertigoTarget(Bc,Om,1)
call SaveAgentHandle(O,GetHandleId(t),0,Bc)
call SetUnitInvulnerable(Bc,true)
call TriggerRegisterUnitEvent(t,Bc,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,4,false)
call TriggerAddAction(t,function RegisterVarianSkillActionCallBackAction)
set t=null
set Bc=null
set Om=null
endfunction
function RegisterVarianSkillAction takes nothing returns nothing
local unit Bc=GetTriggerUnit()
local real Pv=GetUnitLifePercent(Bc)
local trigger t=null
local group DG
local unit D6
local unit Om=null
if GetTriggerEventId()==EVENT_UNIT_DAMAGED then
if GetUnitAbilityLevel(Bc,Pw)>0 and not LoadBoolean(O,GetHandleId(Bc),StringHash("angry double blades death")) and GetEventDamage()>=GetUnitState(Bc,UNIT_STATE_LIFE) then
call SaveBoolean(O,GetHandleId(Bc),StringHash("angry double blades death"),true)
call SetUnitState(Bc,UNIT_STATE_LIFE,RMinBJ(1500,GetUnitState(Bc,UNIT_STATE_LIFE)+GetUnitState(Bc,UNIT_STATE_MANA)*20))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIre\\AIreTarget.mdl",Bc,"chest"))
set DG=SelectRange(Bc,GetUnitX(Bc),GetUnitY(Bc),500)
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
if Om==null or GetUnitState(D6,ConvertUnitState(18))>=GetUnitState(Om,ConvertUnitState(18)) then
set Om=D6
endif
endloop
if Om!=null then
call SetUnitPosition(Bc,GetUnitX(Om),GetUnitY(Om))
call RegisterVarianSkillActionCallBack(Bc,Om)
set Om=null
endif
call DestroyGroup(DG)
set DG=null
elseif Pv>=66 then
if not HaveSavedBoolean(O,GetHandleId(Bc),StringHash("fully armed")) then
call SaveBoolean(O,GetHandleId(Bc),StringHash("fully armed"),true)
call RemoveSavedBoolean(O,GetHandleId(Bc),StringHash("weapon mastery"))
call RemoveSavedBoolean(O,GetHandleId(Bc),StringHash("angry double blades"))
call RemoveSavedBoolean(O,GetHandleId(Bc),StringHash("angry double blades battle"))
call AddUnitAnimationProperties(Bc,"alternate",false)
call AddUnitAnimationProperties(Bc,"gold",false)
call UnitAddAbility(Bc,Pz)
call UnitAddAbility(Bc,P0)
call UnitAddAbility(Bc,P1)
call UnitRemoveAbility(Bc,P2)
call UnitRemoveAbility(Bc,P3)
call UnitRemoveAbility(Bc,P4)
if not HaveSavedHandle(O,GetHandleId(Bc),StringHash("fully armed")) and GetUnitAbilityLevel(Bc,Pw)>0 then
set t=CreateTrigger()
call SaveAgentHandle(O,GetHandleId(t),0,Bc)
call TriggerRegisterUnitEvent(t,Bc,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,5,true)
call TriggerRegisterTimerEvent(t,0,false)
call TriggerAddAction(t,function RegisterVarianSkillActionAction)
call SaveAgentHandle(O,GetHandleId(Bc),StringHash("fully armed"),t)
set t=null
endif
endif
elseif Pv<66 and Pv>=33 then
if not HaveSavedBoolean(O,GetHandleId(Bc),StringHash("weapon mastery")) then
call SaveBoolean(O,GetHandleId(Bc),StringHash("weapon mastery"),true)
call RemoveSavedBoolean(O,GetHandleId(Bc),StringHash("fully armed"))
call RemoveSavedBoolean(O,GetHandleId(Bc),StringHash("angry double blades"))
call RemoveSavedBoolean(O,GetHandleId(Bc),StringHash("angry double blades battle"))
call AddUnitAnimationProperties(Bc,"alternate",true)
call AddUnitAnimationProperties(Bc,"gold",false)
call UnitAddAbility(Bc,P2)
call UnitRemoveAbility(Bc,Pz)
call UnitRemoveAbility(Bc,P0)
call UnitRemoveAbility(Bc,P1)
call UnitRemoveAbility(Bc,P3)
call UnitRemoveAbility(Bc,P4)
if GetUnitAbilityLevel(Bc,Pw)>0 then
set t=CreateTrigger()
call SaveAgentHandle(O,GetHandleId(t),0,Bc)
if GetUnitTypeId(Bc)==$68305843 then
call SaveAgentHandle(O,GetHandleId(t),1,AddSpecialEffectTarget("Bjlwlassgw01_Spell01.mdx",Bc,"origin"))
else
call SaveAgentHandle(O,GetHandleId(t),1,AddSpecialEffectTarget("war3mapImported\\JRFB14.mdx",Bc,"origin"))
endif
call TriggerRegisterUnitEvent(t,Bc,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,.04,true)
call TriggerAddAction(t,function FullyArmedAction)
endif
endif
elseif Pv<33 then
if not HaveSavedBoolean(O,GetHandleId(Bc),StringHash("angry double blades")) then
call SaveBoolean(O,GetHandleId(Bc),StringHash("angry double blades"),true)
call RemoveSavedBoolean(O,GetHandleId(Bc),StringHash("fully armed"))
call RemoveSavedBoolean(O,GetHandleId(Bc),StringHash("weapon mastery"))
call AddUnitAnimationProperties(Bc,"alternate",false)
call AddUnitAnimationProperties(Bc,"gold",true)
call UnitAddAbility(Bc,P3)
call UnitAddAbility(Bc,P4)
call UnitRemoveAbility(Bc,P2)
call UnitRemoveAbility(Bc,Pz)
call UnitRemoveAbility(Bc,P0)
call UnitRemoveAbility(Bc,P1)
if GetUnitAbilityLevel(Bc,Pw)>0 then
call SaveBoolean(O,GetHandleId(Bc),StringHash("angry double blades battle"),true)
set t=CreateTrigger()
call SaveAgentHandle(O,GetHandleId(t),0,Bc)
call TriggerRegisterUnitEvent(t,Bc,EVENT_UNIT_DEATH)
call TriggerRegisterTimerEvent(t,5,false)
call TriggerAddAction(t,function AngryDoubleBladesAction)
set t=null
endif
endif
endif
else
call FlushChildHashtable(O,GetHandleId(GetTriggeringTrigger()))
call DestroyTrigger(GetTriggeringTrigger())
endif
set Bc=null
endfunction
function RegisterVarianSkill takes unit Bc returns nothing
local trigger t
if GetUnitAbilityLevel(Bc,Ps)>0 and GetUnitAbilityLevel(Bc,Pt)>0 and GetUnitAbilityLevel(Bc,Pu)>0 then
set t=CreateTrigger()
call TriggerRegisterUnitEvent(t,Bc,EVENT_UNIT_DAMAGED)
call TriggerRegisterUnitEvent(t,Bc,EVENT_UNIT_DEATH)
call TriggerAddAction(t,function RegisterVarianSkillAction)
set t=null
endif
set Bc=null
endfunction
function RegisterMummyAbilityAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
local integer BF=LoadInteger(O,GetHandleId(t),1)
if GetTriggerEventId()==EVENT_WIDGET_DEATH then
if GetUnitTypeId(Bc)==$68305144 then
call SetUnitAnimation(Bc,"spell alternate")
endif
call YDWETimerDestroyEffect(2,AddSpecialEffect("[tx][jn]chuanjialingjian111.mdx",GetUnitX(Bc),GetUnitY(Bc)))
call TriggerRegisterTimerEvent(t,2.01,false)
call DestroyEffect(LoadEffectHandle(O,GetHandleId(Bc),$41313446))
else
call UnitRemoveAbility(Bc,BF)
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
endif
set Bc=null
set t=null
endfunction
function RegisterMummyAbility takes unit Bc,integer BF returns nothing
local trigger t=CreateTrigger()
call SaveAgentHandle(O,GetHandleId(t),0,Bc)
call SaveInteger(O,GetHandleId(t),1,BF)
call TriggerRegisterDeathEvent(t,Bc)
call TriggerAddAction(t,function RegisterMummyAbilityAction)
set Bc=null
set t=null
endfunction
function SelectRangeNotMummy takes unit Pf,real FF,real FG,real Px,integer BF returns group
local group DG=CreateGroup()
local group Om=CreateGroup()
local unit D6=null
call GroupEnumUnitsInRange(DG,FF,FG,Px,null)
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
if IsUnitAlly(D6,GetOwningPlayer(Pf)) and GetUnitAbilityLevel(D6,BF)==0 and GetUnitTypeId(Pf)!=$6E303631 and GetUnitTypeId(Pf)!=$6E303632 then
if IsUnitType(D6,UNIT_TYPE_SUMMONED) or GetUnitTypeId(D6)==$68305049 or GetUnitTypeId(D6)==$6831384A or GetUnitTypeId(D6)==$68304A53 or GetUnitTypeId(D6)==$6833384A then
call DoNothing()
else
call GroupAddUnit(Om,D6)
endif
endif
call GroupRemoveUnit(DG,D6)
endloop
call DestroyGroup(DG)
set QF=Om
set DG=null
set Om=null
set Pf=null
return QF
endfunction
function RegisterSuperMummyAbilityAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
local integer BF=LoadInteger(O,GetHandleId(t),1)
local group DG=SelectRangeNotMummy(Bc,GetUnitX(Bc),GetUnitY(Bc),600,BF)
local unit Om=RadomOfGroup(DG)
local integer D9=LoadInteger(O,GetHandleId(t),2)
if GetTriggerEventId()==EVENT_WIDGET_DEATH then
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
else
if Om!=null then
if IssueTargetOrder(Bc,"unflamingattack",Om) then
call UnitAddAbility(Om,BF)
call UnitMakeAbilityPermanent(Om,true,BF)
call RegisterMummyAbility(Om,BF)
call SaveEffectHandle(O,GetHandleId(Om),$41313446,AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIda\\AIdaTarget.mdl",Om,"overhead"))
set D9=D9+1
if D9>=4 then
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
else
call SaveInteger(O,GetHandleId(t),2,D9)
endif
endif
endif
endif
call GroupClear(DG)
call DestroyGroup(DG)
set Bc=null
set t=null
set DG=null
set Om=null
endfunction
function RegisterSupperMummyAbility takes unit Bc,integer BF,integer QE returns nothing
local trigger t=CreateTrigger()
call RegisterMummyAbility(Bc,QE)
call SaveAgentHandle(O,GetHandleId(t),0,Bc)
call SaveInteger(O,GetHandleId(t),1,QE)
call TriggerRegisterTimerEvent(t,5,true)
call TriggerRegisterDeathEvent(t,Bc)
call TriggerAddAction(t,function RegisterSuperMummyAbilityAction)
set Bc=null
set t=null
endfunction
function RegisterSpaceTimeFissureAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer BF=GetHandleId(t)
local unit Bc=LoadUnitHandle(O,BF,0)
local real DK=LoadReal(O,BF,2)
local real QY=LoadReal(O,BF,1)
local real Qa=LoadReal(O,BF,4)
set Qa=Qa+DK
if Qa==QY then
call SetUnitLifePercentBJ(Bc,LoadReal(O,BF,10+R2I(LoadReal(O,BF,3))))
call YDWETimerDestroyEffect(2,AddSpecialEffect("LJQ_Heidong.mdx",GetUnitX(Bc),GetUnitY(Bc)))
call SaveReal(O,BF,4,0)
call UnitAddAbility(Bc,$41313530)
else
call SaveReal(O,BF,4,Qa)
call SaveReal(O,BF,10+R2I(Qa),GetUnitLifePercent(Bc))
endif
if IsUnitType(Bc,UNIT_TYPE_DEAD) then
call FlushChildHashtable(O,BF)
call DestroyTrigger(t)
endif
set Bc=null
set t=null
endfunction
function RegisterSpaceTimeFissure takes unit Bc,real QY,real DK,real QZ returns nothing
local trigger t=CreateTrigger()
local integer BF=GetHandleId(t)
call SaveAgentHandle(O,BF,0,Bc)
call SaveReal(O,BF,1,QY)
call SaveReal(O,BF,2,DK)
call SaveReal(O,BF,3,QZ)
call TriggerRegisterTimerEvent(t,DK,true)
call TriggerAddAction(t,function RegisterSpaceTimeFissureAction)
set t=null
set Bc=null
endfunction
function RegisterSpaceTimeFissureExAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local integer BF=GetHandleId(t)
local unit Bc=LoadUnitHandle(O,BF,0)
local real QY=LoadReal(O,BF,1)
local real BB=QY
loop
exitwhen BB<=1
call SaveReal(O,BF,10+R2I(BB),LoadReal(O,BF,10+R2I(BB-1)))
set BB=BB-1
endloop
call SaveReal(O,BF,10+1,GetUnitLifePercent(Bc))
if IsUnitType(Bc,UNIT_TYPE_DEAD) then
call FlushChildHashtable(O,BF)
call DestroyTrigger(t)
endif
set Bc=null
set t=null
endfunction
function RegisterSpaceTimeFissureEx takes unit Bc,integer p,real QY,real DK returns nothing
local trigger t=CreateTrigger()
local integer BF=GetHandleId(t)
call SaveAgentHandle(O,GetHandleId(Bc),p,t)
call SaveAgentHandle(O,BF,0,Bc)
call SaveReal(O,BF,1,QY)
call TriggerRegisterTimerEvent(t,DK,true)
call TriggerAddAction(t,function RegisterSpaceTimeFissureExAction)
set t=null
set Bc=null
endfunction
