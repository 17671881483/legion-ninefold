local force Bo=YDWEGetPlayersMatchingNull(Condition(function GetLiveingPlayerSizeForce))
local integer N6=CountPlayersInForceBJ(Bo)
call DestroyForce(Bo)
set Bo=null
return N6
endfunction
function IsUnitDead takes unit Bc returns boolean
local boolean Cd=IsUnitType(Bc,UNIT_TYPE_DEAD)
set Bc=null
return Cd
endfunction
function SetUnitTypeModel takes integer BF,string Qg,string Qh returns boolean
local boolean KH=false
if Qh==null then
set Qh=Qg
endif
set KH=EXSetUnitString(BF,13,Qg)
set KH=KH and EXSetUnitString(BF,14,Qh)
return KH
endfunction
function GetPlayerRect takes player h returns rect
if not IsLivingPlayer(h) then
return null
endif
if h==Player(0) then
return Z
elseif h==Player(1) then
return a
elseif h==Player(2) then
return b
elseif h==Player(3) then
return c
elseif h==Player(4) then
return d
elseif h==Player(5) then
return e
elseif h==Player(6) then
return f
elseif h==Player(7) then
return g
endif
return null
endfunction
