function GarroshBleedAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
local unit Om=LoadUnitHandle(O,GetHandleId(t),1)
if GetTriggerEventId()==EVENT_GAME_TIMER_EXPIRED then
if Bc==null or Om==null or GetUnitState(Bc,UNIT_STATE_LIFE)<=.405 or GetUnitState(Om,UNIT_STATE_LIFE)<=.405 then
call RemoveSavedBoolean(O,GetHandleId(Om),GetHandleId(Bc))
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
else
call UnitDamageTargetBJ(Bc,Om,10,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl",GetUnitX(Om),GetUnitY(Om)))
endif
else
call RemoveSavedBoolean(O,GetHandleId(Om),GetHandleId(Bc))
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
endif
set t=null
set Bc=null
set Om=null
endfunction
function GarroshBleed takes unit Bc,unit Om returns nothing
local trigger t
if IsUnitAlly(Bc,GetOwningPlayer(Om)) or LoadBoolean(O,GetHandleId(Om),GetHandleId(Bc)) then
set Bc=null
set Om=null
return
endif
call SaveBoolean(O,GetHandleId(Om),GetHandleId(Bc),true)
set t=CreateTrigger()
call SaveAgentHandle(O,GetHandleId(t),0,Bc)
call SaveAgentHandle(O,GetHandleId(t),1,Om)
call TriggerRegisterTimerEvent(t,0,false)
call TriggerRegisterTimerEvent(t,1,true)
call TriggerRegisterDeathEvent(t,Om)
call TriggerRegisterDeathEvent(t,Bc)
call TriggerAddAction(t,function GarroshBleedAction)
set t=null
set Bc=null
set Om=null
endfunction
