function ArthasHolyLightAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
local integer y=LoadInteger(O,GetHandleId(t),1)
local group DG
local unit D6
if GetTriggerEventId()==EVENT_PLAYER_UNIT_DEATH then
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
elseif GetKillingUnit()==Bc then
if y+1<20 then
call SaveInteger(O,GetHandleId(t),1,y+1)
else
call SaveInteger(O,GetHandleId(t),1,0)
set DG=SelectRangeAlly(Bc,GetUnitX(Bc),GetUnitY(Bc),600)
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
call ArthasAddAtkSpd(Bc,D6,6)
endloop
call DestroyGroup(DG)
set DG=null
endif
endif
set t=null
set Bc=null
endfunction
function ArthasHolyLight takes unit Bc returns nothing
