function ToLetter takes integer BB returns string
return SubString("ABCDEFGHIJKLMNOPQRSTUVWXYZ",BB,BB+1)
endfunction
function GetMostHeroId takes integer BB,integer BF returns integer
local integer y=1+LoadInteger(K,BB,BF)
local integer Ex=LoadInteger(K,BB,1)
local integer Ey=LoadInteger(K,BB,Ex)
call SaveInteger(K,BB,BF,y)
if y>=Ey then
call SaveInteger(K,BB,1,BF)
if y>=2 then
return BF
endif
return -2
endif
return -1
endfunction
function GetGCMaxVaulePlayer takes integer Cx returns player
local integer PP=0
local integer Ex=-1
local integer BB=0
local player h
loop
set h=Player(BB)
if not LoadBoolean(O,H2I(h),StringHash("winner")) and Cx==1 or Cx!=1 then
if PP<LoadInteger(O,H2I(h),Cx) then
set PP=LoadInteger(O,H2I(h),Cx)
set Ex=BB
endif
endif
exitwhen BB>=12
set BB=BB+1
endloop
if Ex==-1 then
set h=null
return null
endif
set h=null
return Player(Ex)
endfunction
