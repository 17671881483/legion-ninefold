function DisableEggUnitTypeDialog___ShowDialogEggUnitTypeAction takes nothing returns nothing
local player h=GetTriggerPlayer()
if LoadBoolean(O,GetHandleId(h),StringHash("ban_time_out")) then
call DisplayTimedTextToPlayer(h,0,0,10,"禁止兵种已超时!!!")
elseif LoadBoolean(O,GetHandleId(h),StringHash("ban")) then
call DisplayTimedTextToPlayer(h,0,0,10,"你已经禁止过兵种了!!!")
else
call DisableEggUnitTypeDialog___Disable(h)
endif
set h=null
endfunction
function DisableEggUnitTypeDialog___Init takes nothing returns nothing
local trigger t=CreateTrigger()
set u=CreateTrigger()
call TriggerAddAction(u,function DisableEggUnitTypeDialog___DialogEggUnitTypeAction)
if BD then
call TriggerRegisterPlayerChatEvent(t,Player(0),"-ban",true)
call TriggerRegisterPlayerChatEvent(t,Player(4),"-ban",true)
call SaveInteger(O,GetHandleId(Player(0)),StringHash("ban_count"),BE)
call SaveInteger(O,GetHandleId(Player(4)),StringHash("ban_count"),BE)
endif
call TriggerAddAction(t,function DisableEggUnitTypeDialog___ShowDialogEggUnitTypeAction)
set t=CreateTrigger()
call TriggerRegisterTimerEvent(t,.2,false)
call TriggerAddAction(t,function DisableEggUnitTypeDialog___InitList)
set t=null
endfunction
function EasterEgg___UpdataArtTimer takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer BQ=GetHandleId(t)
local integer BR=LoadInteger(O,BQ,0)
local string BP=LoadStr(O,BQ,2)
call EXSetAbilityString(BR,1,204,BP)
call FlushChildHashtable(O,BQ)
call DestroyTimer(t)
set t=null
set BP=null
endfunction
function EasterEggRegister takes integer BR,string BO returns nothing
local integer y=LoadInteger(O,StringHash("EasterEgg"),StringHash("count"))+1
call SaveInteger(O,StringHash("EasterEgg"),y,BR)
call SaveInteger(O,StringHash("EasterEgg"),StringHash("count"),y)
set BO=null
endfunction
function EasterEgg___GetMaxPage takes nothing returns integer
local integer y=LoadInteger(O,StringHash("EasterEgg"),StringHash("count"))
if y<=dM then
return 1
endif
return (y-1)/dM+1
endfunction
