call UnitApplyTimedLife(bj_lastCreatedUnit,$42487765,1.)
call SetUnitAbilityLevel(bj_lastCreatedUnit,$41304937,CC)
call IssueTargetOrder(bj_lastCreatedUnit,"thunderbolt",Om)
set Pf=null
set Om=null
endfunction
function VertigoTargetEx takes unit Pf,unit Om,integer CC returns nothing
set bj_lastCreatedUnit=CreateUnit(GetOwningPlayer(Pf),Pn,GetUnitX(Om),GetUnitY(Om),0)
