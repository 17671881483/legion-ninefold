endif
endfunction
function C_SushuiCalcSystemDivision takes nothing returns boolean
local string Bj=GetEventPlayerChatString()
local integer KJ=StringLength(Bj)
if SubStringBJ(Bj,1,1)=="0" then
return false
endif
if SubStringBJ(Bj,2,2)=="/" and KJ<=6 and S2I(SubStringBJ(Bj,3,KJ))!=0 then
return true
elseif SubStringBJ(Bj,3,3)=="/" and KJ<=7 and S2I(SubStringBJ(Bj,4,KJ))!=0 then
return true
elseif SubStringBJ(Bj,4,4)=="/" and KJ<=8 and S2I(SubStringBJ(Bj,5,KJ))!=0 then
return true
elseif SubStringBJ(Bj,5,5)=="/" and KJ<=9 and S2I(SubStringBJ(Bj,6,KJ))!=0 then
return true
endif
return false
endfunction
function A_SushuiCalcSystemDivision takes nothing returns nothing
local integer fs=0
local integer KJ=0
local boolean ft=false
set H7=GetEventPlayerChatString()
set KJ=StringLength(H7)
if SubStringBJ(H7,2,2)=="/" then
set fs=2
elseif SubStringBJ(H7,3,3)=="/" then
set fs=3
elseif SubStringBJ(H7,4,4)=="/" then
set fs=4
elseif SubStringBJ(H7,5,5)=="/" then
set fs=5
else
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,1.,15.,Fb[2])
return
endif
set Xj=S2I(SubStringBJ(H7,1,fs-1))
set Xk=S2I(SubStringBJ(H7,fs+1,KJ))
if Xk==0 then
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,1.,15.,Fb[2])
return
endif
set W7=I2R(Xj)/I2R(Xk)
set Xl=ModuloInteger(Xj,Xk)
if fs==2 then
set ft=W7>=-10. and Xl<89992
elseif fs==3 then
set ft=Xl>-89992 and Xl<989902
elseif fs==4 then
set ft=Xl>-989902 and Xl<$986B8A
elseif fs==5 then
set ft=Xl>-9989002 and Xl<$5F592E8
endif
if ft then
set Xm=GetRandomInt(1,40)
if Xm<=5 then
set Fb[0]=Fb[10+Xm]+H7+(Fb[20+Xm]+(R2S(W7)+(" 余 "+I2S(Xl))))+Fb[30+Xm]
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,1.,15.,Fb[0])
else
set Fb[0]=Fb[10]+H7+(Fb[20]+(R2S(W7)+(" 余 "+I2S(Xl))))+Fb[30]
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,1.,15.,Fb[0])
endif
else
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,1.,15.,Fb[1])
endif
endfunction
function C_SushuiRoll takes nothing returns boolean
return SubStringBJ(GetEventPlayerChatString(),1,5)=="-roll"
endfunction
function A_SushuiRoll takes nothing returns nothing
if StringLength(GetEventPlayerChatString())==5 then
set Xj=GetRandomInt(0,100)
set Xk=4
set Xm=96
if Xj<=Xk then
set Xk=1
else
set Xk=0
endif
if Xj>=Xm then
set Xm=2
else
set Xm=0
endif
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,5.,FW[GetConvertedPlayerId(GetTriggerPlayer())]+GetPlayerName(GetTriggerPlayer())+(YDWETranslate("|r从 100 中掷出了 ")+I2S(Xj)+("|r"+(Fc[Xk]+Fc[Xm]))))
else
if SubStringBJ(GetEventPlayerChatString(),6,6)==" " then
if StringLength(GetEventPlayerChatString())<=11 then
set Xj=S2I(SubStringBJ(GetEventPlayerChatString(),7,StringLength(GetEventPlayerChatString())))
if Xj<=20000 and Xj>0 then
set Xk=R2I(I2R(Xj)*.02)
set Xm=R2I(I2R(Xj)*.98)
set Xl=GetRandomInt(0,Xj)
if Xj<50 then
set Xk=0
set Xm=0
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,5.,FW[GetConvertedPlayerId(GetTriggerPlayer())]+GetPlayerName(GetTriggerPlayer())+(YDWETranslate("|r从 ")+(I2S(Xj)+YDWETranslate(" 中掷出了 "))+I2S(Xl)+("|r"+(Fc[Xk]+Fc[Xm]))))
else
if Xl<=Xk then
set Xk=1
else
set Xk=0
endif
if Xl>=Xm then
set Xm=2
else
set Xm=0
endif
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,5.,FW[GetConvertedPlayerId(GetTriggerPlayer())]+GetPlayerName(GetTriggerPlayer())+(YDWETranslate("|r从 ")+(I2S(Xj)+YDWETranslate(" 中掷出了 "))+I2S(Xl)+("|r"+(Fc[Xk]+Fc[Xm]))))
endif
else
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,5.,FW[GetConvertedPlayerId(GetTriggerPlayer())]+GetPlayerName(GetTriggerPlayer())+YDWETranslate("|r 请选择1-20000之间的一个数字"))
endif
else
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,5.,FW[GetConvertedPlayerId(GetTriggerPlayer())]+GetPlayerName(GetTriggerPlayer())+YDWETranslate("|r 请选择1-20000之间的一个数字"))
endif
else
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,5.,FW[GetConvertedPlayerId(GetTriggerPlayer())]+GetPlayerName(GetTriggerPlayer())+YDWETranslate("|r 请尝试重新输入并在-roll后面加上空格"))
endif
endif
endfunction
