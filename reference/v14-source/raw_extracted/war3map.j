function TreasureBoxMonsterAction takes unit Bc,unit Om,player h,integer BF returns nothing
local integer CC=GetUnitAbilityLevel(Bc,BF)
local boolean YV=false
local unit Be
local integer YY
local integer array YW
local integer array YX
local integer array YZ
if BF==$41315038 then
set YV=true
set YW[1]=100
set YW[2]=130
set YW[3]=300
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl",GetUnitX(Bc),GetUnitY(Bc)))
call SetPlayerState(h,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(h,PLAYER_STATE_RESOURCE_GOLD)+YW[CC])
elseif BF==$41315039 then
set YV=true
set YX[1]=200
set YX[2]=300
set YX[3]=600
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl",GetUnitX(Bc),GetUnitY(Bc)))
call SetPlayerState(h,PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(h,PLAYER_STATE_RESOURCE_LUMBER)+YX[CC])
elseif BF==$41315041 then
set YV=true
if IsUnitAlly(Bd,h) then
set Be=Bd
else
set Be=Bh
endif
if GetUnitAbilityLevel(Be,$41315044)==0 then
call UnitAddAbility(Be,$41315044)
call UnitMakeAbilityPermanent(Be,true,$41315044)
endif
set YY=CC+LoadInteger(O,GetHandleId(Be),$41315044)
call SaveInteger(O,GetHandleId(Be),$41315044,YY)
call YDWESetUnitAbilityDataReal(Be,$41315044,1,108,YY)
call SetUnitAbilityLevel(Be,$41315044,2)
call SetUnitAbilityLevel(Be,$41315044,1)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Items\\AIlm\\AIlmTarget.mdl",GetUnitX(Be),GetUnitY(Be)))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Items\\AIlm\\AIlmTarget.mdl",GetUnitX(Bc),GetUnitY(Bc)))
elseif BF==$41315042 then
if IsUnitOwnedByPlayer(Om,GetOwningPlayer(Bc)) then
set YV=true
if GetUnitAbilityLevel(Om,$41315045)==0 then
call UnitAddAbility(Om,$41315045)
call UnitMakeAbilityPermanent(Om,true,$41315045)
endif
set YZ[1]=15
set YZ[2]=30
set YZ[3]=50
set YY=YZ[CC]+LoadInteger(O,GetHandleId(Om),$41315045)
call SaveInteger(O,GetHandleId(Om),$41315045,YY)
call YDWESetUnitAbilityDataReal(Om,$41315045,1,108,YY)
call SetUnitAbilityLevel(Om,$41315045,2)
call SetUnitAbilityLevel(Om,$41315045,1)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Items\\AIlm\\AIlmTarget.mdl",GetUnitX(Om),GetUnitY(Om)))
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Items\\AIlm\\AIlmTarget.mdl",GetUnitX(Bc),GetUnitY(Bc)))
endif
elseif BF==$41315043 then
if UpLumbering(h) then
set YV=true
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Items\\AIlm\\AIlmTarget.mdl",GetUnitX(Bc),GetUnitY(Bc)))
else
call DisplayTimedTextToPlayer(h,0,0,10,"伐木等级已满")
endif
endif
if YV then
call RemoveUnit(Bc)
endif
set Bc=null
set Om=null
set h=null
set Be=null
endfunction
