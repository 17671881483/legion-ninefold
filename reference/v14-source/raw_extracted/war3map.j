if LoadInteger(O,aE,22)>=10 then
call DestroyEffect(LoadEffectHandle(O,aE,88))
call FlushChildHashtable(O,aE)
call DestroyTimer(t)
set t=null
endif
call DestroyGroup(Uz)
set i=null
set Uz=null
set h=null
set t=null
endfunction
