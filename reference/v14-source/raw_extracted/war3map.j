call SetUnitVertexColorBJ(Ki,100,100,100,60)
call SaveAgentHandle(O,GetHandleId(t),0,Bc)
call SaveAgentHandle(O,GetHandleId(t),1,Ki)
call TriggerRegisterTimerEvent(t,1,true)
call TriggerRegisterTimerEvent(t,0,false)
call TriggerRegisterDeathEvent(t,Ki)
call TriggerRegisterDeathEvent(t,Bc)
call TriggerAddAction(t,function VashjSummonAction)
set Bc=null
set Ki=null
set t=null
endfunction
function VashjSwapTimer takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer BQ=GetHandleId(t)
local unit Bc=LoadUnitHandle(O,BQ,0)
local group DG=YDWEGetUnitsOfTypeIdAllNull($68304F56)
local unit D6
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
if IsUnitAlly(D6,GetOwningPlayer(Bc)) then
if GetUnitAbilityLevel(Bc,$4131434B)==0 then
call UnitAddAbility(Bc,$4131434B)
call SetUnitAbilityLevel(Bc,$4131434B,2)
call UnitMakeAbilityPermanent(Bc,true,$4131434B)
elseif GetUnitAbilityLevel(Bc,$4131434B)==3 then
call SetUnitAbilityLevel(Bc,$4131434B,4)
endif
elseif IsUnitEnemy(D6,GetOwningPlayer(Bc)) then
if GetUnitAbilityLevel(Bc,$4131434B)==0 then
call UnitAddAbility(Bc,$4131434B)
call SetUnitAbilityLevel(Bc,$4131434B,3)
call UnitMakeAbilityPermanent(Bc,true,$4131434B)
elseif GetUnitAbilityLevel(Bc,$4131434B)==2 then
call SetUnitAbilityLevel(Bc,$4131434B,4)
endif
if GetUnitAbilityLevel(Bc,$41314F45)==0 then
call UnitAddAbility(Bc,$41314F45)
call UnitMakeAbilityPermanent(Bc,true,$41314F45)
endif
endif
endloop
call DestroyGroup(DG)
call FlushChildHashtable(O,BQ)
call DestroyTimer(t)
set t=null
set Bc=null
set DG=null
set D6=null
endfunction
function VashjSwap takes unit Bc returns nothing
local timer t=CreateTimer()
call SaveUnitHandle(O,GetHandleId(t),0,Bc)
call TimerStart(t,0,false,function VashjSwapTimer)
set t=null
set Bc=null
endfunction
