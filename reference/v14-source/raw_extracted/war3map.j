function A313s takes nothing returns boolean
return IsUnitType(GetFilterUnit(),UNIT_TYPE_DEAD)==false and IsUnitEnemy(GetFilterUnit(),GetOwningPlayer(LoadUnitHandle(K,421,0)))==true
endfunction
function A313_t takes nothing returns nothing
local timer EP=GetExpiredTimer()
local integer Ca=GetHandleId(EP)
local integer Bj=LoadInteger(K,421,Ca)-1
local unit i=LoadUnitHandle(K,1421,Ca)
local real Eg=GetUnitX(i)
local real Eh=GetUnitY(i)
local real D1=GetUnitFacing(i)
local group DG=CreateGroup()
local real CP=LoadReal(K,2421,Ca)+5
local unit EQ
local boolexpr Cd=Condition(function A313s)
set Eg=Eg+15*Cos(D1*bj_DEGTORAD)
set Eh=Eh+15*Sin(D1*bj_DEGTORAD)
call SetUnitPosition(i,Eg,Eh)
call SaveInteger(K,421,Ca,Bj)
call SaveReal(K,2421,Ca,CP)
call SaveUnitHandle(K,421,0,i)
call GroupEnumUnitsInRange(DG,Eg,Eh,CP,Cd)
loop
set EQ=FirstOfGroup(DG)
exitwhen EQ==null
set Eg=GetUnitX(EQ)+7*Cos(D1*bj_DEGTORAD)
set Eh=GetUnitY(EQ)+7*Sin(D1*bj_DEGTORAD)
if IsTerrainPathable(Eg,Eh,PATHING_TYPE_WALKABILITY)==false then
call SetUnitX(EQ,Eg)
call SetUnitY(EQ,Eh)
endif
call GroupRemoveUnit(DG,EQ)
endloop
if Bj<=0 then
call UnitApplyTimedLife(i,$42487765,.01)
call RemoveSavedInteger(K,421,Ca)
call RemoveSavedHandle(K,1421,Ca)
call RemoveSavedReal(K,2421,Ca)
call PauseTimer(EP)
call DestroyTimer(EP)
endif
call DestroyGroup(DG)
call DestroyBoolExpr(Cd)
set EP=null
set DG=null
set Cd=null
set i=null
set EQ=null
endfunction
function A07Ys takes nothing returns boolean
return GetUnitState(GetFilterUnit(),UNIT_STATE_LIFE)>=1. and IsUnitAlly(GetFilterUnit(),GetOwningPlayer(GetTriggerUnit()))==true and GetFilterUnit()!=GetSpellTargetUnit()
endfunction
function A0HBs takes nothing returns boolean
return GetUnitAbilityLevel(GetFilterUnit(),$41303753)>0 and GetUnitUserData(GetFilterUnit())==Ej
endfunction
function A050Condition takes nothing returns boolean
return GetUnitAbilityLevel(GetTriggerUnit(),$41303530)==0
endfunction
function A313_CastA07YOnRandom takes unit Ei,group DG returns nothing
local unit i
set bj_groupRandomConsidered=0
set bj_groupRandomCurrentPick=null
call ForGroup(DG,function GroupPickRandomUnitEnum)
if bj_groupRandomCurrentPick!=null then
set i=CreateUnit(GetOwningPlayer(Ei),$75303036,GetUnitX(Ei),GetUnitY(Ei),0)
call UnitApplyTimedLife(i,$42487765,1.)
call UnitAddAbility(i,$41303759)
call IssueTargetOrderById(i,852225,bj_groupRandomCurrentPick)
call GroupRemoveUnit(DG,bj_groupRandomCurrentPick)
endif
set i=null
set Ei=null
set DG=null
endfunction
