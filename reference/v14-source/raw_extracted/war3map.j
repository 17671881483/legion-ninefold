function Trig_RegisterActions takes nothing returns nothing
local integer BB=0
local unit D6
local group DG
local player h
local boolean dL=false
loop
set h=Player(BB)
set dL=YDWERPGBillingHasStatus(h,"20062731") or YDWERPGBillingHasStatus(h,"20070487")
set DG=YDWEGetUnitsOfPlayerAndTypeIdNull(h,$48305550)
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
if dL then
call EasterEggRegisterShowShop(h,D6)
else
call RemoveUnit(D6)
endif
call GroupRemoveUnit(DG,D6)
endloop
call DestroyGroup(DG)
set BB=BB+1
exitwhen BB>=8
endloop
set D6=null
set DG=null
set h=null
endfunction
