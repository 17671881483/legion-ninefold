function NagaFarmer___Eb takes unit i,string Bj,real Bk,real Bl,real Bm,player Bn returns nothing
local force Bo
local location h
local integer BB=LoadInteger(O,100,776)
local integer Bs
if i==null then
set i=null
set Bn=null
return
endif
call SaveInteger(O,100,776,BB+1)
set h=GetUnitLoc(i)
set Bp[BB]=CreateTextTagLocBJ(Bj,h,0,10,Bk,Bl,Bm,0)
set Bo=CreateForce()
call ForceAddPlayer(Bo,Bn)
call SetTextTagLifespanBJ(Bp[BB],3)
call SetTextTagPermanentBJ(Bp[BB],false)
call SetTextTagFadepointBJ(Bp[BB],2)
call SetTextTagVelocityBJ(Bp[BB],40,90)
call ShowTextTagForceBJ(false,Bp[BB],bj_FORCE_ALL_PLAYERS)
call ShowTextTagForceBJ(true,Bp[BB],Bo)
if BB==100 then
set Bs=0
loop
exitwhen Bs==100
call DestroyTextTag(Bp[Bs])
set Bp[Bs]=null
set Bs=Bs+1
endloop
elseif BB==200 then
set Bs=101
loop
exitwhen Bs==200
call DestroyTextTag(Bp[Bs])
set Bp[Bs]=null
set Bs=Bs+1
endloop
call SaveInteger(O,100,776,0)
endif
call DestroyForce(Bo)
call RemoveLocation(h)
set Bo=null
set h=null
set i=null
set Bn=null
endfunction
function NagaFarmer_SubtractGoldForPlayer takes player h returns nothing
local real B0=0
if h!=null then
set B0=LoadReal(O,GetHandleId(h),StringHash("NagaFarmerGoldRate"))
if B0==Yb then
call SaveReal(O,GetHandleId(h),StringHash("NagaFarmerGoldRate"),0)
elseif B0>0 then
call SaveReal(O,GetHandleId(h),StringHash("NagaFarmerGoldRate"),B0-Yc)
endif
endif
set h=null
endfunction
function NagaFarmer_SubtractGold takes unit Bc returns nothing
call NagaFarmer_SubtractGoldForPlayer(GetOwningPlayer(Bc))
set Bc=null
endfunction
function NagaFarmer_AddGold takes unit Bc returns nothing
local player h=GetOwningPlayer(Bc)
local real B0=LoadReal(O,GetHandleId(h),StringHash("NagaFarmerGoldRate"))
if B0<Yb then
call SaveReal(O,GetHandleId(h),StringHash("NagaFarmerGoldRate"),Yb)
else
call SaveReal(O,GetHandleId(h),StringHash("NagaFarmerGoldRate"),B0+Yc)
endif
set h=null
set Bc=null
endfunction
function NagaFarmer_SuperAddGold takes unit Bc returns nothing
local integer BU=0
local group DG=CreateGroup()
local unit D6
local integer y=0
local player h
call GroupEnumUnitsOfPlayer(DG,GetOwningPlayer(Bc),null)
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
if GetUnitTypeId(D6)==O4 or LoadInteger(O,GetUnitTypeId(D6),StringHash("SkinBase"))==O4 and not IsUnitType(D6,UNIT_TYPE_DEAD) then
if GetUnitUserData(Bc)==GetUnitUserData(D6) then
set y=y+1
endif
endif
endloop
set BU=3*y
if BU>0 then
set h=ConvertedPlayer(GetUnitUserData(Bc))
call NagaFarmer___Eb(Bc,"+"+I2S(BU),100.,77.,0.,h)
call DisplayTimedTextToPlayer(h,0,0,10,"你从压榨中获得 "+I2S(BU)+" 金币")
call AdjustPlayerStateBJ(BU,h,PLAYER_STATE_RESOURCE_GOLD)
endif
call DestroyGroup(DG)
set DG=null
set Bc=null
set D6=null
set h=null
endfunction
function NagaFarmer___DeathAction takes nothing returns nothing
local unit i=GetTriggerUnit()
local unit Bz=GetKillingUnit()
local player h
local real B0
if Bz!=null and GetUnitUserData(Bz)>0 then
set h=ConvertedPlayer(GetUnitUserData(Bz))
set B0=LoadReal(O,GetHandleId(h),StringHash("NagaFarmerGoldRate"))
if B0>0 and GetRandomPercentageBJ()<=B0 then
call AdjustPlayerStateBJ(1,ConvertedPlayer(GetUnitUserData(Bz)),PLAYER_STATE_RESOURCE_GOLD)
call NagaFarmer___Eb(Bz,"+1",100.,77.,0.,ConvertedPlayer(GetUnitUserData(Bz)))
endif
endif
set i=null
set Bz=null
set h=null
endfunction
function NagaFarmer___Init takes nothing returns nothing
local trigger t=CreateTrigger()
call TriggerRegisterPlayerUnitEvent(t,Player(8),EVENT_PLAYER_UNIT_DEATH,null)
call TriggerRegisterPlayerUnitEvent(t,Player(9),EVENT_PLAYER_UNIT_DEATH,null)
call TriggerRegisterPlayerUnitEvent(t,Player(10),EVENT_PLAYER_UNIT_DEATH,null)
call TriggerRegisterPlayerUnitEvent(t,Player(11),EVENT_PLAYER_UNIT_DEATH,null)
call TriggerAddAction(t,function NagaFarmer___DeathAction)
set t=null
endfunction
function NextMonsterType___registerMonstertypeNext takes nothing returns nothing
set B1[3]=$68305141
set B2[3]=1
set B1[6]=$68305142
set B2[6]=1
set B1[9]=$68305143
set B2[9]=1
set B1[12]=$68305137
set B2[12]=2
set B1[15]=$68305138
set B2[15]=3
set B1[18]=$68305139
set B2[18]=3
endfunction
function NextMonsterType___initMonstertypeNext takes nothing returns nothing
local integer BB=0
local timer t=GetExpiredTimer()
loop
set BB=BB+1
set B1[BB]=0
set B2[BB]=0
exitwhen BB>=By
endloop
call NextMonsterType___registerMonstertypeNext()
call SaveRectHandle(O,GetHandleId(Player(0)),StringHash("rect"),B3)
call SaveRectHandle(O,GetHandleId(Player(1)),StringHash("rect"),B4)
call SaveRectHandle(O,GetHandleId(Player(2)),StringHash("rect"),B5)
call SaveRectHandle(O,GetHandleId(Player(3)),StringHash("rect"),B6)
call SaveRectHandle(O,GetHandleId(Player(4)),StringHash("rect"),B7)
call SaveRectHandle(O,GetHandleId(Player(5)),StringHash("rect"),B8)
call SaveRectHandle(O,GetHandleId(Player(6)),StringHash("rect"),B9)
call SaveRectHandle(O,GetHandleId(Player(7)),StringHash("rect"),CB)
call DestroyTimer(t)
set t=null
endfunction
function NextMonsterType___init takes nothing returns nothing
call TimerStart(CreateTimer(),1,false,function NextMonsterType___initMonstertypeNext)
endfunction
function RegisterNumberData___RegisterData takes integer BF,integer CC returns nothing
call SaveInteger(O,BF,StringHash("vip_level"),CC)
endfunction
function RegisterNumberData___RegisterVipLevelZero takes nothing returns nothing
call RegisterNumberData___RegisterData($6E303632,0)
call RegisterNumberData___RegisterData($6E303441,0)
call RegisterNumberData___RegisterData($68313035,0)
endfunction
function RegisterNumberData___RegisterVipLevelTwo takes nothing returns nothing
call RegisterNumberData___RegisterData($6E303439,2)
call RegisterNumberData___RegisterData($6E303358,2)
call RegisterNumberData___RegisterData($68304D32,2)
call RegisterNumberData___RegisterData($6E303547,2)
call RegisterNumberData___RegisterData($6E303054,2)
