call SaveStr(O,C0,StringHash("file"),"LJQ_JT_JDTfmg.mdx")
call SaveStr(O,C1,StringHash("file"),"LJQ_JT_JDTfmg.mdx")
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddAction(t,function BuildingFrame___BtnClick)
set t=null
endfunction
