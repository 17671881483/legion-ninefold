local unit Bc=LoadUnitHandle(O,GetHandleId(Eb),0)
if GetUnitAbilityLevel(Bc,$41314246)>0 then
call SetUnitState(Bc,ConvertUnitState(81),GetUnitState(Bc,ConvertUnitState(81))+1)
call UnitAddAbility(Bc,Qq)
call SaveAgentHandle(O,GetHandleId(t),0,Bc)
