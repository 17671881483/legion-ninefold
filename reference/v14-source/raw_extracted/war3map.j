function InitIntegral takes nothing returns nothing
local integer BB=0
local boolean Ds=false
set Ds=EXNetIsYYHighLadder()
set Dy=CreateTrigger()
if Ds then
call YDWERPGSetKey(Player(0),"force",1)
call YDWERPGSetKey(Player(1),"force",1)
call YDWERPGSetKey(Player(2),"force",1)
call YDWERPGSetKey(Player(3),"force",1)
call YDWERPGSetKey(Player(4),"force",2)
call YDWERPGSetKey(Player(5),"force",2)
call YDWERPGSetKey(Player(6),"force",2)
call YDWERPGSetKey(Player(7),"force",2)
endif
loop
if not Ds then
call YDWERPGAddKey(Player(BB),YDWETranslate("胜利+1"),0)
call YDWERPGAddKey(Player(BB),YDWETranslate("最佳+1"),0)
call YDWERPGAddKey(Player(BB),YDWETranslate("军+1"),0)
call YDWERPGAddKey(Player(BB),YDWETranslate("木+1"),0)
call YDWERPGAddKey(Player(BB),YDWETranslate("杀+1"),0)
call YDWERPGAddKey(Player(BB),YDWETranslate("兵+1"),0)
call YDWERPGAddKey(Player(BB),YDWETranslate("魂+1"),0)
call YDWERPGAddKey(Player(BB),YDWETranslate("逃+1"),0)
call YDWERPGAddKey(Player(BB),YDWETranslate("局数+1"),0)
endif
call TriggerRegisterPlayerEventLeave(Dy,Player(BB))
exitwhen BB>=11
set BB=BB+1
endloop
call TriggerAddAction(Dy,function PlayerEscapeAction)
endfunction
function SettlementNumber takes nothing returns nothing
local integer BB=1
local player h
local string Rx=null
loop
set h=GetGCMaxVaulePlayer(BB)
if h!=null then
if BB==1 then
if not HaveSavedBoolean(O,H2I(h),StringHash("winner")) then
set Rx=YDWETranslate("魂+1")
endif
elseif BB==2 then
set Rx=YDWETranslate("木+1")
elseif BB==3 then
set Rx=YDWETranslate("杀+1")
call EXNetStatRemoteData(GetPlayerId(h),"Slayer","1")
elseif BB==4 then
set Rx=YDWETranslate("兵+1")
elseif BB==5 then
set Rx=YDWETranslate("军+1")
call EXNetStatRemoteData(GetPlayerId(h),"MilitaryExploitMax","1")
endif
if Rx!=null then
call YDWERPGAddKey(h,Rx,1)
call YDWERPGAddKey(h,YDWETranslate("军功+1000"),1)
endif
endif
exitwhen BB==5
set BB=BB+1
endloop
if Dy!=null then
call DestroyTrigger(Dy)
set Dy=null
endif
set h=null
endfunction
function WritePlayerScore takes player h returns boolean
local integer BB=GetPlayerId(h)
if E3 then
set h=null
return false
endif
call Record(Player(BB),1,E4[1+BB])
call Record(Player(BB),2,R2I(I2R(GetPlayerState(Player(BB),PLAYER_STATE_LUMBER_GATHERED))/4))
call Record(Player(BB),3,E5[1+BB])
if E6[1+BB]>32750 then
call Record(Player(BB),4,32760)
else
call Record(Player(BB),4,E6[1+BB])
endif
call Record(Player(BB),5,E7[BB])
call Record(Player(BB),6,DS[1+BB])
call Record(Player(BB),7,GetPlayerTechCount(Player(BB),$52303033,true)+GetPlayerTechCount(Player(BB),$52303048,true)+GetPlayerTechCount(Player(BB),$52303657,true))
set h=null
return false
endfunction
function WritePlayerScoreAuto takes nothing returns boolean
set FV=FV+1
if FV>11 then
set FV=0
endif
call WritePlayerScore(Player(FV))
return false
endfunction
function WriteAllScore takes nothing returns boolean
local integer BB=0
if E3 then
return false
endif
loop
exitwhen BB>11
call WritePlayerScore(Player(BB))
set BB=BB+1
endloop
return false
endfunction
function IsPlayer takes player h returns boolean
local boolean DJ=IsPlayerObserver(h)==false and GetPlayerController(h)==MAP_CONTROL_USER and GetPlayerSlotState(h)==PLAYER_SLOT_STATE_PLAYING
set h=null
return DJ
endfunction
function PlayerLeaveRecord takes nothing returns boolean
local integer E8=0
local integer E9=0
local integer BB=0
local player h=GetTriggerPlayer()
call OC5F_MQ()
if E3 then
set h=null
return false
endif
call WritePlayerScore(h)
loop
exitwhen BB>11
if IsPlayer(Player(BB)) and Player(BB)!=h then
if GetPlayerTeam(Player(BB))==0 then
set E8=E8+1
elseif GetPlayerTeam(Player(BB))==1 then
set E9=E9+1
endif
endif
set BB=BB+1
endloop
if E8==0 then
call BJDebugMsg(YDWETranslate("|cff00ccff游戏已经结束,战绩已结算.你可以继续游戏或退出游戏,不会再影响战绩.|r"))
elseif E9==0 then
call BJDebugMsg(YDWETranslate("|cff00ccff游戏已经结束,战绩已结算.你可以继续游戏或退出游戏,不会再影响战绩.|r"))
endif
set h=null
return false
endfunction
