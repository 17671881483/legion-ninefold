function ArthasModel takes string aB,string aC returns string
if aD then
return aC
endif
return aB
endfunction
function ArthasReadyAttack takes unit Bc,real P8 returns nothing
local real KI=LoadReal(O,GetHandleId(Bc),StringHash("ArthasReadyAttackDamage"))+P8
if KI>=GetUnitState(Bc,UNIT_STATE_MAX_LIFE)*.4 then
call SaveReal(O,GetHandleId(Bc),StringHash("ArthasReadyAttackDamage"),0)
call SaveBoolean(O,GetHandleId(Bc),StringHash("ArthasReadyAttackDamage"),true)
else
call SaveReal(O,GetHandleId(Bc),StringHash("ArthasReadyAttackDamage"),KI)
endif
set Bc=null
endfunction
