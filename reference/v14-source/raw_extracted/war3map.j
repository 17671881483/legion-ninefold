function BoxGiftRefundResource takes player h,integer BU,integer BV returns nothing
if BU>0 then
call AdjustPlayerStateBJ(BU,h,PLAYER_STATE_RESOURCE_GOLD)
endif
if BV>0 then
call AdjustPlayerStateBJ(BV,h,PLAYER_STATE_RESOURCE_LUMBER)
endif
if BU>0 and BV>0 then
call DisplayTimedTextToPlayer(h,0,0,10,"神秘礼物返还资源: +"+I2S(BU)+"金币 +"+I2S(BV)+"木材")
elseif BU>0 then
call DisplayTimedTextToPlayer(h,0,0,10,"神秘礼物返还资源: +"+I2S(BU)+"金币")
elseif BV>0 then
call DisplayTimedTextToPlayer(h,0,0,10,"神秘礼物返还资源: +"+I2S(BV)+"木材")
endif
set h=null
endfunction
function BoxGiftTryConsumeBuildFreeWithCost takes player h,integer BU,integer BV returns boolean
local boolean DJ=false
if BU>0 or BV>0 and LoadBoolean(O,GetHandleId(h),StringHash("box_build_free_once")) then
call RemoveSavedBoolean(O,GetHandleId(h),StringHash("box_build_free_once"))
call BoxGiftRefundResource(h,BU,BV)
set DJ=true
endif
set h=null
return DJ
endfunction
function BoxGiftSaveBuildFree takes player h returns nothing
call SaveBoolean(O,GetHandleId(h),StringHash("box_build_free_once"),true)
set h=null
endfunction
function BoxGiftTryConsumeBuildFreeForUnit takes unit i returns boolean
