function A313 takes nothing returns nothing
local unit EQ=GetTriggerUnit()
local unit i=GetSpellTargetUnit()
local real D1=GetUnitFacing(EQ)
local timer t
local integer Ca
local group DG
local boolexpr Cd
local integer Ef=GetSpellAbilityId()
if Ef!=$41333133 and Ef!=$41303759 and Ef!=$41304842 then
set EQ=null
set i=null
return
endif
if Ef==$41333133 then
if D1<180 then
set D1=90
else
set D1=270
endif
set EQ=CreateUnit(GetOwningPlayer(EQ),$65303130,GetUnitX(EQ),GetUnitY(EQ),D1)
call SetUnitTimeScale(EQ,.7)
set t=CreateTimer()
set Ca=GetHandleId(t)
call SaveReal(K,2421,Ca,250)
call SaveInteger(K,421,Ca,40)
call SaveUnitHandle(K,1421,Ca,EQ)
call TimerStart(t,.04,true,function A313_t)
endif
if Ef==$41303759 and GetUnitTypeId(EQ)==$68313038 then
set DG=CreateGroup()
set Cd=Condition(function A07Ys)
call GroupEnumUnitsInRange(DG,GetUnitX(EQ),GetUnitY(EQ),400,Cd)
call A313_CastA07YOnRandom(EQ,DG)
call A313_CastA07YOnRandom(EQ,DG)
call GroupClear(DG)
call DestroyGroup(DG)
call DestroyBoolExpr(Cd)
set Cd=null
endif
if Ef==$41304842 then
set Ca=LoadInteger(K,$41304842,GetHandleId(EQ))
if Ca>0 then
call SetUnitState(EQ,UNIT_STATE_LIFE,GetUnitState(EQ,UNIT_STATE_LIFE)+Ca*2)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl",EQ,"origin"))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl",i,"origin"))
set Ej=GetUnitUserData(EQ)
set DG=CreateGroup()
set Cd=Condition(function A0HBs)
call GroupEnumUnitsInRange(DG,GetUnitX(EQ),GetUnitY(EQ),2000,Cd)
loop
set i=FirstOfGroup(DG)
exitwhen i==null
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl",i,"origin"))
call SetUnitState(i,UNIT_STATE_LIFE,GetUnitState(i,UNIT_STATE_LIFE)+Ca)
call GroupRemoveUnit(DG,i)
endloop
call GroupClear(DG)
call DestroyGroup(DG)
call DestroyBoolExpr(Cd)
set Cd=null
endif
endif
set EQ=null
set i=null
set t=null
set DG=null
set Cd=null
endfunction
function Trig_Lens takes nothing returns nothing
if EVENT_PLAYER_ARROW_UP_DOWN==GetTriggerEventId() then
call SetCameraFieldForPlayer(GetTriggerPlayer(),CAMERA_FIELD_TARGET_DISTANCE,GetCameraField(CAMERA_FIELD_TARGET_DISTANCE)+300,.5)
elseif EVENT_PLAYER_ARROW_DOWN_DOWN==GetTriggerEventId() then
call SetCameraFieldForPlayer(GetTriggerPlayer(),CAMERA_FIELD_TARGET_DISTANCE,GetCameraField(CAMERA_FIELD_TARGET_DISTANCE)-300,.5)
endif
endfunction
function main2 takes nothing returns nothing
local trigger t
local integer BB
local integer IG
local integer IH
local version Do
local integer IJ
local region D1
set Dx=GetGameStartTime()
call InitIntegral()
call New_skill()
set t=CreateTrigger()
call TriggerRegisterGameEvent(t,EVENT_GAME_SAVE)
call TriggerAddAction(t,function CancelSave1)
set t=CreateTrigger()
call TriggerRegisterPlayerUnitEvent(t,Player(0),EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER,null)
call TriggerRegisterPlayerUnitEvent(t,Player(1),EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER,null)
call TriggerRegisterPlayerUnitEvent(t,Player(2),EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER,null)
call TriggerRegisterPlayerUnitEvent(t,Player(3),EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER,null)
call TriggerRegisterPlayerUnitEvent(t,Player(4),EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER,null)
call TriggerRegisterPlayerUnitEvent(t,Player(5),EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER,null)
call TriggerRegisterPlayerUnitEvent(t,Player(6),EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER,null)
call TriggerRegisterPlayerUnitEvent(t,Player(7),EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER,null)
call TriggerAddCondition(t,Condition(function Conditions_Smart))
call TriggerAddAction(t,function Actions_Smart)
set t=CreateTrigger()
call TriggerRegisterPlayerUnitEvent(t,Player(0),EVENT_PLAYER_UNIT_ATTACKED,null)
call TriggerRegisterPlayerUnitEvent(t,Player(1),EVENT_PLAYER_UNIT_ATTACKED,null)
call TriggerRegisterPlayerUnitEvent(t,Player(2),EVENT_PLAYER_UNIT_ATTACKED,null)
call TriggerRegisterPlayerUnitEvent(t,Player(3),EVENT_PLAYER_UNIT_ATTACKED,null)
call TriggerRegisterPlayerUnitEvent(t,Player(4),EVENT_PLAYER_UNIT_ATTACKED,null)
call TriggerRegisterPlayerUnitEvent(t,Player(5),EVENT_PLAYER_UNIT_ATTACKED,null)
call TriggerRegisterPlayerUnitEvent(t,Player(6),EVENT_PLAYER_UNIT_ATTACKED,null)
