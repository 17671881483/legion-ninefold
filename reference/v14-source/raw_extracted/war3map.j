function DamageAoe takes unit i,real FF,real FG,real P7,real P8,attacktype P9,damagetype QB returns nothing
local group DG=CreateGroup()
local unit D6=null
local player h=GetOwningPlayer(i)
call GroupEnumUnitsInRange(DG,FF,FG,P7,null)
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
if IsUnitEnemy(D6,h) then
call UnitDamageTarget(i,D6,P8,false,false,P9,QB,WEAPON_TYPE_WHOKNOWS)
endif
endloop
call GroupClear(DG)
call DestroyGroup(DG)
set DG=null
set D6=null
set h=null
set i=null
endfunction
function AoeDamage takes unit i,real FF,real FG,real P7,real P8,attacktype P9,damagetype QB returns nothing
call DamageAoe(i,FF,FG,P7,P8,P9,QB)
set i=null
endfunction
function VertigoTarget takes unit Pf,unit Om,integer CC returns nothing
