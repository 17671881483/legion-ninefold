function ArthasSummonAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
if GetTriggerEventId()==EVENT_UNIT_DAMAGED then
if GetUnitLifePercent(GetTriggerUnit())<=20 then
call SetUnitLifePercentBJ(GetTriggerUnit(),GetUnitLifePercent(GetTriggerUnit())+GetUnitLifePercent(Bc)+5)
call KillUnit(Bc)
endif
else
call RemoveUnit(Bc)
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
endif
set t=null
set Bc=null
endfunction
function ArthasSummon takes unit Bc returns nothing
local integer QK=8
local integer y=0
local unit Ki
local trigger t
local integer BF=GetUnitUserData(Bc)
loop
set Ki=CreateUnit(GetOwningPlayer(Bc),$6830434C,GetUnitX(Bc),GetUnitY(Bc),GetUnitFacing(Bc))
call SetUnitColor(Ki,GetPlayerColor(ConvertedPlayer(BF)))
call GroupAddUnit(JW,Ki)
call GroupAddUnit(JH[BF],Ki)
call SetUnitUserData(Ki,BF)
set t=CreateTrigger()
call SaveAgentHandle(O,GetHandleId(t),0,Ki)
call TriggerRegisterDeathEvent(t,Ki)
call TriggerRegisterUnitEvent(t,Bc,EVENT_UNIT_DAMAGED)
call TriggerAddAction(t,function ArthasSummonAction)
set y=y+1
exitwhen y>=QK
endloop
call SaveInteger(O,GetHandleId(Bc),$41315656,LoadInteger(O,GetHandleId(Bc),$41315656)+5)
if LoadInteger(O,GetHandleId(Bc),$41315656)>=3 then
call UnitRemoveAbility(Bc,$41315656)
endif
set Bc=null
set t=null
set Ki=null
endfunction
