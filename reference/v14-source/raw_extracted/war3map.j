function CreateUnitMonsterForPlayer takes player h,integer CT returns nothing
local rect D1
local unit i
if h!=null then
set D1=LoadRectHandle(O,GetHandleId(h),StringHash("rect"))
if CT<=4 then
set i=CreateUnit(Player(10),Bw[Dg],GetRandomReal(GetRectMinX(D1),GetRectMaxX(D1)),GetRandomReal(GetRectMinY(D1),GetRectMaxY(D1)),90+180*CT)
call GroupAddUnit(JQ[1],i)
else
set i=CreateUnit(Player(11),Bw[Dg],GetRandomReal(GetRectMinX(D1),GetRectMaxX(D1)),GetRandomReal(GetRectMinY(D1),GetRectMaxY(D1)),90+180*CT)
call GroupAddUnit(JQ[2],i)
endif
call SetUnitUserData(i,CT)
call GroupAddUnit(Je,i)
call GroupAddUnit(JI[CT],i)
call IssuePointOrderByIdLoc(i,851983,Md[CT])
endif
set D1=null
set i=null
endfunction
function IsBossWave takes integer BB returns boolean
return BB>=10 and I2R(BB)/10-BB/10==0.
endfunction
function IsWaveLaneActive takes integer OR returns boolean
if OR==1 then
return M8
elseif OR==2 then
return M9
elseif OR==3 then
return NB
elseif OR==4 then
return NC
elseif OR==5 then
return ND
elseif OR==6 then
return NE
elseif OR==7 then
return NF
elseif OR==8 then
return NG
endif
return false
endfunction
function SpawnWaveUnitForLane takes integer OR,integer OS,boolean OT returns unit
local rect OV=null
local player OU=Player(10)
local group OX=JQ[1]
local real OW=270
local unit i
if OR==1 then
set OV=B3
set OW=270
elseif OR==2 then
set OV=B4
set OW=90
elseif OR==3 then
set OV=B5
set OW=270
elseif OR==4 then
set OV=B6
set OW=90
elseif OR==5 then
set OV=B7
set OU=Player(11)
set OX=JQ[2]
set OW=270
elseif OR==6 then
set OV=B8
set OU=Player(11)
set OX=JQ[2]
set OW=90
elseif OR==7 then
set OV=B9
set OU=Player(11)
set OX=JQ[2]
set OW=270
elseif OR==8 then
set OV=CB
set OU=Player(11)
set OX=JQ[2]
set OW=90
endif
set i=CreateUnit(OU,OS,GetRandomReal(GetRectMinX(OV),GetRectMaxX(OV)),GetRandomReal(GetRectMinY(OV),GetRectMaxY(OV)),OW)
call SetUnitUserData(i,OR)
call GroupAddUnit(Je,i)
call GroupAddUnit(OX,i)
call GroupAddUnit(JI[OR],i)
call IssuePointOrderByIdLoc(i,851983,Md[OR])
if OT then
call SaveBoolean(O,GetHandleId(i),StringHash("next"),true)
endif
set OV=null
set OU=null
set OX=null
return i
endfunction
function SpawnWaveFiveRewardUnitForLane takes integer OR returns nothing
local unit i=SpawnWaveUnitForLane(OR,$68304F55,false)
call UnitApplyTimedLife(i,$42487765,60)
if OR==2 then
call UnitApplyTimedLife(GetTriggerUnit(),$42487765,5)
endif
call SetUnitState(i,UNIT_STATE_MAX_LIFE,3000)
if OR==1 then
call SetUnitState(i,UNIT_STATE_LIFE,3000)
endif
call SaveInteger(O,9997,11,LoadInteger(O,9997,11)+1)
set i=null
endfunction
function ib takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer ON=Ik[Dg]
local integer CT=1
local integer OQ=MB[Dg]
local unit i=null
local rect D1
local player h
local boolean OP=false
if OM>=ON then
if Bw[Dg]>0 and OJ<Bx[Dg] then
set OJ=OJ+1
call CreateUnitMonsterForPlayer(OH,GetConvertedPlayerId(OH))
call CreateUnitMonsterForPlayer(OI,GetConvertedPlayerId(OI))
endif
if B2[Dg]==0 or OO==B2[Dg] then
set OO=0
call PauseTimer(t)
call GroupClear(G)
set OM=0
set t=null
else
set OO=OO+1
loop
set h=ConvertedPlayer(CT)
if not (GetPlayerSlotState(h)==PLAYER_SLOT_STATE_EMPTY or GetPlayerSlotState(h)==PLAYER_SLOT_STATE_LEFT) then
set D1=LoadRectHandle(O,GetHandleId(h),StringHash("rect"))
if CT<=4 then
set i=CreateUnit(Player(10),B1[Dg],GetRandomReal(GetRectMinX(D1),GetRectMaxX(D1)),GetRandomReal(GetRectMinY(D1),GetRectMaxY(D1)),90+180*CT)
call GroupAddUnit(JQ[1],i)
else
set i=CreateUnit(Player(11),B1[Dg],GetRandomReal(GetRectMinX(D1),GetRectMaxX(D1)),GetRandomReal(GetRectMinY(D1),GetRectMaxY(D1)),90+180*CT)
call GroupAddUnit(JQ[2],i)
endif
call SetUnitUserData(i,CT)
call GroupAddUnit(Je,i)
call GroupAddUnit(JI[CT],i)
call IssuePointOrderByIdLoc(i,851983,Md[CT])
endif
exitwhen CT>=8
set CT=CT+1
endloop
endif
set i=null
return
endif
if C6 and not IsBossWave(Dg) and Dg<29 and Dg>5 then
if GetRandomPercentageBJ()<=10 then
set OP=true
set OQ=MB[Dg+1]
endif
endif
loop
exitwhen CT>8
if IsWaveLaneActive(CT) then
set i=SpawnWaveUnitForLane(CT,OQ,OP)
set i=null
if ON-OM==1 and Dg==5 then
call SpawnWaveFiveRewardUnitForLane(CT)
endif
endif
set CT=CT+1
endloop
set OM=OM+1
set t=null
endfunction
