call YDWETimerDestroyEffect(8,AddSpecialEffectTarget("LJQ_YR_SYZZ.mdx",Om,"origin"))
call NagaApplyShadowStrike(Bc,Om,$41325933,9)
endif
set Bc=null
set Om=null
endfunction
function NagaChieftainTideHurricaneTimer takes nothing returns nothing
local timer t=GetExpiredTimer()
local integer BF=GetHandleId(t)
local unit Bc=LoadUnitHandle(O,BF,StringHash("hero"))
local real FF=LoadReal(O,BF,StringHash("x"))
local real FG=LoadReal(O,BF,StringHash("y"))
local integer y=LoadInteger(O,BF,StringHash("count"))+1
local group DG=SelectRange(Bc,FF,FG,350)
local unit D6=null
local real Pm=0
local real ID=0
local real IF=0
local real Qx=0
local real Hn=0
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
call UnitDamageTargetBJ(Bc,D6,13.,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
set ID=FF-GetUnitX(D6)
set IF=FG-GetUnitY(D6)
set Qx=SquareRoot(ID*ID+IF*IF)
if Qx>0 then
set Hn=RMinBJ(20.,Qx)
set Pm=Atan2BJ(IF,ID)
call SetUnitX(D6,GetUnitX(D6)+CosBJ(Pm)*Hn)
call SetUnitY(D6,GetUnitY(D6)+SinBJ(Pm)*Hn)
endif
endloop
call DestroyGroup(DG)
if y>=25 then
call DestroyEffect(LoadEffectHandle(O,BF,StringHash("eff")))
call FlushChildHashtable(O,BF)
call DestroyTimer(t)
else
call SaveInteger(O,BF,StringHash("count"),y)
endif
set t=null
set Bc=null
set DG=null
set D6=null
endfunction
