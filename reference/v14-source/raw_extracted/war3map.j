if Of>=13 then
if not Ot then
set Ot=true
call BoxShowSkillNext()
endif
endif
endfunction
function WaterPrisonHaloActionAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
local unit Om=LoadUnitHandle(O,GetHandleId(t),1)
local real Px=LoadReal(O,GetHandleId(t),2)
if GetTriggerEventId()==EVENT_GAME_TIMER_EXPIRED then
if UnitHasBuffBJ(Om,Qn) then
if GetTriggerExecCount(t)>=8 then
if GetUnitTypeId(Bc)==$68305742 then
call YDWETimerDestroyEffect(3,AddSpecialEffectTarget("LJQ_Aesara01_G1.mdx",Om,"origin"))
else
call YDWETimerDestroyEffect(3,AddSpecialEffectTarget("AZ_yijie01_G2.mdx",Om,"origin"))
endif
call VertigoTarget(Bc,Om,3)
call RemoveSavedBoolean(O,GetHandleId(Om),Qn)
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
endif
else
call RemoveSavedBoolean(O,GetHandleId(Om),Qn)
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
endif
else
call RemoveSavedBoolean(O,GetHandleId(Om),Qn)
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
endif
set t=null
set Bc=null
set Om=null
endfunction
function WaterPrisonHaloAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local trigger El
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
local unit Om=GetTriggerUnit()
local real Px=LoadReal(O,GetHandleId(t),1)
if GetTriggerEventId()==EVENT_UNIT_TARGET_IN_RANGE then
if IsUnitEnemy(Om,GetOwningPlayer(Bc)) then
if not LoadBoolean(O,GetHandleId(Om),Qn) then
call SaveBoolean(O,GetHandleId(Om),Qn,true)
set El=CreateTrigger()
call SaveAgentHandle(O,GetHandleId(El),0,Bc)
call SaveAgentHandle(O,GetHandleId(El),1,Om)
call SaveReal(O,GetHandleId(El),2,Px)
call TriggerRegisterTimerEvent(El,1,true)
call TriggerRegisterDeathEvent(El,Bc)
call TriggerRegisterDeathEvent(El,Om)
call TriggerAddAction(El,function WaterPrisonHaloActionAction)
set El=null
endif
endif
else
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
endif
set t=null
set Bc=null
set Om=null
endfunction
function RegisterWaterPrisonHalo takes unit Bc,real Px returns nothing
local trigger t=CreateTrigger()
call SaveAgentHandle(O,GetHandleId(t),0,Bc)
call SaveReal(O,GetHandleId(t),1,Px)
call TriggerRegisterUnitInRange(t,Bc,Px,null)
call TriggerRegisterDeathEvent(t,Bc)
call TriggerAddAction(t,function WaterPrisonHaloAction)
set t=null
set Bc=null
endfunction
function DeathAuraCondition takes nothing returns boolean
local trigger t=GetTriggeringTrigger()
local integer Pg=GetHandleId(t)
local unit Bc=LoadUnitHandle(O,GetHandleId(t),1)
local unit D6
local group DG
if GetTriggerEventId()==EVENT_UNIT_DEATH or GetUnitAbilityLevel(Bc,LoadInteger(O,Pg,2))==0 then
call FlushChildHashtable(O,Pg)
call DestroyTrigger(t)
else
set DG=CreateGroup()
call GroupEnumUnitsInRange(DG,GetUnitX(Bc),GetUnitY(Bc),700,null)
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
if IsUnitEnemy(D6,GetOwningPlayer(Bc)) then
call UnitDamageTarget(Bc,D6,GetUnitState(D6,UNIT_STATE_MAX_LIFE)*.025,false,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL,WEAPON_TYPE_WHOKNOWS)
endif
endloop
endif
set t=null
set Bc=null
set DG=null
return false
endfunction
function DeathAura takes unit Bc,integer BF returns nothing
