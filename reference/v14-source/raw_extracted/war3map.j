if GetUnitTypeId(Bc)==$68305657 then
call SetUnitTypeModel(x,"FelHoundFire_Red01.mdx",null)
else
call SetUnitTypeModel(x,"FelHoundFire.mdl",null)
endif
loop
set y=y+1
set Ki=CreateUnit(GetOwningPlayer(Bc),x,GetUnitX(Bc),GetUnitY(Bc),GetUnitFacing(Bc))
call GroupAddUnit(JW,Ki)
call GroupAddUnit(JH[GetUnitUserData(Bc)],Ki)
call SetUnitUserData(Ki,GetUnitUserData(Bc))
exitwhen y>=QK
endloop
set Bc=null
set Ki=null
endfunction
function IllidanEyePrismAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
local unit Bc=LoadUnitHandle(O,GetHandleId(t),0)
local real FF=LoadReal(O,GetHandleId(t),1)
local real FG=LoadReal(O,GetHandleId(t),2)
local group DG
local unit D6
local real P8=10
if GetTriggerEventId()==EVENT_GAME_TIMER_EXPIRED then
if GetTriggerExecCount(t)==1 then
set P8=215
endif
set DG=SelectRange(Bc,FF,FG,200)
loop
set D6=FirstOfGroup(DG)
exitwhen D6==null
call GroupRemoveUnit(DG,D6)
call UnitDamageTargetBJ(Bc,D6,P8,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
endloop
call DestroyGroup(DG)
set DG=null
if GetTriggerExecCount(t)>=13 then
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
endif
else
call FlushChildHashtable(O,GetHandleId(t))
call DestroyTrigger(t)
endif
set t=null
set Bc=null
endfunction
function IllidanEyePrism takes unit Bc,real FF,real FG returns nothing
local real Pm=Atan2BJ(FG-GetUnitY(Bc),FF-GetUnitX(Bc))
local real Qv
local real Qw
local trigger t
local integer BB=0
local effect DE
local string QM="LJQ_Illidanevil_YL1.mdx"
if GetUnitTypeId(Bc)==$68305657 then
set QM="LJQ_IllidanevilRed01_YL1.mdx"
endif
set DE=AddSpecialEffect(QM,GetUnitX(Bc),GetUnitY(Bc))
call EXEffectMatRotateZ(DE,Pm)
call DestroyEffect(DE)
if GetUnitTypeId(Bc)==$68305657 then
set QM="LJQ_IllidanevilRed01_YL2.mdx"
else
set QM="LJQ_Illidanevil_YL2.mdx"
endif
set DE=AddSpecialEffect(QM,GetUnitX(Bc),GetUnitY(Bc))
call EXEffectMatRotateZ(DE,Pm)
call YDWETimerDestroyEffect(13,DE)
loop
set BB=BB+1
set Qv=GetUnitX(Bc)+CosBJ(Pm)*BB*150
set Qw=GetUnitY(Bc)+SinBJ(Pm)*BB*150
set t=CreateTrigger()
call SaveAgentHandle(O,GetHandleId(t),0,Bc)
call SaveReal(O,GetHandleId(t),1,Qv)
call SaveReal(O,GetHandleId(t),2,Qw)
call TriggerRegisterTimerEvent(t,1,true)
call TriggerRegisterTimerEvent(t,0,false)
call TriggerRegisterDeathEvent(t,Bc)
call TriggerAddAction(t,function IllidanEyePrismAction)
exitwhen BB>=4
endloop
set Bc=null
set t=null
set DE=null
endfunction
function IllidanDemonicFrenzyActionAction takes nothing returns nothing
local trigger t=GetTriggeringTrigger()
